        "custom_liquid_79DAKm": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"cl-accordion\">\n\n  <div class=\"cl-item\">\n    <button class=\"cl-header active\" type=\"button\" aria-expanded=\"true\">\n      <span class=\"cl-title\">DESCRIPTION</span>\n      <svg class=\"cl-icon\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <path d=\"M6 9L12 15L18 9\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      </svg>\n    </button>\n    <div class=\"cl-content open\">\n      <div class=\"cl-body\">\n        <p><strong>Ghost Tee is designed for carrying and concealing your handgun comfortably without anyone knowing.</strong></p>\n        <div style=\"text-align: center;\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0950/6740/6647/files/UTUCShirtGIFSquare_1.webp?v=1779438052\" alt=\"2TAC Ghost Tee demo\" style=\"max-width: 100%; height: auto; margin: 16px 0;\">\n        </div>\n        <p>It is made from a unique 4-way stretch MicroPoly/Lycra fabric blend, providing a soft, breathable, and moisture-wicking experience all day long. Look like a regular crew neck tee. Zero attention. Zero printing.</p>\n\n        <p><strong>Dual Built-In Holsters</strong></p>\n        <p>This is perfect for those who carry a handgun daily but struggle to find a comfortable, truly concealable solution.</p>\n        <p>The shirt comes with two built-in holsters — one on each side — accommodating both right and left-hand shooters. Each holster is universal in size, holding virtually any full-size self-defense handgun securely in place.</p>\n\n        <p><strong>Fits Most Gun Sizes</strong></p>\n        <p><img src=\"https://cdn.shopify.com/s/files/1/0624/7134/0266/files/20260324-182735.jpg?v=1774352135\" alt=\"Fits most gun sizes\" style=\"max-width: 100%; height: auto;\"></p>\n        <p>Great concealment shirt for everyday carry. Perfect for your needs.</p>\n        <p>Can fit Compact / Subcompact / Full-Size handguns without printing or bulging. The snug 4-way stretch fabric keeps your weapon firmly in place — no bouncing, no shifting when you move.</p>\n\n        <p><strong>Multiple Ways To Wear</strong></p>\n        <ul>\n          <li>Wear it as a standalone undershirt beneath any outer layer for complete concealment</li>\n          <li>Works as a base layer under button-ups, jackets, or casual tees</li>\n          <li>Trusted by federal agents, law enforcement, special forces, diplomats, executives, doctors, and lawyers worldwide</li>\n        </ul>\n\n        <p><strong>SIZING CHART:</strong></p>\n        <p><img src=\"https://cdn.shopify.com/s/files/1/0950/6740/6647/files/20260509-150557.webp?v=1779437532\" alt=\"Sizing chart\" style=\"max-width: 100%; height: auto;\"></p>\n        <p><strong>Holster Opening:</strong> Precision-sized 2.0\" diameters for a secure and universal gear fit.</p>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"cl-item\">\n    <button class=\"cl-header\" type=\"button\" aria-expanded=\"false\">\n      <span class=\"cl-title\">SHIPPING &amp; RETURNS</span>\n      <svg class=\"cl-icon\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <path d=\"M6 9L12 15L18 9\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      </svg>\n    </button>\n    <div class=\"cl-content\">\n      <div class=\"cl-body\">\n        <p><strong>- Processing Time:</strong> 1 - 3 days</p>\n        <p><strong>- Shipping Time:</strong></p>\n        <p>US mainland: 6 - 11 days</p>\n        <p>Rest of world: 14 - 21 business days</p>\n        <p><strong>- Note:</strong> During peak time, processing and shipping time may be a bit longer. We are sorry for any inconvenience.</p>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"cl-item\">\n    <button class=\"cl-header\" type=\"button\" aria-expanded=\"false\">\n      <span class=\"cl-title\">SATISFACTION GUARANTEE</span>\n      <svg class=\"cl-icon\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <path d=\"M6 9L12 15L18 9\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      </svg>\n    </button>\n    <div class=\"cl-content\">\n      <div class=\"cl-body\">\n        <p>We want you to be satisfied with the products you buy from us.</p>\n        <p>We have 24/7/365 ticket and email support. Please contact us at <a href=\"mailto:support@southedc.com\"><strong>support@southedc.com</strong></a> if you need any assistance.</p>\n      </div>\n    </div>\n  </div>\n\n</div>\n\n<style>\n  .cl-accordion {\n    width: 100%;\n    margin: 20px 0;\n    box-sizing: border-box;\n  }\n\n  .cl-accordion .cl-item {\n    border-bottom: 1px solid #e0e0e0;\n  }\n\n  .cl-accordion .cl-item:first-child {\n    border-top: 1px solid #e0e0e0;\n  }\n\n  .cl-accordion .cl-header {\n    width: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    background: transparent;\n    border: none;\n    padding: 18px 4px;\n    cursor: pointer;\n    font-size: 16px;\n    font-weight: 700;\n    color: #1a1a1a;\n    text-align: left;\n    transition: color 0.2s ease;\n  }\n\n  .cl-accordion .cl-header:hover {\n    color: #555;\n  }\n\n  .cl-accordion .cl-title {\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n  }\n\n  .cl-accordion .cl-icon {\n    flex-shrink: 0;\n    transition: transform 0.3s ease;\n    color: #1a1a1a;\n  }\n\n  .cl-accordion .cl-header.active .cl-icon {\n    transform: rotate(180deg);\n  }\n\n  .cl-accordion .cl-content {\n    max-height: 0;\n    overflow: hidden;\n    transition: max-height 0.4s ease;\n  }\n\n  .cl-accordion .cl-content.open {\n    max-height: 5000px;\n  }\n\n  .cl-accordion .cl-body {\n    padding: 4px 4px 18px;\n    font-size: 14px;\n    line-height: 1.6;\n    color: #333;\n  }\n\n  .cl-accordion .cl-body p {\n    margin: 0 0 10px;\n  }\n\n  .cl-accordion .cl-body ul {\n    margin: 0 0 10px;\n    padding-left: 22px;\n  }\n\n  .cl-accordion .cl-body li {\n    margin-bottom: 6px;\n  }\n\n  .cl-accordion .cl-body img {\n    border-radius: 4px;\n  }\n\n  .cl-accordion .cl-body a {\n    color: #1a1a1a;\n    text-decoration: underline;\n  }\n\n  @media (max-width: 768px) {\n    .cl-accordion .cl-header {\n      font-size: 14px;\n      padding: 15px 4px;\n    }\n    .cl-accordion .cl-body {\n      font-size: 13px;\n    }\n  }\n</style>\n\n<script>\n  (function() {\n    var accordion = document.querySelector('.cl-accordion');\n    if (!accordion) return;\n\n    var headers = accordion.querySelectorAll('.cl-header');\n\n    headers.forEach(function(header) {\n      header.addEventListener('click', function() {\n        var content = header.nextElementSibling;\n        var isOpen = header.classList.contains('active');\n\n        // Đóng tất cả các item khác (chế độ accordion - chỉ mở 1 lúc)\n        headers.forEach(function(h) {\n          h.classList.remove('active');\n          h.setAttribute('aria-expanded', 'false');\n          h.nextElementSibling.classList.remove('open');\n        });\n\n        // Mở item được click (nếu đang đóng)\n        if (!isOpen) {\n          header.classList.add('active');\n          header.setAttribute('aria-expanded', 'true');\n          content.classList.add('open');\n        }\n      });\n    });\n  })();\n</script>"
          }
        }
      },
