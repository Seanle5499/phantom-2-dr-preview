            "custom_liquid": "<div class=\"pb-testimonial-custom\">\n  <img class=\"pb-test-avatar\" src=\"https://cdn.shopify.com/s/files/1/0950/6740/6647/files/Screenshot_12_fb1d96f9-788a-4fb4-a7d8-bc383a7e6dd1.webp?v=1779438051\" alt=\"Joe\" width=\"50\" height=\"50\" loading=\"lazy\">\n  <div class=\"pb-test-content\">\n    <p class=\"pb-test-quote\">\"Best shop around for your tactical needs! Quality is great, exactly what I expect from reliable gear.</p>\n    <div class=\"pb-test-meta\">\n      <span class=\"pb-test-author\">Joe</span>\n      <span class=\"pb-test-verified\">\n        <svg class=\"pb-test-icon\" width=\"16\" height=\"16\" viewBox=\"0 0 22 22\" xmlns=\"http://www.w3.org/2000/svg\">\n          <path d=\"M20.396 11c-.018-.646-.215-1.275-.57-1.816-.354-.54-.852-.972-1.438-1.246.223-.607.27-1.264.14-1.897-.131-.634-.437-1.218-.882-1.687-.47-.445-1.053-.75-1.687-.882-.633-.13-1.29-.083-1.897.14-.273-.587-.704-1.086-1.245-1.44S11.647 1.62 11 1.604c-.646.017-1.273.213-1.813.568s-.969.854-1.24 1.44c-.608-.223-1.267-.272-1.902-.14-.635.13-1.22.436-1.69.882-.445.47-.749 1.055-.878 1.688-.13.633-.08 1.29.144 1.896-.587.274-1.087.705-1.443 1.245-.356.54-.555 1.17-.574 1.817.02.647.218 1.276.574 1.817.356.54.856.972 1.443 1.245-.224.606-.274 1.263-.144 1.896.13.634.433 1.218.877 1.688.47.443 1.054.747 1.687.878.633.132 1.29.084 1.897-.136.274.586.705 1.084 1.246 1.439.54.354 1.17.551 1.816.569.647-.016 1.276-.213 1.817-.567s.972-.854 1.245-1.44c.604.239 1.266.296 1.903.164.636-.132 1.22-.447 1.68-.907.46-.46.776-1.044.908-1.681s.075-1.299-.165-1.903c.586-.274 1.084-.705 1.439-1.246.354-.54.551-1.17.569-1.816zM9.662 14.85l-3.429-3.428 1.293-1.302 2.072 2.072 4.4-4.794 1.347 1.246z\" fill=\"currentColor\"/>\n        </svg>\n        Verified buyer\n      </span>\n    </div>\n  </div>\n</div>\n\n<div class=\"pb-viewing-now\">\n  <span class=\"pb-live-dot\"></span>\n  <span class=\"pb-viewing-text\"><strong><span id=\"pbRandomNumber\">18</span> People are viewing this right now</strong></span>\n</div>\n\n<style>\n  .pb-testimonial-custom {\n    display: flex;\n    align-items: flex-start;\n    gap: 14px;\n    background: #f4f4f4;\n    border-radius: 10px;\n    padding: 14px 16px;\n    margin: 14px 0 10px;\n    box-sizing: border-box;\n  }\n  .pb-test-avatar {\n    width: 50px;\n    height: 50px;\n    border-radius: 50%;\n    object-fit: cover;\n    flex-shrink: 0;\n  }\n  .pb-test-content {\n    flex: 1;\n    min-width: 0;\n  }\n  .pb-test-quote {\n    margin: 0 0 6px;\n    font-size: 14px;\n    line-height: 1.45;\n    color: #1a1a1a;\n  }\n  .pb-test-meta {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    font-size: 13px;\n    color: #666;\n    font-style: italic;\n  }\n  .pb-test-author {\n    font-weight: 500;\n  }\n  .pb-test-verified {\n    display: inline-flex;\n    align-items: center;\n    gap: 4px;\n    color: #666;\n  }\n  .pb-test-icon {\n    color: #2196f3;\n    flex-shrink: 0;\n  }\n\n  .pb-viewing-now {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    border: 1px solid #e0e0e0;\n    border-radius: 8px;\n    padding: 12px 16px;\n    margin: 10px 0 14px;\n    background: #fff;\n    box-sizing: border-box;\n  }\n  .pb-live-dot {\n    width: 10px;\n    height: 10px;\n    border-radius: 50%;\n    background: #fd0234;\n    flex-shrink: 0;\n    box-shadow: 0 0 0 0 rgba(253, 2, 52, 0.6);\n    animation: pbPulse 1.6s infinite;\n  }\n  @keyframes pbPulse {\n    0% { box-shadow: 0 0 0 0 rgba(253, 2, 52, 0.6); }\n    70% { box-shadow: 0 0 0 8px rgba(253, 2, 52, 0); }\n    100% { box-shadow: 0 0 0 0 rgba(253, 2, 52, 0); }\n  }\n  .pb-viewing-text {\n    font-size: 14px;\n    color: #1a1a1a;\n  }\n\n  @media (max-width: 768px) {\n    .pb-test-avatar { width: 44px; height: 44px; }\n    .pb-test-quote { font-size: 13px; }\n    .pb-test-meta { font-size: 12px; gap: 8px; flex-wrap: wrap; }\n    .pb-viewing-text { font-size: 13px; }\n  }\n</style>\n\n<script>\n  (function() {\n    function pbRand(min, max) {\n      return Math.floor(Math.random() * (max - min + 1)) + min;\n    }\n    function pbUpdate() {\n      var el = document.getElementById('pbRandomNumber');\n      if (el) el.textContent = pbRand(16, 28);\n    }\n    setInterval(pbUpdate, 3000);\n  })();\n</script>"
