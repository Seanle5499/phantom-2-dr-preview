            "custom_liquid": "<section class=\"qty-bundle-box\">\n  <div class=\"qty-bundle-header\">\n    <span></span>\n    <strong>BUNDLE & SAVE</strong>\n    <span></span>\n  </div>\n\n  <div id=\"qty-bundle-options\"></div>\n\n  <button type=\"button\" id=\"qty-bundle-add\">ADD TO CART</button>\n</section>\n\n<style>\n.qty-bundle-box{\n  width:100%;\n  max-width:680px;\n  margin:14px 0;\n  font-family:inherit;\n}\n\n.qty-bundle-header{\n  display:grid;\n  grid-template-columns:1fr auto 1fr;\n  align-items:center;\n  gap:14px;\n  margin-bottom:10px;\n  font-size:15px;\n  font-weight:900;\n  color:#111;\n}\n\n.qty-bundle-header span{\n  height:1px;\n  background:#aaa;\n}\n\n.qty-option{\n  position:relative;\n  margin-bottom:8px;\n  border:1px solid #d7d7d7;\n  border-radius:10px;\n  background:#f4f4f4;\n  overflow:hidden;\n}\n\n.qty-option.active{\n  background:#fff;\n  border:2px solid #000;\n}\n\n.qty-main{\n  display:grid;\n  grid-template-columns:28px 1fr auto;\n  gap:10px;\n  align-items:start;\n  padding:12px 16px;\n  cursor:pointer;\n}\n\n.qty-main input{\n  appearance:none;\n  width:23px;\n  height:23px;\n  border:2px solid #aaa;\n  border-radius:50%;\n  background:#fff;\n  margin-top:4px;\n  position:relative;\n}\n\n.qty-main input:checked{\n  border-color:#000;\n}\n\n.qty-main input:checked:after{\n  content:\"\";\n  position:absolute;\n  inset:4px;\n  background:#000;\n  border-radius:50%;\n}\n\n.qty-title{\n  display:flex;\n  align-items:center;\n  gap:8px;\n  flex-wrap:wrap;\n  font-size:22px;\n  font-weight:900;\n  line-height:1.1;\n  color:#000;\n}\n\n.qty-sub{\n  margin-top:4px;\n  font-size:14px;\n  color:#444;\n}\n\n.qty-badge{\n  display:inline-flex;\n  align-items:center;\n  padding:4px 9px;\n  border-radius:999px;\n  background:#eee;\n  color:#111;\n  font-size:12px;\n  font-weight:900;\n  line-height:1;\n}\n\n.qty-badge-dark{\n  background:#111;\n  color:#fff;\n}\n\n.qty-price{\n  text-align:right;\n  font-size:22px;\n  font-weight:900;\n  color:#000;\n  line-height:1.1;\n  white-space:nowrap;\n}\n\n.qty-price s{\n  display:block;\n  margin-top:6px;\n  font-size:13px;\n  color:#666;\n  font-weight:500;\n}\n\n.qty-popular{\n  position:absolute;\n  right:14px;\n  top:0;\n  z-index:5;\n  background:#000;\n  color:#fff;\n  padding:5px 11px;\n  border-radius:0 0 6px 6px;\n  font-size:12px;\n  font-weight:900;\n}\n\n.qty-variants{\n  display:none;\n  padding:0 16px 12px 42px;\n}\n\n.qty-option.active .qty-variants{\n  display:block;\n}\n\n.qty-label{\n  margin:0 0 7px 0;\n  font-size:12px;\n  font-weight:800;\n  color:#555;\n}\n\n.qty-variant-row{\n  display:flex;\n  align-items:center;\n  gap:8px;\n  margin-bottom:6px;\n}\n\n.qty-variant-row img,\n.qty-free-row img{\n  width:32px;\n  height:32px;\n  object-fit:cover;\n  border-radius:6px;\n  background:#fff;\n  border:1px solid #e5e5e5;\n  flex:0 0 32px;\n}\n\n.qty-variant-row select,\n.qty-free-row select{\n  height:32px;\n  border:1px solid #cfcfcf;\n  border-radius:6px;\n  background:#fff;\n  color:#000;\n  padding:0 8px;\n  font-size:13px;\n  font-weight:800;\n}\n\n.qty-color{\n  width:118px;\n}\n\n.qty-size{\n  width:90px;\n}\n\n.qty-free-row{\n  display:flex;\n  align-items:center;\n  gap:8px;\n  margin:8px -16px -12px -42px;\n  padding:9px 12px;\n  background:#000;\n  color:#fff;\n}\n\n.qty-free-row strong{\n  font-size:13px;\n  font-weight:900;\n  white-space:nowrap;\n  margin-right:6px;\n  color:#fff;\n}\n\n.qty-free-compare{\n  margin-left:auto;\n  font-size:13px;\n  color:#fff;\n  text-decoration:line-through;\n  opacity:.85;\n}\n\n#qty-bundle-add{\n  width:100%;\n  margin-top:10px;\n  background:linear-gradient(#30383f,#1d252b);\n  color:#fff;\n  border:2px solid #000;\n  border-radius:8px;\n  padding:15px 20px;\n  font-size:18px;\n  font-weight:900;\n  cursor:pointer;\n}\n\n#qty-bundle-add:disabled{\n  opacity:.6;\n  cursor:not-allowed;\n}\n\n@media(max-width:640px){\n  .qty-main{\n    grid-template-columns:28px 1fr;\n  }\n\n  .qty-price{\n    grid-column:2;\n    text-align:left;\n    margin-top:6px;\n  }\n\n  .qty-variants{\n    padding:0 12px 10px 42px;\n  }\n\n  .qty-free-row{\n    margin:8px -12px -10px -42px;\n    flex-wrap:wrap;\n  }\n\n  .qty-color{\n    width:110px;\n  }\n\n  .qty-size{\n    width:80px;\n  }\n\n  .qty-free-compare{\n    display:none;\n  }\n}\n\n.qty-option:has(.qty-popular) .qty-main{\n  padding-top:28px;\n}\n</style>\n\n<script>\n(function(){\n  document.addEventListener(\"DOMContentLoaded\", async function(){\n    const productHandle = \"2tac-ghost-tee\";\n\n    const bundles = [\n      { id:\"ghost\", title:\"Ghost\", subtitle:\"1 shirt\", qty:1, paidQty:1, discount:0, badge:\"\" },\n      { id:\"two\", title:\"2-Man Cover\", subtitle:\"2 shirts\", qty:2, paidQty:2, discount:5, badge:\"Most popular\" },\n      { id:\"three\", title:\"Fire Team\", subtitle:\"3 shirts\", qty:3, paidQty:3, discount:10, badge:\"\" },\n      { id:\"five\", title:\"Full Squad\", subtitle:\"5 shirts\", qty:5, paidQty:4, discount:20, badge:\"Buy 4 Get 1 Free\", freeText:\"+1 FREE\" }\n    ];\n\n    const optionsWrap = document.getElementById(\"qty-bundle-options\");\n    const addBtn = document.getElementById(\"qty-bundle-add\");\n\n    let product = null;\n    let selectedBundleId = \"two\";\n\n    function money(cents){\n      if(window.Shopify && typeof Shopify.formatMoney === \"function\"){\n        return Shopify.formatMoney(Number(cents || 0));\n      }\n      return \"$\" + (Number(cents || 0) / 100).toFixed(2);\n    }\n\n    function normalizeImage(src){\n      if(!src) return product.featured_image;\n      if(typeof src === \"string\") return src;\n      return src.src || product.featured_image;\n    }\n\n    function getDefaultVariant(){\n      return product.variants.find(v => v.available) || product.variants[0];\n    }\n\n    function getOptionValues(index){\n      const values = [];\n      product.variants.forEach(function(v){\n        const value = v.options[index];\n        if(value && !values.includes(value)) values.push(value);\n      });\n      return values;\n    }\n\n    function findVariant(color, size){\n      return product.variants.find(v => v.available && v.options[0] === color && v.options[1] === size)\n        || product.variants.find(v => v.options[0] === color && v.options[1] === size)\n        || getDefaultVariant();\n    }\n\n    function getImageByColor(color){\n      const variant = product.variants.find(v => v.available && v.options[0] === color && v.featured_image)\n        || product.variants.find(v => v.options[0] === color && v.featured_image);\n\n      return variant && variant.featured_image\n        ? normalizeImage(variant.featured_image)\n        : product.featured_image;\n    }\n\n    function updateRowImage(row){\n      const color = row.querySelector(\".qty-color\").value;\n      const size = row.querySelector(\".qty-size\").value;\n      const img = row.querySelector(\"img\");\n      const variant = findVariant(color, size);\n\n      img.src = variant && variant.featured_image\n        ? normalizeImage(variant.featured_image)\n        : getImageByColor(color);\n    }\n\n    function calcBundlePrice(bundle){\n      const defaultVariant = getDefaultVariant();\n      const base = Number(defaultVariant.price || 0);\n      const compare = Number(defaultVariant.compare_at_price || base);\n      const each = Math.round(base * (100 - bundle.discount) / 100);\n\n      return {\n        total: each * bundle.paidQty,\n        compare: compare * bundle.qty,\n        each: each\n      };\n    }\n\n    function render(){\n      const defaultVariant = getDefaultVariant();\n      const colors = getOptionValues(0);\n      const sizes = getOptionValues(1);\n      const compareEach = Number(defaultVariant.compare_at_price || defaultVariant.price || 0);\n\n      optionsWrap.innerHTML = bundles.map(function(bundle){\n        const price = calcBundlePrice(bundle);\n        const active = bundle.id === selectedBundleId;\n        let rows = \"\";\n\n        for(let i = 0; i < bundle.qty; i++){\n          const isFree = bundle.freeText && i === bundle.qty - 1;\n          const defaultColor = defaultVariant.options[0];\n          const defaultSize = defaultVariant.options[1];\n          const defaultImage = defaultVariant.featured_image\n            ? normalizeImage(defaultVariant.featured_image)\n            : getImageByColor(defaultColor);\n\n          rows += `\n            <div class=\"${isFree ? \"qty-free-row\" : \"qty-variant-row\"}\">\n              <img src=\"${defaultImage}\" alt=\"${product.title}\" loading=\"lazy\">\n\n              ${isFree ? `<strong>${bundle.freeText}</strong>` : \"\"}\n\n              <select class=\"qty-color\">\n                ${colors.map(color => `\n                  <option value=\"${color}\" ${color === defaultColor ? \"selected\" : \"\"}>${color}</option>\n                `).join(\"\")}\n              </select>\n\n              <select class=\"qty-size\">\n                ${sizes.map(size => `\n                  <option value=\"${size}\" ${size === defaultSize ? \"selected\" : \"\"}>${size}</option>\n                `).join(\"\")}\n              </select>\n\n              ${isFree ? `<span class=\"qty-free-compare\">${money(compareEach)}</span>` : \"\"}\n            </div>\n          `;\n        }\n\n        return `\n          <div class=\"qty-option ${active ? \"active\" : \"\"}\" data-bundle-id=\"${bundle.id}\">\n            ${bundle.badge === \"Most popular\" ? `<div class=\"qty-popular\">★ ${bundle.badge}</div>` : \"\"}\n\n            <label class=\"qty-main\">\n              <input type=\"radio\" name=\"qty-bundle\" value=\"${bundle.id}\" ${active ? \"checked\" : \"\"}>\n\n              <div>\n                <div class=\"qty-title\">\n                  ${bundle.title}\n                  ${bundle.badge && bundle.badge !== \"Most popular\" ? `<span class=\"qty-badge qty-badge-dark\">${bundle.badge}</span>` : \"\"}\n                  ${bundle.discount ? `<span class=\"qty-badge\">Save ${bundle.discount}%</span>` : \"\"}\n                </div>\n\n                <div class=\"qty-sub\">\n                  ${bundle.subtitle}${bundle.qty > 1 ? \" • \" + money(price.each) + \" each\" : \"\"}\n                </div>\n              </div>\n\n              <div class=\"qty-price\">\n                ${money(price.total)}\n                <s>${money(price.compare)}</s>\n              </div>\n            </label>\n\n            <div class=\"qty-variants\">\n              <div class=\"qty-label\">Color, Size</div>\n              ${rows}\n            </div>\n          </div>\n        `;\n      }).join(\"\");\n\n      bindEvents();\n    }\n\n    function bindEvents(){\n      document.querySelectorAll(\"input[name='qty-bundle']\").forEach(function(input){\n        input.addEventListener(\"change\", function(){\n          selectedBundleId = input.value;\n\n          document.querySelectorAll(\".qty-option\").forEach(card => card.classList.remove(\"active\"));\n\n          const activeCard = document.querySelector('.qty-option[data-bundle-id=\"' + selectedBundleId + '\"]');\n          if(activeCard) activeCard.classList.add(\"active\");\n        });\n      });\n\n      document.querySelectorAll(\".qty-color, .qty-size\").forEach(function(select){\n        select.addEventListener(\"change\", function(){\n          const row = select.closest(\".qty-variant-row, .qty-free-row\");\n          if(row) updateRowImage(row);\n        });\n      });\n    }\n\n    function getSelectedBundle(){\n      return bundles.find(bundle => bundle.id === selectedBundleId) || bundles[0];\n    }\n\n    function getSelectedItems(){\n      const bundle = getSelectedBundle();\n      const activeCard = document.querySelector('.qty-option[data-bundle-id=\"' + bundle.id + '\"]');\n      const rows = activeCard.querySelectorAll(\".qty-variant-row, .qty-free-row\");\n      const items = [];\n\n      rows.forEach(function(row){\n        const color = row.querySelector(\".qty-color\").value;\n        const size = row.querySelector(\".qty-size\").value;\n        const variant = findVariant(color, size);\n\n        if(variant && variant.available){\n          items.push({\n            id:Number(variant.id),\n            quantity:1\n          });\n        }\n      });\n\n      return items;\n    }\n\n    function getSectionsToRender(){\n      const sections = [];\n\n      if(document.querySelector(\"cart-drawer\")) sections.push(\"cart-drawer\");\n      if(document.querySelector(\"cart-notification\")) sections.push(\"cart-notification-product\", \"cart-notification-button\");\n\n      sections.push(\"cart-icon-bubble\");\n\n      return [...new Set(sections)];\n    }\n\n    function openCartDrawerFromResponse(parsedState){\n      const cartDrawer = document.querySelector(\"cart-drawer\");\n      const cartNotification = document.querySelector(\"cart-notification\");\n\n      if(cartDrawer && typeof cartDrawer.renderContents === \"function\"){\n        cartDrawer.classList.remove(\"is-empty\");\n        cartDrawer.renderContents(parsedState);\n        return;\n      }\n\n      if(cartNotification && typeof cartNotification.renderContents === \"function\"){\n        cartNotification.renderContents(parsedState);\n        return;\n      }\n\n      document.dispatchEvent(new CustomEvent(\"cart:refresh\", { bubbles:true, detail:parsedState }));\n      document.dispatchEvent(new CustomEvent(\"cart:updated\", { bubbles:true, detail:parsedState }));\n      document.dispatchEvent(new CustomEvent(\"cart:open\", { bubbles:true, detail:parsedState }));\n\n      const cartIcon =\n        document.querySelector(\"#cart-icon-bubble\") ||\n        document.querySelector(\"a[href='/cart']\") ||\n        document.querySelector(\"a[href='/cart/']\");\n\n      if(cartIcon) cartIcon.click();\n    }\n\n    async function addToCart(){\n      const items = getSelectedItems();\n\n      if(!items.length){\n        alert(\"Selected variants are not available.\");\n        return;\n      }\n\n      addBtn.disabled = true;\n      addBtn.textContent = \"ADDING...\";\n\n      try{\n        const res = await fetch(\"/cart/add.js\", {\n          method:\"POST\",\n          headers:{\n            \"Content-Type\":\"application/json\",\n            \"Accept\":\"application/json\"\n          },\n          body:JSON.stringify({\n            items:items,\n            sections:getSectionsToRender(),\n            sections_url:window.location.pathname\n          })\n        });\n\n        const parsedState = await res.json();\n\n        if(!res.ok){\n          console.error(\"Shopify add cart error:\", parsedState);\n          alert(parsedState.description || parsedState.message || \"Cannot add products to cart.\");\n          throw new Error(parsedState.description || parsedState.message || \"Add to cart failed\");\n        }\n\n        openCartDrawerFromResponse(parsedState);\n\n        addBtn.textContent = \"ADDED!\";\n\n        setTimeout(function(){\n          addBtn.textContent = \"ADD TO CART\";\n          addBtn.disabled = false;\n        }, 900);\n\n      }catch(error){\n        console.error(error);\n        addBtn.disabled = false;\n        addBtn.textContent = \"ADD TO CART\";\n      }\n    }\n\n    try{\n      const res = await fetch(\"/products/\" + productHandle + \".js\");\n      if(!res.ok) throw new Error(\"Cannot load product: \" + productHandle);\n\n      product = await res.json();\n\n      render();\n      addBtn.addEventListener(\"click\", addToCart);\n\n    }catch(error){\n      console.error(error);\n      document.querySelector(\".qty-bundle-box\").innerHTML = \"<p>Cannot load bundle product.</p>\";\n    }\n  });\n})();\n</script>"
