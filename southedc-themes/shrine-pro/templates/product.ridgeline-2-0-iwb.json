    "rich_text_VxBDAw": {
      "type": "rich-text",
      "blocks": {
        "caption_Uagzby": {
          "type": "caption",
          "settings": {
            "caption": "READY WHEN IT MATTERS",
            "text_style": "caption-with-letter-spacing",
            "text_size": "large"
          }
        },
        "heading_eeFpRt": {
          "type": "heading",
          "settings": {
            "title": "Chest-Level Access In One Clean Motion",
            "title_highlight_color": "#6d388b",
            "heading_size": "h1"
          }
        },
        "text_BLPgBK": {
          "type": "text",
          "settings": {
            "text": "<p>When the belt is buried under a backpack, a coat, or a seatbelt, hip carry doesn't draw. The Ridgeline 2.0 rides at chest level — your hand falls naturally on the grip, and the adjustable retention pulls clean every time. Designed for people who actually carry in the field, not just on the range. See it in action below.</p>"
          }
        }
      },
