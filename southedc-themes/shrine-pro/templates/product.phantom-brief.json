        "custom_liquid_accordion": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"cl-accordion\">\n\n  <div class=\"cl-item\">\n    <button class=\"cl-header active\" type=\"button\" aria-expanded=\"true\">\n      <span class=\"cl-title\">DESCRIPTION</span>\n      <svg class=\"cl-icon\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <path d=\"M6 9L12 15L18 9\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      </svg>\n    </button>\n    <div class=\"cl-content open\">\n      <div class=\"cl-body\">\n        <p><strong>Designed for carrying and concealing your handgun comfortably — without anyone ever knowing.</strong></p>\n        <p>The 2TAC Ghost Brief is engineered for those who carry daily but struggle to find a solution that's truly comfortable, truly concealable, and works with anything you wear.</p>\n        <p>Built from a unique 4-way stretch MicroPoly/Lycra fabric blend, it delivers a soft, breathable, and moisture-wicking fit that moves with your body all day long. Looks like a regular pair of boxer-briefs. Zero attention. Zero printing.</p>\n        <p><strong>Dual Built-In Holsters</strong></p>\n        <p>Features two integrated side pockets — one on each side — accommodating both right and left-hand shooters, or allowing you to carry spare magazines on the opposite side.</p>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"cl-item\">\n    <button class=\"cl-header\" type=\"button\" aria-expanded=\"false\">\n      <span class=\"cl-title\">SIZE CHART</span>\n      <svg class=\"cl-icon\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <path d=\"M6 9L12 15L18 9\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      </svg>\n    </button>\n    <div class=\"cl-content\">\n      <div class=\"cl-body\">\n        <p>Measure your waist to find the perfect fit:</p>\n        <table style=\"width:100%; border-collapse:collapse; margin-bottom:12px; font-size:13px; text-align:center;\">\n          <thead>\n            <tr style=\"background:#111; color:#fff;\"><th style=\"padding:8px;\">Size</th><th style=\"padding:8px;\">Waist (in.)</th><th style=\"padding:8px;\">Hip (in.)</th></tr>\n          </thead>\n          <tbody>\n            <tr style=\"border-bottom:1px solid #ddd;\"><td style=\"padding:8px; font-weight:700;\">S</td><td style=\"padding:8px;\">29–32</td><td style=\"padding:8px;\">36–39</td></tr>\n            <tr style=\"border-bottom:1px solid #ddd; background:#f9f9f9;\"><td style=\"padding:8px; font-weight:700;\">M</td><td style=\"padding:8px;\">32–35</td><td style=\"padding:8px;\">39–42</td></tr>\n            <tr style=\"border-bottom:1px solid #ddd;\"><td style=\"padding:8px; font-weight:700;\">L</td><td style=\"padding:8px;\">35–38</td><td style=\"padding:8px;\">42–46</td></tr>\n            <tr style=\"border-bottom:1px solid #ddd; background:#f9f9f9;\"><td style=\"padding:8px; font-weight:700;\">XL</td><td style=\"padding:8px;\">38–43</td><td style=\"padding:8px;\">46–50</td></tr>\n            <tr style=\"border-bottom:1px solid #ddd;\"><td style=\"padding:8px; font-weight:700;\">2XL</td><td style=\"padding:8px;\">43–47</td><td style=\"padding:8px;\">45–51</td></tr>\n            <tr style=\"border-bottom:1px solid #ddd; background:#f9f9f9;\"><td style=\"padding:8px; font-weight:700;\">3XL</td><td style=\"padding:8px;\">47–52</td><td style=\"padding:8px;\">48–51</td></tr>\n          </tbody>\n        </table>\n        <p style=\"font-size:12px; color:#c0392b; font-weight:700;\">⚠️ Hygiene Notice: Underwear is final sale and cannot be returned or exchanged due to health and safety regulations.</p>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"cl-item\">\n    <button class=\"cl-header\" type=\"button\" aria-expanded=\"false\">\n      <span class=\"cl-title\">SHIPPING &amp; RETURNS</span>\n      <svg class=\"cl-icon\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <path d=\"M6 9L12 15L18 9\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      </svg>\n    </button>\n    <div class=\"cl-content\">\n      <div class=\"cl-body\">\n        <p><strong>- Processing Time:</strong> 1 - 3 days</p>\n        <p><strong>- Shipping Time:</strong></p>\n        <p>US mainland: 6 - 11 days</p>\n        <p>Rest of world: 14 - 21 business days</p>\n        <p><strong>- Note:</strong> Underwear products are final sale for hygiene reasons. Please check sizing chart carefully before ordering.</p>\n      </div>\n    </div>\n  </div>\n\n</div>\n\n<style>\n  .cl-accordion {\n    width: 100%;\n    margin: 20px 0;\n    box-sizing: border-box;\n  }\n\n  .cl-accordion .cl-item {\n    border-bottom: 1px solid #e0e0e0;\n  }\n\n  .cl-accordion .cl-item:first-child {\n    border-top: 1px solid #e0e0e0;\n  }\n\n  .cl-accordion .cl-header {\n    width: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    background: transparent;\n    border: none;\n    padding: 18px 4px;\n    cursor: pointer;\n    font-size: 16px;\n    font-weight: 700;\n    color: #1a1a1a;\n    text-align: left;\n    transition: color 0.2s ease;\n  }\n\n  .cl-accordion .cl-header:hover {\n    color: #555;\n  }\n\n  .cl-accordion .cl-title {\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n  }\n\n  .cl-accordion .cl-icon {\n    flex-shrink: 0;\n    transition: transform 0.3s ease;\n    color: #1a1a1a;\n  }\n\n  .cl-accordion .cl-header.active .cl-icon {\n    transform: rotate(180deg);\n  }\n\n  .cl-accordion .cl-content {\n    max-height: 0;\n    overflow: hidden;\n    transition: max-height 0.4s ease;\n  }\n\n  .cl-accordion .cl-content.open {\n    max-height: 5000px;\n  }\n\n  .cl-accordion .cl-body {\n    padding: 4px 4px 18px;\n    font-size: 14px;\n    line-height: 1.6;\n    color: #333;\n  }\n\n  .cl-accordion .cl-body p {\n    margin: 0 0 10px;\n  }\n\n  .cl-accordion .cl-body ul {\n    margin: 0 0 10px;\n    padding-left: 22px;\n  }\n\n  .cl-accordion .cl-body li {\n    margin-bottom: 6px;\n  }\n\n  .cl-accordion .cl-body img {\n    border-radius: 4px;\n  }\n\n  .cl-accordion .cl-body a {\n    color: #1a1a1a;\n    text-decoration: underline;\n  }\n\n  @media (max-width: 768px) {\n    .cl-accordion .cl-header {\n      font-size: 14px;\n      padding: 15px 4px;\n    }\n    .cl-accordion .cl-body {\n      font-size: 13px;\n    }\n  }\n</style>\n\n<script>\n  (function() {\n    var accordion = document.querySelector('.cl-accordion');\n    if (!accordion) return;\n\n    var headers = accordion.querySelectorAll('.cl-header');\n\n    headers.forEach(function(header) {\n      header.addEventListener('click', function() {\n        var content = header.nextElementSibling;\n        var isOpen = header.classList.contains('active');\n\n        // Đóng tất cả các item khác (chế độ accordion - chỉ mở 1 lúc)\n        headers.forEach(function(h) {\n          h.classList.remove('active');\n          h.setAttribute('aria-expanded', 'false');\n          h.nextElementSibling.classList.remove('open');\n        });\n\n        // Mở item được click (nếu đang đóng)\n        if (!isOpen) {\n          header.classList.add('active');\n          header.setAttribute('aria-expanded', 'true');\n          content.classList.add('open');\n        }\n      });\n    });\n  })();\n</script>"
          }
        }
      },
