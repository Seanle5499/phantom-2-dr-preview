    "55bd100e-3bbd-426c-a5cf-eed7b2a3706f": {
      "type": "testimonials",
      "blocks": {
        "template--21507361800487__55bd100e-3bbd-426c-a5cf-eed7b2a3706f-column-1": {
          "type": "column",
          "settings": {
            "star_rating": 5,
            "title": "\"Massive Confidence boost, faster draw time\"",
            "text": "<p><em>\"I wasn't expecting the confidence boost this holster gave me. With the breakout draw I feel WAY more prepared and draw faster then ever. Just bought another for my Sig 365.</em></p>",
            "author": "<em>Mike R.</em>"
          }
        },
        "template--21507361800487__55bd100e-3bbd-426c-a5cf-eed7b2a3706f-column-2": {
          "type": "column",
          "settings": {
            "star_rating": 5,
            "title": "\"Fastest draw, completely secure, very comfortable\"",
            "text": "<p>\"I was skeptical about the open channel, but after using it, It\u2019s completely legit, fasest draw I've ever had, completely secure and forget it\u2019s on me half the time. Lives up to the hype, will buy again.\"</p>",
            "author": "<em>Jason T.</em>"
          }
        },
        "template--21507361800487__55bd100e-3bbd-426c-a5cf-eed7b2a3706f-column-3": {
          "type": "column",
          "settings": {
            "star_rating": 5,
            "title": "Very concealable, comfortable all day.",
            "text": "<p>This holster is exactly what I needed. I wear it all day with no problems at all. VERY concealable, and the breakout feature is a game changer. Would recommend.</p>",
            "author": "<em>Chris S.</em>"
          }
        }
      },
      "block_order": [
        "template--21507361800487__55bd100e-3bbd-426c-a5cf-eed7b2a3706f-column-1",
        "template--21507361800487__55bd100e-3bbd-426c-a5cf-eed7b2a3706f-column-2",
        "template--21507361800487__55bd100e-3bbd-426c-a5cf-eed7b2a3706f-column-3"
      ],
