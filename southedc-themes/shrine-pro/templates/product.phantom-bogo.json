            "author_1": "Ryan S. - CCW Instructor",
            "image_1": "shopify://shop_images/image_6.webp",
            "text_1": "<p>As a concealed carry instructor, I recommend the Phantom 2.0 to my students \u2014 it's the only IWB that truly delivers all-day comfort and reliable concealment.</p>",
            "author_2": "",
            "text_2": "",
            "author_3": "",
