
<div class="lp-faq color-{{ section.settings.color_scheme }}" style="--lp-pad-top:{{ section.settings.padding_top }}px;--lp-pad-bottom:{{ section.settings.padding_bottom }}px;">
  <div class="page-width lp-faq__inner">
    {%- if section.settings.eyebrow != blank -%}
      <div class="lp-faq__eyebrow">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="lp-faq__heading title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="lp-faq__list">
      {%- for block in section.blocks -%}
        <details class="lp-faq__item" {% if block.settings.open_default %}open{% endif %} {{ block.shopify_attributes }}>
          <summary class="lp-faq__q">
            <span>{{ block.settings.question }}</span>
            <span class="lp-faq__chev" aria-hidden="true">+</span>
          </summary>
          <div class="lp-faq__a rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
/* LP Spacing & Margin Calibration */
.section-lp-feature + .section-lp-faq,
.section-lp-spec-table + .section-lp-faq,
.section-lp-faq + .section-lp-feature,
.section-lp-faq + .section-lp-spec-table {
  margin-top: 0 !important;
}

.section.section-lp-faq {
  margin-top: 0 !important;
  margin-bottom: 0 !important;
  padding-top: 12px !important;
  padding-bottom: 12px !important;
}

.lp-faq {
  padding: 0 !important;
}

.lp-faq__inner { max-width: 780px; }

/* 3-Tier Font Sizes System */
.lp-faq__eyebrow {
  font-size: 13px !important;
  letter-spacing: 1.5px !important;
  text-transform: uppercase !important;
  font-weight: 700 !important;
  color: #666 !important;
  margin-bottom: 6px !important;
  text-align: center;
}

.lp-faq__heading {
  text-align: center;
  font-size: 24px !important;
  line-height: 1.25 !important;
  font-weight: 800 !important;
  letter-spacing: 0.5px !important;
  text-transform: uppercase !important;
  margin: 0 0 20px 0 !important;
  color: #111 !important;
}

@media screen and (min-width: 750px) {
  .lp-faq__heading {
    font-size: 28px !important;
  }
}

.lp-faq__list { display:grid; gap:.5rem; }
.lp-faq__item { border:1px solid rgba(127,127,127,.2); border-radius:12px; overflow:hidden; }

.lp-faq__q {
  display: flex !important;
  justify-content: space-between;
  gap: 1rem;
  align-items: center;
  padding: 1rem 1.25rem;
  cursor: pointer;
  list-style: none;
}

.lp-faq__q span {
  font-size: 14px !important;
  font-weight: 600;
}

.lp-faq__q::-webkit-details-marker { display:none; }
.lp-faq__chev { font-size:1.4rem; line-height:1; transition: transform .2s; }
.lp-faq__item[open] .lp-faq__chev { transform: rotate(45deg); }

.lp-faq__a,
.lp-faq__a p {
  padding: 0 1.25rem 1.1rem;
  font-size: 15px !important;
  line-height: 1.6 !important;
  color: #333 !important;
}
</style>


{% schema %}
{
  "name": "LP FAQ",
  "tag": "section",
  "class": "section section-lp-faq",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked" },
    { "type": "select", "id": "heading_size", "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 56 }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What kind of steel is the blade made of?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>440C stainless, hardened to 58 HRC. It's a long-running EDC and kitchen-blade steel — good edge retention, easy to bring back to sharp, and resists rust well with basic care.</p>" },
        { "type": "checkbox", "id": "open_default", "label": "Open by default", "default": false }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "LP FAQ",
      "blocks": [
        { "type": "qa", "settings": { "question": "What kind of steel is the blade made of?", "answer": "<p>440C stainless, hardened to 58 HRC — solid edge retention with easy maintenance.</p>" } },
        { "type": "qa", "settings": { "question": "Is this good for outdoor / camp use?", "answer": "<p>Yes. The blade handles rope, cordage, food prep, and general utility work. The wooden handle is contoured for a secure grip even when hands are wet.</p>" } },
        { "type": "qa", "settings": { "question": "How do I keep the edge sharp?", "answer": "<p>A few passes on a basic whetstone or a pull-through sharpener once it starts to drag. Wipe dry after wet use.</p>" } },
        { "type": "qa", "settings": { "question": "What's the warranty?", "answer": "<p>30-day return window plus coverage on manufacturing defects. If anything's off, we repair, replace, or refund.</p>" } },
        { "type": "qa", "settings": { "question": "How long is shipping?", "answer": "<p>Processing 2–4 days, delivery 5–12 days depending on location. Tracking sent as soon as it ships.</p>" } }
      ]
    }
  ]
}
{% endschema %}
