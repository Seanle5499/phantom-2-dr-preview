{% doc %}
  @prompt
    A video carousel, 3 columns, each columns is a video, on mobile version can you make it carousel format, on mobile it still show a part of seccond video, i don't want it

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-carousel-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-video-carousel-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.video_spacing }}px;
    max-width: {{ settings.page_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-video-item-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
    background-color: {{ block.settings.placeholder_bg_color }};
    aspect-ratio: {{ block.settings.aspect_ratio }};
  }

  .ai-video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-video-element-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ block.settings.video_border_radius }}px;
  }

  .ai-video-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.placeholder_bg_color }};
    color: {{ block.settings.placeholder_text_color }};
    border-radius: {{ block.settings.video_border_radius }}px;
    position: relative;
  }

  .ai-video-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.6;
    margin-bottom: 12px;
  }

  .ai-video-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 14px;
    color: {{ block.settings.placeholder_text_color }};
    text-align: center;
    opacity: 0.8;
    pointer-events: none;
  }

  .ai-video-title-{{ ai_gen_id }} {
    margin-top: 16px;
    font-size: {{ block.settings.title_font_size }}px;
    color: {{ block.settings.title_color }};
    text-align: {{ block.settings.text_alignment }};
    font-weight: 600;
  }

  .ai-video-description-{{ ai_gen_id }} {
    margin-top: 8px;
    font-size: {{ block.settings.description_font_size }}px;
    color: {{ block.settings.description_color }};
    text-align: {{ block.settings.text_alignment }};
    line-height: 1.5;
  }

  .ai-video-play-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: {{ block.settings.play_button_size }}px;
    height: {{ block.settings.play_button_size }}px;
    background-color: {{ block.settings.play_button_color }};
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 2;
    opacity: {{ block.settings.play_button_opacity | divided_by: 100.0 }};
  }

  .ai-video-play-button-{{ ai_gen_id }}:hover {
    transform: translate(-50%, -50%) scale(1.1);
    opacity: 1;
  }

  .ai-video-play-button-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.play_button_size }}px * 0.4);
    height: calc({{ block.settings.play_button_size }}px * 0.4);
    fill: {{ block.settings.play_button_icon_color }};
    margin-left: 2px;
  }

  .ai-carousel-navigation-{{ ai_gen_id }} {
    display: none;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-top: 24px;
  }

  .ai-carousel-arrow-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border: none;
    border-radius: 50%;
    background-color: {{ block.settings.arrow_bg_color }};
    color: {{ block.settings.arrow_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-carousel-arrow-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_bg_color }};transform: scale(1.1);
  }

  .ai-carousel-arrow-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  .ai-carousel-arrow-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-carousel-dots-{{ ai_gen_id }} {
    display: none;
    justify-content: center;
    gap: 8px;
  }

  .ai-carousel-dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background-color: {{ block.settings.dot_inactive_color }};
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-carousel-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
    transform: scale(1.5);
  }

  @media screen and (max-width: 990px) {
    .ai-video-carousel-container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-video-carousel-{{ ai_gen_id }} {
      overflow: hidden;
    }

    .ai-video-carousel-container-{{ ai_gen_id }} {
      display: flex;
      overflow: hidden;
      scroll-snap-type: x mandatory;
      gap: 0;padding: 0 16px;
      grid-template-columns: none;
      transition: transform 0.3s ease;
    }

    .ai-video-item-{{ ai_gen_id }} {
      flex: 0 0 calc(100% - 32px);
      scroll-snap-align: start;margin-right: {{ block.settings.mobile_video_spacing }}px;
    }

    .ai-video-item-{{ ai_gen_id }}:last-child {
      margin-right: 0;
    }

    .ai-video-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.9 }}px;
    }

    .ai-video-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_font_size | times: 0.9 }}px;
    }

    .ai-carousel-navigation-{{ ai_gen_id }} {
      display: flex;}

    .ai-carousel-dots-{{ ai_gen_id }} {
      display: flex;
    }
  }
{% endstyle %}<video-carousel-{{ ai_gen_id }}
  class="ai-video-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-video-carousel-container-{{ ai_gen_id }}" data-carousel-container>
    {% for i in (1..3) %}
      {% liquid
        assign video_key = 'video_' | append: i
        assign title_key = 'video_' | append: i | append: '_title'
        assign description_key = 'video_' | append: i | append: '_description'
        assign autoplay_key = 'video_' | append: i | append: '_autoplay'
        assign muted_key = 'video_' | append: i | append: '_muted'
        assign loop_key = 'video_' | append: i | append: '_loop'
        assign controls_key = 'video_' | append: i | append: '_controls'

        assign video = block.settings[video_key]
        assign title = block.settings[title_key]
        assign description = block.settings[description_key]
        assign autoplay = block.settings[autoplay_key]
        assign muted = block.settings[muted_key]
        assign loop = block.settings[loop_key]
        assign controls = block.settings[controls_key]
      %}

      <div class="ai-video-item-{{ ai_gen_id }}" data-slide="{{ forloop.index0 }}">
        <div class="ai-video-wrapper-{{ ai_gen_id }}">
          {% if video != blank %}
            <video
              class="ai-video-element-{{ ai_gen_id }}"
              {% if autoplay %}autoplay{% endif %}
              {% if muted %}muted{% endif %}
              {% if loop %}loop{% endif %}
              {% if controls %}controls{% endif %}
              playsinline
              preload="metadata"
              data-video-index="{{ i }}"
            >
              <source src="{{ video }}" type="video/mp4">
              Your browser does not support the video tag.
            </video>

            {% unless controls or autoplay %}
              <button
                class="ai-video-play-button-{{ ai_gen_id }}"
                aria-label="Play video {{ i }}"
                data-play-button="{{ i }}"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </button>
            {% endunless %}
          {% else %}
            <div class="ai-video-placeholder-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="23 7 16 12 23 17 23 7"></polygon>
                <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
              </svg>
              <div class="ai-video-empty-state-{{ ai_gen_id }}">
                Add video {{ i }}
              </div>
            </div>
          {% endif %}
        </div>

        {% if title != blank %}
          <h3 class="ai-video-title-{{ ai_gen_id }}">{{ title }}</h3>
        {% endif %}

        {% if description != blank %}
          <div class="ai-video-description-{{ ai_gen_id }}">{{ description }}</div>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  <div class="ai-carousel-navigation-{{ ai_gen_id }}">
    <button
      class="ai-carousel-arrow-{{ ai_gen_id }} ai-carousel-prev-{{ ai_gen_id }}"
      aria-label="Previous video"
      data-carousel-prev
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15,18 9,12 15,6"></polyline>
      </svg>
    </button>

    <div class="ai-carousel-dots-{{ ai_gen_id }}" data-carousel-dots>
      {% for i in (1..3) %}
        <button
          class="ai-carousel-dot-{{ ai_gen_id }}{% if forloop.first %} active{% endif %}"
          aria-label="Go to video {{ i }}"
          data-carousel-dot="{{ forloop.index0 }}"></button>
      {% endfor %}
    </div>

    <button
      class="ai-carousel-arrow-{{ ai_gen_id }} ai-carousel-next-{{ ai_gen_id }}"
      aria-label="Next video"
      data-carousel-next
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="9,18 15,12 9,6"></polyline>
      </svg>
    </button>
  </div>
</video-carousel-{{ ai_gen_id }}><script>
  (function() {
    class VideoCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.totalSlides = 3;
        this.isMobile = false;
      }

      connectedCallback() {
        this.videos = this.querySelectorAll('.ai-video-element-{{ ai_gen_id }}');
        this.playButtons = this.querySelectorAll('.ai-video-play-button-{{ ai_gen_id }}');
        this.container = this.querySelector('[data-carousel-container]');
        this.prevButton = this.querySelector('[data-carousel-prev]');
        this.nextButton = this.querySelector('[data-carousel-next]');
        this.dots = this.querySelectorAll('[data-carousel-dot]');
        this.slides = this.querySelectorAll('[data-slide]');

        this.setupEventListeners();
        this.checkMobile();
        this.updateCarousel();

        window.addEventListener('resize', () => {
          this.checkMobile();
          this.updateCarousel();
        });
      }

      checkMobile() {
        this.isMobile = window.innerWidth <= 749;
      }

      setupEventListeners() {
        this.playButtons.forEach((button) => {
          button.addEventListener('click', (e) => {
            const index = e.currentTarget.getAttribute('data-play-button');
            const video = this.querySelector(`[data-video-index="${index}"]`);
            
            if (video) {
              if (video.paused) {
                this.pauseAllVideos();
                video.play();
                button.style.opacity = '0';
              } else {
                video.pause();
                button.style.opacity = '{{ block.settings.play_button_opacity | divided_by: 100.0 }}';
              }
            }
          });
        });

        this.videos.forEach((video) => {
          video.addEventListener('click', () => {
            if (!video.hasAttribute('controls')) {
              const index = video.getAttribute('data-video-index');
              const playButton = this.querySelector(`[data-play-button="${index}"]`);
              
              if (video.paused) {
                this.pauseAllVideos();
                video.play();
                if (playButton) playButton.style.opacity = '0';
              } else {
                video.pause();
                if (playButton) playButton.style.opacity = '{{ block.settings.play_button_opacity | divided_by: 100.0 }}';
              }
            }
          });

          video.addEventListener('pause', () => {
            const index = video.getAttribute('data-video-index');
            const playButton = this.querySelector(`[data-play-button="${index}"]`);
            if (playButton) playButton.style.opacity = '{{ block.settings.play_button_opacity | divided_by: 100.0 }}';
          });

          video.addEventListener('ended', () => {
            const index = video.getAttribute('data-video-index');
            const playButton = this.querySelector(`[data-play-button="${index}"]`);
            if (playButton) playButton.style.opacity = '{{ block.settings.play_button_opacity | divided_by: 100.0 }}';
          });
        });

        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => {
            this.goToPrevSlide();
          });
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => {
            this.goToNextSlide();
          });
        }

        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => {
            this.goToSlide(index);
          });
        });

        let startX = 0;
        let currentX = 0;
        let isDragging = false;

        this.container.addEventListener('touchstart', (e) => {
          if (!this.isMobile) return;
          startX = e.touches[0].clientX;
          isDragging = true;
        });

        this.container.addEventListener('touchmove', (e) => {
          if (!this.isMobile || !isDragging) return;
          currentX = e.touches[0].clientX;
        });

        this.container.addEventListener('touchend', () => {
          if (!this.isMobile || !isDragging) return;
          const diff = startX - currentX;
          const threshold = 50;

          if (Math.abs(diff) > threshold) {
            if (diff > 0) {
              this.goToNextSlide();
            } else {
              this.goToPrevSlide();
            }
          }

          isDragging = false;
        });
      }

      goToPrevSlide() {
        if (!this.isMobile) return;
        this.currentSlide = this.currentSlide > 0 ? this.currentSlide - 1 : this.totalSlides - 1;
        this.updateCarousel();
      }

      goToNextSlide() {
        if (!this.isMobile) return;
        this.currentSlide = this.currentSlide < this.totalSlides - 1 ? this.currentSlide + 1 : 0;
        this.updateCarousel();
      }

      goToSlide(index) {
        if (!this.isMobile) return;
        this.currentSlide = index;
        this.updateCarousel();
      }

      updateCarousel() {
        if (!this.isMobile) return;

        const slideWidth = 100;
        const spacing = {{ block.settings.mobile_video_spacing }};
        const translateX = -(this.currentSlide * (slideWidth + (spacing / (this.container.offsetWidth /100))));

        this.container.style.transform = `translateX(calc(-${this.currentSlide * 100}% - ${this.currentSlide * spacing}px))`;

        this.dots.forEach((dot, index) => {
          dot.classList.toggle('active', index === this.currentSlide);
        });

        if (this.prevButton) {
          this.prevButton.disabled = this.currentSlide === 0;
        }

        if (this.nextButton) {
          this.nextButton.disabled = this.currentSlide === this.totalSlides - 1;
        }
      }

      pauseAllVideos() {
        this.videos.forEach((video) => {
          if (!video.paused) {
            video.pause();
          }
        });
        this.playButtons.forEach((button) => {
          button.style.opacity = '{{ block.settings.play_button_opacity | divided_by: 100.0 }}';
        });
      }
    }

    customElements.define('video-carousel-{{ ai_gen_id }}', VideoCarousel{{ ai_gen_id }});
  })();
</script>

