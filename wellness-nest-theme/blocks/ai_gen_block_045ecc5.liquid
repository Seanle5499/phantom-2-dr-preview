{% doc %}
  @prompt
    Create a money-back guarantee banner for product pages with a purple background, featuring a checkmark icon and text that says "Enjoy our 90 day money back guarantee. Less than 0.5% of users ask for their money back". The banner should be styled with rounded corners and appropriate spacing to match the design shown in the uploaded image.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-guarantee-banner-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding }}px;
    border-radius: {{ block.settings.border_radius }}px;
    display: flex;
    align-items: center;
    gap: 12px;
    margin: {{ block.settings.margin }}px 0;
    max-width: 100%;
  }

  .ai-guarantee-banner-icon-{{ ai_gen_id }} {
    flex-shrink: 0;width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    background-color: {{ block.settings.icon_background_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;}

  .ai-guarantee-banner-icon-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.icon_size }}px * 0.6);
    height: calc({{ block.settings.icon_size }}px * 0.6);
    fill: {{ block.settings.icon_color }};
  }

  .ai-guarantee-banner-text-{{ ai_gen_id }} {
    flex-grow: 1;
    font-size: {{ block.settings.font_size }}px;
    line-height: 1.4;
    font-weight: {{ block.settings.font_weight }};
  }

  @media screen and (max-width: 749px) {
    .ai-guarantee-banner-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.8 }}px;
      gap: 10px;
    }

    .ai-guarantee-banner-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div
  class="ai-guarantee-banner-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-guarantee-banner-icon-{{ ai_gen_id }}">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
      <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
  </div>
  <div class="ai-guarantee-banner-text-{{ ai_gen_id }}">
    {{ block.settings.guarantee_text }}
  </div>
</div>

{% schema %}
{
  "name": "Money back guarantee",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "guarantee_text",
      "label": "Guarantee text",
      "default": "Enjoy our 90 day money back guarantee. Less than 0.5% of users ask for their money back"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#7c3aed"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "icon_background_color",
      "label": "Icon background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#7c3aed"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Margin",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Border radius",
      "default": 8
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 20,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Icon size",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Money back guarantee"
    }
  ],
  "tag": null
}
{% endschema %}