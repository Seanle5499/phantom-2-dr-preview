{% doc %}
  @prompt
    I want a video carousel block, for 3 video. On desktop show 3 columns, on mobile show 1 video, on mobile each video is in 1 columns of the carousel

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-carousel-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
  }

  .ai-video-carousel-container-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-video-carousel-wrapper-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.spacing }}px;
    transition: transform 0.3s ease;
  }

  .ai-video-carousel-slide-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    background-color: #000;
  }

  .ai-video-carousel-video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-carousel-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-video-carousel-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    color: #999;
  }

  .ai-video-carousel-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    background-color: rgba(0, 0, 0, 0.7);
    color: white;
    font-size: 12px;
    border-radius: 4px;
    text-align: center;
    pointer-events: none;
  }

  .ai-video-carousel-controls-{{ ai_gen_id }} {
    display: none;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-top: 20px;
  }

  .ai-video-carousel-arrow-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border: none;
    border-radius: 50%;
    background-color: {{ block.settings.control_color }};
    color: {{ block.settings.control_text_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s ease;
  }

  .ai-video-carousel-arrow-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-video-carousel-arrow-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-video-carousel-arrow-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-video-carousel-dots-{{ ai_gen_id }} {
    display: none;
    gap: 8px;
  }

  .ai-video-carousel-dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background-color: {{ block.settings.control_color }};
    opacity: 0.3;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .ai-video-carousel-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-video-carousel-wrapper-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 100%);
      gap: 0;
      transform: translateX(calc(-100% * var(--current-slide, 0)));
    }

    .ai-video-carousel-controls-{{ ai_gen_id }} {
      display: flex;}

    .ai-video-carousel-dots-{{ ai_gen_id }} {
      display: flex;
    }
  }
{% endstyle %}<video-carousel-{{ ai_gen_id }}
  class="ai-video-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-video-carousel-container-{{ ai_gen_id }}">
    <div class="ai-video-carousel-wrapper-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign video_key = 'video_' | append: i
          assign video = block.settings[video_key]
        %}
        <div class="ai-video-carousel-slide-{{ ai_gen_id }}" data-slide="{{ forloop.index0 }}">
          {% if video != blank %}
            <video
              class="ai-video-carousel-video-{{ ai_gen_id }}"
              {% if block.settings.autoplay %}autoplay{% endif %}
              {% if block.settings.muted %}muted{% endif %}
              {% if block.settings.loop %}loop{% endif %}
              {% if block.settings.controls %}controls{% endif %}
              preload="metadata"
            >
              <source src="{{ video.sources[0].url }}" type="{{ video.sources[0].mime_type }}">
              Your browser does not support the video tag.
            </video>
          {% else %}
            <div class="ai-video-carousel-placeholder-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="5,3 19,12 5,21"></polygon>
              </svg><div class="ai-video-carousel-empty-state-{{ ai_gen_id }}">
                Add video {{ i }}
              </div>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div></div>

  <div class="ai-video-carousel-controls-{{ ai_gen_id }}">
    <button
      class="ai-video-carousel-arrow-{{ ai_gen_id }} ai-video-carousel-prev-{{ ai_gen_id }}"
      aria-label="Previous video"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15,18 9,12 15,6"></polyline>
      </svg>
    </button>

    <div class="ai-video-carousel-dots-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        <button
          class="ai-video-carousel-dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
          data-slide="{{ forloop.index0 }}"
          aria-label="Go to video {{ forloop.index }}"
        ></button>
      {% endfor %}
    </div>

    <button
      class="ai-video-carousel-arrow-{{ ai_gen_id }} ai-video-carousel-next-{{ ai_gen_id }}"
      aria-label="Next video"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9,18 15,12 9,6"></polyline>
      </svg>
    </button>
  </div>
</video-carousel-{{ ai_gen_id }}><script>
  (function() {
    class VideoCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.totalSlides = 3;
      }

      connectedCallback() {
        this.wrapper = this.querySelector('.ai-video-carousel-wrapper-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-video-carousel-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-video-carousel-next-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-video-carousel-dot-{{ ai_gen_id }}');
        this.setupEventListeners();
        this.updateCarousel();
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.previousSlide());
        this.nextButton.addEventListener('click', () => this.nextSlide());
        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => this.goToSlide(index));
        });

        let startX = 0;
        let endX = 0;

        this.addEventListener('touchstart', (e) => {
          startX = e.touches[0].clientX;
        });

        this.addEventListener('touchend', (e) => {
          endX = e.changedTouches[0].clientX;this.handleSwipe();
        });
      }

      handleSwipe() {
        const threshold = 50;
        const diff = startX - endX;

        if (Math.abs(diff) > threshold) {
          if (diff > 0) {
            this.nextSlide();
          } else {
            this.previousSlide();
          }
        }
      }

      previousSlide() {
        this.currentSlide = this.currentSlide > 0 ? this.currentSlide - 1 : this.totalSlides - 1;
        this.updateCarousel();
      }

      nextSlide() {
        this.currentSlide = this.currentSlide < this.totalSlides - 1 ? this.currentSlide + 1 : 0;
        this.updateCarousel();
      }

      goToSlide(index) {
        this.currentSlide = index;
        this.updateCarousel();
      }

      updateCarousel() {
        this.wrapper.style.setProperty('--current-slide', this.currentSlide);
        
        this.prevButton.disabled = this.currentSlide === 0;
        this.nextButton.disabled = this.currentSlide === this.totalSlides - 1;

        this.dots.forEach((dot, index) => {
          dot.classList.toggle('active', index === this.currentSlide);
        });
      }
    }

    customElements.define('video-carousel-{{ ai_gen_id }}', VideoCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Video carousel",
  "settings": [
    {
      "type": "header",
      "content": "Videos"
    },
    {
      "type": "video",
      "id": "video_1",
      "label": "Video 1"
    },
    {
      "type": "video",
      "id": "video_2",
      "label": "Video 2"
    },
    {
      "type": "video",
      "id": "video_3",
      "label": "Video 3"
    },
    {
      "type": "header",
      "content": "Video settings"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay videos",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "muted",
      "label": "Mute videos",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop videos",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "controls",
      "label": "Show video controls",
      "default": true
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "spacing",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Space between videos",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 8
    },
    {
      "type": "color",
      "id": "control_color",
      "label": "Control color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "control_text_color",
      "label": "Control icon color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Video carousel"
    }
  ]
}
{% endschema %}