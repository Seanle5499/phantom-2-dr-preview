  <script>
const experts = [
  {
    avt: "https://im8health.com/cdn/shop/files/Frame_1000004731.png?v=1727767462&width=600",
    name: "Prof. Suzanne Devkota",
    desc: "Director of Cedars-Sinai Human Microbiome Research Institute"
  },
  {
    avt: "https://im8health.com/cdn/shop/files/Frame_1000004729.png?v=1727767462&width=600",
    name: "Dr. James L. Green",
    desc: "Former Chief Scientist of NASA"
  },
  {
    avt: "https://im8health.com/cdn/shop/files/sab_Dawn_grid.jpg?v=1747304298&width=600",
    name: "Dr. Dawn Mussallem",
    desc: "CMO of Fountain Life & Integrative Oncologist at Mayo Clinic"
  },
  {
    avt: "https://im8health.com/cdn/shop/files/Dr._James_D.png?v=1730708665&width=600",
    name: "Dr. James DiNicolantonio",
    desc: "Cardiovascular Research Scientist and Doctor of Pharmacy"
  },
  {
    avt: "https://im8health.com/cdn/shop/files/sab_London_headshot.jpg?v=1741755281&width=600",
    name: "Dr. Jeremy London",
    desc: "Board Certified Cardiovascular Surgeon"
  },
  {
    avt: "https://im8health.com/cdn/shop/files/sab_Shah_headshot.jpg?v=1741754337&width=600",
    name: "Dr. Amy Shah",
    desc: "Double-Board Certified Physician & Host of Podcast \"Save Yourself\""
  },
  {
    avt: "https://im8health.com/cdn/shop/files/sab_Suppiah_headshot.jpg?v=1750043459&width=600",
    name: "Dr. Ara Suppiah",
    desc: "Performance Strategist, Sports Physician, Creator of Functional Sports Medicine"
  },
  {
    avt: "https://im8health.com/cdn/shop/files/sab_DarshanShah_headshot.jpg?v=1750043459&width=600",
    name: "Dr. Darshan Shah",
    desc: "Board Certified Surgeon & Physician, CEO and Founder of Next Health"
  },
  {
    avt: "https://im8health.com/cdn/shop/files/sab_Hill_headshot.jpg?v=1750043459&width=600",
    name: "Simon Hill",
    desc: "MSc, BSc, Nutritionist, Physiologist, Author and Podcast Host"
  }
];

const wrap = document.getElementById("experts-wrap");


experts.forEach(expert => {
  const card = document.createElement("div");
  card.className = "expert-card";
  card.tabIndex = 0;

  card.setAttribute("data-modal-name", expert.name);
  card.setAttribute("data-modal-role", expert.desc);   // ← fix: desc not role
  card.setAttribute("data-modal-img", expert.avt);
  card.setAttribute("data-modal-desc", expert.desc);   // ← fix: desc not role
  card.setAttribute("data-modal-cta-text", "Learn More");
  card.setAttribute("data-modal-cta-url", "#");

  card.innerHTML = `
    <div class="expert-media">
      <div class="expert-photo-bg"></div>
      <img class="expert-photo" src="${expert.avt}" alt="${expert.name}" 
           onerror="this.style.display='none'">
    </div>
    <div class="expert-body">
      <h3 class="expert-name">${expert.name}</h3>
      <p class="expert-title">${expert.desc}</p>
    </div>
    <div class="expert-divider"></div>
    <a class="expert-link" href="#">Learn More <span class="arrow">→</span></a>
  `;

  wrap.appendChild(card);
});


  (function(){
    if (window.__expertsModalInit__) return;
    window.__expertsModalInit__ = true;

    var root = document.getElementById('experts-cards');
    if (!root) return;

    var modal = document.getElementById('experts-modal');
    var imgEl = document.getElementById('experts-modal-img');
    var nameEl = document.getElementById('experts-modal-name');
    var roleEl = document.getElementById('experts-modal-role');
    var descEl = document.getElementById('experts-modal-desc');
    var ctaEl = document.getElementById('experts-modal-cta');
    var ctaTextEl = document.getElementById('experts-modal-cta-text');

    var lastFocus = null;

    function openModal(card){
      if (!card) return;

      lastFocus = document.activeElement;

      var name = card.getAttribute('data-modal-name') || '';
      var role = card.getAttribute('data-modal-role') || '';
      var img = card.getAttribute('data-modal-img') || '';
      var desc = card.getAttribute('data-modal-desc') || '';
      var ctaText = card.getAttribute('data-modal-cta-text') || 'Learn More';
      var ctaUrl = card.getAttribute('data-modal-cta-url') || '#';

      nameEl.textContent = name;
      roleEl.textContent = role;
      descEl.textContent = desc;

      imgEl.src = img;
      imgEl.alt = name;

      ctaTextEl.textContent = ctaText;
      ctaEl.setAttribute('href', ctaUrl);

      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden','false');
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';

      // focus close for accessibility
      var closeBtn = modal.querySelector('[data-close-modal="1"]');
      if (closeBtn) closeBtn.focus();
    }

    function closeModal(){
      if (!modal.classList.contains('is-open')) return;

      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden','true');
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';

      // cleanup image to stop loading if spam opened
      imgEl.src = '';
      imgEl.alt = '';

      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }

    // Event delegation: click card OR link
    root.addEventListener('click', function(e){
      var closeHit = e.target.closest('[data-close-modal="1"]');
      if (closeHit){
        e.preventDefault();
        closeModal();
        return;
      }

      var openHit = e.target.closest('.expert-card');
      if (openHit){
        // prevent anchor default if clicked link
        var a = e.target.closest('a');
        if (a) e.preventDefault();
        openModal(openHit);
      }
    });

    // Click overlay close
    modal.addEventListener('click', function(e){
      if (e.target && e.target.matches('[data-close-modal="1"]')){
        e.preventDefault();
        closeModal();
      }
    });

    // ESC close
    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape') closeModal();
    });
  })();
  </script>
