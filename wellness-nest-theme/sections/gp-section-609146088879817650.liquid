        <h3 class="experts-modal__name" id="experts-modal-name"></h3>
        <div class="experts-modal__role" id="experts-modal-role"></div>
        <p class="experts-modal__desc" id="experts-modal-desc"></p>
        <a class="experts-modal__cta" id="experts-modal-cta" href="#" target="_blank" rel="noopener">
          <span id="experts-modal-cta-text">Learn More</span> <span aria-hidden="true">→</span>
        </a>
      </div>
