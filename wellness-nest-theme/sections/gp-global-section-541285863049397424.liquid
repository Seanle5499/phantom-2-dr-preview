  function createRechargeWidget(productId) {
    const gconfig = {
      productId: productId,
      injectionParent: '.rc-widget-injection-parent-' + productId,
      injectionMethod: 'prepend',
      injectFn: (node, target) => {},
      selectors: {
        price: ['.gf_product-price'],
        variant: ['.gf_variants']
      }
    };

    var ticks = 0;
    var intervalID = setInterval(function() {
      if (window.ReChargeWidget) {
        window.ReChargeWidget.createWidget(gconfig);
        clearInterval(intervalID);
      }
      if (++ticks == 10) {
        clearInterval(intervalID);
      }
    }, 2000);
  }

