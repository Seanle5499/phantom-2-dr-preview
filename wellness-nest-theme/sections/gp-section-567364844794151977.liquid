      <script id="custom-js-gvwbjI2AC2">
        try {
          document.addEventListener('click', function(e) {
  const toggle = e.target.closest('.custom-toggle-selling-plan');
  if (!toggle) return;

  const form = toggle.closest('form[action*="/cart/add"]');
  if (!form) return;

  // 1. Toggle disable trên nút và lấy trạng thái
  const isDisabled = toggle.classList.toggle('disable');

  // 2. Xóa 'disable' trên tất cả .subsave & .normal
  form.querySelectorAll('.subsave, .normal').forEach(el =>
    el.classList.remove('disable')
  );

  // 3. Thêm 'disable' cho nhóm tương ứng
  form.querySelectorAll(isDisabled ? '.subsave' : '.normal').forEach(el =>
    el.classList.add('disable')
  );

  // 4. Xử lý input[name="selling_plan"]
  const input = form.querySelector('input[name="selling_plan"]');
  if (input) {
    input.value = isDisabled
      ? ''
      : (input.getAttribute('data-value') || '');
  }
});

        } catch(err){}
