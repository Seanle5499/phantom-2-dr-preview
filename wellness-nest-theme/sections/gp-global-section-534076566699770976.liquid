        const priceOriginal = rechargeWidget.closest('form').querySelector(".custom-price-sp.custom-price-original");
        const saveReCharge = rechargeWidget.closest('form').querySelector(".save-price-sp.save-price-recharge");
        const saveOriginal = rechargeWidget.closest('form').querySelector(".save-price-sp.save-price-original");

        if (featuredList) {
