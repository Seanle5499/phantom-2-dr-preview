      <script id="custom-js-g-8UCtNeLC">
        try {
          // ╔═══════════════════════════════════════════════════════════════╗
// ║  CONFIG                                                       ║
// ╚═══════════════════════════════════════════════════════════════╝
var PP_PRODUCT_HANDLES = [
    "ageaura-pure-nmn-tmg",
    "ageaura-pure-longevity-peptides",
    "ageaura-pure-urolithin-a"
];

// ╔═══════════════════════════════════════════════════════════════╗
// ║  TEXT                                                         ║
// ╚═══════════════════════════════════════════════════════════════╝
var PP_TEXT = {
    btn_cta: "CLAIM YOUR PROTOCOL →",
    btn_loading: "ADDING...",
    btn_added: "ADDED! ✓",
    alert_loading: "Products are still loading. Please try again.",
    alert_error: "Error adding to cart. Please try again."
};

// ╔═══════════════════════════════════════════════════════════════╗
// ║  STATE                                                        ║
// ╚═══════════════════════════════════════════════════════════════╝
var _ppProducts = [];
var _ppMode = "sub";
var _ppSelectedQty = 3;

// ╔═══════════════════════════════════════════════════════════════╗
// ║  HELPERS                                                      ║
// ╚═══════════════════════════════════════════════════════════════╝
function ppGetSellingPlanId(variant, planIndex) {
    if (!variant.selling_plan_allocations || !variant.selling_plan_allocations.length) return null;

    var groups = {};
    variant.selling_plan_allocations.forEach(function (alloc) {
        var gid = alloc.selling_plan_group_id;
        if (!groups[gid]) groups[gid] = [];
        groups[gid].push(alloc);
    });

    var groupKeys = Object.keys(groups);
    if (!groupKeys.length) return null;

    var plansInGroup = groups[groupKeys[0]];
    if (planIndex < plansInGroup.length) return plansInGroup[planIndex].selling_plan_id;
    return plansInGroup[0].selling_plan_id;
}

function ppGetVariantAndPlanIndex(qty) {
    if (qty === 1) {
        return { variantIndex: 0, planIndex: 0 };
    } else if (qty === 3) {
        return { variantIndex: 0, planIndex: 1 };
    } else if (qty === 9) {
        return { variantIndex: 0, planIndex: 2 };
    }
    return { variantIndex: 0, planIndex: 0 };
}

// ╔═══════════════════════════════════════════════════════════════╗
// ║  UI UPDATE                                                    ║
// ╚═══════════════════════════════════════════════════════════════╝
function ppUpdateUI() {
    var tiersWrap = document.querySelector("[data-pp-tiers]");
    var priceCompare = document.querySelector("[data-pp-compare]");
    var priceSale = document.querySelector("[data-pp-sale]");
    var priceSave = document.querySelector("[data-pp-save]");
    if (!tiersWrap) return;

    var tiers = tiersWrap.querySelectorAll(".pp-tier");
    var prefix = _ppMode === "sub" ? "sub" : "otp";

    tiers.forEach(function (tier) {
        var qty = parseInt(tier.getAttribute("data-qty"), 10);
        var price = tier.getAttribute("data-" + prefix + "-price");
        var compare = tier.getAttribute("data-" + prefix + "-compare");
        var save = tier.getAttribute("data-" + prefix + "-save");
        var cadence = tier.getAttribute("data-sub-cadence");

        tier.querySelector(".pp-tier-price").textContent = price;
        tier.querySelector(".pp-tier-compare").textContent = compare;
        tier.querySelector(".pp-tier-save").textContent = "Save " + save;

        var cadenceEl = tier.querySelector(".pp-tier-cadence");
        if (cadenceEl) {
            cadenceEl.style.display = _ppMode === "sub" ? "" : "none";
            if (_ppMode === "sub") cadenceEl.textContent = "Delivered " + cadence;
        }

        if (qty === _ppSelectedQty) {
            if (priceSale) priceSale.textContent = price;
            if (priceCompare) priceCompare.textContent = compare;
            if (priceSave) priceSave.textContent = "SAVE " + save;
        }
    });
}

// ╔═══════════════════════════════════════════════════════════════╗
// ║  EVENT DELEGATION                                             ║
// ╚═══════════════════════════════════════════════════════════════╝
document.addEventListener("click", function (e) {
    // 1. Thumbnails click
    var thumb = e.target.closest(".pp-thumb");
    if (thumb) {
        var thumbsWrap = thumb.closest("[data-pp-thumbs]");
        if (thumbsWrap) {
            thumbsWrap.querySelectorAll(".pp-thumb").forEach(function (t) {
                t.classList.remove("active");
            });
            thumb.classList.add("active");

            var mainImg = document.getElementById("ppMainImg");
            if (mainImg) {
                var img = thumb.querySelector("img");
                if (img) mainImg.src = img.src;
            }
        }
        return;
    }

    // 2. Toggle Subscribe/One-time click
    var toggleBtn = e.target.closest(".pp-toggle-btn");
    if (toggleBtn) {
        var toggleWrap = toggleBtn.closest("[data-pp-toggle]");
        if (toggleWrap) {
            toggleWrap.querySelectorAll(".pp-toggle-btn").forEach(function (b) {
                b.classList.remove("active");
            });
            toggleBtn.classList.add("active");
            _ppMode = toggleBtn.getAttribute("data-mode");
            ppUpdateUI();
        }
        return;
    }

    // 3. Tier label click
    var tier = e.target.closest(".pp-tier");
    if (tier) {
        var radio = tier.querySelector('input[type="radio"]');
        if (radio) {
            if (e.target !== radio && !radio.checked) {
                radio.checked = true;
                _ppSelectedQty = parseInt(radio.value, 10);
                ppUpdateUI();
            } else if (e.target === radio) {
                _ppSelectedQty = parseInt(radio.value, 10);
                ppUpdateUI();
            }
        }
        return;
    }

    // 4. ATC Button click
    var atcBtn = e.target.closest("[data-pp-atc]");
    if (atcBtn) {
        ppHandleATC(atcBtn);
        return;
    }
});

// ╔═══════════════════════════════════════════════════════════════╗
// ║  ADD TO CART                                                  ║
// ╚═══════════════════════════════════════════════════════════════╝
function ppHandleATC(btn) {
    if (btn.disabled) return;
    if (_ppProducts.length < PP_PRODUCT_HANDLES.length) {
        alert(PP_TEXT.alert_loading);
        return;
    }

    btn.disabled = true;
    btn.classList.add("is-loading");
    btn.textContent = PP_TEXT.btn_loading;

    var items = [];
    var mapping = ppGetVariantAndPlanIndex(_ppSelectedQty);

    _ppProducts.forEach(function (product) {
        var variant = product.variants[mapping.variantIndex];
        if (!variant) variant = product.variants[0]; // fallback
        if (!variant) return;

        var item = {
            id: parseInt(variant.id, 10),
            quantity: _ppSelectedQty
        };

        if (_ppMode === "sub") {
            var spId = ppGetSellingPlanId(variant, mapping.planIndex);
            if (spId) {
                item.selling_plan = parseInt(spId, 10);
            }
        }

        items.push(item);
    });

    fetch((window.Shopify && window.Shopify.routes ? window.Shopify.routes.root : "/") + "cart/clear.js", {
        method: "POST",
        headers: { "Content-Type": "application/json" }
    })
    .then(function () {
        return fetch((window.Shopify && window.Shopify.routes ? window.Shopify.routes.root : "/") + "cart/add.js", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                items: items
            })
        });
    })
    .then(function (res) {
        if (!res.ok) throw new Error("Cart add failed: " + res.status);
        return res.json();
    })
    .then(function (response) {
        btn.textContent = PP_TEXT.btn_added;
        window.location.href = (window.Shopify && window.Shopify.routes ? window.Shopify.routes.root : "/") + "checkout";
    })
    .catch(function (err) {
        console.error("[PP] Add to cart error:", err);
        btn.disabled = false;
        btn.classList.remove("is-loading");
        btn.textContent = PP_TEXT.btn_cta;
        alert(PP_TEXT.alert_error);
    });
}

// ╔═══════════════════════════════════════════════════════════════╗
// ║  FETCH + INIT                                                 ║
// ╚═══════════════════════════════════════════════════════════════╝
var ppPromises = PP_PRODUCT_HANDLES.map(function (handle) {
    return fetch("/products/" + handle + ".js")
        .then(function (r) { return r.json(); })
        .then(function (data) {
            _ppProducts.push(data);
        })
        .catch(function (err) {
            console.error("[PP] Failed to fetch: " + handle, err);
        });
});

Promise.all(ppPromises).then(function () {
    console.log("[PP] All products loaded:", _ppProducts.length);
});

function ppInit() {
    var tiersWrap = document.querySelector("[data-pp-tiers]");
    if (!tiersWrap) {
        setTimeout(ppInit, 50);
        return;
    }
    var checkedRadio = tiersWrap.querySelector('input[name="pp-tier"]:checked');
    if (checkedRadio) {
        _ppSelectedQty = parseInt(checkedRadio.value, 10);
    }
    ppUpdateUI();
}

if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", ppInit);
} else {
    ppInit();
}

        } catch(err){}
      </script>
    
