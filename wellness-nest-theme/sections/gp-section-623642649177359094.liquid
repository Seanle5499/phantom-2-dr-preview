    --pp-text-secondary: #555;
    --pp-text-muted: #888;
    --pp-border: #e5e5e5;
    --pp-border-active: #1a1a1a;
    --pp-bg-card: #fafafa;
    --pp-radius: 10px;
    --pp-font: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;

    font-family: var(--pp-font) !important;
    color: var(--pp-black) !important;
    width: 100% !important;
}

/* ── Reset ── */
.pp-hero *,
.pp-hero *::before,
.pp-hero *::after {
    box-sizing: border-box !important;
    margin: 0 !important;
    padding: 0 !important;
}

/* ── Layout ── */
.pp-hero {
    display: grid !important;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) !important;
    gap: 40px !important;
    max-width: 1200px !important;
    margin: 0 auto !important;
    padding: 20px !important;
    line-height: 1.5 !important;
}

/* ══════════════════════════════
   LEFT COLUMN — Gallery
   ══════════════════════════════ */

.pp-gallery {
    position: sticky !important;
    top: 20px !important;
    align-self: start !important;
    min-width: 0 !important;
}

.pp-main-img {
    width: 100% !important;
    aspect-ratio: 1 / 1 !important;
    border-radius: 12px !important;
    overflow: hidden !important;
    background: #f5f5f5 !important;
    margin-bottom: 12px !important;
}

.pp-main-img img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block !important;
}

/* Thumbnail strip */
.pp-thumb-strip {
    display: flex !important;
    gap: 8px !important;
    overflow-x: auto !important;
    padding-bottom: 4px !important;
    scroll-behavior: smooth !important;
    -webkit-overflow-scrolling: touch !important;
    width: 100% !important;
    max-width: 100% !important;
}

.pp-thumb-strip::-webkit-scrollbar {
    height: 4px !important;
}

.pp-thumb-strip::-webkit-scrollbar-thumb {
    background: #ccc !important;
    border-radius: 2px !important;
}

.pp-thumb {
    flex: 0 0 60px !important;
    width: 60px !important;
    height: 60px !important;
    border-radius: 8px !important;
    overflow: hidden !important;
    border: 2px solid transparent !important;
    cursor: pointer !important;
    background: #f5f5f5 !important;
    padding: 0 !important;
    transition: border-color 0.2s ease !important;
}

.pp-thumb:hover,
.pp-thumb.active {
    border-color: var(--pp-black) !important;
}

.pp-thumb img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block !important;
}

/* Review card */
.pp-review-card {
    margin-top: 20px !important;
    padding: 20px !important;
    background: var(--pp-bg-card) !important;
    border-radius: 12px !important;
    border: 1px solid #eee !important;
}

.pp-review-stars {
    color: var(--pp-black) !important;
    font-size: 16px !important;
    letter-spacing: 2px !important;
    margin-bottom: 10px !important;
}

.pp-review-quote {
    font-size: 14px !important;
    line-height: 1.6 !important;
    color: #333 !important;
    font-style: italic !important;
    margin-bottom: 12px !important;
}

.pp-review-footer {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    font-size: 13px !important;
}

.pp-review-author {
    color: var(--pp-text-secondary) !important;
    font-weight: 500 !important;
}

.pp-review-verified {
    display: flex !important;
    align-items: center !important;
    gap: 4px !important;
    color: var(--pp-text-secondary) !important;
    font-size: 12px !important;
}

/* ══════════════════════════════
   RIGHT COLUMN — Buybox
   ══════════════════════════════ */

.pp-buybox-wrap {
    position: relative !important;
    min-width: 0 !important;
}

.pp-buybox {
    display: flex !important;
    flex-direction: column !important;
    gap: 12px !important;
}

/* Eyebrow */
.pp-eyebrow {
    display: inline-block !important;
    background: var(--pp-black) !important;
    color: #fff !important;
    font-size: 11px !important;
    font-weight: 600 !important;
    letter-spacing: 1.5px !important;
    padding: 5px 12px !important;
    border-radius: 4px !important;
    text-transform: uppercase !important;
    width: fit-content !important;
}

/* Rating */
.pp-rating {
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
    font-size: 13px !important;
    flex-wrap: wrap !important;
}

.pp-stars {
    color: var(--pp-black) !important;
    font-size: 15px !important;
    letter-spacing: 1px !important;
}

.pp-rating-text {
    color: var(--pp-text-secondary) !important;
}

/* Title */
.pp-h1 {
    font-size: 26px !important;
    font-weight: 700 !important;
    line-height: 1.25 !important;
    color: var(--pp-black) !important;
    letter-spacing: -0.3px !important;
}

/* Price block */
.pp-price-block {
    display: flex !important;
    align-items: center !important;
    gap: 10px !important;
    flex-wrap: wrap !important;
}

.pp-compare-price {
    font-size: 16px !important;
    color: #999 !important;
    text-decoration: line-through !important;
}

.pp-sale-price {
    font-size: 28px !important;
    font-weight: 700 !important;
    color: var(--pp-black) !important;
}

.pp-save-badge {
    display: inline-block !important;
    background: var(--pp-black) !important;
    color: #fff !important;
    font-size: 11px !important;
    font-weight: 700 !important;
    padding: 4px 10px !important;
    border-radius: 4px !important;
    letter-spacing: 0.5px !important;
}

/* Intro & desc */
.pp-intro {
    font-size: 15px !important;
    border-top: 1px solid var(--pp-border) !important;
    padding-top: 12px !important;
}

.pp-desc {
    font-size: 14px !important;
    color: #444 !important;
    line-height: 1.65 !important;
}

/* Bullets */
.pp-bullets {
    list-style: none !important;
    padding: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 8px !important;
}

.pp-bullets li {
    display: flex !important;
    align-items: flex-start !important;
    gap: 8px !important;
    font-size: 14px !important;
    color: #333 !important;
    line-height: 1.5 !important;
}

.pp-bullets li svg {
    flex-shrink: 0 !important;
    margin-top: 2px !important;
}

/* ── Tier label ── */
.pp-tier-label {
    text-align: center !important;
    font-size: 12px !important;
    font-weight: 600 !important;
    letter-spacing: 2px !important;
    color: var(--pp-text-muted) !important;
    text-transform: uppercase !important;
    padding: 8px 0 0 !important;
}

/* ── Subscribe / One-time toggle ── */
.pp-purchase-toggle {
    display: flex !important;
    border: 2px solid var(--pp-black) !important;
    border-radius: 8px !important;
    overflow: hidden !important;
}

.pp-toggle-btn {
    flex: 1 !important;
    padding: 12px 16px !important;
    font-size: 14px !important;
    font-weight: 600 !important;
    border: none !important;
    cursor: pointer !important;
    transition: all 0.2s ease !important;
    background: #fff !important;
    color: var(--pp-black) !important;
    text-align: center !important;
}

.pp-toggle-btn.active {
    background: var(--pp-black) !important;
    color: #fff !important;
}

.pp-toggle-btn:not(.active):hover {
    background: #f5f5f5 !important;
}

/* ── Tier cards ── */
.pp-tiers {
    display: flex !important;
    flex-direction: column !important;
    gap: 0 !important;
    overflow: visible !important;
}

.pp-tier {
    display: block !important;
    position: relative !important;
    padding: 16px !important;
    border: 1px solid #e5e5e5 !important;
    border-radius: 12px !important;
    cursor: pointer !important;
    transition: border-color 0.2s ease, background 0.2s ease !important;
    margin-bottom: 12px !important;
    overflow: visible !important;
    background: #fff !important;
}

.pp-tier:last-child {
    margin-bottom: 0 !important;
}

.pp-tier input[type="radio"] {
    position: absolute !important;
    opacity: 0 !important;
    width: 0 !important;
    height: 0 !important;
    pointer-events: none !important;
}

.pp-tier:has(input:checked) {
    border: 2px solid #1a1a1a !important;
    padding: 15px !important;
    background: #fff !important;
    z-index: 1 !important;
}

.pp-tier-inner {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    gap: 12px !important;
}

.pp-tier-radio {
    width: 20px !important;
    height: 20px !important;
    border: 2px solid #d1d1d1 !important;
    border-radius: 50% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-shrink: 0 !important;
    background: #fff !important;
    position: relative !important;
}

.pp-tier:has(input:checked) .pp-tier-radio {
    border-color: #1a1a1a !important;
}

.pp-tier:has(input:checked) .pp-tier-radio::after {
    content: "" !important;
    display: block !important;
    width: 10px !important;
    height: 10px !important;
    background: #1a1a1a !important;
    border-radius: 50% !important;
}

.pp-tier-left {
    display: flex !important;
    flex-direction: column !important;
    gap: 2px !important;
    flex-grow: 1 !important;
    min-width: 0 !important;
}

.pp-tier-name {
    font-size: 15px !important;
    font-weight: 700 !important;
    color: var(--pp-black) !important;
}

.pp-tier-detail {
    font-size: 12px !important;
    color: #666 !important;
}

.pp-tier-cadence {
    font-size: 12px !important;
    color: var(--pp-text-muted) !important;
}

.pp-tier-right {
    text-align: right !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-end !important;
    gap: 2px !important;
    flex-shrink: 0 !important;
}

.pp-tier-save {
    display: inline-block !important;
    background: var(--pp-black) !important;
    color: #fff !important;
    font-size: 10px !important;
    font-weight: 700 !important;
    padding: 3px 8px !important;
    border-radius: 4px !important;
    letter-spacing: 0.3px !important;
}

.pp-tier-price {
    font-size: 22px !important;
    font-weight: 700 !important;
    color: var(--pp-black) !important;
}

.pp-tier-compare {
    font-size: 13px !important;
    color: #999 !important;
    text-decoration: line-through !important;
}

/* Tier badges */
.pp-tier-badge {
    position: absolute !important;
    top: -11px !important;
    left: 16px !important;
    background: var(--pp-black) !important;
    color: #fff !important;
    font-size: 10px !important;
    font-weight: 700 !important;
    padding: 3px 10px !important;
    border-radius: 999px !important;
    letter-spacing: 1px !important;
    text-transform: uppercase !important;
    z-index: 2 !important;
}

.pp-tier-badge--best {
    background: #333 !important;
}

/* ── CTA Button ── */
.pp-atc {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    width: 100% !important;
    padding: 18px 24px !important;
    background: var(--pp-black) !important;
    color: #fff !important;
    border: none !important;
    border-radius: 9999px !important;
    font-size: 16px !important;
    font-weight: 700 !important;
    letter-spacing: 1px !important;
    cursor: pointer !important;
    transition: background 0.35s ease, box-shadow 0.35s ease !important;
    margin-top: 4px !important;
    position: relative !important;
    overflow: hidden !important;
    text-transform: uppercase !important;
    min-height: 54px !important;
}

.pp-atc::before {
    content: '' !important;
    display: block !important;
    position: absolute !important;
    top: 0 !important;
    left: -100% !important;
    width: 100% !important;
    height: 100% !important;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.12), transparent) !important;
    transition: left 0.6s ease !important;
    pointer-events: none !important;
    z-index: 1 !important;
}

.pp-atc:hover {
    background: #333 !important;
}

.pp-atc:hover::before {
    left: 100% !important;
}

.pp-atc.is-loading {
    opacity: 0.7 !important;
    pointer-events: none !important;
}

.pp-atc-sub {
    text-align: center !important;
    font-size: 12px !important;
    color: var(--pp-text-muted) !important;
}

/* ── Trust row ── */
.pp-trust-row {
    display: flex !important;
    justify-content: center !important;
    gap: 20px !important;
    flex-wrap: wrap !important;
    padding: 12px 0 !important;
    font-size: 13px !important;
    color: var(--pp-text-secondary) !important;
    border-top: 1px solid var(--pp-border) !important;
    border-bottom: 1px solid var(--pp-border) !important;
    margin: 8px 0 !important;
}

.pp-trust-item {
    white-space: nowrap !important;
}

/* ── Payment icons ── */
.pp-pay-row {
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    width: 100% !important;
    text-align: center !important;
}

.pp-pay-row img {
    display: inline-block !important;
    max-width: 100% !important;
    height: 24px !important;
    object-fit: contain !important;
    margin: 0 auto !important;
}

/* ── Mini FAQ ── */
.pp-mini-faq {
    border-top: 1px solid var(--pp-border) !important;
    margin-top: 4px !important;
}

.pp-mini-faq details {
    border-bottom: 1px solid var(--pp-border) !important;
}

.pp-mini-faq summary {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    padding: 14px 0 !important;
    font-size: 14px !important;
    font-weight: 600 !important;
    cursor: pointer !important;
    list-style: none !important;
    color: var(--pp-black) !important;
}

.pp-mini-faq summary::-webkit-details-marker {
    display: none !important;
}

.pp-mini-faq summary::marker {
    display: none !important;
    content: "" !important;
}

.pp-faq-icon {
    font-size: 20px !important;
    font-weight: 300 !important;
    color: var(--pp-text-muted) !important;
    transition: transform 0.2s ease !important;
    margin-left: 8px !important;
}

.pp-mini-faq details[open] .pp-faq-icon {
    transform: rotate(90deg) !important;
}

.pp-faq-body {
    padding: 0 0 14px !important;
}

.pp-faq-body p {
    font-size: 13px !important;
    line-height: 1.65 !important;
    color: var(--pp-text-secondary) !important;
}

/* ══════════════════════════════
   RESPONSIVE
   ══════════════════════════════ */

@media (max-width: 768px) {
    .pp-hero {
        grid-template-columns: minmax(0, 1fr) !important;
        gap: 24px !important;
        padding: 16px !important;
    }

    .pp-gallery {
        position: static !important;
        min-width: 0 !important;
    }

    .pp-h1 {
        font-size: 22px !important;
    }

    .pp-sale-price {
        font-size: 24px !important;
    }



    .pp-trust-row {
        gap: 12px !important;
        font-size: 11px !important;
    }

    .pp-thumb {
        flex: 0 0 52px !important;
