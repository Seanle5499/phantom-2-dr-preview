<script>
(function () {
  var PRODUCT_HANDLE = 'test-widget'; // ← chỉ đổi cái này

  var wrap = document.getElementById('gp-fs-wrap');
  var list = wrap.querySelector('.gp-fs-list');

  // ── Fetch variants từ Shopify ──────────────────────────────
  fetch('/products/' + PRODUCT_HANDLE + '.js')
    .then(function(r) { return r.json(); })
    .then(function(data) {
      renderFlavors(data.variants, data.media);
      initInteraction();
    })
    .catch(function(err) { 
      console.error('Flavor fetch failed:', err);
      // Fallback: giữ nguyên HTML tĩnh
      initInteraction();
    });

  // ── Render li items từ variants ────────────────────────────
  function renderFlavors(variants, media) {
    list.innerHTML = '';

    variants.forEach(function(v, i) {
      // Tìm image match với variant title trong media array
      var img = '';
      if (media && media.length) {
        var matched = media.find(function(m) {
          return m.alt && m.alt.toLowerCase().includes(v.title.toLowerCase());
        });
        img = matched ? matched.src : (media[i] ? media[i].src : '');
      }

      var isFirst = i === 0;
      var slug = v.title.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');

      var li = document.createElement('li');
      li.className = 'gp-fs-item' + (isFirst ? ' is-sel' : '');
      li.dataset.value = slug;
      li.dataset.variantId = v.id;  // ← key field cho add to cart
      li.setAttribute('role', 'radio');
      li.setAttribute('aria-checked', isFirst ? 'true' : 'false');
      li.setAttribute('tabindex', '0');

      li.innerHTML =
        '<input type="radio" name="gpflavor" value="' + slug + '"' + (isFirst ? ' checked' : '') + '>' +
        (img ? '<img class="gp-fs-thumb" src="' + img + '" alt="' + v.title + '">' : '') +
        '<div class="gp-fs-text">' +
          '<div class="gp-fs-name">' + v.title +
            (isFirst ? '<span class="gp-fs-badge">Popular</span>' : '') +
          '</div>' +
        '</div>' +
        '<svg class="gp-fs-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">' +
          '<polyline points="20 6 9 17 4 12"/>' +
        '</svg>';

      list.appendChild(li);
    });

    // Set default selected variant
    window.gpSelectedVariantId = variants[0] ? variants[0].id : null;
    window.gpSelectedFlavor    = variants[0] ? variants[0].title.toLowerCase() : null;
  }

  // ── Interaction logic (giữ nguyên logic cũ) ───────────────
  function initInteraction() {
    var items = wrap.querySelectorAll('.gp-fs-item');

    function handleClick(target) {
      if (wrap.classList.contains('is-col')) {
        wrap.classList.remove('is-col');
        return;
      }

      items.forEach(function(item) {
        item.classList.remove('is-sel');
        item.setAttribute('aria-checked', 'false');
        var r = item.querySelector('input[type="radio"]');
        if (r) r.checked = false;
      });

      target.classList.add('is-sel');
      target.setAttribute('aria-checked', 'true');

      var radio = target.querySelector('input[type="radio"]');
      if (radio) {
        radio.checked = true;
        radio.dispatchEvent(new Event('change', { bubbles: true }));
      }

      // Expose ra global để RC widget dùng
      window.gpSelectedFlavor    = target.getAttribute('data-value');
      window.gpSelectedVariantId = parseInt(target.dataset.variantId);

      wrap.classList.add('is-col');
    }

    items.forEach(function(item) {
      item.addEventListener('click', function() { handleClick(this); });
      item.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); handleClick(this); }
      });
    });
  }

}());
</script>
