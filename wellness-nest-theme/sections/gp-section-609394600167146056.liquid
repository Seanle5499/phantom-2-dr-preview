      <style id="custom-css-gmw0Cr7t2n">
        /* ===== Experts Grid (GemPages-safe, scoped) ===== */
#wn-experts-grid.wn-experts-grid{
  width: 100%;
  box-sizing: border-box;
  padding: 10px 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Roboto, Arial, sans-serif;
}

#wn-experts-grid .wn-experts-grid__wrap{
  max-width: 920px;
  margin: 0 auto;
  /*padding: 8px 12px;*/
  box-sizing: border-box;

  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

/* Card */
#wn-experts-grid .wn-expert{
  background: #fff4e8;
  border-radius: 12px;
  border: 1px solid rgba(0,0,0,.05);
  box-shadow: 0 10px 22px rgba(0,0,0,.06);
  overflow: hidden;

  display: flex;
  flex-direction: column;
  min-width: 0; /* critical in grids */
  cursor: pointer;

  transition: transform .18s ease, box-shadow .18s ease;
  will-change: transform;
}

#wn-experts-grid .wn-expert:hover,
#wn-experts-grid .wn-expert:focus-within{
  transform: translateY(-6px);
  box-shadow: 0 18px 40px rgba(0,0,0,.14);
}

#wn-experts-grid .wn-expert__media{
  position: relative;
  padding: 4px 4px 0 4px;
}

#wn-experts-grid .wn-expert__photo{
  width: 100% !important;   /* beat theme img rules */
  height: auto !important;
  aspect-ratio: 1 / 1;
  object-fit: cover;
  object-position: center;
  display: block;
  border-radius: 16px;
  background: linear-gradient(180deg,#f5e9df 0%,#efb6a2 52%,#e58c79 100%);
}

/* Body */
#wn-experts-grid .wn-expert__body{
  padding: 10px 12px 14px;
  text-align: center;
}

#wn-experts-grid .wn-expert__name{
  margin: 0;
  font-size: 14px;
  line-height: 1.25;
  font-weight: 800;
  color: #3a0d12;
}

#wn-experts-grid .wn-expert__role{
  margin: 6px auto 0;
  max-width: 220px;
  font-size: 11.5px;
  line-height: 1.35;
  color: rgba(0,0,0,.55);
}

/* Responsive */
@media (max-width: 768px){
  #wn-experts-grid .wn-experts-grid__wrap{
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
}
@media (max-width: 420px){
  #wn-experts-grid .wn-experts-grid__wrap{
    grid-template-columns: 1fr;
  }
}
      </style>
    
      <script id="custom-js-gmw0Cr7t2n">
        try {
          (() => {
  // Guard: tránh chạy nhiều lần trong GemPages LIVE
  if (window.__WN_EXPERTS_GRID_INIT__) return;
  window.__WN_EXPERTS_GRID_INIT__ = true;

  const DATA = [
    {
      name: "Dr. Dawn Mussallem",
      role: "Cancer Survivor & Physician at Mayo Clinic",
      img: "https://im8health.com/cdn/shop/files/sab_Dawn_grid.jpg?v=1747304298&width=900",
      url: "#"
    },
    {
      name: "Bobby Rich",
      role: "Trainer to David Beckham and World-class Athletes",
      img: "https://im8health.com/cdn/shop/files/Rectangle_3_68b5f4fc-fe48-466d-9d97-487fbdea1942.png?v=1764066245&width=300",
      url: "#"
    },
    {
      name: "Dr. Suzanne Devkota",
      role: "Gut Health Expert & Prof at Cedars Sinai",
      img: "https://im8health.com/cdn/shop/files/Rectangle_5.png?v=1764066392&width=300",
      url: "#"
    },
    {
      name: "Tavi Castro",
      role: "Breathwork Expert & Free-Diving World Record Holder",
      img: "https://im8health.com/cdn/shop/files/Rectangle_5.png?v=1764066392&width=300",
      url: "#"
    },
    {
      name: "Dr. Amy Shah",
      role: "Double-Board Certified Physician and Host of “Save Yourself” Podcast",
      img: "https://im8health.com/cdn/shop/files/Rectangle_7.png?v=1764066430&width=300",
      url: "#"
    },
    {
      name: "Dr. Ara Supplah",
      role: "Performance & Longevity Physician at LIV Golf",
      img: "https://im8health.com/cdn/shop/files/Rectangle_6.png?v=1764066459&width=300",
      url: "#"
    }
  ];

  const esc = (s) =>
    String(s).replace(/[&<>"']/g, (c) => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
    }[c]));

  const buildCard = (x) => `
    <article class="wn-expert" tabindex="0" role="button"
      data-url="${esc(x.url || "#")}"
      aria-label="${esc(x.name)}">
      <div class="wn-expert__media">
        <img class="wn-expert__photo" src="${esc(x.img)}" alt="${esc(x.name)}" loading="lazy">
      </div>
      <div class="wn-expert__body">
        <h3 class="wn-expert__name">${esc(x.name)}</h3>
        <p class="wn-expert__role">${esc(x.role)}</p>
      </div>
    </article>
  `;

  const render = () => {
    const wrap = document.querySelector('#wn-experts-grid [data-wn-experts-wrap]');
    if (!wrap) return false;
    if (wrap.dataset.rendered === "1") return true;

    wrap.innerHTML = DATA.map(buildCard).join("");
    wrap.dataset.rendered = "1";
    return true;
  };

  // Render with retries (GemPages LIVE hay inject DOM muộn)
  const tryRender = () => render() || requestAnimationFrame(render);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", tryRender, { once: true });
  } else {
    tryRender();
  }
  window.addEventListener("load", render, { once: true });

  // Click / keyboard open (event delegation)
  document.addEventListener("click", (e) => {
    const card = e.target.closest("#wn-experts-grid .wn-expert");
    if (!card) return;
    const url = card.getAttribute("data-url") || "#";
    if (url && url !== "#") window.location.href = url;
  });

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Enter" && e.key !== " ") return;
    const card = document.activeElement?.closest?.("#wn-experts-grid .wn-expert");
    if (!card) return;
    e.preventDefault();
    const url = card.getAttribute("data-url") || "#";
    if (url && url !== "#") window.location.href = url;
  });
})();
        } catch(err){}
      </script>
    
