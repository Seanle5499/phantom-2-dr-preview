      <script id="custom-js-gNPqEWLC3O">
        try {
          (() => {
  const cards = document.querySelectorAll('.gNPqEWLC3O');
  if (!cards.length) return;

  cards.forEach(card => {
    // prevent duplicate overlay (GemPages sometimes re-renders)
    if (card.querySelector('.im8-pro-trusted__card-overlay')) return;

    const overlay = document.createElement('div');
    overlay.className = 'im8-pro-trusted__card-overlay';

    overlay.innerHTML = `<div class="im8-pro-trusted__overlay-name">Dustin Poirier</div><div class="im8-pro-trusted__overlay-role">Professional MMA Fighter</div><p class="im8-pro-trusted__card-quote">As a fighter, I've tried it all — endless pills and powders just to keep up. After my team checked out the science, partnering with IM8 was a no-brainer.</p>
                    
                    
    `;

    card.appendChild(overlay);
  });
})();
        } catch(err){}
      </script>
    
