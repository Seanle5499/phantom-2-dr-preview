}
.gps .custom_daily_price {
    font-size: 12px;
    color: #913CB5;
}
.gps .custom_toggle_label.disable,
.gps .custom_unit_price.disable,
.gps .custom_daily_price.disable,
.gps .custom_variant_image.disable,
.gps .custom_benefit_subsave.disable,
.gps .custom_benefit_list-icon.disable{
