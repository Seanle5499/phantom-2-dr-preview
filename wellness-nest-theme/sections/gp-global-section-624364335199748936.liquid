      </style>
    
      <script id="custom-js-gaueBqO6ld">
        try {
          (function(){
  var MN_PRODUCT_HANDLE = "menomate-menopause-probiotic";
  var mnProduct = null;
  var mnMode = "sub";
  var mnSelectedQty = 2;

  var MN_TEXT = {
    cta: "GET MENOMATE TODAY →",
    loading: "ADDING...",
    added: "ADDED! ✓",
    productLoading: "Product is still loading. Please try again.",
    error: "Error adding to cart. Please try again."
  };

  function moneyToNumber(str){
    return parseFloat(String(str).replace(/[^0-9.]/g,"")) || 0;
  }

  function formatMoney(n){
    return "$" + n.toFixed(2);
  }

  function getSelectedTier(){
    return document.querySelector(".mn-tier input:checked")?.closest(".mn-tier");
  }

  function updateSelectedClasses(){
    document.querySelectorAll(".mn-tier").forEach(function(tier){
      var input = tier.querySelector("input");
      tier.classList.toggle("is-selected", !!input && input.checked);
    });
  }

  function updateUI(){
    var tier = getSelectedTier();
    if(!tier) return;

    var price = tier.getAttribute("data-" + mnMode + "-price");
    var compare = tier.getAttribute("data-compare");
    var save = moneyToNumber(compare) - moneyToNumber(price);

    document.querySelectorAll(".mn-tier").forEach(function(t){
      var p = t.getAttribute("data-" + mnMode + "-price");
      var c = t.getAttribute("data-compare");
      var priceEl = t.querySelector(".mn-tier-price");
      var compareEl = t.querySelector(".mn-tier-compare");
      var cadenceEl = t.querySelector(".mn-tier-cadence");

      if(priceEl) priceEl.textContent = p;
      if(compareEl) compareEl.textContent = c;
      if(cadenceEl) cadenceEl.style.display = mnMode === "sub" ? "" : "none";
    });

    var saleEl = document.querySelector("[data-mn-sale]");
    var compareEl = document.querySelector("[data-mn-compare]");
    var saveEl = document.querySelector("[data-mn-save]");

    if(saleEl) saleEl.textContent = price;
    if(compareEl) compareEl.textContent = compare;
    if(saveEl) saveEl.textContent = "SAVE " + formatMoney(save);

    updateSelectedClasses();
  }

  function getSellingPlanId(variant){
    if(!variant || !variant.selling_plan_allocations || !variant.selling_plan_allocations.length){
      return null;
    }

    // Always use the first purchase option:
    // The Test Drive - 1 Bottle
    return variant.selling_plan_allocations[0].selling_plan_id;
  }

  function getOtpExtraDiscountCode(qty){
    if(qty === 4) return "MNMB2G2EXTRA";
    if(qty === 6) return "MNMB3G3EXTRA";
    return "";
  }

  function getSubDiscountCode(qty){
    if(qty === 2) return "MNMB1G1SUB";
    if(qty === 4) return "MNMB2G2SUB";
    if(qty === 6) return "MNMB3G3SUB";
    return "";
  }

  function getCheckoutDiscountCode(){
    if(mnMode === "sub"){
      return getSubDiscountCode(mnSelectedQty);
    }

    if(mnMode === "otp"){
      return getOtpExtraDiscountCode(mnSelectedQty);
    }

    return "";
  }

  function goToCheckoutWithDiscount(discountCode){
    var root = window.Shopify && window.Shopify.routes ? window.Shopify.routes.root : "/";

    if(discountCode){
      window.location.href = root + "checkout?discount=" + encodeURIComponent(discountCode);
    } else {
      window.location.href = root + "checkout";
    }
  }

  function loadProduct(){
    fetch("/products/" + MN_PRODUCT_HANDLE + ".js")
      .then(function(r){ return r.json(); })
      .then(function(product){
        mnProduct = product;
        console.log("[MenoMate Widget] Product loaded:", product.title);
      })
      .catch(function(err){
        console.error("[MenoMate Widget] Product fetch failed:", err);
      });
  }

  document.addEventListener("click", function(e){
    var thumb = e.target.closest(".mn-thumb");
    if(thumb){
      var img = thumb.querySelector("img");
      var main = document.getElementById("mnMainImg");

      document.querySelectorAll(".mn-thumb").forEach(function(btn){
        btn.classList.remove("active");
      });

      thumb.classList.add("active");

      if(img && main) {
        main.src = img.src;
      }

      return;
    }

    var toggle = e.target.closest(".mn-toggle-btn");
    if(toggle){
      document.querySelectorAll(".mn-toggle-btn").forEach(function(btn){
        btn.classList.remove("active");
      });

      toggle.classList.add("active");
      mnMode = toggle.getAttribute("data-mode");
      updateUI();
      return;
    }

    var tier = e.target.closest(".mn-tier");
    if(tier){
      var input = tier.querySelector("input");

      if(input){
        input.checked = true;
        mnSelectedQty = parseInt(input.value, 10);
        updateUI();
      }

      return;
    }

    var atc = e.target.closest("[data-mn-atc]");
    if(atc){
      handleATC(atc);
    }
  });

  function handleATC(btn){
    if(btn.disabled) return;

    if(!mnProduct || !mnProduct.variants || !mnProduct.variants.length){
      alert(MN_TEXT.productLoading);
      return;
    }

    var variant = mnProduct.variants[0];

    var item = {
      id: parseInt(variant.id, 10),
      quantity: mnSelectedQty
    };

    if(mnMode === "sub"){
      var spId = getSellingPlanId(variant);

      if(spId){
        item.selling_plan = parseInt(spId, 10);
      }
    }

    btn.disabled = true;
    btn.classList.add("is-loading");
    btn.textContent = MN_TEXT.loading;

    fetch((window.Shopify && window.Shopify.routes ? window.Shopify.routes.root : "/") + "cart/add.js", {
      method: "POST",
      headers: {
        "Content-Type":"application/json"
      },
      body: JSON.stringify({
        items:[item]
      })
    })
    .then(function(res){
      if(!res.ok) throw new Error("Cart add failed");
      return res.json();
    })
    .then(function(){
      btn.textContent = MN_TEXT.added;

      var discountCode = getCheckoutDiscountCode();

      goToCheckoutWithDiscount(discountCode);
    })
    .catch(function(err){
      console.error("[MenoMate Widget] Add to cart error:", err);
      btn.disabled = false;
      btn.classList.remove("is-loading");
      btn.textContent = MN_TEXT.cta;
      alert(MN_TEXT.error);
    });
  }

  updateUI();
  loadProduct();
})();
        } catch(err){}
      </script>
    
    </div>

      
    </gp-row>
  
        </section>
      
  
    
