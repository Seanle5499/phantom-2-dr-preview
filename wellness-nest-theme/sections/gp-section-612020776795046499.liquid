      <style id="custom-css-gG2EAT5-8h">
        /* =========================
   PRO TRUSTED CARD OVERLAY
   Clean version (no duplicates)
   ========================= */

/* Card wrapper */
.gG2EAT5-8h{
  position: relative;
  overflow: hidden !important;
      width: 100%;
    height: 100%;
    min-height: 460px;
    flex: 1;
    overflow: hidden;
    background: linear-gradient(135deg, #4A0E18 0%, #50000B 50%, #4A0E18 100%);
  border-radius: 20px;
}

/* Overlay layer (created by JS) */
.gG2EAT5-8h .im8-pro-trusted__card-overlay{
  position: absolute;
  inset: 0;
  z-index: 4;

  display: flex;
  flex-direction: column;
  justify-content: flex-end;

  padding: 28px 24px;
  border-radius: 20px;

  background: linear-gradient(
    180deg,
    rgba(48, 8, 14, 0) 0%,
    rgba(48, 8, 14, 0.35) 25%,
    rgba(48, 8, 14, 0.82) 52%,
    rgba(48, 8, 14, 0.97) 100%
  );

  /* hidden/open animation */
  clip-path: inset(100% 0 0 0);
  transition: clip-path 0.65s cubic-bezier(0.22, 1, 0.36, 1);

  /* ensure text default is white even if theme overrides */
  color: #fff !important;

  pointer-events: none;
}

/* Gold line */
.gG2EAT5-8h .im8-pro-trusted__card-overlay::before{
  content: '';
  width: 0;
  height: 1px;
  background: linear-gradient(90deg, #D4A84B, rgba(212,168,75,0.4), transparent);
  margin-bottom: 20px;
  transition: width 0.6s cubic-bezier(0.22,1,0.36,1) 0.25s;
}

/* Hover open overlay + animate line */
.gG2EAT5-8h:hover .im8-pro-trusted__card-overlay{
  clip-path: inset(0 0 0 0);
}
.gG2EAT5-8h:hover .im8-pro-trusted__card-overlay::before{
  width: 80%;
}

/* Text base (hidden state) */
.gG2EAT5-8h .im8-pro-trusted__overlay-name,
.gG2EAT5-8h .im8-pro-trusted__overlay-role,
.gG2EAT5-8h .im8-pro-trusted__card-quote{
  opacity: 0;
  transform: translateY(10px);
}

/* Hover reveal (stagger) */
.gG2EAT5-8h:hover .im8-pro-trusted__overlay-name{
  opacity: 1;
  transform: translateY(0);
  transition: opacity .4s cubic-bezier(0.22,1,0.36,1) .12s,
              transform .4s cubic-bezier(0.22,1,0.36,1) .12s;
}
.gG2EAT5-8h:hover .im8-pro-trusted__overlay-role{
  opacity: 1;
  transform: translateY(0);
  transition: opacity .4s cubic-bezier(0.22,1,0.36,1) .2s,
