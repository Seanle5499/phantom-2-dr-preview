      <style id="custom-css-gurWSY_cQd">
        /* ===== CARD SETUP ===== */
.gurWSY_cQd{
  position: relative;
  overflow: hidden;
}

/* ===== OVERLAY (created by JS) ===== */
.gurWSY_cQd .im8-social-proof__card-overlay{
  position: absolute;
  inset: 0;
  z-index: 4;

  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 28px 24px;
border-radius: 20px;
  background: linear-gradient(
    180deg,
    rgba(10, 2, 4, 0) 0%,
    rgba(10, 2, 4, 0.35) 25%,
    rgba(10, 2, 4, 0.82) 52%,
    rgba(10, 2, 4, 0.97) 100%
  );

  /* hidden state */
  clip-path: inset(100% 0 0 0);
  transition: clip-path 0.65s cubic-bezier(0.22, 1, 0.36, 1);

  pointer-events: none;
}/* đảm bảo overlay là flex column */
.gurWSY_cQd .im8-social-proof__card-overlay{
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

/* GOLD LINE */
.gurWSY_cQd .im8-social-proof__card-overlay::before{
  content: '';
  width: 0;
  height: 1px;
  background: linear-gradient(
    90deg,
    #D4A84B,
    rgba(212,168,75,0.4),
    transparent
  );
  margin-bottom: 20px;
  transition: width 0.6s cubic-bezier(0.22,1,0.36,1) 0.25s;
}

/* animate when card hover */
.gurWSY_cQd:hover .im8-social-proof__card-overlay::before{
  width: 80%;   /* hoặc 100% nếu muốn full */
}
/* OPEN overlay on hover */
.gurWSY_cQd:hover .im8-social-proof__card-overlay{
  clip-path: inset(0 0 0 0);
}

/* ===== TEXT ANIMATION ===== */
.im8-social-proof__overlay-name,
.im8-social-proof__overlay-role,
.im8-social-proof__card-quote{
  opacity: 0;
  transform: translateY(10px);
}

.gurWSY_cQd:hover .im8-social-proof__overlay-name{
  opacity: 1;
  transform: translateY(0);
  transition: opacity .4s cubic-bezier(0.22,1,0.36,1) .12s,
              transform .4s cubic-bezier(0.22,1,0.36,1) .12s;
}
.gurWSY_cQd:hover .im8-social-proof__overlay-role{
  opacity: 1;
  transform: translateY(0);
  transition: opacity .4s cubic-bezier(0.22,1,0.36,1) .2s,
              transform .4s cubic-bezier(0.22,1,0.36,1) .2s;
}
.gurWSY_cQd:hover .im8-social-proof__card-quote{
  opacity: 1;
  transform: translateY(0);
  transition: opacity .4s cubic-bezier(0.22,1,0.36,1) .28s,
              transform .4s cubic-bezier(0.22,1,0.36,1) .28s;
}

/* ===== TYPO (giữ style bạn muốn) ===== */
.im8-social-proof__overlay-name{
  font-family: 'Aeonik', var(--font-body-family), sans-serif;
  font-size: 18px;
  font-weight: 600;
  color: #fff;
  line-height: 1.2;
  margin-bottom: 3px;
}
.im8-social-proof__overlay-role{
  font-family: 'Aeonik', var(--font-body-family), sans-serif;
  font-size: 12px;
  font-weight: 500;
  color: rgba(212, 168, 75, 0.7);
  line-height: 1.3;
  margin-bottom: 16px;
}
.im8-social-proof__card-quote {
    font-family: 'Aeonik', var(--font-body-family), sans-serif;
    font-size: 15px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.85);
    font-style: italic;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s cubic-bezier(0.22, 1, 0.36, 1) 0.28s, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1) 0.28s;
}/* Force all text inside overlay to be white */
.gurWSY_cQd .im8-social-proof__card-overlay{
  color: #fff !important;
}

/* Force quote color (in case p rules override) */
.gurWSY_cQd .im8-social-proof__card-overlay .im8-social-proof__card-quote{
  color: rgba(255,255,255,0.85) !important;
}

/* Optional: also force name/role if needed */
.gurWSY_cQd .im8-social-proof__card-overlay .im8-social-proof__overlay-name{
  color:#fff !important;
}
.gurWSY_cQd .im8-social-proof__card-overlay .im8-social-proof__overlay-role{
  color: rgba(212,168,75,0.7) !important;
}
