      <style id="custom-css-gtEydUcJPD">
        #wn-tracking-root {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  color: #303030;
}

#wn-tracking-root * {
  box-sizing: border-box !important;
}

#wn-tracking-root a {
  color: inherit;
  text-decoration: none;
}

/* Reset only lists — avoid breaking inline styles on other elements */
#wn-tracking-root ul, #wn-tracking-root li {
  margin: 0;
  padding: 0;
  list-style: none;
}

#wn-tracking-root .wn-progress-bar {
  height: 5px !important;
  border-radius: 8px !important;
  flex: 1 !important;
  margin: 12px 4px 0 !important;
  display: block !important;
  min-height: 5px !important;
}

#wn-tracking-root .wn-timeline-line {
  position: absolute !important;
  left: 13px !important;
  top: 28px !important;
  bottom: 0 !important;
  width: 2px !important;
  background: #efefef !important;
  z-index: 0 !important;
  display: block !important;
}

#wn-tracking-root .wn-event-row {
  position: relative !important;
  display: flex !important;
  gap: 8px !important;
}

/* Timeline scrollbar */
.wn-timeline-scroll::-webkit-scrollbar {
  width: 4px;
}

.wn-timeline-scroll::-webkit-scrollbar-thumb {
  background: transparent;
  border-radius: 2px;
}

.wn-timeline-scroll:hover::-webkit-scrollbar-thumb {
  background: #ddd;
}

/* Float widget content scrollbar hide */
.wn-float-content {
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.wn-float-content::-webkit-scrollbar {
  display: none;
}

/* Mobile responsive */
@media (max-width: 768px) {
  .wn-tracking-content {
    display: flex !important;
    flex-direction: column !important;
    overflow: visible !important;
  }

  .wn-tracking-timeline {
    float: none !important;
    width: 100% !important;
    margin-bottom: 20px !important;
  }

  .wn-tracking-sidebar {
    float: none !important;
    width: 100% !important;
    padding: 0 !important;
  }

  .wn-timeline-scroll {
    max-height: none !important;
  }

  #wn-float-panel,
  #wn-float-btn {
    display: none !important;
  }

  #wn-track-btn {
    width: 100% !important;
  }

  /* Mobile progress: hide desktop, show mobile */
  .wn-progress-desktop {
    display: none !important;
  }

  .wn-progress-mobile {
    display: block !important;
  }
}

@media (min-width: 769px) {
  .wn-progress-desktop {
    display: flex !important;
  }

  .wn-progress-mobile {
    display: none !important;
  }
}

