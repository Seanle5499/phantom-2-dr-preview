        /* =========================
   PRO TRUSTED CARD OVERLAY
   Clean version (no duplicates)
   ========================= */

/* Card wrapper */
.gIDl6mOaGB{
  position: relative;
  overflow: hidden !important;
      width: 100%;
    height: 100%;
    min-height: 460px;
    flex: 1;
    overflow: hidden;
    background: linear-gradient(135deg, #4A0E18 0%, #50000B 50%, #4A0E18 100%);
  border-radius: 20px;
}

/* Overlay layer (created by JS) */
.gIDl6mOaGB .im8-pro-trusted__card-overlay{
  position: absolute;
  inset: 0;
  z-index: 4;

  display: flex;
  flex-direction: column;
  justify-content: flex-end;

  padding: 28px 24px;
  border-radius: 20px;

  background: linear-gradient(
    180deg,
    rgba(48, 8, 14, 0) 0%,
    rgba(48, 8, 14, 0.35) 25%,
    rgba(48, 8, 14, 0.82) 52%,
    rgba(48, 8, 14, 0.97) 100%
  );

  /* hidden/open animation */
  clip-path: inset(100% 0 0 0);
  transition: clip-path 0.65s cubic-bezier(0.22, 1, 0.36, 1);

  /* ensure text default is white even if theme overrides */
  color: #fff !important;

  pointer-events: none;
}

/* Gold line */
.gIDl6mOaGB .im8-pro-trusted__card-overlay::before{
  content: '';
  width: 0;
  height: 1px;
  background: linear-gradient(90deg, #D4A84B, rgba(212,168,75,0.4), transparent);
  margin-bottom: 20px;
  transition: width 0.6s cubic-bezier(0.22,1,0.36,1) 0.25s;
}

/* Hover open overlay + animate line */
.gIDl6mOaGB:hover .im8-pro-trusted__card-overlay{
  clip-path: inset(0 0 0 0);
}
.gIDl6mOaGB:hover .im8-pro-trusted__card-overlay::before{
  width: 80%;
}

/* Text base (hidden state) */
.gIDl6mOaGB .im8-pro-trusted__overlay-name,
.gIDl6mOaGB .im8-pro-trusted__overlay-role,
.gIDl6mOaGB .im8-pro-trusted__card-quote{
  opacity: 0;
  transform: translateY(10px);
}

/* Hover reveal (stagger) */
.gIDl6mOaGB:hover .im8-pro-trusted__overlay-name{
  opacity: 1;
  transform: translateY(0);
  transition: opacity .4s cubic-bezier(0.22,1,0.36,1) .12s,
              transform .4s cubic-bezier(0.22,1,0.36,1) .12s;
}
.gIDl6mOaGB:hover .im8-pro-trusted__overlay-role{
  opacity: 1;
  transform: translateY(0);
  transition: opacity .4s cubic-bezier(0.22,1,0.36,1) .2s,
              transform .4s cubic-bezier(0.22,1,0.36,1) .2s;
}
.gIDl6mOaGB:hover .im8-pro-trusted__card-quote{
  opacity: 1;
  transform: translateY(0);
  transition: opacity .5s cubic-bezier(0.22,1,0.36,1) .28s,
              transform .5s cubic-bezier(0.22,1,0.36,1) .28s;
}

/* Typo */
.gIDl6mOaGB .im8-pro-trusted__overlay-name{
  font-family: 'Aeonik', var(--font-body-family), sans-serif;
  font-size: 17px;
  font-weight: 600;
  color: #fff !important;
