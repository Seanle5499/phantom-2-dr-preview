<script>
(function(){
const root=document.currentScript.closest('.wn-chip-panel');
if(!root) return;

const chips=[...root.querySelectorAll('.wn-chip')];
const titleEl=root.querySelector('#wnCardTitle');
const descEl=root.querySelector('#wnCardDesc');
const iconEl=root.querySelector('#wnCardIcon');
const contentWrap=root.querySelector('#wnCardContent');

const data={
digestive:{
title:"Digestive Support",
desc:"Probiotics + prebiotics to support regularity, reduce bloating, and maintain a healthy gut microbiome for better nutrient absorption.",
icon:"🫁"
},
immune:{
title:"Immune Support",
desc:"Vitamin C (1,000% DV), Zinc (136% DV), D3 (250% DV), Selenium (127% DV), Elderberry, and Reishi + Chaga mushroom complex.",
icon:"🛡️"
},
heart:{
title:"Heart Support",
desc:"Helps support healthy circulation, cardiovascular function, and oxidative protection with targeted antioxidant nutrients.",
icon:"❤️"
},
muscular:{
title:"Muscular Support",
desc:"Supports strength, recovery, and performance with key nutrients that help muscles work efficiently and bounce back faster.",
icon:"💪"
},
skeletal:{
title:"Skeletal Support",
desc:"Supports bone density and structural strength with foundational minerals and cofactors for long-term resilience.",
icon:"🦴"
},
skin:{
title:"Skin & Hair Support",
desc:"Nourishes skin elasticity and hair strength with antioxidant support and beauty-forward micronutrients.",
icon:"✨"
},
brain:{
title:"Brain Support",
desc:"Supports focus, memory, and mental clarity with nutrients involved in neurotransmitter and cognitive function.",
icon:"🧠"
},
endocrine:{
title:"Endocrine Support",
desc:"Supports hormone signaling and metabolic balance with nutrients that help the body adapt and maintain steady energy.",
icon:"⚡"
},
hydration:{
title:"Hydration Support",
desc:"Electrolytes and cofactors that help maintain fluid balance, stamina, and cellular hydration throughout the day.",
icon:"💧"
}
};

function setActive(key){
const item=data[key];
if(!item) return;

chips.forEach(btn=>{
const isOn=btn.dataset.key===key;
btn.classList.toggle('is-active',isOn);
btn.setAttribute('aria-selected',isOn?'true':'false');
});

contentWrap.classList.add('is-fading');

setTimeout(()=>{
titleEl.textContent=item.title;
descEl.textContent=item.desc;
iconEl.textContent=item.icon;
contentWrap.classList.remove('is-fading');
},140);
}

chips.forEach(btn=>{
btn.addEventListener('click',()=>setActive(btn.dataset.key));
});

setActive(root.querySelector('.wn-chip.is-active')?.dataset.key||'immune');
})();
</script>
