.wn-chip-panel *{box-sizing:border-box;}

.wn-chip-panel .wn-chip-wrap{
  max-width:1120px;
  display:flex;
  flex-direction:column;
  gap:20px;
  margin:0 auto;
}

/* CHIPS */
.wn-chip-panel .wn-chips{
  display:flex;
  flex-wrap:wrap;
  justify-content:center;
  gap:10px;
  margin:0 auto;
  padding:0;
  max-width:800px;
  list-style:none;
}

.wn-chip-panel .wn-chip{
  appearance:none;
  -webkit-appearance:none;
  border:1px solid var(--chipBorder);
  background:var(--chip);
  color:var(--chipText);
  border-radius:999px;
  padding:9px 14px;
  display:inline-flex;
  align-items:center;
  gap:10px;
  cursor:pointer;
  font-size:13px;
  font-weight:700;
  line-height:1;
  transition:transform .15s ease,background .15s ease,color .15s ease,box-shadow .15s ease,border-color .15s ease;
  box-shadow:0 6px 14px rgba(0,0,0,0.06);
  user-select:none;
  white-space:nowrap;
}

.wn-chip-panel .wn-chip:focus{
  outline:none;
  box-shadow:0 0 0 3px rgba(201,163,87,0.25),0 6px 14px rgba(0,0,0,0.06);
  border-color:rgba(201,163,87,0.65);
}

.wn-chip-panel .wn-chip:hover{
  transform:translateY(-1px);
}

.wn-chip-panel .wn-chip.is-active{
  background:var(--active);
  color:var(--activeText);
  border-color:rgba(255,255,255,0.12);
  box-shadow:0 14px 26px rgba(61,0,9,0.18);
}

.wn-chip-panel .wn-chip__icon{
  width:18px;
  height:18px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  flex:0 0 18px;
  font-size:16px;
  line-height:1;
  opacity:.95;
}

.wn-chip-panel .wn-chip.is-active .wn-chip__icon{
  opacity:1;
}

/* CARD */
.wn-chip-panel .wn-card{
  border-radius:18px;
  background:linear-gradient(180deg,#ffffff 0%,#fffaf6 100%);
  border:1px solid var(--cardBorder);
  box-shadow:var(--cardShadow);
  overflow:hidden;
}

.wn-chip-panel .wn-card__topline{
  display:block;
  width:100%;
  height:2px;
  min-height:2px;
  flex-shrink:0;
  background:linear-gradient(90deg,var(--gold),rgba(201,163,87,0.35),var(--gold));
}

.wn-chip-panel .wn-card__body{
  padding:18px 22px 20px;
  display:flex;
  align-items:flex-start;
  gap:14px;
}

.wn-chip-panel .wn-card__bigicon{
  width:34px;
  height:34px;
  border-radius:12px;
  display:flex;
  align-items:center;
  justify-content:center;
  flex:0 0 34px;
  margin-top:2px;
  font-size:20px;
}

.wn-chip-panel .wn-card__title{
  margin:0 0 6px;
  font-size:16px;
  line-height:1.15;
  font-weight:600;
  color:#1a1210;
}

.wn-chip-panel .wn-card__desc{
  margin:0;
  font-size:13px;
  line-height:1.6;
  color:#8a7f79;
  max-width:980px;
}

/* Smooth content swap */
.wn-chip-panel .wn-card__content{
  opacity:1;
  transform:translateY(0);
  transition:opacity .18s ease,transform .18s ease;
  will-change:opacity,transform;
}

.wn-chip-panel .wn-card__content.is-fading{
  opacity:0;
  transform:translateY(6px);
}

@media (max-width:680px){

  .wn-chip-panel{
    padding:16px 10px 18px;
  }

  .wn-chip-panel .wn-chip-wrap{
    gap:16px;
  }

  .wn-chip-panel .wn-chips{
    gap:7px;
