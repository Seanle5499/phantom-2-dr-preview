<script>
(function(){
  function initAccordions() {
    document.querySelectorAll('.ageaura-adv gp-accordion').forEach(function(acc) {
      if (acc.dataset.gpInit) return;
      acc.dataset.gpInit = '1';

      // Close all
      acc.querySelectorAll('.gp-accordion-item').forEach(function(item) {
        item.classList.remove('gp-acc-open');
      });
      // Open first
      var first = acc.querySelector('.gp-accordion-item');
      if (first) first.classList.add('gp-acc-open');

      acc.querySelectorAll('.gp-accordion-item_header').forEach(function(header) {
        header.style.cursor = 'pointer';
        header.removeAttribute('aria-hidden');
        header.addEventListener('click', function() {
          var item = header.closest('.gp-accordion-item');
          if (!item) return;
          var isOpen = item.classList.contains('gp-acc-open');
          acc.querySelectorAll('.gp-accordion-item').forEach(function(i) {
            i.classList.remove('gp-acc-open');
          });
          if (!isOpen) item.classList.add('gp-acc-open');
        });
      });
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAccordions);
  } else {
    initAccordions();
  }
})();
</script>

