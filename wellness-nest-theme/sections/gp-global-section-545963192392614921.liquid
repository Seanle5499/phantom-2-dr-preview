      <script id="custom-js-gz4W_Wkkel">
        try {
          document.addEventListener("DOMContentLoaded", function() {
    const rechargeWidget = document.querySelectorAll('.rcct');
    if (rechargeWidget.length > 0) {
        rechargeWidget.forEach(optioneach => {
            const productForm = optioneach.closest('form');
            const subscriptionOptions = productForm.querySelectorAll('.custom-subscription-option');
            if (subscriptionOptions.length > 0) {
                subscriptionOptions.forEach(option => {
                    option.addEventListener('click', function() {
                        const eachp = productForm.querySelectorAll('.custom-subscription-option');
                        eachp.forEach(opt => opt.classList.remove('active'));
                        this.classList.add('active');

                        let selectedOption = this.classList.contains('onetime') ? 'onetime' : 'subsave';
                        let sellingPlan = this.classList.contains('onetime') ? '' : 'selling_plan';

                        let optionElements = productForm.querySelectorAll('.rc-option.rc_widget__option');
                        let inputElements = productForm.querySelectorAll('input.rc_widget__option__input');
                        let selectedInput = productForm.querySelector(`input.rc_widget__option__input[value="${selectedOption}"]`);

                        if (optionElements.length > 0 && inputElements.length > 0 && selectedInput) {
                            optionElements.forEach(opt => opt.classList.remove('rc_widget__option--active', 'rc-option--active'));
                            let selectedOptionElement = productForm.querySelector(`.rc-option.rc_widget__option.rc-option__${selectedOption}`);
                            if (selectedOptionElement) {
                                selectedOptionElement.classList.add('rc_widget__option--active', 'rc-option--active');
                            }

                            let sellingPlanDropdown = productForm.querySelector('select.rc-selling-plans__dropdown');
                            if (sellingPlanDropdown) {
                                sellingPlanDropdown.setAttribute('name', sellingPlan);
                            }

                            inputElements.forEach(input => input.checked = false);
                            selectedInput.checked = true;
                            selectedInput.click();
                        }
                    });
                });
            }
        });
    }
});

function handleRechargeWidget(rechargeWidget) {
    if (!rechargeWidget.dataset.initialized) {
        const productForm = rechargeWidget.closest('form');
        const featuredList = productForm.querySelector(".listoption");
        const onlyonetime = productForm.querySelector(".onlyonetime");

        if (featuredList && onlyonetime) {
            const rechargeInputs = rechargeWidget.querySelectorAll('.rc_widget__option__input');
            rechargeInputs.forEach(input => {
                input.addEventListener('click', function(event) {
                    const sellingPlanId = input.value;
                    if (sellingPlanId === "onetime") {
                        featuredList.classList.add("onetime");
                        onlyonetime.classList.add("onetime");
                    } else {
                        featuredList.classList.remove("onetime");
                        onlyonetime.classList.remove("onetime");
                    }
                });
            });

            rechargeWidget.dataset.initialized = true;
        } else {
            console.log("No featured list");
        }
    }

    // Show the rcbundlecustom element now that the recharge widget has loaded
    document.querySelectorAll('.rcbundlecustom').forEach(el => el.style.display = 'grid');
}

document.addEventListener("DOMContentLoaded", function () {
    const observer = new MutationObserver(function (mutationsList, observer) {
        mutationsList.forEach(function (mutation) {
            if (mutation.type === "childList") {
                const rechargeWidgets = document.querySelectorAll('.rcct .rc-widget');
                rechargeWidgets.forEach(rechargeWidget => {
                    handleRechargeWidget(rechargeWidget);
                });
            }
        });
    });

    observer.observe(document.body, { childList: true, subtree: true });
});

window.addEventListener("load", function () {
    const rechargeWidgets = document.querySelectorAll('.rcct .rc-widget');
    rechargeWidgets.forEach(rechargeWidget => {
        handleRechargeWidget(rechargeWidget);
    });
});

        } catch(err){}
      </script>
    
  
