      <script id="custom-js-gipQOf0QAN">
        try {
          document.addEventListener("DOMContentLoaded", function () {
  const buttons = document.querySelectorAll(".gps-tab-btn");
  const menu = document.querySelector('.gps-menu-scroll');
  const links = menu.querySelectorAll(".gps-menu-scroll a.gp-trigger-button-link");
  const sections = [];

  links.forEach(function(link, i) {
    const href = link.getAttribute("href");
    if (href && href.startsWith("#")) {
      const target = document.querySelector(href);
      if (target) {
        sections.push({
          el: target,
          index: i,
          id: href,
          button: buttons[i] || null
        });
      }
    }
  });

  let isUserScrolling = false;
  let scrollTimeout;

  function setActive(index, shouldScroll = false) {
    if (!buttons[index]) return;

    buttons.forEach(function(btn) {
      btn.classList.remove("active");
    });
    buttons[index].classList.add("active");

    buttons[index].scrollIntoView({
        behavior: 'smooth',
        inline: 'start',
        block: 'nearest'
    });
  }

  buttons.forEach(function(btn, i) {
    btn.addEventListener("click", function() {
      isUserScrolling = true;
      setActive(i, true);

      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        isUserScrolling = false;
      }, 1000);
    });
  });

  let currentActive = -1;

  const observer = new IntersectionObserver(function(entries) {
    if (isUserScrolling) return;

    const visible = entries.filter(function(entry) {
      return entry.isIntersecting && entry.intersectionRatio > 0.3;
    });

    if (visible.length > 0) {
      visible.sort(function(a, b) {
        return b.intersectionRatio - a.intersectionRatio;
      });

      const mostVisible = visible[0];
      const section = sections.find(function(s) {
        return s.el === mostVisible.target;
      });

      if (section && section.index !== currentActive) {
        currentActive = section.index;
        setActive(section.index);
      }
    }
  }, {
    threshold: [0, 0.3, 0.5, 0.7, 1.0],
    rootMargin: '-10% 0px -10% 0px'
  });

  sections.forEach(function(section) {
    observer.observe(section.el);
  });

  const firstVisibleSection = sections.find(section => {
    const rect = section.el.getBoundingClientRect();
    return rect.top >= 0 && rect.top <= window.innerHeight;
  });

  if (firstVisibleSection) {
    currentActive = firstVisibleSection.index;
    setActive(currentActive);
  } else if (sections.length > 0) {
    currentActive = 0;
    setActive(currentActive);
  }
});
        } catch(err){}
