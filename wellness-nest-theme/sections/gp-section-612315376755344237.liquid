    rgba(10, 2, 4, 0.97) 100%
  );

  /* hidden state */
  clip-path: inset(100% 0 0 0);
  transition: clip-path 0.65s cubic-bezier(0.22, 1, 0.36, 1);

  pointer-events: none;
}/* đảm bảo overlay là flex column */
.gWwiOqL1OM .im8-social-proof__card-overlay{
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

/* GOLD LINE */
.gWwiOqL1OM .im8-social-proof__card-overlay::before {
  background: linear-gradient(
    90deg,
    #54B94A,
    rgba(84, 185, 74, 0.4),
    transparent
  );
}

/* animate when card hover */
.gWwiOqL1OM:hover .im8-social-proof__card-overlay::before{
  width: 80%;   /* hoặc 100% nếu muốn full */
}
/* OPEN overlay on hover */
.gWwiOqL1OM:hover .im8-social-proof__card-overlay{
  clip-path: inset(0 0 0 0);
}

/* ===== TEXT ANIMATION ===== */
