document.addEventListener('DOMContentLoaded', function() {
  var wrap = document.getElementById('im8-float-wrap');
  var hero = document.querySelector('.gp-hero-banner-row');
  if (!wrap || !hero) return;

  var isMobile = window.innerWidth <= 749;
  
  if (isMobile) {
    // Parent chứa cả bg image + row, có class hero-banner-container
    var container = hero.closest('.hero-banner-container') 
                 || hero.parentElement?.parentElement 
                 || hero.parentElement;
    container.style.position = 'relative';
    container.appendChild(wrap);
  } else {
    hero.appendChild(wrap);
  }
});
