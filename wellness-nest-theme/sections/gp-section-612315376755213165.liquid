  .im8-badge--verify { right: 6%; top: 62%; animation: im8FF2 4.5s ease-in-out 0.4s infinite; }
  .im8-badge--metal  { left: 55%; top: 80%; animation: im8FF3 5s ease-in-out 0.7s infinite; }
