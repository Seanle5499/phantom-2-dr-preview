<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: #fafafa;
    line-height: 1.6;
}

.product-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 20px;
}

.product-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    background: white;
    border-radius: 20px;
    padding: 40px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.1);
}

/* Left Side - Images */
.product-images {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.main-image {
    aspect-ratio: 1;
    border-radius: 20px;
    overflow: hidden;
    background: linear-gradient(135deg, #f8bbd9 0%, #f783ac 100%);
    display: flex;
    align-items: center;
    justify-content: center;
}

.main-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
}

.main-image:hover img {
    transform: scale(1.05);
}

.thumbnail-gallery {
    display: flex;
    align-items: center;
    gap: 10px;
}

.gallery-nav {
    background: white;
    border: 2px solid #eee;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 18px;
    font-weight: bold;
    color: #666;
    transition: all 0.2s ease;
}

.gallery-nav:hover {
    border-color: #e91e63;
    color: #e91e63;
    transform: scale(1.1);
}

.thumbnails {
    display: flex;
    gap: 10px;
    flex: 1;
    overflow-x: auto;
    padding: 5px 0;
}

.thumbnails img {
    width: 60px;
    height: 60px;
    border-radius: 10px;
    object-fit: cover;
    cursor: pointer;
    border: 2px solid transparent;
    transition: all 0.2s ease;
}

.thumbnails img:hover,
.thumbnails img.active {
    border-color: #e91e63;
    transform: scale(1.1);
}

/* Right Side - Product Info */
.product-info {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.product-title {
    font-size: 32px;
    font-weight: 700;
    color: #333;
    line-height: 1.2;
}

.rating-section {
    display: flex;
    align-items: center;
    gap: 12px;
}

.stars {
    display: flex;
    gap: 2px;
}

.star {
    color: #ffa500;
    font-size: 18px;
}

.rating-text {
    color: #666;
    font-weight: 500;
}

.price-section {
    margin: 10px 0;
}

.price {
    font-size: 36px;
    font-weight: 700;
    color: #4ade80;
}

.bundle-section h3 {
    font-size: 20px;
    font-weight: 600;
    color: #333;
    margin-bottom: 16px;
    text-align: center;
    position: relative;
}

.bundle-section h3::before,
.bundle-section h3::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 80px;
    height: 2px;
    background: #ddd;
}

.bundle-section h3::before {
    left: 0;
}

.bundle-section h3::after {
    right: 0;
}

.bundle-options {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.bundle-option {
    display: block;
    border: 2px solid #eee;
    border-radius: 12px;
    padding: 16px;
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
}

.bundle-option:hover {
    border-color: #e91e63;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(233, 30, 99, 0.15);
}

.bundle-option.popular {
    border-color: #e91e63;
    background: linear-gradient(135deg, rgba(233, 30, 99, 0.05), rgba(156, 39, 176, 0.05));
}

.bundle-option input[type="radio"] {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    width: 20px;
    height: 20px;
    accent-color: #e91e63;
}

.option-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-left: 32px;
}

.option-info {
    display: flex;
    align-items: center;
    gap: 10px;
}

.option-title {
    font-weight: 600;
    color: #333;
}

.badge {
    padding: 4px 8px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.badge.essential {
    background: #e91e63;
    color: white;
}

.badge.best-selling {
    background: #9c27b0;
    color: white;
}

.option-pricing {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
}

.option-price {
    font-weight: 700;
    color: #333;
    font-size: 16px;
}

.option-original {
    text-decoration: line-through;
    color: #999;
    font-size: 14px;
}

.purchase-buttons {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 20px;
}

.add-to-cart-btn {
    background: linear-gradient(135deg, #e91e63, #9c27b0);
    color: white;
    border: none;
    padding: 18px 32px;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.add-to-cart-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(233, 30, 99, 0.4);
}

.shop-pay-btn {
    background: #5a31f4;
    color: white;
    border: none;
    padding: 16px 32px;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}

.shop-pay-btn:hover {
    background: #4c28d4;
    transform: translateY(-1px);
}

.shop-pay-text {
    font-size: 14px;
    opacity: 0.9;
}

.shop-pay-logo {
    font-weight: 700;
    font-size: 18px;
}

.subscription-section {
    border-top: 1px solid #eee;
    padding-top: 20px;
}

.subscription-section h4 {
    font-size: 16px;
    font-weight: 600;
    color: #333;
    margin-bottom: 12px;
}

.subscription-option {
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
}

.subscription-option input[type="checkbox"] {
    width: 18px;
    height: 18px;
    accent-color: #e91e63;
}

.subscription-text {
    display: flex;
    flex-direction: column;
}

.subscription-text span:first-child {
    font-weight: 500;
    color: #333;
}

.discount {
    font-size: 14px;
    color: #4ade80;
    font-weight: 600;
}

/* Mobile Responsive */
@media (max-width: 768px) {
    .product-container {
        grid-template-columns: 1fr;
        gap: 30px;
        padding: 20px;
    }
    
    .product-title {
        font-size: 24px;
    }
    
    .price {
        font-size: 28px;
    }
    
    .thumbnails {
        justify-content: center;
    }
    
    .option-content {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
    }
    
    .option-pricing {
        align-items: flex-start;
    }
}

/* Animations */
@keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}

.product-container {
    animation: fadeIn 0.6s ease-out;
}

.bundle-option {
    animation: fadeIn 0.6s ease-out;
}

.bundle-option:nth-child(1) { animation-delay: 0.1s; }
.bundle-option:nth-child(2) { animation-delay: 0.2s; }
.bundle-option:nth-child(3) { animation-delay: 0.3s; }
</style>

<script>
let currentImageIndex = 0;
const images = [
    'https://images.unsplash.com/photo-1559181567-c3190ca9959b?w=500&h=500&fit=crop',
    'https://images.unsplash.com/photo-1576671081837-49000212a370?w=500&h=500&fit=crop',
    'https://images.unsplash.com/photo-1563865436874-d7d68c6e4c68?w=500&h=500&fit=crop',
    'https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=500&h=500&fit=crop',
    'https://images.unsplash.com/photo-1573169567304-50eebd62903d?w=500&h=500&fit=crop'
];

function changeImage(thumbnail) {
    const mainImage = document.getElementById('mainProductImage');
    const allThumbnails = document.querySelectorAll('.thumbnails img');
    
    // Remove active class from all thumbnails
    allThumbnails.forEach(img => img.classList.remove('active'));
    
    // Add active class to clicked thumbnail
    thumbnail.classList.add('active');
    
    // Change main image
    mainImage.src = thumbnail.src.replace('w=100&h=100', 'w=500&h=500');
    
    // Update current index
    currentImageIndex = Array.from(allThumbnails).indexOf(thumbnail);
}

function prevImage() {
    currentImageIndex = currentImageIndex > 0 ? currentImageIndex - 1 : images.length - 1;
    updateImage();
}

function nextImage() {
    currentImageIndex = currentImageIndex < images.length - 1 ? currentImageIndex + 1 : 0;
    updateImage();
}

function updateImage() {
    const mainImage = document.getElementById('mainProductImage');
    const thumbnails = document.querySelectorAll('.thumbnails img');
    
    mainImage.src = images[currentImageIndex];
    
    thumbnails.forEach((img, index) => {
        img.classList.toggle('active', index === currentImageIndex);
    });
}

function addToCart() {
    const selectedBundle = document.querySelector('input[name="bundle"]:checked');
    const isSubscription = document.getElementById('subscription').checked;
    
    if (selectedBundle) {
        const quantity = selectedBundle.value;
        const price = selectedBundle.dataset.price;
        
        // Add animation
        const button = document.querySelector('.add-to-cart-btn');
        button.style.transform = 'scale(0.95)';
        button.textContent = 'ADDING...';
        
        setTimeout(() => {
            button.style.transform = 'scale(1)';
            button.textContent = 'ADDED TO CART ✓';
            button.style.background = '#4ade80';
            
            setTimeout(() => {
                button.textContent = 'ADD TO CART';
                button.style.background = 'linear-gradient(135deg, #e91e63, #9c27b0)';
            }, 2000);
        }, 500);
        
        console.log(`Added ${quantity} items to cart`, {
            price: price,
            subscription: isSubscription
        });
    }
}

function buyWithShopPay() {
    const selectedBundle = document.querySelector('input[name="bundle"]:checked');
    
    if (selectedBundle) {
        console.log('Redirecting to Shop Pay...');
        // Integrate with Shop Pay API here
        alert('Redirecting to Shop Pay...');
    }
}

function toggleSubscription() {
    const isChecked = document.getElementById('subscription').checked;
    const priceElements = document.querySelectorAll('.option-price');
    
    priceElements.forEach(priceEl => {
        const originalPrice = parseInt(priceEl.textContent.replace(/[^\d]/g, ''));
        if (isChecked) {
            const discountedPrice = Math.round(originalPrice * 0.85);
            priceEl.textContent = discountedPrice.toLocaleString('vi-VN') + 'đ';
            priceEl.style.color = '#4ade80';
        } else {
            priceEl.textContent = originalPrice.toLocaleString('vi-VN') + 'đ';
            priceEl.style.color = '#333';
        }
    });
}

// Initialize
document.addEventListener('DOMContentLoaded', function() {
    // Set default selection
    const defaultOption = document.querySelector('input[name="bundle"][value="2"]');
    if (defaultOption) {
        defaultOption.checked = true;
    }
    
    // Add smooth scroll for mobile
    if (window.innerWidth <= 768) {
        document.querySelectorAll('.bundle-option').forEach(option => {
            option.addEventListener('click', function() {
                this.scrollIntoView({ behavior: 'smooth', block: 'center' });
            });
        });
    }
});
</script>

