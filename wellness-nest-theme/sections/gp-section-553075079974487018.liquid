      <script id="custom-js-gxRRdxuXCA">
        try {
          function handleRechargeWidget(rechargeWidget) {
    if (!rechargeWidget.dataset.initialized) {
        const featuredList = rechargeWidget.closest('form').querySelector(".listoption");
        const priceReCharge = rechargeWidget.closest('form').querySelector(".custom-price-sp.custom-price-recharge");
        const priceOriginal = rechargeWidget.closest('form').querySelector(".custom-price-sp.custom-price-original");
        const saveReCharge = rechargeWidget.closest('form').querySelector(".save-price-sp.save-price-recharge");
        const saveOriginal = rechargeWidget.closest('form').querySelector(".save-price-sp.save-price-original");

        if (featuredList) {
        } else {
            //console.log("No featured list");
        }

        if (priceReCharge) {
        } else {
            //console.log("No priceReCharge");
        }

        if (priceOriginal) {
        } else {
            //console.log("No priceOriginal");
        }

        if (saveReCharge) {
        } else {
            //console.log("No saveReCharge");
        }

        if (saveOriginal) {
        } else {
            //console.log("No saveOriginal");
        }

        if (featuredList && priceReCharge && priceOriginal && saveReCharge && saveOriginal) {
            const rechargeInputs = rechargeWidget.querySelectorAll('.rc_widget__option__input');
            rechargeInputs.forEach(input => {
                input.addEventListener('click', function(event) {
                    const sellingPlanId = input.value;
                    if (sellingPlanId === "onetime") {
                        featuredList.classList.add("onetime");
                        priceReCharge.classList.add("custom-price-hidden");
                        priceOriginal.classList.remove("custom-price-hidden");
                        saveReCharge.classList.add("save-price-hidden");
                        saveOriginal.classList.remove("save-price-hidden");
                    } else {
                        featuredList.classList.remove("onetime");
                        priceReCharge.classList.remove("custom-price-hidden");
                        priceOriginal.classList.add("custom-price-hidden");
                        saveReCharge.classList.remove("save-price-hidden");
                        saveOriginal.classList.add("save-price-hidden");
                    }
                });
            });

            rechargeWidget.dataset.initialized = true;
        } else {
            //console.log("No featured list or necessary price elements found in the current product form.");
        }
    }
}

document.addEventListener("DOMContentLoaded", function () {
    const observer = new MutationObserver(function (mutationsList, observer) {
        mutationsList.forEach(function (mutation) {
            if (mutation.type === "childList") {
                const rechargeWidgets = document.querySelectorAll('.rc_widget');
                rechargeWidgets.forEach(rechargeWidget => {
                    handleRechargeWidget(rechargeWidget);
                });
            }
        });
    });

    observer.observe(document.body, { childList: true, subtree: true });
});

window.addEventListener("load", function () {
    const rechargeWidgets = document.querySelectorAll('.rc_widget');
    rechargeWidgets.forEach(rechargeWidget => {
        handleRechargeWidget(rechargeWidget);
    });
});

