    <style>
  .ba-wrap {
    position: relative;
    width: 100%;
    height: 450px;
    overflow: hidden;
    user-select: none;
    font-family: inherit;
  }

  /* Both panels are full-width, stacked */
  .ba-panel {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .ba-panel-right { z-index: 1; }
  .ba-panel-left  { z-index: 2; clip-path: inset(0 50% 0 0); }

  .ba-panel img {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    pointer-events: none;
  }

  /* Text card sits inside each panel */
  .ba-card {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: #fff;
    padding: 24px 20px;
    max-width: 210px;
    color: #000b44;
    pointer-events: none;
  }

  .ba-panel-left  .ba-card { left: 24px; }
  .ba-panel-right .ba-card { right: 24px; text-align: right; }

  .ba-card h3 {
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 2px;
    color: #000b44;
  }

  .ba-card .purity {
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 12px;
    color: #000b44;
  }

  .ba-card p {
    font-size: 13px;
    line-height: 1.6;
    margin: 0 0 12px;
  }

  .ba-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 13px;
    line-height: 1.9;
  }

  .ba-card ul li::before { content: "○  "; }

  /* Divider line */
  .ba-divider {
    position: absolute;
    top: 0;
    left: 50%;
    width: 2px;
    height: 100%;
    background: rgba(255,255,255,0.4);
    transform: translateX(-50%);
    z-index: 6;
    pointer-events: none;
  }

  /* Handle */
  .ba-handle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 40px;
    height: 40px;
    background: #000b44;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    z-index: 7;
    pointer-events: none;
    box-shadow: 0 2px 12px rgba(0,0,0,0.35);
  }

  .ba-handle span {
    display: block;
    width: 2px;
    height: 14px;
    background: #fff;
    border-radius: 2px;
  }

  /* Range slider on top of everything */
  .ba-slider {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: ew-resize;
    z-index: 10;
    margin: 0;
    -webkit-appearance: none;
  }

  @media (max-width: 767px) {
    .ba-wrap { height: 400px; }
    .ba-card { max-width: 150px; padding: 16px 14px; }
    .ba-card h3, .ba-card .purity { font-size: 14px; }
    .ba-card p, .ba-card ul { font-size: 11px; }
    .ba-panel-left  .ba-card { left: 10px; }
    .ba-panel-right .ba-card { right: 10px; }
  }
</style>

<div class="ba-wrap" id="baWrap">

  <!-- RIGHT panel (behind) — full width -->
  <div class="ba-panel ba-panel-right">
    <img src="https://cdn.shopify.com/s/files/1/2005/9307/files/image_compare_after.png" alt="Generic creatine" />
    <div class="ba-card">
      <h3>Generic creatine</h3>
      <p class="purity">40–88% Purity</p>
      <p>Not tested for quality or<br>safety. Undetermined<br>levels of toxins and<br>fillers.</p>
      <ul>
        <li>No certifications</li>
        <li>Not accepted globally</li>
      </ul>
    </div>
  </div>

  <!-- LEFT panel (on top, clipped) — full width -->
  <div class="ba-panel ba-panel-left" id="baLeft">
    <img src="https://cdn.shopify.com/s/files/1/2005/9307/files/image_compare_before.png" alt="Creapure" />
    <div class="ba-card">
      <h3>Creapure<sup>®</sup></h3>
      <p class="purity">99.99% Purity</p>
      <p>Each batch is tested<br>for quality assurance<br>with HPLC technology.</p>
      <ul>
        <li>GMP certified <sup>†</sup></li>
        <li>Cologne List<sup>®</sup> approved</li>
        <li>ISF/GFSI certified</li>
      </ul>
    </div>
  </div>

  <!-- Divider + handle -->
  <div class="ba-divider" id="baDivider">
    <div class="ba-handle">
      <span></span><span></span><span></span>
    </div>
  </div>

  <!-- Invisible range slider -->
  <input type="range" class="ba-slider" id="baSlider" min="0" max="100" value="50" />

</div>

<script>
(function () {
  const slider  = document.getElementById('baSlider');
  const panLeft = document.getElementById('baLeft');
  const divider = document.getElementById('baDivider');

  function update(val) {
    panLeft.style.clipPath = 'inset(0 ' + (100 - val) + '% 0 0)';
    divider.style.left = val + '%';
  }

  slider.addEventListener('input', function () {
    update(this.value);
  });

  update(50);
})();
</script>
