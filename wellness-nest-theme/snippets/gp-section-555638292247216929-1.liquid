          var variantPrice = variantSelected.price;
          var saveVariantPrice = variantSelected.selling_plan_allocations.length > 0
            ? variantSelected.selling_plan_allocations[0].price
            : 0;

          var onetimepricect1, sabsavepricect1;

          var variantorder1 = productelm.querySelectorAll(".variantorder");
          variantorder1.forEach(function (quantityElement) {
            var checknumber1 = quantityElement.getAttribute("data-variant");
            if (String(checkvariant).trim() === String(checknumber1).trim()) {
              var numberquantity1 = parseInt(quantityElement.getAttribute("data-number"));
              onetimepricect1 = variantPrice / numberquantity1;
              sabsavepricect1 = saveVariantPrice / numberquantity1;
            }
          });

          if (onetimePriceElement) {
            onetimePriceElement.innerHTML = Shopify.formatMoney(onetimepricect1, money_format);
          }

          if (rcsavepriceElement) {
            rcsavepriceElement.innerHTML = Shopify.formatMoney(sabsavepricect1, money_format);
          }
        }
         
            var countryCode = Shopify.country || "US";
            var currencyCode = Shopify.currency.active || "USD";
      
            //   Format selected variant price
          var varPrice = variant.selling_plan_allocations[0].price !== undefined ? variant.selling_plan_allocations[0].price / 100 : variant.price / 100;
         
         if (productelm.querySelectorAll("input.rc_widget__option__input").length > 0) {
            varPrice =
              productelm.querySelector("input.rc_widget__option__input:checked").value ==
              "onetime"
                ? variant.price / 100
                : varPrice;
          }
      
          var curPrice = new Intl.NumberFormat("en-" + countryCode, {
            style: "currency",
            currency: currencyCode,
          }).format(varPrice);   
          
          document.querySelector('.gWZEEQKgvs .gp-product-price [data-gp-text]').textContent = curPrice
          
          if (
        productelm.querySelectorAll(
          'form[action="/cart/add"] > input[name="id"][type="hidden"]'
        ).length > 0
      ) {
        productelm
          .querySelector('form[action="/cart/add"] > input[name="id"][type="hidden"]')
          .value = variant.id;
        productelm
          .querySelector('form[action="/cart/add"] > input[name="id"][type="hidden"]')
          .setAttribute("data-value", variant.id);
      }
        }
    });
  }
});



