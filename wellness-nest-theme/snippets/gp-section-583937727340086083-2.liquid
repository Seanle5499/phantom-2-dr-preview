// Configuration
const CONFIG = {
  imageUrls: {
    '90 Days Supply': 'https://wellnessnest.co/cdn/shop/files/gempages_501444340413891578-2c6c7c98-9ae7-4e38-975f-e29e6090ef57.png?v=16179464708810712767&width=432',
    '60 Days Supply': 'https://wellnessnest.co/cdn/shop/files/gempages_501444340413891578-6f0866b7-c6ac-46f0-b0df-ddee0df791f6.png?v=3405703307767134546&width=2565',
    '30 Days Supply': 'https://wellnessnest.co/cdn/shop/files/gempages_501444340413891578-753e7c8e-cc78-4e65-8b7f-e390d773b9f5.png?v=11268536178291601998&width=2565'
  },
  variantInfo: {
    '90 Days Supply': { bottles: 3, capsules: 180, days: '90' },
    '60 Days Supply': { bottles: 2, capsules: 120, days: '60' },
    '30 Days Supply': { bottles: 1, capsules: 60, days: '30' }
  }
};

// Main initialization - IMMEDIATE EXECUTION
document.addEventListener('DOMContentLoaded', function() {
  console.log('✅ DOM loaded, initializing new design...');
  initializeNewDesign();
});

// Multiple backup initializations to ensure it runs
