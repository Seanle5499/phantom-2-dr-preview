    <!-- ═══════════════════════════════════════════════════════════════════════
     VARIANT-SELECTS COMPONENT — GemPages Drop-In
     Paste this entire block into a GemPages "Custom HTML" element.
     Change PRODUCT_HANDLE below to match your product.
     ═══════════════════════════════════════════════════════════════════════ -->

<style>
  /* ── Design Tokens ──────────────────────────────────────────────────── */
  .im8-variant-selects-wrapper {
    --im8-red: #a40011;
    --im8-maroon: #50000b;
    --im8-border-warm: #e1cbb9;
    --im8-text-primary: #50000b;
    --im8-text-secondary: rgba(80, 0, 11, 0.6);
    --im8-text-muted: rgba(80, 0, 11, 0.35);
    --im8-border-active: #a40011;
    --im8-shadow-sm:
      0 2px 8px rgba(80, 0, 11, 0.04), 0 1px 2px rgba(0, 0, 0, 0.03);
    --im8-shadow-md:
      0 4px 16px rgba(80, 0, 11, 0.08), 0 1px 3px rgba(0, 0, 0, 0.04);
    --im8-ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    --im8-radius-lg: 14px;

    font-family:
      "Aeonik",
      -apple-system,
      BlinkMacSystemFont,
      sans-serif;
    color: var(--im8-text-primary);
    width: 100%;
    max-width: 520px;
  }
  .im8-variant-selects-wrapper *,
  .im8-variant-selects-wrapper *::before,
  .im8-variant-selects-wrapper *::after {
    box-sizing: border-box;
  }
  .im8-variant-selects-wrapper fieldset {
    border: none;
    margin: 0 0 24px;
    padding: 0;
  }
  .im8-variant-selects-wrapper .vs-label {
    font-size: 15px;
    font-weight: 700;
    color: var(--im8-text-primary);
    margin-bottom: 12px;
    display: block;
  }

  /* ── Flavor Dropdown ────────────────────────────────────────────────── */
  .im8-flavor-dropdown {
    position: relative;
    width: 100%;
    border: 1.5px solid var(--im8-border-warm);
    border-radius: var(--im8-radius-lg);
    background: #fff;
    box-shadow: var(--im8-shadow-sm);
    transition:
      border-color 0.3s var(--im8-ease-out),
      box-shadow 0.3s var(--im8-ease-out),
      border-radius 0.3s ease;
    z-index: 10;
    overflow: hidden;
  }
  .im8-flavor-dropdown:hover {
    border-color: rgba(80, 0, 11, 0.25);
    box-shadow: var(--im8-shadow-md);
  }
  .im8-flavor-dropdown.is-expanded {
    border-color: var(--im8-border-active);
    border-radius: var(--im8-radius-lg) var(--im8-radius-lg) 0 0;
    box-shadow: none;
    z-index: 20;
    overflow: visible;
  }
  .im8-flavor-dropdown__trigger {
    display: flex;
    align-items: center;
    padding: 0 16px 0 0;
    gap: 14px;
    min-height: 80px;
    cursor: pointer;
    user-select: none;
  }
  .im8-flavor-dropdown__thumb {
    width: 80px;
    height: 80px;
    border-radius: var(--im8-radius-lg) 0 0 var(--im8-radius-lg);
    object-fit: cover;
    object-position: center;
    flex-shrink: 0;
  }
  .im8-flavor-dropdown.is-expanded .im8-flavor-dropdown__thumb {
    border-bottom-left-radius: 0;
  }
  .im8-flavor-dropdown__selected-info {
    flex: 1;
    min-width: 0;
    padding: 4px 0;
  }
  .im8-flavor-dropdown__selected-name {
    font-size: 16px;
    font-weight: 700;
    color: var(--im8-text-primary);
    line-height: 1.3;
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .im8-flavor-dropdown__selected-sub {
    font-size: 13px;
    color: var(--im8-text-secondary);
    margin-top: 2px;
  }
  .im8-flavor-dropdown__chevron {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    transition: transform 0.35s var(--im8-ease-out);
    color: var(--im8-text-muted);
  }
  .im8-flavor-dropdown.is-expanded .im8-flavor-dropdown__chevron {
    transform: rotate(180deg);
    color: var(--im8-text-secondary);
  }
  .im8-flavor-dropdown__options {
    position: absolute;
    top: 100%;
    left: -1.5px;
    right: -1.5px;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    background: #fff;
    border: 1.5px solid transparent;
    border-top: none;
    border-radius: 0 0 var(--im8-radius-lg) var(--im8-radius-lg);
    transition:
      max-height 0.35s var(--im8-ease-out),
      opacity 0.25s ease;
    z-index: 20;
  }
  .im8-flavor-dropdown.is-expanded .im8-flavor-dropdown__options {
    max-height: 500px;
    opacity: 1;
    pointer-events: auto;
    border-color: var(--im8-border-active);
    box-shadow:
      0 16px 48px rgba(80, 0, 11, 0.16),
      0 4px 12px rgba(0, 0, 0, 0.05);
  }
  .im8-flavor-dropdown__option {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 0 16px 0 0;
    cursor: pointer;
    transition: background 0.2s ease;
    min-height: 76px;
    overflow: hidden;
    border-top: 1px solid rgba(80, 0, 11, 0.05);
  }
  .im8-flavor-dropdown__option:last-child {
    border-radius: 0 0 var(--im8-radius-lg) var(--im8-radius-lg);
  }
  .im8-flavor-dropdown__option:hover {
    background: rgba(80, 0, 11, 0.035);
  }
  .im8-flavor-dropdown__option.is-selected {
    background: rgba(164, 0, 17, 0.06);
  }
  .im8-flavor-dropdown__option-thumb {
    width: 76px;
    height: 76px;
    object-fit: cover;
    flex-shrink: 0;
  }
  .im8-flavor-dropdown__option:last-child .im8-flavor-dropdown__option-thumb {
    border-bottom-left-radius: var(--im8-radius-lg);
  }
  .im8-flavor-dropdown__option-info {
    flex: 1;
    min-width: 0;
  }
  .im8-flavor-dropdown__option-name {
    font-size: 15px;
    font-weight: 600;
    color: var(--im8-text-primary);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .im8-flavor-dropdown__check {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: transparent;
    transition: color 0.2s ease;
  }
  .im8-flavor-dropdown__option.is-selected .im8-flavor-dropdown__check {
    color: var(--im8-red);
  }
  [data-flavor-radios] {
    display: none !important;
  }

  /* ── Plan Cards ─────────────────────────────────────────────────────── */
  .plan-cards-wrapper {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    padding-top: 16px;
    overflow: visible;
  }
  .plan-card {
    position: relative;
    border-radius: 10px;
    border: 1.5px solid rgba(80, 0, 11, 0.18);
    padding: 14px 16px;
    cursor: pointer;
    background: transparent;
    overflow: visible;
    transition:
      background 0.18s,
      box-shadow 0.18s;
  }
  .plan-card.selected {
    border: 1.5px solid rgba(164, 0, 17, 0.75) !important;
    background: linear-gradient(
      170deg,
      rgba(164, 0, 17, 0.04) 0%,
      rgba(164, 0, 17, 0.01) 100%
    );
    box-shadow: 0 2px 12px rgba(164, 0, 17, 0.08);
  }
  .plan-card__badges {
    position: absolute;
    top: -5px;
    left: 14px;
    right: 14px;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
  }
  .plan-card__badge-offer {
    font-family: "NB Architekt", "Montserrat", sans-serif;
    background: #f5c518;
    color: #3a1800;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 3px 10px 4px;
    border-radius: 6px;
    line-height: 1;
  }
  .plan-card__badge-best {
    font-family: "NB Architekt", "Montserrat", sans-serif;
    background: #8b0000;
    color: #fff;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 3px 10px 4px;
    border-radius: 6px;
    line-height: 1;
  }
  .plan-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }
  .plan-card__left {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .plan-card__radio-wrap {
    margin-top: 2px;
    flex-shrink: 0;
    width: 22px;
    height: 22px;
  }
  .plan-card__radio-wrap input[type="radio"] {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
  .plan-card__radio-icon {
    display: block;
    width: 22px;
    height: 22px;
    cursor: pointer;
    background: url("https://im8health.com/cdn/shop/t/121/assets/radio_blank.svg")
      center / cover no-repeat;
  }
  .plan-card__radio-wrap input[type="radio"]:checked + .plan-card__radio-icon {
    background: url("https://im8health.com/cdn/shop/t/121/assets/radio_fill.svg")
      center / cover no-repeat;
  }
  .plan-card__title {
    font-family: "Aeonik", sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: #50000b;
    line-height: 1.3;
  }
  .plan-card__billing {
    font-family: "Aeonik", sans-serif;
    font-size: 11px;
    color: rgba(80, 0, 11, 0.6);
    margin-top: 2px;
  }
  .plan-card__right {
    text-align: right;
    flex-shrink: 0;
    margin-left: 12px;
  }
  .plan-card__price {
    font-family: "Aeonik", sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: #50000b;
    white-space: nowrap;
  }
  .plan-card__price-mo {
    font-size: 11px;
    font-weight: 400;
    color: rgba(80, 0, 11, 0.6);
  }
  .plan-card__price-strike {
    font-size: 13px;
    font-weight: 400;
    color: rgba(80, 0, 11, 0.45);
    text-decoration: line-through;
    margin: 0 2px;
  }
  .plan-card__price-day {
    font-family: "Aeonik", sans-serif;
    font-size: 11px;
    color: rgba(80, 0, 11, 0.6);
    margin-top: 2px;
  }
