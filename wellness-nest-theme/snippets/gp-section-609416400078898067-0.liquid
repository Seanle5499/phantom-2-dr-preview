    <section class="plan-cards-wrapper" data-plan-cards></section>
    <div
      class="one-time-purchase-standalone"
      data-otp-container
      style="display: none"
    >
      <a href="#" class="one-time-purchase-link" data-otp-link>
        One Time Purchase <span class="otp-price" data-otp-price></span>
      </a>
    </div>
  </fieldset>
</div>

<!-- ═══ JavaScript ══════════════════════════════════════════════════ -->
<script>
  (function () {
    "use strict";

    // ╔═══════════════════════════════════════════════════════════════╗
    // ║  CHANGE THIS to your Shopify product handle                  ║
    // ╚═══════════════════════════════════════════════════════════════╝
    var PRODUCT_HANDLE = "test-widget";

    // ── Helpers ──
    function fmt(cents) {
      if (cents >= 10000000)
        return (
          new Intl.NumberFormat("vi-VN").format(Math.round(cents / 100)) + "₫"
        );
      return "$" + (cents / 100).toFixed(2).replace(/\.00$/, "");
    }
    function fmtShort(cents) {
      if (cents >= 10000000)
        return (
          new Intl.NumberFormat("vi-VN").format(Math.round(cents / 100)) + "₫"
        );
      return "$" + (cents / 100).toFixed(0);
    }
    function fmtPerDay(cents, days) {
      if (!days) return "";
      var d = cents / days;
      if (cents >= 10000000)
        return new Intl.NumberFormat("vi-VN").format(Math.round(d / 100)) + "₫";
      return "$" + (d / 100).toFixed(2);
    }
    function esc(s) {
      var d = document.createElement("div");
      d.textContent = s;
      return d.innerHTML;
    }

    function findImg(variant, media) {
      if (!media || !media.length) return null;
      var n = (variant.option1 || variant.title || "").toLowerCase();
      for (var i = 0; i < media.length; i++) {
        if ((media[i].alt || "").toLowerCase().indexOf(n) !== -1)
          return media[i];
      }
      return null;
    }

    // ── Fetch ──
    fetch("/products/" + PRODUCT_HANDLE + ".js")
      .then(function (r) {
        return r.json();
      })
      .then(function (data) {
        buildFlavors(data.variants, data.media);
        buildPlans(data.variants, data.selling_plan_groups);
        buildOTP(data.variants);
        initDropdown();
      })
      .catch(function (e) {
        console.error("[VariantSelects] fetch failed:", e);
      });

    // ── 1. Flavors ──
    function buildFlavors(variants, media) {
      var c = document.querySelector("[data-flavor-radios]");
      if (!c) return;
      c.innerHTML = "";
      variants.forEach(function (v, i) {
        var name = v.option1 || v.title;
        var img = findImg(v, media);
        var src = img ? img.src : "";
        var div = document.createElement("div");
        div.innerHTML =
          '<input type="radio" name="im8-flavor" value="' +
          esc(name) +
          '"' +
          (i === 0 ? " checked" : "") +
          ' data-variant-id="' +
          v.id +
          '" style="display:none">' +
          (src
            ? '<img src="' + src + '" data-flavor-img style="display:none">'
            : "");
        c.appendChild(div);
      });
    }

    // ── 2. Plan Cards ──
    function buildPlans(variants, groups) {
      var c = document.querySelector("[data-plan-cards]");
      if (!c || !groups || !groups.length) return;
      c.innerHTML = "";
      var v0 = variants[0];
      var allocs = v0.selling_plan_allocations || [];

      var plans = groups.map(function (g) {
        var sp = g.selling_plans[0];
        var alloc = null;
        for (var i = 0; i < allocs.length; i++) {
          if (allocs[i].selling_plan_id === sp.id) {
            alloc = allocs[i];
            break;
          }
        }
        var qty = 1;
        g.options.forEach(function (o) {
          if (o.name === "Product Quantity") qty = parseInt(o.values[0]) || 1;
        });
        var save =
          sp.price_adjustments && sp.price_adjustments[0]
            ? sp.price_adjustments[0].value
            : 0;
        return {
          group: g,
          plan: sp,
          alloc: alloc,
          qty: qty,
          save: save,
          price: alloc ? alloc.price : v0.price,
          compare: alloc ? alloc.compare_at_price : v0.price,
          spId: sp.id,
        };
      });

      plans.sort(function (a, b) {
        return b.qty - a.qty;
      });
      var bestIdx = 0,
        maxS = 0;
      plans.forEach(function (p, i) {
        if (p.save > maxS) {
          maxS = p.save;
          bestIdx = i;
        }
      });

      plans.forEach(function (p, idx) {
        var best = idx === bestIdx;
        var def = best;
        var days = p.qty * 30;
        var total = p.price * p.qty;
        var weeks = p.qty * 4;
        var billing = "Billed " + fmt(total) + " every " + weeks + " weeks";
        var perDay = fmtPerDay(p.price, 30) + " / DAY";
        var saveLabel = p.save > 0 ? " (Save " + p.save + "%)" : "";

        var badges = "";
        if (best) {
          badges =
            '<div class="plan-card__badges">' +
            '<span class="plan-card__badge-offer">Launch Offer</span>' +
            '<span class="plan-card__badge-best">Best Value</span></div>';
        }

        var priceHtml = fmtShort(p.price);
        if (p.compare && p.compare > p.price) {
          priceHtml +=
            ' <span class="plan-card__price-strike">' +
            fmtShort(p.compare) +
            "</span>";
        }
        priceHtml += '<span class="plan-card__price-mo">/mo</span>';

        var feats = [];
        if (p.qty >= 3) {
          feats = [
            {
              i: "🎯",
              t: "Exclusive Access to " + days + " Day Transformation Program",
            },
            { i: "💰", t: "Maximum savings – lowest price per serving" },
            { i: "🔵", t: days + "-Day Money-Back Guarantee" },
            { i: "🧡", t: "Share with family and friends" },
            { i: "🎁", t: "Free Mystery Gift" },
            {
              i: "🚚",
              t: "Free Shipping to US, UK, CA, and most of EU and APAC",
            },
            { i: "📋", t: "Cancel or pause anytime" },
          ];
        } else if (p.qty >= 2) {
          feats = [
            { i: "💰", t: "Great savings per serving" },
            {
              i: "🚚",
              t: "Free Shipping to US, UK, CA, and most of EU and APAC",
            },
            { i: "📋", t: "Cancel or pause anytime" },
            { i: "🎁", t: "Free Mystery Gift" },
          ];
        } else {
          feats = [
            { i: "💰", t: "Save " + p.save + "% vs one-time purchase" },
            { i: "🚚", t: "Free Priority Shipping" },
            { i: "📋", t: "Cancel or pause anytime" },
            { i: "🎁", t: "Free Mystery Gift" },
          ];
        }
        var fHtml = '<div class="plan-card__features">';
        feats.forEach(function (f) {
          fHtml +=
            '<div class="plan-card__feature"><span class="plan-card__feature-icon">' +
            f.i +
            "</span><span>" +
            esc(f.t) +
            "</span></div>";
        });
        fHtml += "</div>";

        c.insertAdjacentHTML(
          "beforeend",
          '<div class="plan-card' +
            (def ? " selected" : "") +
            '" data-plan-days="' +
            days +
            '" data-selling-plan-id="' +
            p.spId +
            '">' +
            badges +
            '<div class="plan-card__header"' +
            (best ? ' style="padding-top:4px"' : "") +
            ">" +
            '<div class="plan-card__left"><div class="plan-card__radio-wrap">' +
            '<input type="radio" name="im8-plan" ' +
            (def ? "checked " : "") +
            "/>" +
            '<span class="plan-card__radio-icon"></span></div><div>' +
            '<div class="plan-card__title">' +
            esc(days + "-Day Supply") +
            esc(saveLabel) +
            "</div>" +
            '<div class="plan-card__billing">' +
            billing +
            "</div></div></div>" +
            '<div class="plan-card__right"><div class="plan-card__price">' +
            priceHtml +
            "</div>" +
            '<div class="plan-card__price-day">' +
            perDay +
            "</div></div></div>" +
            '<hr class="plan-card__divider"/>' +
            fHtml +
            "</div>",
        );
      });

      // Click handlers
      var cards = c.querySelectorAll(".plan-card");
      cards.forEach(function (card) {
        card.addEventListener("click", function () {
          cards.forEach(function (c2) {
            c2.classList.remove("selected");
            var r = c2.querySelector('input[type="radio"]');
            if (r) r.checked = false;
          });
          card.classList.add("selected");
          var r = card.querySelector('input[type="radio"]');
          if (r) r.checked = true;
        });
      });
    }

    // ── 3. OTP ──
    function buildOTP(variants) {
      var ctr = document.querySelector("[data-otp-container]");
      var priceEl = document.querySelector("[data-otp-price]");
      var link = document.querySelector("[data-otp-link]");
      if (!ctr || !variants.length) return;
      var v = variants[0];
      ctr.style.display = "";
      if (priceEl) priceEl.textContent = fmt(v.price);
      if (link) link.dataset.variantId = v.id;

      // Update on flavor change
      document
        .querySelector("[data-flavor-radios]")
        .addEventListener("change", function (e) {
          if (!e.target.dataset.variantId) return;
          for (var i = 0; i < variants.length; i++) {
            if (String(variants[i].id) === String(e.target.dataset.variantId)) {
              if (priceEl) priceEl.textContent = fmt(variants[i].price);
              if (link) link.dataset.variantId = variants[i].id;
              break;
            }
          }
        });

      if (link)
        link.addEventListener("click", function (e) {
          e.preventDefault();
          var vid = this.dataset.variantId;
          // Add to cart via Shopify AJAX API
          fetch("/cart/add.js", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              items: [{ id: parseInt(vid), quantity: 1 }],
            }),
          })
            .then(function () {
              window.location.href = "/cart";
            })
            .catch(function (err) {
              console.error("[OTP] Add to cart failed:", err);
              window.location.href = "/cart/add?id=" + vid + "&quantity=1";
            });
        });
    }

    // ── 4. Dropdown ──
    function initDropdown() {
      var dd = document.querySelector("[data-im8-flavor-dropdown]");
      if (!dd) return;
      var trigger = dd.querySelector("[data-im8-flavor-trigger]");
      var panel = dd.querySelector("[data-im8-flavor-options]");
      var thumbEl = dd.querySelector("[data-im8-flavor-thumb]");
      var nameEl = dd.querySelector("[data-im8-flavor-selected-name]");
      var subEl = dd.querySelector("[data-im8-flavor-selected-sub]");
      var radios = document.querySelectorAll(
        '[data-flavor-radios] input[type="radio"]',
      );
      if (!radios.length) return;

      panel.innerHTML = "";
      var seen = {};
      radios.forEach(function (radio) {
        var name = radio.value,
          key = name.toLowerCase();
        if (seen[key]) return;
        seen[key] = true;
        var imgEl = radio.parentElement.querySelector("[data-flavor-img]");
        var src = imgEl ? imgEl.src : "";

        var opt = document.createElement("div");
        opt.className = "im8-flavor-dropdown__option";
        opt.setAttribute("data-value", name);
        opt.setAttribute("tabindex", "0");
        opt.innerHTML =
          (src
            ? '<img class="im8-flavor-dropdown__option-thumb" src="' +
              src +
              '" alt="' +
              esc(name) +
              '">'
            : "") +
          '<div class="im8-flavor-dropdown__option-info"><div class="im8-flavor-dropdown__option-name">' +
          esc(name) +
          "</div></div>" +
          '<svg class="im8-flavor-dropdown__check" viewBox="0 0 20 20" fill="none"><path d="M4 10.5L8 14.5L16 6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
        panel.appendChild(opt);
        opt.addEventListener("click", function () {
          sel(name);
        });
      });

      function getSrc(radio) {
        var img = radio.parentElement.querySelector("[data-flavor-img]");
        return img ? img.src : "";
      }
      function sel(name) {
        radios.forEach(function (r) {
          if (r.value === name) {
            r.checked = true;
            r.dispatchEvent(new Event("change", { bubbles: true }));
          }
        });
        upd();
        close();
      }
      function upd() {
        var checked =
          document.querySelector(
            '[data-flavor-radios] input[type="radio"]:checked',
          ) || radios[0];
        var name = checked.value,
          src = getSrc(checked);
        if (src) {
          thumbEl.src = src;
          thumbEl.alt = name;
          thumbEl.style.display = "";
        } else {
          thumbEl.style.display = "none";
        }
        nameEl.textContent = name;
        subEl.style.display = "none";
        panel
          .querySelectorAll(".im8-flavor-dropdown__option")
          .forEach(function (o) {
            var s = o.getAttribute("data-value") === name;
            o.classList.toggle("is-selected", s);
          });
      }
      function open() {
        dd.classList.add("is-expanded");
        trigger.setAttribute("aria-expanded", "true");
      }
      function close() {
        dd.classList.remove("is-expanded");
        trigger.setAttribute("aria-expanded", "false");
      }
      function toggle() {
        dd.classList.contains("is-expanded") ? close() : open();
      }

      trigger.addEventListener("click", toggle);
      document.addEventListener("click", function (e) {
        if (!dd.contains(e.target)) close();
      });
      radios.forEach(function (r) {
        r.addEventListener("change", upd);
      });
      upd();
    }
  })();
</script>
    </div>
    </div>
