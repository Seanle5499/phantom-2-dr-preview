    <div class="im8-flavor-dropdown" data-im8-flavor-dropdown role="listbox">
      <div
        class="im8-flavor-dropdown__trigger"
        tabindex="0"
        aria-expanded="false"
        data-im8-flavor-trigger
      >
        <img
          class="im8-flavor-dropdown__thumb"
          src=""
          alt=""
          data-im8-flavor-thumb
        />
        <div class="im8-flavor-dropdown__selected-info">
          <div
            class="im8-flavor-dropdown__selected-name"
            data-im8-flavor-selected-name
          >
            Loading...
          </div>
