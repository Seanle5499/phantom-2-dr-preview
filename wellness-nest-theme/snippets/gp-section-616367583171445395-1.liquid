      <script id="custom-js-gEstdqh4of">
        try {
          (function() {

  var PRODUCT_HANDLE = "shilasource-himalayan-shilajit-resin";

  var PACK_TO_PLAN_INDEX = { "1p": 5, "2p": 3, "3p": 4 };
  var PACK_TO_QTY = { "1p": 1, "2p": 2, "3p": 3 };

  var TAB_ROOT_SEL  = ".gEstdqh4of";
  var ATC_BTN_SEL   = ".gWZEEQKgvs";
  var RC_WIDGET_SEL = ".mainrc .rc-widget";

  var LOG = "[PW]";

  var _pwVariants = [];
  var _pwGroups   = [];
  var _pwPlans    = [];
  var _pwState    = { mode: "subsave", pack: "1p" };

  // ═══════════════════════════════════════════════════════════════
  //  DOM HELPERS
  // ═══════════════════════════════════════════════════════════════
  function _pwQuery(sel, root)  { return (root || document).querySelector(sel); }
  function _pwQueryAll(sel, root) {
    var nl = (root || document).querySelectorAll(sel);
    var out = [];
    for (var idxQ = 0; idxQ < nl.length; idxQ++) out.push(nl[idxQ]);
    return out;
  }

  // ═══════════════════════════════════════════════════════════════
  //  CURRENCY
  // ═══════════════════════════════════════════════════════════════
  function _pwActiveCurrency() {
    try {
      if (window.Shopify && window.Shopify.currency && window.Shopify.currency.active) {
        return window.Shopify.currency.active;
      }
    } catch(ePw) {}
    return 'USD';
  }

  function _pwCurrencySymbol(curCode) {
    if (curCode === "USD") return "$";
    if (curCode === "EUR") return "€";
    if (curCode === "GBP") return "£";
    if (curCode === "JPY") return "¥";
    if (curCode === "VND") return "₫";
    if (curCode === "KRW") return "₩";
    if (curCode === "AUD") return "A$";
    if (curCode === "CAD") return "C$";
    if (curCode === "INR") return "₹";
    if (curCode === "CNY") return "¥";
    if (curCode === "THB") return "฿";
    if (curCode === "PHP") return "₱";
    if (curCode === "IDR") return "Rp";
    if (curCode === "MXN") return "$";
    if (curCode === "BRL") return "R$";
    return curCode + " ";
  }

  function _pwIsZeroDecimal(curCode) {
    if (curCode === "JPY" || curCode === "KRW" || curCode === "VND") return true;
    if (curCode === "CLP" || curCode === "BIF" || curCode === "DJF") return true;
    if (curCode === "GNF" || curCode === "KMF" || curCode === "MGA") return true;
    if (curCode === "PYG" || curCode === "RWF" || curCode === "UGX") return true;
    if (curCode === "VUV" || curCode === "XAF" || curCode === "XOF" || curCode === "XPF") return true;
    return false;
  }

  function _pwFormatPrice(cents) {
    if (cents === undefined || cents === null) return "";
    var priceNum = Number(cents);
    var curCode = _pwActiveCurrency();
    var priceAmount = priceNum / 100;
    var priceDecimals = _pwIsZeroDecimal(curCode) ? 0 : 2;
    var priceFixed = priceAmount.toFixed(priceDecimals);

    var useEuStyle = (curCode === "EUR" || curCode === "VND" || curCode === "IDR");
    var priceParts = priceFixed.split(".");
    var intSection = priceParts[0];
    var decSection = priceParts.length === 2 ? priceParts[1] : "";

    var thousandSep = useEuStyle ? "." : ",";
    intSection = intSection.replace(/\B(?=(\d{3})+(?!\d))/g, thousandSep);

    var priceResult = intSection;
    if (decSection) {
      priceResult += (useEuStyle ? "," : ".") + decSection;
    }

    return _pwCurrencySymbol(curCode) + priceResult;
  }

  // ═══════════════════════════════════════════════════════════════
  //  DATA HELPERS
  // ═══════════════════════════════════════════════════════════════
  function _pwBaseVariant() { return _pwVariants[0] || null; }

  function _pwPlanForPack(packKey) {
    var mapIdx = PACK_TO_PLAN_INDEX[packKey];
    return (mapIdx !== undefined) ? (_pwPlans[mapIdx] || null) : null;
  }

  function _pwCurrentTotalPrice() {
    var baseVar = _pwBaseVariant();
    if (!baseVar) return 0;
    if (_pwState.mode === "onetime") {
      var otpQty = PACK_TO_QTY[_pwState.pack] || 1;
      return baseVar.price * otpQty;
    }
    var planObj = _pwPlanForPack(_pwState.pack);
    if (!planObj) return baseVar.price;
    return planObj.price * planObj.qty;
  }

  function _pwCurrentSellingPlanId() {
    if (_pwState.mode === "onetime") return null;
    var planObj2 = _pwPlanForPack(_pwState.pack);
    return planObj2 ? planObj2.spId : null;
  }

  function _pwCurrentQuantity() {
    if (_pwState.mode === "onetime") return PACK_TO_QTY[_pwState.pack] || 1;
    var planObj3 = _pwPlanForPack(_pwState.pack);
    return planObj3 ? planObj3.qty : 1;
  }

  // ═══════════════════════════════════════════════════════════════
  //  FETCH
  // ═══════════════════════════════════════════════════════════════
  console.log(LOG, "FETCH START", PRODUCT_HANDLE, "| currency:", _pwActiveCurrency());

  fetch("/products/" + PRODUCT_HANDLE + ".js")
    .then(function(respFetch) {
      console.log(LOG, "FETCH response:", respFetch.status);
      if (!respFetch.ok) throw new Error("HTTP " + respFetch.status);
      return respFetch.json();
    })
    .then(function(dataRes) {
      try { _pwParseData(dataRes); }
      catch(eParse) { console.error(LOG, "parseData CRASHED:", eParse.message, eParse.stack); }
    })
    .catch(function(errFetch) {
      console.error(LOG, "FETCH FAILED:", errFetch.message);
    });

  function _pwParseData(dataObj) {
    _pwVariants = dataObj.variants || [];
    _pwGroups   = dataObj.selling_plan_groups || [];

    var firstVariant = _pwBaseVariant();
    var allocArr = (firstVariant && firstVariant.selling_plan_allocations) || [];

    _pwPlans = [];
    for (var gIdx = 0; gIdx < _pwGroups.length; gIdx++) {
      var groupItem = _pwGroups[gIdx];
      var spItem = (groupItem.selling_plans && groupItem.selling_plans[0]) || null;
      if (!spItem) { _pwPlans.push(null); continue; }

      var allocMatch = null;
      for (var aIdx = 0; aIdx < allocArr.length; aIdx++) {
        if (allocArr[aIdx].selling_plan_id === spItem.id) {
          allocMatch = allocArr[aIdx];
          break;
        }
      }

      var planQty = 1;
      var groupOpts = groupItem.options || [];
      for (var oIdx = 0; oIdx < groupOpts.length; oIdx++) {
        if (groupOpts[oIdx].name === "Product Quantity") {
          planQty = parseInt(groupOpts[oIdx].values[0]) || 1;
        }
      }

      _pwPlans.push({
        qty   : planQty,
        spId  : spItem.id,
        name  : spItem.name || groupItem.name,
        price : allocMatch ? allocMatch.price : (firstVariant ? firstVariant.price : 0)
      });
    }

    console.log(LOG, "plans loaded:", _pwPlans.length);
    _pwWaitForUI(_pwInit);
  }

  // ═══════════════════════════════════════════════════════════════
  //  WAIT UI
  // ═══════════════════════════════════════════════════════════════
  function _pwWaitForUI(callback) {
    if (_pwQuery(TAB_ROOT_SEL) && _pwQuery(ATC_BTN_SEL)) { callback(); return; }
    var observer = new MutationObserver(function(_m, obs) {
      if (_pwQuery(TAB_ROOT_SEL) && _pwQuery(ATC_BTN_SEL)) {
        obs.disconnect();
        callback();
      }
    });
    observer.observe(document.body, { childList: true, subtree: true });
    setTimeout(function() { observer.disconnect(); }, 10000);
  }

  function _pwInit() {
    try {
      _pwBindTabs();
      _pwBindPacksDelegation();
      _pwReplaceATC();
      _pwUpdateTabLabels();
      _pwUpdatePackActiveVisual();
      _pwSyncFormVariant();
      _pwUpdateATCLabel();
      _pwStartATCPriceWatcher();
      console.log(LOG, "INIT DONE", _pwState);
    } catch(eInit) {
      console.error(LOG, "INIT CRASHED:", eInit.message, eInit.stack);
    }
  }

  // ═══════════════════════════════════════════════════════════════
  //  TABS
  // ═══════════════════════════════════════════════════════════════
  function _pwBindTabs() {
    var tabList = _pwQueryAll(TAB_ROOT_SEL + " .gp-navs-tab");
    for (var tIdx = 0; tIdx < tabList.length; tIdx++) {
      (function(tabIdx, tabEl) {
        var tabMode = (tabIdx === 0) ? "subsave" : "onetime";
        tabEl.addEventListener("click", function() {
          _pwState.mode = tabMode;
          _pwSyncRecharge(tabMode);
          _pwUpdateATCLabel();
          console.log(LOG, "mode →", tabMode, "| total:", _pwFormatPrice(_pwCurrentTotalPrice()));
        });
      })(tIdx, tabList[tIdx]);
    }
  }

  function _pwSyncRecharge(modeVal) {
    var rcEl = _pwQuery(RC_WIDGET_SEL);
    if (!rcEl) return;
    var rcValue = (modeVal === "onetime") ? "onetime" : "subsave";
    var rcInput = rcEl.querySelector('input.rc-radio__input[value="' + rcValue + '"]');
    if (rcInput && !rcInput.checked) { rcInput.checked = true; rcInput.click(); }
    var rcDropdown = rcEl.querySelector("select.rc-selling-plans__dropdown");
    if (rcDropdown) rcDropdown.setAttribute("name", modeVal === "onetime" ? "" : "selling_plan");
  }

  // ═══════════════════════════════════════════════════════════════
  //  PACK CLICK
  // ═══════════════════════════════════════════════════════════════
  function _pwBindPacksDelegation() {
    document.addEventListener("click", function(evt) {
      var swatchEl = evt.target.closest(".gp-cus-swatch-1p, .gp-cus-swatch-2p, .gp-cus-swatch-3p");
      if (!swatchEl) return;
      if (!swatchEl.closest(TAB_ROOT_SEL)) return;

      var packKey = null;
      if (swatchEl.classList.contains("gp-cus-swatch-1p")) packKey = "1p";
      else if (swatchEl.classList.contains("gp-cus-swatch-2p")) packKey = "2p";
      else if (swatchEl.classList.contains("gp-cus-swatch-3p")) packKey = "3p";
      if (!packKey) return;

      _pwState.pack = packKey;
      _pwUpdatePackActiveVisual();
      _pwSyncFormVariant();
      _pwUpdateATCLabel();

      console.log(LOG, "pack →", packKey, "| total:", _pwFormatPrice(_pwCurrentTotalPrice()));
    }, true);
  }

  function _pwUpdatePackActiveVisual() {
    var allPacks = _pwQueryAll(TAB_ROOT_SEL + " .mainvaluevariant");
    for (var i1 = 0; i1 < allPacks.length; i1++) {
      var packEl = allPacks[i1];
      packEl.classList.remove("gp-active");
      packEl.style.removeProperty("--bgc");
      packEl.style.setProperty("--bgc", "#ffffff", "important");
      packEl.style.setProperty("background", "#ffffff", "important");
      packEl.style.setProperty("border-color", "#BDBDBD", "important");
    }

    var activePacks = _pwQueryAll(TAB_ROOT_SEL + " .gp-cus-swatch-" + _pwState.pack);
    for (var i2 = 0; i2 < activePacks.length; i2++) {
      var activeEl = activePacks[i2];
      activeEl.classList.add("gp-active");
      activeEl.style.setProperty("--bgc", "#F4F4F4", "important");
      activeEl.style.setProperty("background", "#F4F4F4", "important");
      activeEl.style.setProperty("border-color", "#26A243", "important");
      activeEl.style.setProperty("border-width", "2px", "important");
    }
  }

  function _pwSyncFormVariant() {
    var baseV = _pwBaseVariant();
    if (!baseV) return;
    var formInputs = _pwQueryAll('form[action="/cart/add"] input[name="id"]');
    for (var i3 = 0; i3 < formInputs.length; i3++) {
      formInputs[i3].value = baseV.id;
      formInputs[i3].setAttribute("data-value", baseV.id);
    }
  }

  function _pwUpdateTabLabels() {
    var baseV2 = _pwBaseVariant();
    if (!baseV2) return;
    var plan1 = _pwPlanForPack("1p");
    var subUnit = plan1 ? plan1.price : baseV2.price;
    var tabList2 = _pwQueryAll(TAB_ROOT_SEL + " .gp-navs-tab");
    if (tabList2[0]) {
      var s0 = tabList2[0].querySelector("strong");
      if (s0) { try { s0.textContent = _pwFormatPrice(subUnit); } catch(eT1) {} }
    }
    if (tabList2[1]) {
      var s1 = tabList2[1].querySelector("strong");
      if (s1) { try { s1.textContent = _pwFormatPrice(baseV2.price); } catch(eT2) {} }
    }
  }

  // ═══════════════════════════════════════════════════════════════
  //  ATC PRICE UPDATE + WATCHER
  // ═══════════════════════════════════════════════════════════════
  function _pwUpdateATCLabel() {
    var totalCents = _pwCurrentTotalPrice();
    var priceStr = _pwFormatPrice(totalCents);

    var atcBtn = _pwQuery(ATC_BTN_SEL);
    if (!atcBtn) return;

    var wrapper = atcBtn.closest("gp-product-button") || atcBtn;

    var priceEls = _pwQueryAll("[data-gp-text]", wrapper);
    for (var i4 = 0; i4 < priceEls.length; i4++) {
      var priceEl = priceEls[i4];
      var txtContent = priceEl.textContent || "";
      if (/[€$£¥₫₩\d]/.test(txtContent) && !priceEl.querySelector("*")) {
        try { priceEl.textContent = priceStr; } catch(ePx) {}
      }
    }
  }

  function _pwStartATCPriceWatcher() {
    var atcBtn = _pwQuery(ATC_BTN_SEL);
    if (!atcBtn) return;
    var wrapper = atcBtn.closest("gp-product-button") || atcBtn;
    var isUpdating = false;

    var obs = new MutationObserver(function() {
      if (isUpdating) return;
      isUpdating = true;
      try {
        _pwUpdateATCLabel();
      } catch(eW) {}
      setTimeout(function() { isUpdating = false; }, 100);
    });

    obs.observe(wrapper, {
      childList: true,
      subtree: true,
      characterData: true
    });

    console.log(LOG, "ATC price watcher started");
  }

  // ═══════════════════════════════════════════════════════════════
  //  ATC — REPLACE BUTTON + GO STRAIGHT TO CHECKOUT
  // ═══════════════════════════════════════════════════════════════
  function _pwReplaceATC() {
    var oldBtn = _pwQuery(ATC_BTN_SEL);
    if (!oldBtn) {
      console.warn(LOG, "ATC button not found");
      return;
    }

    var newBtn = oldBtn.cloneNode(true);
    oldBtn.parentNode.replaceChild(newBtn, oldBtn);

    newBtn.setAttribute("type", "button");
    newBtn.addEventListener("click", function(evt) {
      evt.preventDefault();
      evt.stopPropagation();
      evt.stopImmediatePropagation();
      _pwDoCheckout(newBtn);
    }, true);

    console.log(LOG, "ATC button replaced");
  }

  function _pwDoCheckout(btnEl) {
    var baseV3 = _pwBaseVariant();
    if (!baseV3) { alert("Producto no disponible"); return; }

    var qtyVal = _pwCurrentQuantity();
    var planIdVal = _pwCurrentSellingPlanId();
    var payloadObj = { id: baseV3.id, quantity: qtyVal };
    if (planIdVal) payloadObj.selling_plan = planIdVal;

    console.log(LOG, "CHECKOUT payload:", payloadObj);

    btnEl.setAttribute("data-state", "loading");
    btnEl.disabled = true;

    fetch("/cart/clear.js", {
      method: "POST",
      headers: { "Content-Type": "application/json" }
    })
    .then(function() {
      return fetch("/cart/add.js", {
        method : "POST",
        headers: { "Content-Type": "application/json" },
        body   : JSON.stringify({ items: [payloadObj] })
      });
    })
    .then(function(respAdd) {
      if (!respAdd.ok) {
        return respAdd.json().then(function(jErr) {
          throw new Error(jErr.description || jErr.message || "ATC failed");
        });
      }
      return respAdd.json();
    })
    .then(function(addRes) {
      console.log(LOG, "Added:", addRes);

      if (window.fbq) {
        try {
          fbq("track", "AddToCart", {
            content_ids : [String(baseV3.id)],
            content_type: "product_variant",
            value       : _pwCurrentTotalPrice() / 100,
            currency    : _pwActiveCurrency(),
            num_items   : qtyVal
          });
        } catch(ePx2) {}
      }

      if (window.gtag) {
        try {
          gtag("event", "add_to_cart", {
            currency: _pwActiveCurrency(),
            value: _pwCurrentTotalPrice() / 100,
            items: [{
              item_id: String(baseV3.id),
              item_name: baseV3.title || "Product",
