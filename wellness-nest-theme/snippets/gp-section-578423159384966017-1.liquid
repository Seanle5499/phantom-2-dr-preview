        /* CSS cho GemPages Product Variant - Fixed Layout */
/* Container chính cho variant options */
.variant-option-group {
  display: flex !important;
  flex-direction: column !important;
  gap: 10px !important;
  width: 100% !important;
}
/* Reset option items */
.option-item {
  width: 100% !important;
  height: auto !important;
  position: relative !important;
}
/* Option value wrapper - main container */
.option-value-wrapper {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  width: 100% !important;
  min-height: 60px !important;
  padding: 16px 20px !important;
  border-radius: 10px !important;
  border: 1px solid #DDC3E8 !important;
  background: transparent !important;
  cursor: pointer !important;
  transition: all 0.3s ease !important;
  position: relative !important;
}
/* Remove CSS content-based pricing (was causing duplicates) */
.option-value-wrapper::after {
  display: none !important;
}
/* Left section styling */
.option-value-wrapper .option-value {
  display: flex !important;
  align-items: center !important;
  gap: 12px !important;
  flex: 1 !important;
  padding: 0 !important;
  margin: 0 !important;
}
/* Custom Radio Button */
.option-value-wrapper .option-value::before {
  content: '' !important;
  width: 20px !important;
  height: 20px !important;
  border: 1px solid #DDC3E8 !important;
  border-radius: 50% !important;
  background: transparent !important;
  flex-shrink: 0 !important;
  transition: all 0.3s ease !important;
  margin-right: 8px !important;
}
/* Radio button checked state */
.option-item-active .option-value-wrapper .option-value::before {
  border-color: #772B90 !important;
  background: #772B90 !important;
  box-shadow: inset 0 0 0 3px white !important;
}
/* Text styling */
.option-value span {
  font-family: 'Poppins', sans-serif !important;
  font-size: 16px !important;
  font-weight: 600 !important;
  color: #434343 !important;
  line-height: 1.4 !important;
  margin: 0 !important;
  padding: 0 !important;
}
/* Hover effect */
.option-value-wrapper:hover {
  border-color: #772B90 !important;
  background: #f8f4fb !important;
  transform: translateY(-1px) !important;
}
.option-value-wrapper:hover .option-value::before {
  border-color: #772B90 !important;
}
/* Active/Selected state */
.option-item-active .option-value-wrapper {
  background: #EFE1F4 !important;
  border: 1px solid #772B90 !important;
}
/* Hide original radio inputs */
.option-item input[type="radio"] {
  display: none !important;
}
/* Hide tooltips */
.option-item .gp-invisible {
  display: none !important;
}
.option-value-wrapper {
  min-height: 92px !important;
  padding: 24px 24px !important;
  font-size: 20px !important;
}
.option-value-wrapper .gp-text-center {
  font-size: 20px !important;
  color: #434343 !important;
}

/* MINIMAL FIX - chỉ fix alignment */
.option-value-wrapper {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  min-height: 94px !important;
  padding: 24px !important;
}

/* Text alignment */
.option-value {
  flex: 1 !important;
  display: flex !important;
  align-items: center !important;
}

/* Price section */
.price-section {
  margin-left: auto !important;
  text-align: right !important;
  flex-shrink: 0 !important;
}

/* Giữ Most Popular badge style simple */
.option-value span span {
  background: #772B90 !important;
  color: white !important;
  padding: 6px 12px !important;
  border-radius: 6px !important;
  font-size: 14px !important;
  font-weight: 700 !important;
  margin-left: 12px !important;
  vertical-align: middle !important;
}

/* MOBILE SPECIFIC FIXES */
@media (max-width: 768px) {
