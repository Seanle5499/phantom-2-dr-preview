// Main function to initialize the new design
function initializeNewDesign() {
  console.log('🎨 Initializing new design...');
  
  const wrappers = document.querySelectorAll('.option-value-wrapper');
  console.log('📦 Found', wrappers.length, 'variant options');
  
  if (wrappers.length === 0) {
    console.log('❌ No options found, retrying in 1 second...');
    setTimeout(initializeNewDesign, 1000);
    return;
  }
  
  // Check if already initialized
  const transformedWrappers = document.querySelectorAll('.option-value-wrapper[data-transformed="true"]');
  if (transformedWrappers.length === wrappers.length) {
    console.log('✅ All wrappers already transformed, skipping...');
    updateTotalPrice(); // Update total price even if wrappers are transformed
    return;
  }
  
  // Get variant data from Shopify
  const variantData = getVariantData();
  
  // Transform each wrapper to new design
  wrappers.forEach((wrapper, index) => {
    transformWrapper(wrapper, variantData, index);
  });
  
  // Add total price section
  addTotalPriceSection();
  updateTotalPrice();
  
  console.log('🎉 New design initialization complete!');
  setupEventListeners();
}

// Get variant data from Shopify
function getVariantData() {
  const variantComponent = document.querySelector('gp-product-variants');
  
  if (!variantComponent) {
    console.log('❌ No variant component found');
    return null;
  }
  
  try {
    const gpData = variantComponent.getAttribute('gp-data');
    const data = JSON.parse(gpData);
    console.log('✅ Variant data loaded successfully');
    return data;
  } catch (e) {
    console.error('❌ Failed to parse variant data:', e);
    return null;
  }
}

// Transform a wrapper to the new design
function transformWrapper(wrapper, variantData, index) {
  const optionValue = wrapper.getAttribute('option-value');
  const info = CONFIG.variantInfo[optionValue];
  
  if (!info) {
    console.log('⚠️ No info found for:', optionValue);
    return;
  }
  
  console.log(`🔄 Transforming wrapper ${index + 1}: ${optionValue}`);
  
  // Clear existing content and check if already processed
  const shouldProcess = clearWrapperContent(wrapper);
  if (!shouldProcess) {
    return; // Skip if already transformed
  }
  
  // Create new structure
  const leftContent = createLeftContent(optionValue, info);
  const priceContent = createPriceContent(optionValue, info, variantData);
  
  // Apply new structure
  wrapper.appendChild(leftContent);
  wrapper.appendChild(priceContent);
  
  console.log(`✅ Transformed wrapper ${index + 1}`);
}

// Clear existing wrapper content - COMPLETE CLEANUP
function clearWrapperContent(wrapper) {
  // Check if already transformed to avoid double processing
  if (wrapper.dataset.transformed === 'true') {
    console.log('⚠️ Wrapper already transformed, skipping...');
    return false;
  }
  
  // Remove ALL existing content
  wrapper.innerHTML = '';
  
  // Clean up classes but keep essential ones
  const optionValue = wrapper.getAttribute('option-value');
  wrapper.className = 'option-value-wrapper';
  wrapper.setAttribute('option-value', optionValue);
  
  // Reset wrapper styles
  wrapper.style.cssText = '';
  
  // Mark as being processed
  wrapper.dataset.transformed = 'true';
  
  return true;
}

// Create left content area (image + text)
function createLeftContent(optionValue, info) {
  const leftContent = document.createElement('div');
  leftContent.className = 'left-content';
  
  // Product image
  const productImage = document.createElement('div');
  productImage.className = 'product-image';
  productImage.style.backgroundImage = `url('${CONFIG.imageUrls[optionValue]}')`;
  
  // Text content
  const textContent = document.createElement('div');
  textContent.className = 'text-content';
  
  const supplyTitle = document.createElement('div');
  supplyTitle.className = 'supply-title';
  supplyTitle.textContent = optionValue.replace('Days', 'Day');
  
  const bottlesCount = document.createElement('div');
  bottlesCount.className = 'bottles-count';
  bottlesCount.textContent = `${info.bottles} ${info.bottles === 1 ? 'Bottle' : 'Bottles'}`;
  
  const capsulesCount = document.createElement('div');
  capsulesCount.className = 'capsules-count';
  capsulesCount.textContent = `${info.capsules} Capsules`;
  
  textContent.appendChild(supplyTitle);
  textContent.appendChild(bottlesCount);
  textContent.appendChild(capsulesCount);
  
  leftContent.appendChild(productImage);
  leftContent.appendChild(textContent);
  
  return leftContent;
}

// Create price content area
function createPriceContent(optionValue, info, variantData) {
  const priceContent = document.createElement('div');
  priceContent.className = 'price-content';
  
  // Get pricing data
  const pricing = calculatePricing(info.days, variantData, info.bottles);
  
  // Per bottle price
  const perBottlePrice = document.createElement('div');
  perBottlePrice.className = 'per-bottle-price';
  perBottlePrice.textContent = pricing.perBottlePrice;
  
  // Per bottle text
  const perBottleText = document.createElement('div');
  perBottleText.className = 'per-bottle-text';
  perBottleText.textContent = 'Per bottle';
  
  // Savings amount
  const savingsAmount = document.createElement('div');
  savingsAmount.className = 'savings-amount';
  savingsAmount.textContent = pricing.savings;
  
  priceContent.appendChild(perBottlePrice);
  priceContent.appendChild(perBottleText);
  priceContent.appendChild(savingsAmount);
  
  return priceContent;
}

// Calculate pricing based on variant data and purchase type
function calculatePricing(days, variantData, bottles) {
  if (!variantData || !variantData.variants) {
    console.log('❌ No variant data available for pricing');
    return {
      perBottlePrice: '$0.00',
      savings: 'Save $0.00'
    };
  }
  
  // Find the variant
  const targetVariant = variantData.variants.find(v => 
    v.title.toLowerCase().includes(days.toString())
  );
  
  if (!targetVariant) {
    console.log(`❌ No variant found for ${days} days`);
    return {
      perBottlePrice: '$0.00',
      savings: 'Save $0.00'
    };
  }
  
  console.log(`💰 Calculating pricing for ${days} days variant:`, targetVariant.title);
  
  const isAutoship = isAutoshipSelected();
  console.log('🏷️ Purchase type:', isAutoship ? 'Autoship' : 'One-time');
  
  let currentPrice, originalPrice;
  
  if (isAutoship && targetVariant.selling_plan_allocations && targetVariant.selling_plan_allocations.length > 0) {
    // Autoship pricing
    const sellingPlan = targetVariant.selling_plan_allocations[0];
    currentPrice = sellingPlan.price / 100;
    
    // Original price for comparison (use compare_at_price if available, otherwise regular price)
    originalPrice = targetVariant.compare_at_price ? 
      (targetVariant.compare_at_price / 100) : 
      (targetVariant.price / 100);
  } else {
    // One-time pricing
    currentPrice = targetVariant.price / 100;
    originalPrice = targetVariant.compare_at_price ? 
      (targetVariant.compare_at_price / 100) : null;
  }
  
  // Calculate per bottle price
  const perBottlePrice = (currentPrice / bottles).toFixed(2);
  
  // Calculate savings
  const savings = originalPrice ? (originalPrice - currentPrice).toFixed(2) : '0.00';
  
  console.log(`✅ Pricing calculated:`, {
    currentPrice: currentPrice.toFixed(2),
    originalPrice: originalPrice ? originalPrice.toFixed(2) : 'N/A',
    perBottlePrice: perBottlePrice,
    savings: savings
  });
  
  return {
    perBottlePrice: `$${perBottlePrice}`,
    savings: `Save $${savings}`
  };
}

// Detect if autoship is selected
function isAutoshipSelected() {
  // Method 1: Check radio inputs
  const autoshipRadio = document.querySelector('input[name="purchaseOption"][value="subscription"]');
  const onetimeRadio = document.querySelector('input[name="purchaseOption"][value="onetime"]');
  
  if (autoshipRadio && autoshipRadio.checked) {
    return true;
  }
  if (onetimeRadio && onetimeRadio.checked) {
    return false;
  }
  
  // Method 2: Check active classes
  const activeAutoship = document.querySelector('.rc-radio.subscription-radio.rc-radio--active');
  const activeOnetime = document.querySelector('.rc-radio.onetime-radio.rc-radio--active');
  
  if (activeAutoship) {
    return true;
  }
  if (activeOnetime) {
    return false;
  }
  
  // Default to autoship
  return true;
}

// Add total price section to the page
function addTotalPriceSection() {
  // Check if total price section already exists
  if (document.querySelector('.total-price-section')) {
    console.log('✅ Total price section already exists');
    return;
  }
  
  // Find the container (variant option group or parent)
  const container = document.querySelector('.variant-option-group') || 
                   document.querySelector('.option-value-wrapper')?.parentElement;
  
  if (!container) {
    console.log('❌ Could not find container for total price section');
    return;
  }
  
  // Create total price section với new structure để align với images
  const totalSection = document.createElement('div');
  totalSection.className = 'total-price-section';
  
  // Create content wrapper để align với text content của options
  const totalContent = document.createElement('div');
  totalContent.className = 'total-price-content';
  totalContent.innerHTML = `
    <span class="total-price-label">Total:</span>
    <span class="total-price-amount">$0.00</span>
  `;
  
  // Append content to section (::before pseudo element sẽ tạo spacing cho image alignment)
  totalSection.appendChild(totalContent);
  
  // Add to container
  container.appendChild(totalSection);
  
  console.log('✅ Total price section added with image alignment');
}

// Update total price based on selected variant
function updateTotalPrice() {
  const totalPriceEl = document.querySelector('.total-price-amount');
  if (!totalPriceEl) {
    console.log('❌ Total price element not found');
    return;
  }
  
  // Find selected/active wrapper
  const activeWrapper = document.querySelector('.option-item-active .option-value-wrapper') ||
                       document.querySelector('.option-value-wrapper'); // fallback to first option
  
  if (!activeWrapper) {
    console.log('❌ No active wrapper found');
    return;
  }
  
  const optionValue = activeWrapper.getAttribute('option-value');
  const info = CONFIG.variantInfo[optionValue];
  
  if (!info) {
    console.log('❌ No variant info found for:', optionValue);
    return;
  }
  
  // Get variant data and calculate total price
  const variantData = getVariantData();
  const pricing = calculatePricing(info.days, variantData, info.bottles);
  
  // Extract numeric value from per bottle price and multiply by bottles
  const perBottlePrice = parseFloat(pricing.perBottlePrice.replace('$', ''));
  const totalPrice = (perBottlePrice * info.bottles).toFixed(2);
  
  // Update total price display
  totalPriceEl.textContent = `$${totalPrice}`;
  
  console.log(`💰 Updated total price: $${totalPrice} (${info.bottles} bottles × $${perBottlePrice})`);
}

// Setup event listeners
function setupEventListeners() {
  console.log('👂 Setting up event listeners...');
  
  // Listen for Recharge widget changes
  document.addEventListener('click', function(e) {
    const isRechargeClick = e.target.closest('.rc-radio, .rc-radio__label');
    if (isRechargeClick) {
      console.log('🔄 Purchase type changed, updating pricing...');
      setTimeout(() => {
        updateAllPricing();
      }, 200);
    }
  });
  
  // Listen for variant option clicks
  document.addEventListener('click', function(e) {
    const wrapper = e.target.closest('.option-value-wrapper');
    if (wrapper) {
      handleVariantSelection(wrapper);
    }
  });
  
  console.log('✅ Event listeners ready');
}

// Handle variant selection
function handleVariantSelection(selectedWrapper) {
  console.log('🎯 Variant selected');
  
  // Remove active class from all wrappers
  document.querySelectorAll('.option-value-wrapper').forEach(wrapper => {
    wrapper.closest('.option-item').classList.remove('option-item-active');
  });
  
  // Add active class to selected wrapper
  selectedWrapper.closest('.option-item').classList.add('option-item-active');
  
  // Update total price for newly selected variant
  updateTotalPrice();
  
  // Trigger the original Shopify variant selection
  const hiddenRadio = selectedWrapper.closest('.option-item').querySelector('input[type="radio"]');
  if (hiddenRadio && !hiddenRadio.checked) {
    hiddenRadio.checked = true;
    hiddenRadio.dispatchEvent(new Event('change', { bubbles: true }));
  }
}

// Update pricing for all variants (when purchase type changes)
function updateAllPricing() {
  console.log('💰 Updating all pricing...');
  
  const variantData = getVariantData();
  
  document.querySelectorAll('.option-value-wrapper').forEach(wrapper => {
    const optionValue = wrapper.getAttribute('option-value');
    const info = CONFIG.variantInfo[optionValue];
    
    if (!info) return;
    
    const priceContent = wrapper.querySelector('.price-content');
    if (!priceContent) return;
    
    // Recalculate pricing
    const pricing = calculatePricing(info.days, variantData, info.bottles);
    
    // Update DOM
    const perBottlePriceEl = priceContent.querySelector('.per-bottle-price');
    const savingsEl = priceContent.querySelector('.savings-amount');
    
    if (perBottlePriceEl) {
      perBottlePriceEl.textContent = pricing.perBottlePrice;
    }
    
    if (savingsEl) {
      savingsEl.textContent = pricing.savings;
    }
  });
  
  // Update total price after updating all pricing
  updateTotalPrice();
  
  console.log('✅ All pricing updated');
}

