<script>
(function(){
const CID="wn_phase7_canvas";
const DATA=[[1,500],[2,520],[3,545],[4,580],[5,625],[6,680],[7,710],[8,740],[9,752],[10,760],[11,775],[12,800]];
const MW=12;
const LAST_Y=800;
const MILESTONES=[
  {y:520,label:'Energy Bump',emoji:'⚡'},
  {y:580,label:'Drive Returns',emoji:'🔥'},
  {y:680,label:'Strength Gains',emoji:'💪'},
  {y:740,label:'Peak Confidence',emoji:'👑'},
  {y:760,label:'New Baseline',emoji:'🎯'},
  {y:800,label:'Full Optimization',emoji:'🚀'},
];

function draw(){
  const canvas=document.getElementById(CID);
  if(!canvas) return;
  const wrap=canvas.parentElement;
  const r=wrap.getBoundingClientRect();
  if(r.width<10||r.height<10) return; // hidden tab
  const ctx=canvas.getContext('2d');
  const dpr=window.devicePixelRatio||1;
  canvas.width=r.width*dpr;canvas.height=r.height*dpr;
  ctx.scale(dpr,dpr);
  const W=r.width,H=r.height;
  ctx.clearRect(0,0,W,H);

  const p={l:W*0.09,r:W*0.21,t:H*0.05,b:H*0.12};
  const cw=W-p.l-p.r,ch=H-p.t-p.b;
  const yMin=450,yMax=850;

  function xP(wk){return p.l+((wk-1)/11)*cw}
  function yP(v){return p.t+ch-((v-yMin)/(yMax-yMin))*ch}

  // BG zones
  const redGrad=ctx.createLinearGradient(0,yP(550),0,yP(450));
  redGrad.addColorStop(0,'rgba(192,57,43,0.04)');redGrad.addColorStop(1,'rgba(192,57,43,0.14)');
  ctx.fillStyle=redGrad;ctx.fillRect(p.l,yP(550),cw,yP(450)-yP(550));

  const yelGrad=ctx.createLinearGradient(0,yP(700),0,yP(550));
  yelGrad.addColorStop(0,'rgba(232,168,56,0.04)');yelGrad.addColorStop(1,'rgba(232,168,56,0.10)');
  ctx.fillStyle=yelGrad;ctx.fillRect(p.l,yP(700),cw,yP(550)-yP(700));

  const grnGrad=ctx.createLinearGradient(0,yP(850),0,yP(700));
  grnGrad.addColorStop(0,'rgba(46,158,90,0.10)');grnGrad.addColorStop(1,'rgba(46,158,90,0.03)');
  ctx.fillStyle=grnGrad;ctx.fillRect(p.l,yP(850),cw,yP(700)-yP(850));

  // Zone badges
  const zfs=Math.max(8,Math.min(11,W*0.016));
  ctx.fillStyle='#2E9E5A';rr(ctx,p.l+6,yP(810)-10,Math.max(58,W*0.08),20,10);ctx.fill();
  ctx.fillStyle='#fff';ctx.font='700 '+zfs+'px DM Sans,sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';
  ctx.fillText('Optimal',p.l+6+Math.max(29,W*0.04),yP(810));

  ctx.fillStyle='#C0392B';rr(ctx,p.l+6,yP(490)-10,Math.max(48,W*0.065),20,10);ctx.fill();
  ctx.fillStyle='#fff';ctx.font='700 '+zfs+'px DM Sans,sans-serif';
  ctx.fillText('Low T',p.l+6+Math.max(24,W*0.0325),yP(490));

  // Grid
  ctx.strokeStyle='rgba(180,160,140,0.15)';ctx.lineWidth=1;
  [500,550,600,650,700,750,800].forEach(function(v){
    ctx.beginPath();ctx.moveTo(p.l,yP(v));ctx.lineTo(p.l+cw,yP(v));ctx.stroke();
  });

  // Y labels
  const fs=Math.max(9,Math.min(12,W*0.02));
  ctx.font='600 '+fs+'px DM Sans,sans-serif';ctx.textAlign='right';ctx.textBaseline='middle';
  [500,550,600,650,700,750,800].forEach(function(v){
    ctx.fillStyle=v>=700?'#2E9E5A':v>=550?'#B8860B':'#C0392B';
    ctx.fillText(v.toString(),p.l-8,yP(v));
  });

  // X labels
  ctx.textAlign='center';ctx.textBaseline='top';
  for(var x=1;x<=12;x++){
    var active=x<=MW;
    ctx.fillStyle=active?'#1A1714':'#C5B8AA';
    ctx.font=(active?'700 ':'400 ')+fs+'px DM Sans,sans-serif';
    ctx.fillText(x.toString(),xP(x),yP(yMin)+6);
  }

  ctx.fillStyle='#8B7E6F';ctx.font='600 '+Math.max(9,W*0.016)+'px DM Sans,sans-serif';ctx.textAlign='center';
  ctx.fillText('WEEKS',p.l+cw/2,H-2);

  ctx.save();ctx.translate(10,p.t+ch/2);ctx.rotate(-Math.PI/2);
  ctx.fillStyle='#8B7E6F';ctx.font='600 '+Math.max(8,W*0.014)+'px DM Sans,sans-serif';ctx.textAlign='center';
  ctx.fillText('Total Testosterone (ng/dL)',0,0);ctx.restore();

  // Axes
  ctx.strokeStyle='rgba(180,160,140,0.3)';ctx.lineWidth=1.5;
  ctx.beginPath();ctx.moveTo(p.l,yP(yMax));ctx.lineTo(p.l,yP(yMin));ctx.lineTo(p.l+cw,yP(yMin));ctx.stroke();

  // 700 threshold
  ctx.setLineDash([5,4]);ctx.strokeStyle='rgba(46,158,90,0.4)';ctx.lineWidth=1.5;
  ctx.beginPath();ctx.moveTo(p.l,yP(700));ctx.lineTo(p.l+cw,yP(700));ctx.stroke();ctx.setLineDash([]);

  // Area fill
  if(DATA.length>1){
    var aGrad=ctx.createLinearGradient(0,yP(800),0,yP(450));
    aGrad.addColorStop(0,'rgba(46,158,90,0.20)');aGrad.addColorStop(0.4,'rgba(232,168,56,0.12)');aGrad.addColorStop(1,'rgba(192,57,43,0.06)');
    ctx.fillStyle=aGrad;ctx.beginPath();
    ctx.moveTo(xP(DATA[0][0]),yP(yMin));
    DATA.forEach(function(d){ctx.lineTo(xP(d[0]),yP(d[1]))});
    ctx.lineTo(xP(DATA[DATA.length-1][0]),yP(yMin));ctx.closePath();ctx.fill();
  }

  // Line segments
  ctx.lineWidth=3;ctx.lineJoin='round';ctx.lineCap='round';
  for(var i=0;i<DATA.length-1;i++){
    var d1=DATA[i],d2=DATA[i+1],avgY=(d1[1]+d2[1])/2;
    ctx.strokeStyle=avgY>=700?'#2E9E5A':avgY>=600?'#6DB84B':avgY>=550?'#E8A838':'#D4740A';
    ctx.beginPath();ctx.moveTo(xP(d1[0]),yP(d1[1]));ctx.lineTo(xP(d2[0]),yP(d2[1]));ctx.stroke();
  }

  // Line glow
  ctx.globalAlpha=0.12;ctx.strokeStyle='#2E9E5A';ctx.lineWidth=12;
  ctx.beginPath();DATA.forEach(function(d,i){if(i===0)ctx.moveTo(xP(d[0]),yP(d[1]));else ctx.lineTo(xP(d[0]),yP(d[1]))});
  ctx.stroke();ctx.globalAlpha=1;

  // Dots
  DATA.forEach(function(d,i){
    var isLast=i===DATA.length-1;
    var dc=d[1]>=700?'#2E9E5A':d[1]>=600?'#6DB84B':d[1]>=550?'#E8A838':'#D4740A';
    ctx.beginPath();ctx.arc(xP(d[0]),yP(d[1]),isLast?10:6,0,Math.PI*2);ctx.fillStyle=dc+'20';ctx.fill();
    ctx.beginPath();ctx.arc(xP(d[0]),yP(d[1]),isLast?5.5:4,0,Math.PI*2);ctx.fillStyle=dc;ctx.fill();
    ctx.beginPath();ctx.arc(xP(d[0]),yP(d[1]),isLast?2.5:1.8,0,Math.PI*2);ctx.fillStyle='#fff';ctx.fill();
  });

  // Milestone badges
  var badgeX=p.l+cw+10,badgeW=W*0.18,badgeH=Math.max(20,H*0.04),badgeR=badgeH/2;
  var bfs=Math.max(8,Math.min(11,W*0.016));
  MILESTONES.forEach(function(m){
    if(m.y>LAST_Y+10) return;
    var lineY=yP(m.y);
    ctx.setLineDash([3,3]);ctx.strokeStyle='rgba(46,158,90,0.25)';ctx.lineWidth=1;
    var closestX=null;
    for(var j=0;j<DATA.length;j++){if(DATA[j][1]>=m.y-15){closestX=xP(DATA[j][0]);break}}
    if(closestX){ctx.beginPath();ctx.moveTo(closestX+8,lineY);ctx.lineTo(badgeX-4,lineY);ctx.stroke()}
    ctx.setLineDash([]);
    var bg=m.y>=700?'#2E9E5A':m.y>=600?'#6DB84B':m.y>=550?'#E8A838':'#D4740A';
    ctx.fillStyle=bg;rr(ctx,badgeX,lineY-badgeH/2,badgeW,badgeH,badgeR);ctx.fill();
    ctx.fillStyle='#fff';ctx.font='700 '+bfs+'px DM Sans,sans-serif';ctx.textAlign='left';ctx.textBaseline='middle';
    ctx.fillText(m.emoji+' '+m.label,badgeX+8,lineY+0.5);
  });

  // Value label
  var last=DATA[DATA.length-1];
  ctx.fillStyle=last[1]>=700?'#2E9E5A':last[1]>=550?'#E8A838':'#D4740A';
  ctx.font='800 '+Math.max(12,W*0.026)+'px DM Sans,sans-serif';ctx.textAlign='center';
  ctx.fillText(last[1].toString(),xP(last[0]),yP(last[1])-18);
}

function rr(c,x,y,w,h,r){
  c.beginPath();c.moveTo(x+r,y);c.lineTo(x+w-r,y);c.quadraticCurveTo(x+w,y,x+w,y+r);
  c.lineTo(x+w,y+h-r);c.quadraticCurveTo(x+w,y+h,x+w-r,y+h);c.lineTo(x+r,y+h);
  c.quadraticCurveTo(x,y+h,x,y+h-r);c.lineTo(x,y+r);c.quadraticCurveTo(x,y,x+r,y);c.closePath();
}

// Draw on load + resize + visibility change (for tabs)
draw();
window.addEventListener('resize',draw);

// Observer for tab visibility (GemPages hides tabs then shows them)
var obs=new MutationObserver(function(){
  var el=document.getElementById(CID);
  if(el&&el.parentElement.getBoundingClientRect().width>10) draw();
});
obs.observe(document.getElementById("wn_phase7_wrap"),{attributes:true,attributeFilter:['style','class'],subtree:true});

// Also poll briefly for tab switches
var pollCount=0;
var poller=setInterval(function(){
  pollCount++;
  var el=document.getElementById(CID);
  if(el&&el.parentElement.getBoundingClientRect().width>10){
    draw();
    if(pollCount>5) clearInterval(poller);
  }
  if(pollCount>200) clearInterval(poller);
},300);

// IntersectionObserver as backup
if(window.IntersectionObserver){
  new IntersectionObserver(function(entries){
    entries.forEach(function(e){if(e.isIntersecting) draw()});
  },{threshold:0.1}).observe(document.getElementById("wn_phase7_wrap"));
}
})();
</script>
