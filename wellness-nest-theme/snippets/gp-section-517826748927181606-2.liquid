document.addEventListener('DOMContentLoaded', function() {
    function setActive(selector) {
        document.querySelectorAll('.gp-cus-swatch-1p, .gp-cus-swatch-3p, .gp-cus-swatch-5p').forEach(function(elm) {
            elm.classList.remove('gp-active');
        });
        document.querySelectorAll(selector).forEach(function(elm) {
            elm.classList.add('gp-active');
        });
    }

    function addClickListener(selector, optionValue) {
        document.querySelectorAll(selector).forEach(function(elm) {
            elm.addEventListener('click', function(e) {
                e.preventDefault();
                document.querySelector(`.g3pMkKhPgL [option-value="${optionValue}"]`).click();
                setActive(selector);
            });
        });
    }

