{% comment %}
  Quiz Funnel — Step 16: Loading Progress Bars + Submit Button
  Three animated progress bars with popup gates before final CTA.
{% endcomment %}

<div class="qf-step" data-step="16">
  <div class="qf-final">
    <h2 class="qf-final__title">You'll Reclaim Your Energy & Drive With Just a 90-Day Supply</h2>
    <p class="qf-final__sub">Because you qualify, we guarantee you'll achieve all your goals with a 90-day supply of our Natural T-Optimization System.</p>
    <p class="qf-final__guarantee">If not, you'll receive a full refund - no questions asked!</p>

    <img src="{{ img_final }}" alt="Product" class="qf-final__img" width="600" height="600" loading="lazy" style="display:block; max-width:100%; height:auto; margin:20px auto;">

    <!-- CTA Button -->
    <button class="qf-btn qf-btn--final" onclick="qfSubmitQuiz()">
      CLAIM YOUR DISCOUNT
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" style="width:18px; height:18px; margin-left:8px;"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
    </button>
  </div>
</div>
