    const m = dayOfWeek[date.getDay()]; // Lấy thứ từ mảng
    const mm = monthNames[date.getMonth()]; // Lấy tên tháng từ mảng
    return '' + m + ', ' + d + ' ' + mm; // Trả về định dạng mới
}

