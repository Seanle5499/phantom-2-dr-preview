          color:#fff; border-radius:50%; width:36px; height:36px;
          z-index:10;">×</button>
        <video id="gp-expert-modal-video"
          controls autoplay playsinline
          style="display:block; max-height:80vh; width:auto; max-width:90vw; border-radius:16px;">
        </video>
      </div>
    </div>`;

  document.body.insertAdjacentHTML('beforeend', modalHTML);

  var modal    = document.getElementById('gp-expert-modal');
  var videoEl  = document.getElementById('gp-expert-modal-video');
  var closeBtn = document.getElementById('gp-expert-modal-close');

  function openModal(pair) {
    if (!pair.video) return;
    videoEl.src = pair.video;
    videoEl.load();
    videoEl.play();
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.style.display = 'none';
    document.body.style.overflow = '';
    videoEl.pause();
    videoEl.src = '';
  }

  if (container) {
    container.addEventListener('click', function (e) {
      var img = e.target.closest('img');
      if (!img) return;
      var idx = parseInt(img.dataset.index);
      var pair = realReviewers[idx];
      if (pair) openModal(pair);
    });
  }

  closeBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal(); });
})();
