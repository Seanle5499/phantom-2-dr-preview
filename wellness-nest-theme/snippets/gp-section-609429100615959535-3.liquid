];

(function () {
  var container = document.querySelector('.gC8u4MXBkp');
  if (container) {
    container.innerHTML = '';
    container.style.cssText += 'display:flex;gap:12px;overflow-x:auto;min-height:100px;scrollbar-width:none;-ms-overflow-style:none;';

    // Hide webkit scrollbar
    var style = document.createElement('style');
    style.textContent = '.gC8u4MXBkp::-webkit-scrollbar { display:none; }';
    document.head.appendChild(style);

    realReviewers.forEach(function (pair, i) {
      var wrap = document.createElement('div');
      wrap.style.cssText = 'position:relative;flex-shrink:0;cursor:pointer;';

      var img = document.createElement('img');
      img.src = pair.img;
      img.alt = 'Reviewer ' + (i + 1);
      img.style.cssText = 'width:120px;height:160px;object-fit:cover;border-radius:10px;display:block;';
      img.dataset.index = i;

      var play = document.createElement('div');
      play.style.cssText = 'position:absolute;bottom:10px;right:10px;width:32px;height:32px;pointer-events:none;z-index:2;';
      play.innerHTML = '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="10" fill="#50000B"/><path d="M10 8.5L16 12L10 15.5V8.5Z" fill="white"/></svg>';

      wrap.appendChild(img);
      wrap.appendChild(play);
      container.appendChild(wrap);
    });
  }

  var modalHTML = `
    <div id="gp-expert-modal" style="
      display:none; position:fixed; inset:0; z-index:99999;
      background:rgba(0,0,0,0.7); align-items:center; justify-content:center;">
