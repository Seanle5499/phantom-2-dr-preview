</div>

<script>
(function(){

  /* ── INJECT STYLES INTO HEAD (bypasses GemPages scoping) ── */
  var style = document.createElement('style');
  style.textContent = [
 '#wn-gl{overflow:visible!important;}#wn-gl *{box-sizing:border-box;margin:0;padding:0;}',
  '.wng{display:flex;flex-direction:row;align-items:flex-start;gap:12px;width:100%; min-height: 100px !important}',

  '.wng-thumbs{flex:0 0 8.333%;display:flex;flex-direction:column;align-items:center;gap:6px;}',
  '.wng-nbtn{background:none;border:none;cursor:pointer;width:26px;height:26px;display:flex;align-items:center;justify-content:center;border-radius:50%;}',
  '.wng-nbtn:disabled{opacity:.80;cursor:not-allowed;}',
  '.wng-nbtn:hover:not(:disabled){background:rgba(0,0,0,.07);}',
  '.wng-nbtn svg{width:11px;height:11px;display:block;}',
  '.wng-tlist{display:flex;flex-direction:column;gap:6px;width:100%;}',
  '.wng-thumb{width:100%;aspect-ratio:1/1;border-radius:8px;overflow:hidden;cursor:pointer;border:2px solid transparent;opacity:1;transition:border-color .2s;}',
  '.wng-thumb img{width:100%;height:100%;object-fit:cover;display:block;}',
 '.wng-thumb:hover{opacity:1;}',
  '.wng-thumb.on{border-color:#9b0012;opacity:1;}',

  /* MAIN container — aspect ratio HERE only */
  '.wng-main{flex:1 1 0;min-width:0;position:relative;border-radius:16px;overflow:hidden;background:#f5f2ee;}',
  '.wng-desk{width:100%;aspect-ratio:1/1;object-fit:cover;display:block;transition:opacity .2s;}',
  '.wng-desk.wfade{opacity:0;}',

  /* MOBILE track */
  '.wng-mwrap{display:none;overflow:hidden;border-radius:16px;width:100%;aspect-ratio:1/1;}',
  '.wng-track{display:flex;height:100%;transition:transform .32s cubic-bezier(.4,0,.2,1);will-change:transform;}',
  '.wng-slide{flex:0 0 100%;width:100%;height:100%;}',
  '.wng-slide img{width:100%;height:100%;object-fit:cover;display:block;}',

  /* DOTS */
 '.wng-dots{display:none;text-align:center;width:100%;margin-top:12px;overflow:visible;line-height:1;padding:4px 0;}',
'.wng-dot{display:inline-block;vertical-align:middle;width:7px;height:7px;border-radius:50%;background:#ff9693 !important;border:none;cursor:pointer;padding:0;margin:3px 3.5px !important;transition:background .2s,transform .2s;}',
  '.wng-dot.on{background:#50000b !important;transform:scale(1.4);}',

  /* MOBILE OVERRIDES */
  '@media(max-width:767px){',
    '.wng{flex-direction:column!important;gap:0!important;}',
    '.wng-thumbs{display:none!important;}',
    '.wng-main{flex:0 0 100%!important;width:100%!important;}',
    '.wng-desk{display:none!important;}',
    '.wng-mwrap{display:block!important;}',
    '.wng-dots{display:block!important;}',
  '}',
].join('');
  document.head.appendChild(style);

  /* ─── EDIT YOUR IMAGES HERE ─── */
  var IMGS = [
  'https://im8health.com/cdn/shop/files/variety-90.jpg?v=1771828131&width=600',
  'https://im8health.com/cdn/shop/files/variety-bstack.jpg?v=1771827164&width=600',
  'https://im8health.com/cdn/shop/files/bstack-acai.jpg?v=1771827164&width=600',
  'https://im8health.com/cdn/shop/files/bstacklemon.jpg?v=1771827164&width=600',
  'https://im8health.com/cdn/shop/files/mango.jpg?v=1771827170&width=600',
  'https://im8health.com/cdn/shop/files/IM8_PDP_23_Images-daily-essential_longevity-slide_03_1.jpg?v=1771841773&width=600',
  'https://im8health.com/cdn/shop/files/IM8_PDP_23_Images-daily-essential_longevity-slide_03_69563907-32b9-4039-b80a-461c3bebd20f.jpg?v=1771841773&width=600',
  'https://im8health.com/cdn/shop/files/IM8_PDP_23_Images-daily-essential_longevity-slide_03_lemon.jpg?v=1771841773&width=600',
  'https://im8health.com/cdn/shop/files/bstackcaro_acai03.jpg?v=1771841773&width=600',
  'https://im8health.com/cdn/shop/files/bstackcaro_acai02.jpg?v=1771841773&width=600',
  'https://im8health.com/cdn/shop/files/202510-bstack-carousel-04B.jpg?v=1771841773&width=600',
  'https://im8health.com/cdn/shop/files/202510_bstack-carousel_05.jpg?v=1771841773&width=600',
  'https://im8health.com/cdn/shop/files/202510bstack-carousel06_57240d78-7871-480b-8dba-dff023f35bdd.jpg?v=1771841773&width=600',
  'https://im8health.com/cdn/shop/files/202510_bstack-carousel_07.jpg?v=1771841773&width=600',
  'https://im8health.com/cdn/shop/files/6ASOCIALPROOF.jpg?v=1771841773&width=600',
  'https://im8health.com/cdn/shop/files/bstackcaro_acai09.jpg?v=1771841773&width=600',
  'https://im8health.com/cdn/shop/files/8BTRUSTQUALITY.jpg?v=1771841773&width=600',
  'https://im8health.com/cdn/shop/files/202510_bstack-carousel_11.jpg?v=1771841773&width=600',
  'https://im8health.com/cdn/shop/files/Carousel-Image-2025-09-26-11.jpg?v=1771841773&width=600',
  'https://im8health.com/cdn/shop/files/Carousel-Image-2025-09-26-11_lemon.jpg?v=1771841773&width=600',
  'https://im8health.com/cdn/shop/files/bstackcaro_acai12.jpg?v=1771841773&width=600',
  'https://im8health.com/cdn/shop/files/Carousel-Image-2025-09-26-11_a8d5724d-8cb7-4b18-a15d-1bada7d7bb0b.jpg?v=1771841773&width=600',
  'https://im8health.com/cdn/shop/files/pdp_carousel_NLG02.jpg?v=1771841773&width=600',
  'https://im8health.com/cdn/shop/files/202510_bstack-carousel_14.jpg?v=1771841773&width=600',
];

  var MAX = 6, cur = 0, tStart = 0;
  var mobile = window.innerWidth <= 767;

  window.addEventListener('resize', function(){ mobile = window.innerWidth <= 767; });

  function $(id){ return document.getElementById(id); }

  function thumbsHTML(){
    var canUp = tStart > 0;
    var canDn = tStart + MAX < IMGS.length;
    var vis   = IMGS.slice(tStart, tStart + MAX);
    var thumbs = vis.map(function(src,i){
      var idx = tStart+i;
      return '<div class="wng-thumb'+(idx===cur?' on':'')+'" data-i="'+idx+'">'
        +'<img src="'+src+'" loading="lazy" onerror="this.parentElement.style.background=\'#eee\'">'
        +'</div>';
    }).join('');
    return '<button class="wng-nbtn" id="wng-up"'+(canUp?'':' disabled')+'>'
      +'<svg viewBox="0 0 12 12" fill="none"><path d="M2 8.5L6 4l4 4.5" stroke="#9b0012" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>'
      +'</button>'
      +'<div class="wng-tlist">'+thumbs+'</div>'
      +'<button class="wng-nbtn" id="wng-dn"'+(canDn?'':' disabled')+'>'
      +'<svg viewBox="0 0 12 12" fill="none"><path d="M2 3.5L6 8l4-4.5" stroke="#9b0012" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>'
      +'</button>';
  }

  function slidesHTML(){
    return IMGS.map(function(src,i){
      return '<div class="wng-slide"><img src="'+src+'" loading="'+(i===0?'eager':'lazy')+'"></div>';
    }).join('');
  }

  function dotsHTML(){
    return IMGS.map(function(_,i){
      return '<button class="wng-dot'+(i===cur?' on':'')+'" data-i="'+i+'"></button>';
    }).join('');
  }

  function render(){
    var root = $('wn-gl');
    if(!root) return;

    root.innerHTML =
      '<div class="wng">'
        +'<div class="wng-thumbs">'+thumbsHTML()+'</div>'
        +'<div class="wng-main">'
          +'<img class="wng-desk" id="wng-mi" src="'+IMGS[cur]+'" alt="Product image">'
          +'<div class="wng-mwrap">'
            +'<div class="wng-track" id="wng-tr">'+slidesHTML()+'</div>'
          +'</div>'
        +'</div>'
      +'</div>'
      +'<div class="wng-dots">'+dotsHTML()+'</div>';

    syncTrack();
    bind();
  }

  function syncTrack(){
    var tr = $('wng-tr');
    if(tr) tr.style.transform = 'translateX(-'+(cur*100)+'%)';
  }

  function syncDots(){
    document.querySelectorAll('.wng-dot').forEach(function(d){
      d.classList.toggle('on', +d.dataset.i === cur);
    });
  }

  function goTo(idx){
    idx = Math.max(0, Math.min(idx, IMGS.length-1));
    cur = idx;

    var mi = $('wng-mi');
    if(mi){
      mi.classList.add('wfade');
      setTimeout(function(){ mi.src = IMGS[cur]; mi.classList.remove('wfade'); }, 180);
    }

    document.querySelectorAll('.wng-thumb').forEach(function(t){
      t.classList.toggle('on', +t.dataset.i === cur);
    });

    if(cur < tStart){ tStart = cur; render(); return; }
    if(cur >= tStart + MAX){ tStart = cur - MAX + 1; render(); return; }

    syncTrack();
    syncDots();
  }

  function bind(){
    document.querySelectorAll('.wng-thumb').forEach(function(t){
      t.addEventListener('click', function(){ goTo(+t.dataset.i); });
    });

    var up = $('wng-up'), dn = $('wng-dn');
    if(up) up.addEventListener('click', function(){ if(tStart>0){ tStart--; render(); } });
    if(dn) dn.addEventListener('click', function(){ if(tStart+MAX<IMGS.length){ tStart++; render(); } });

    document.querySelectorAll('.wng-dot').forEach(function(d){
      d.addEventListener('click', function(){ goTo(+d.dataset.i); });
    });

    var tr = $('wng-tr');
    if(!tr) return;
    var sx=0, sy=0, dx=0;

    tr.addEventListener('touchstart', function(e){
      sx = e.changedTouches[0].clientX;
      sy = e.changedTouches[0].clientY;
      dx = 0;
    },{passive:true});

    tr.addEventListener('touchmove', function(e){
      dx = e.changedTouches[0].clientX - sx;
      var dy = e.changedTouches[0].clientY - sy;
      if(Math.abs(dx) > Math.abs(dy)){
        tr.style.transform = 'translateX(calc(-'+(cur*100)+'% + '+dx+'px))';
      }
    },{passive:true});

    tr.addEventListener('touchend', function(){
      if(dx < -50)     goTo(cur+1);
      else if(dx > 50) goTo(cur-1);
      else             syncTrack();
    },{passive:true});
  }

  render();

  window.wnGoTo = goTo;
  window.wnSetImages = function(arr){
    IMGS.length = 0;
    arr.forEach(function(u){ IMGS.push(u); });
    cur = 0; tStart = 0; render();
  };

})();
</script>
