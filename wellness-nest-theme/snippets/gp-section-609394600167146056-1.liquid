    <section class="wn-trust">
  <style>
    .wn-trust {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      box-sizing: border-box;
      padding: 0;
    }
    .wn-trust * { box-sizing: border-box; }

    .wn-trust__row {
      display: flex;
      flex-direction: row !important;
      gap: 10px;
      margin-bottom: 10px;
    }

    .wn-trust__card {
      flex: 1 1 0;
      min-width: 0;
      display: flex;
      align-items: center;
      gap: 12px;
      background: #faf9f7;
      border: 1px solid #ede9e4;
      border-radius: 14px;
      padding: 14px 16px;
    }

    .wn-trust__badge {
      flex: 0 0 44px;
      width: 44px;
      height: 44px;
      background: #5c1020;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 17px;
      font-weight: 800;
      letter-spacing: -0.5px;
      line-height: 1;
    }

    .wn-trust__info {
      display: flex;
      flex-direction: column;
      gap: 1px;
      min-width: 0;
    }

    .wn-trust__label {
      font-size: 13px;
      font-weight: 700;
      color: #1a1210;
      line-height: 1.25;
    }

    .wn-trust__sub {
      font-size: 12px;
      color: #b0a8a2;
      font-weight: 400;
      line-height: 1.3;
    }

    .wn-trust__hsa {
      display: flex;
      align-items: center;
      gap: 12px;
      background: #f7f0df;
      border: 1px solid #e8d9b0;
      border-radius: 14px;
      padding: 13px 16px;
    }

    .wn-trust__hsa-icon {
      flex: 0 0 38px;
      width: 38px;
      height: 38px;
      background: #c9a357;
      border-radius: 9px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .wn-trust__hsa-icon svg {
      width: 20px;
      height: 20px;
      display: block;
    }

    .wn-trust__hsa-text {
      font-size: 13px;
      font-weight: 700;
      color: #8a6b1a;
      line-height: 1.45;
      min-width: 0;
    }
    
    /* CARD 1 */
.wn-trust__card:first-child {
  background: linear-gradient(165deg, #FFF5F5 0%, #FFF0F0 100%);
  border-color: rgba(164, 0, 17, 0.12);
}

.wn-trust__card:first-child .wn-trust__badge {
  background: linear-gradient(135deg, #A40011, #8B0E2F);
  color: #fff;
  border: none;
  font-weight: 600;
  box-shadow: 0 2px 8px rgba(164, 0, 17, 0.20);
}

/* CARD 2 */
.wn-trust__card:last-child {
  background: linear-gradient(165deg, #FAF7F3 0%, #F7F2EC 100%);
  border-color: rgba(80, 0, 11, 0.08);
}

.wn-trust__card:last-child .wn-trust__badge {
  background: linear-gradient(135deg, #50000B, #3D000A);
  color: rgba(255, 255, 255, 0.75);
  border: none;
  font-weight: 600;
  box-shadow: 0 2px 8px rgba(80, 0, 11, 0.15);
}

    /* Mobile: cards stay in a row, just tighten padding and font */
    @media screen and (max-width: 767px) {
      .wn-trust__card {
        padding: 12px 10px !important;
        gap: 8px !important;
      }
      .wn-trust__badge {
        flex: 0 0 36px !important;
        width: 36px !important;
        height: 36px !important;
        font-size: 14px !important;
      }
      .wn-trust__label {
        font-size: 12px !important;
      }
      .wn-trust__sub {
        font-size: 11px !important;
      }
    }
  </style>

