{% comment %}
  Quiz Funnel — Step 11: Validation Break / Transition
{% endcomment %}

<div class="qf-step" data-step="11">
  <button class="qf-back" onclick="qfGoBack(11)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg></button>
  <h2 class="qf-q">How often do you eat processed foods?</h2>
  <p class="qf-sub">Processed chemicals disrupt hormone production. Be honest with your intake.</p>
  <div class="qf-opts">
    <button type="button" class="qf-opt" data-answer="Daily" onclick="qfPickOpt(this,11)"><div class="qf-opt__label">Daily - Most meals include processed foods</div></button>
    <button type="button" class="qf-opt" data-answer="Several times a week" onclick="qfPickOpt(this,11)"><div class="qf-opt__label">Several times a week</div></button>
    <button type="button" class="qf-opt" data-answer="Occasionally" onclick="qfPickOpt(this,11)"><div class="qf-opt__label">Occasionally - Mostly whole foods</div></button>
    <button type="button" class="qf-opt" data-answer="Rarely" onclick="qfPickOpt(this,11)"><div class="qf-opt__label">Rarely - I avoid processed foods</div></button>
  </div>
</div>

<!-- ══ BUILDING PROFILE OVERLAY (after step 11) ══ -->
<div class="qf-build-loading" id="qfBuildLoading">
  <div class="qf-build-loading__content">
    <h2 class="qf-build-loading__title">Building your profile...</h2>

    <div class="qf-build-loading__stage" id="buildStage1">
      <div class="qf-build-loading__icon">
        <svg class="qf-build-loading__spinner-svg" viewBox="0 0 50 50">
          <circle cx="25" cy="25" r="20" fill="none" stroke="#ddd" stroke-width="4"/>
          <circle cx="25" cy="25" r="20" fill="none" stroke="#54b94a" stroke-width="4" stroke-dasharray="31.4 94.2" stroke-linecap="round" class="qf-fake-loading__arc"/>
        </svg>
        <svg class="qf-build-loading__done-svg" viewBox="0 0 24 24" fill="none" stroke="#54b94a" stroke-width="2">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/>
        </svg>
      </div>
      <div class="qf-build-loading__label">Analysing your profile</div>
    </div>

    <div class="qf-build-loading__stage" id="buildStage2">
      <div class="qf-build-loading__icon">
        <svg class="qf-build-loading__spinner-svg" viewBox="0 0 50 50">
          <circle cx="25" cy="25" r="20" fill="none" stroke="#ddd" stroke-width="4"/>
          <circle cx="25" cy="25" r="20" fill="none" stroke="#54b94a" stroke-width="4" stroke-dasharray="31.4 94.2" stroke-linecap="round" class="qf-fake-loading__arc"/>
        </svg>
        <svg class="qf-build-loading__done-svg" viewBox="0 0 24 24" fill="none" stroke="#54b94a" stroke-width="2">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/>
        </svg>
      </div>
      <div class="qf-build-loading__label">Gathering relevant data</div>
    </div>

    <div class="qf-build-loading__stage" id="buildStage3">
      <div class="qf-build-loading__icon">
        <svg class="qf-build-loading__spinner-svg" viewBox="0 0 50 50">
          <circle cx="25" cy="25" r="20" fill="none" stroke="#ddd" stroke-width="4"/>
          <circle cx="25" cy="25" r="20" fill="none" stroke="#54b94a" stroke-width="4" stroke-dasharray="31.4 94.2" stroke-linecap="round" class="qf-fake-loading__arc"/>
        </svg>
        <svg class="qf-build-loading__done-svg" viewBox="0 0 24 24" fill="none" stroke="#54b94a" stroke-width="2">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/>
        </svg>
      </div>
      <div class="qf-build-loading__label">Finalizing calculations</div>
    </div>
  </div>
</div>
