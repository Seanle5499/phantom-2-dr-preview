        var days = p.qty * 30;
        var weeks = p.qty * 4;
        var def = prevDays ? String(days) === String(prevDays) : idx === 0;

        var billing = t('billed_every', { price: fmt(p.price * p.qty), weeks: weeks });
        var perDay = t('per_day', { price: fmtPerDay(p.price, 30) });

        var saveLbl = p.save > 0
            ? ' <span class="plan-card__save-label">' + t('save_label', { pct: p.save }) + '</span>'
            : '';

        var badges = best
            ? '<div class="plan-card__badges">' +
            '<span class="plan-card__badge-offer">' + t('badge_offer') + '</span>' +
            '<span class="plan-card__badge-best">' + t('badge_best') + '</span>' +
            '</div>'
            : '';

        var priceHtml = fmt(p.price);
        if (p.compare && p.compare > p.price)
            priceHtml += ' <span class="plan-card__price-strike">' + fmt(p.compare) + '</span>';
        priceHtml += '<span class="plan-card__price-mo">/mo</span>';

        var feats;
        if (p.qty >= 3) {
            feats = [
                { i: "🎯", k: 'feat_3_program', v: { days: days } },
                { i: "💰", k: 'feat_3_savings' },
                { i: "🔵", k: 'feat_3_guarantee', v: { days: days } },
                { i: "🧡", k: 'feat_3_share' },
                { i: "🚚", k: 'feat_3_shipping' },
                { i: "📋", k: 'feat_3_cancel' },
            ];
        } else if (p.qty >= 2) {
            feats = [
                { i: "💰", k: 'feat_2_savings' },
                { i: "🚚", k: 'feat_2_shipping' },
                { i: "📋", k: 'feat_2_cancel' },
            ];
        } else {
            feats = [
                { i: "💰", k: 'feat_1_savings', v: { pct: p.save } },
                { i: "🚚", k: 'feat_1_shipping' },
                { i: "📋", k: 'feat_1_cancel' },
            ];
        }

        var fHtml = '<div class="plan-card__features">';
        feats.forEach(function (f) {
            fHtml +=
                '<div class="plan-card__feature">' +
                '<span class="plan-card__feature-icon">' + f.i + '</span>' +
                '<span>' + esc(t(f.k, f.v || {})) + '</span>' +
                '</div>';
        });
        fHtml += '</div>';

        c.insertAdjacentHTML('beforeend',
            '<div class="plan-card' + (def ? ' selected' : '') +
            '" data-plan-days="' + days +
            '" data-selling-plan-id="' + p.spId +
            '" data-plan-qty="' + p.qty +
            '" data-monthly-price="' + p.price + '">' +

            badges +

            '<div class="plan-card__header"' + (best ? ' style="padding-top:4px"' : '') + '>' +
            '<div class="plan-card__left">' +
            '<div class="plan-card__radio-wrap">' +
            '<input type="radio" name="im8-plan" ' + (def ? 'checked ' : '') + '/>' +
            '<span class="plan-card__radio-icon"></span>' +
            '</div>' +
            '<div>' +
            '<div class="plan-card__title">' +
            esc(t('day_supply', { days: days })) + saveLbl +
            '</div>' +
            '<div class="plan-card__billing">' + billing + '</div>' +
            '</div>' +
            '</div>' +
            '<div class="plan-card__right">' +
            '<div class="plan-card__price">' + priceHtml + '</div>' +
            '</div>' +
            '</div>' +

            '<hr class="plan-card__divider"/>' +
            fHtml +
            '</div>'
        );
    });

    // Click handlers
    var cards = c.querySelectorAll('.plan-card');
    cards.forEach(function (card) {
        card.addEventListener('click', function () {
            cards.forEach(function (c2) {
                c2.classList.remove('selected');
                var r = c2.querySelector('input[type="radio"]');
                if (r) r.checked = false;
            });
            card.classList.add('selected');
            var r = card.querySelector('input[type="radio"]');
            if (r) r.checked = true;
            updateAddToCartBtnPrice();
        });
    });

    updateAddToCartBtnPrice();
}

// ╔═══════════════════════════════════════════════════════════════╗
// ║  OTP (One-Time Purchase)                                      ║
// ╚═══════════════════════════════════════════════════════════════╝
function buildOTP() {
    var ctr = document.querySelector("[data-otp-container]");
    var link = document.querySelector("[data-otp-link]");
    if (!ctr || !_allVariants.length) return;

    ctr.style.display = "";
    updateOTPPrice();

    if (link && !link._otpBound) {
        link._otpBound = true;
        link.addEventListener('click', function (e) {
            e.preventDefault();
            var vid = getActiveVariantId();

            fetch(window.Shopify.routes.root + 'cart/add.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    items: [{ id: parseInt(vid), quantity: 1 }],
                    sections: 'cart-drawer,cart-icon-bubble',
                    sections_url: window.location.pathname
                }),
            })
                .then(function (res) { return res.json(); })
                .then(function (response) {
                    var cartDrawer = document.querySelector('cart-drawer');
                    if (cartDrawer && typeof cartDrawer.renderContents === 'function') {
                        cartDrawer.classList.remove('is-empty');
                        cartDrawer.renderContents(response);
                        return;
                    }
                    document.dispatchEvent(new CustomEvent('gp:open-cart-drawer', {
                        bubbles: true,
                        cancelable: true,
                        detail: { data: response },
                        composed: true
                    }));
                })
                .catch(function (err) {
                    console.error("[OTP] failed:", err);
                    window.location.href = "/cart/add?id=" + vid + "&quantity=1";
                });
        });
    }
}

function updateOTPPrice() {
    var priceEl = document.querySelector("[data-otp-price]");
    if (!priceEl || !_allVariants.length) return;
    priceEl.textContent = fmt(getActiveVariant().price);
}

// ╔═══════════════════════════════════════════════════════════════╗
// ║  ADD TO CART (Subscription)                                   ║
// ╚═══════════════════════════════════════════════════════════════╝
function initAddToCartBtn() {
    var btn = document.querySelector("[data-add-to-cart-btn]");
    if (!btn) return;

    btn.addEventListener('click', function () {
        if (btn.disabled) return;

        var variantId = getActiveVariantId();
        if (!variantId) { alert(t('alert_select_variant')); return; }

        var selectedCard = document.querySelector('.plan-card.selected');
        if (!selectedCard) { alert(t('alert_select_plan')); return; }

        var sellingPlanId = selectedCard.dataset.sellingPlanId;
        var qty = parseInt(selectedCard.dataset.planQty || 1, 10);
        var priceCents = parseInt(selectedCard.dataset.monthlyPrice || 0, 10);
        var totalCents = priceCents * qty;

        if (window.fbq) fbq('track', 'AddToCart', {
            content_ids: [String(variantId)],
            content_type: 'product_variant',
            value: parseFloat((totalCents / 100).toFixed(2)),
            currency: activeCurrency(),
            num_items: qty,
            contents: [{
                id: String(variantId),
                quantity: qty,
                item_price: parseFloat((priceCents / 100).toFixed(2))
            }]
        });

        btn.disabled = true;
        btn.classList.add('is-loading');
        btn.textContent = t('btn_loading');

        var payload = { id: parseInt(variantId, 10), quantity: qty };
        if (sellingPlanId && sellingPlanId !== "undefined" && sellingPlanId !== "null") {
            payload.selling_plan = parseInt(sellingPlanId, 10);
        }

        fetch(window.Shopify.routes.root + 'cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                items: [payload],
                sections: 'cart-drawer,cart-icon-bubble',
                sections_url: window.location.pathname
            }),
        })
            .then(function (res) { return res.json(); })
            .then(function (response) {
                btn.disabled = false;
                btn.classList.remove('is-loading');
                updateAddToCartBtnPrice();

                // Cách 1: dùng renderContents của cart-drawer (GemPages native)
                var cartDrawer = document.querySelector('cart-drawer');
                if (cartDrawer && typeof cartDrawer.renderContents === 'function') {
                    cartDrawer.classList.remove('is-empty');
                    cartDrawer.renderContents(response);
                    return;
                }

                // Cách 2: fallback - dispatch GemPages event
                document.dispatchEvent(new CustomEvent('gp:open-cart-drawer', {
                    bubbles: true,
                    cancelable: true,
                    detail: { data: response },
                    composed: true
                }));
            })
    });
}

function updateAddToCartBtnPrice() {
    var btn = document.querySelector("[data-add-to-cart-btn]");
    if (!btn) return;
    if (btn.classList.contains('is-loading')) return;
    btn.textContent = t('btn_add_cart');
}
