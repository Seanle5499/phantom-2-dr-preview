        /* ── Design Tokens ──────────────────────────────────────────────────── */
.im8-variant-selects-wrapper {
    /* ─ Brand Colors ─ */
    --im8-green: #111111;
    --im8-green-bright: #333333;
    --im8-lime: #111111;
    --im8-lime-hover: #2a2a2a;
    --im8-gold-start: #555555;
    --im8-gold-end: #444444;
    --im8-gold-text: #ffffff;
    --im8-badge-green-start: #222222;
    --im8-badge-green-end: #111111;

    /* ─ Text Colors ─ */
    --im8-text-primary: #111111;
    --im8-text-secondary: rgba(0, 0, 0, 0.6);
    --im8-text-muted: rgba(0, 0, 0, 0.35);
    --im8-text-billing: rgba(0, 0, 0, 0.55);
    --im8-text-price-muted: rgba(0, 0, 0, 0.4);

    /* ─ Borders ─ */
    --im8-border-warm: #d4d4d4;
    --im8-border-active: #111111;
    --im8-border-hover: rgba(0, 0, 0, 0.25);
    --im8-border-light: rgba(0, 0, 0, 0.12);
    --im8-border-divider: rgba(0, 0, 0, 0.07);

    /* ─ Backgrounds ─ */
    --im8-bg-white: #ffffff;
    --im8-bg-option-hover: rgba(0, 0, 0, 0.035);
    --im8-bg-option-selected: rgba(0, 0, 0, 0.06);
    --im8-bg-card-selected-start: rgba(240, 240, 240, 0.85);
    --im8-bg-card-selected-end: rgba(248, 248, 248, 0.7);

    /* ─ Shadows ─ */
    --im8-shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.06), 0 1px 2px rgba(0, 0, 0, 0.04);
    --im8-shadow-md: 0 4px 16px rgba(0, 0, 0, 0.1), 0 1px 3px rgba(0, 0, 0, 0.05);
    --im8-shadow-dropdown: 0 16px 48px rgba(0, 0, 0, 0.16), 0 4px 12px rgba(0, 0, 0, 0.07);
    --im8-shadow-card-selected: 0 4px 12px 0 rgba(0, 0, 0, 0.12);
    --im8-shadow-badge: 0 2px 6px -2px rgba(0, 0, 0, 0.25);
    --im8-shadow-badge-best: 0 3px 10px rgba(0, 0, 0, 0.22);

    /* ─ Animation ─ */
    --im8-ease-out: cubic-bezier(0.22, 1, 0.36, 1);

    /* ─ Radius ─ */
    --im8-radius-lg: 14px;
    --im8-radius-card: 10px;
    --im8-radius-pill: 999px;
    --im8-radius-full: 9999px;

    /* ─ Font ─ */
    --im8-font: "PPNeueMontreal", -apple-system, BlinkMacSystemFont, sans-serif;
    --im8-font-alt: "PPNeueMontreal", "Montserrat", sans-serif;

    font-family: var(--im8-font) !important;
    color: var(--im8-text-primary) !important;
    width: 100% !important;
}

/* ── Reset ─────────────────────────────────────────────────────────── */
.im8-variant-selects-wrapper *,
.im8-variant-selects-wrapper *::before,
.im8-variant-selects-wrapper *::after {
    box-sizing: border-box !important;
}

.im8-variant-selects-wrapper fieldset {
    border: none !important;
    margin: 0 0 24px !important;
    padding: 0 !important;
}

.im8-variant-selects-wrapper .vs-label {
    font-size: 15px !important;
    font-weight: 700 !important;
    color: var(--im8-text-primary) !important;
    margin-bottom: 12px !important;
    display: block !important;
}

/* ── Flavor Dropdown ────────────────────────────────────────────────── */
.im8-flavor-dropdown {
    position: relative !important;
    width: 100% !important;
    z-index: 10 !important;
    overflow: hidden !important;
}

.im8-flavor-dropdown.is-expanded {
    z-index: 20 !important;
    overflow: visible !important;
}

.im8-flavor-dropdown.is-expanded .im8-flavor-dropdown__trigger {
    border-color: var(--im8-border-active) !important;
    border-radius: var(--im8-radius-lg) var(--im8-radius-lg) 0 0 !important;
    box-shadow: none !important;
}

.im8-flavor-dropdown .im8-flavor-dropdown__trigger:hover {
    border-color: var(--im8-border-hover) !important;
    box-shadow: var(--im8-shadow-md) !important;
}

.im8-flavor-dropdown__trigger {
    display: flex !important;
    align-items: center !important;
    padding: 0 16px 0 0 !important;
    gap: 14px !important;
    min-height: 80px !important;
    cursor: pointer !important;
    user-select: none !important;
    border: 1px solid var(--im8-border-warm) !important;
    border-radius: var(--im8-radius-lg) !important;
    background: var(--im8-bg-white) !important;
    box-shadow: var(--im8-shadow-sm) !important;
    transition:
        border-color 0.3s var(--im8-ease-out),
        box-shadow 0.3s var(--im8-ease-out),
        border-radius 0.3s ease !important;
}

.im8-flavor-dropdown__thumb {
    width: 80px !important;
    height: 80px !important;
    border-radius: var(--im8-radius-lg) 0 0 var(--im8-radius-lg) !important;
    object-fit: cover !important;
    object-position: center !important;
    flex-shrink: 0 !important;
}

.im8-flavor-dropdown.is-expanded .im8-flavor-dropdown__thumb {
    border-bottom-left-radius: 0 !important;
}

.im8-flavor-dropdown__selected-info {
    flex: 1 !important;
    min-width: 0 !important;
    padding: 4px 0 !important;
}

.im8-flavor-dropdown__selected-name {
    font-size: 16px !important;
    font-weight: 700 !important;
    color: var(--im8-text-primary) !important;
    line-height: 1.3 !important;
    letter-spacing: -0.02em !important;
    display: flex !important;
    align-items: center !important;
    gap: 10px !important;
    flex-wrap: wrap !important;
}

.im8-flavor-dropdown__selected-sub {
    font-size: 13px !important;
    color: var(--im8-text-secondary) !important;
    margin-top: 2px !important;
}

.im8-flavor-dropdown__chevron {
    width: 20px !important;
    height: 20px !important;
    flex-shrink: 0 !important;
    transition: transform 0.35s var(--im8-ease-out) !important;
    color: var(--im8-text-muted) !important;
}

.im8-flavor-dropdown.is-expanded .im8-flavor-dropdown__chevron {
    transform: rotate(180deg) !important;
    color: var(--im8-text-secondary) !important;
}

.im8-flavor-dropdown__options {
    position: absolute !important;
    top: 100% !important;
    width: 100% !important;
    max-height: 0 !important;
    overflow: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
    background: var(--im8-bg-white) !important;
    border: 1px solid transparent !important;
    border-top: none !important;
    border-radius: 0 0 var(--im8-radius-lg) var(--im8-radius-lg) !important;
    transition:
        max-height 0.35s var(--im8-ease-out),
        opacity 0.25s ease !important;
    z-index: 20 !important;
}

.im8-flavor-dropdown.is-expanded .im8-flavor-dropdown__options {
    max-height: 500px !important;
    opacity: 1 !important;
    pointer-events: auto !important;
    border-color: var(--im8-border-active) !important;
    box-shadow: var(--im8-shadow-dropdown) !important;
}

.im8-flavor-dropdown__option {
    display: flex !important;
    align-items: center !important;
    gap: 14px !important;
    padding: 0 16px 0 0 !important;
    cursor: pointer !important;
    transition: background 0.2s ease !important;
    min-height: 76px !important;
    overflow: hidden !important;
    border-top: 1px solid var(--im8-border-divider) !important;
}

.im8-flavor-dropdown__option:last-child {
    border-radius: 0 0 var(--im8-radius-lg) var(--im8-radius-lg) !important;
}

.im8-flavor-dropdown__option:hover {
    background: var(--im8-bg-option-hover) !important;
}

.im8-flavor-dropdown__option.is-selected {
    background: var(--im8-bg-option-selected) !important;
