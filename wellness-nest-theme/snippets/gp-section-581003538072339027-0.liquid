  function setupToggleAndPricing() {
    const toggleSwitch = document.getElementById("toggle-switch");
    const toggleText = document.getElementById("toggle-text");
    const toggleCircle = document.getElementById("toggle-circle");

    // Function to update benefits based on subscription type and selected plan
    function updateBenefits() {
      const pauseBenefit = document.querySelector(".benefit-pause");
      const guaranteeBenefit = document.querySelector(".benefit-guarantee"); 
      const ebookBenefit = document.querySelector(".benefit-ebook");
      const shippingBenefit = document.querySelector(".benefit-shipping");

      // Hide/show pause benefit based on subscription type (only for subscription)
      if (pauseBenefit) {
        pauseBenefit.style.display = isSubscription ? "flex" : "none";
      }

      // Always show guarantee benefit
      if (guaranteeBenefit) {
        guaranteeBenefit.style.display = "flex";
        const guaranteeIcon = guaranteeBenefit.querySelector("span:first-child");
        const guaranteeText = guaranteeBenefit.querySelector("span:last-child");
        if (guaranteeIcon && guaranteeText) {
          guaranteeIcon.style.display = "inline-block";
          guaranteeText.innerHTML = "90-Day Money-back Guarantee";
        }
      }

      // Handle eBook benefit based on subscription type AND selected plan
      if (ebookBenefit) {
        const ebookIcon = ebookBenefit.querySelector("span:first-child");
        const ebookText = ebookBenefit.querySelector("span:last-child");
        
        if (ebookIcon && ebookText) {
          // Show X only for:
          // - One-time purchase 30day
          // - Subscription 30day
          const shouldShowX = (!isSubscription && selectedPlan === "30day") || 
                             (isSubscription && selectedPlan === "30day");
          
          if (shouldShowX) {
            ebookIcon.style.display = "none";
            ebookText.style.display = "flex";
            ebookText.style.alignItems = "center";
            ebookText.innerHTML = `
              <span style="color: #FF0000; font-size: 18px; margin-right: 8px; display: inline-flex; align-items: center;">✕</span>
              <span style="flex: 1;">FREE "Menopause Recovery Kit" (a $419 value)</span>
            `;
          } else {
            ebookIcon.style.display = "inline-block";
            ebookText.style.display = "inline-block";
            ebookText.innerHTML = `FREE "Menopause Recovery Kit" (a $419 value)`;
          }
        }
      }

      // Handle shipping benefit based on subscription type AND selected plan
      if (shippingBenefit) {
        const shippingIcon = shippingBenefit.querySelector("span:first-child");
        const shippingText = shippingBenefit.querySelector("span:last-child");
        
        if (shippingIcon && shippingText) {
          // Show X only for:
          // - One-time purchase 30day
          // - Subscription 30day
          const shouldShowX = (!isSubscription && selectedPlan === "30day") || 
                             (isSubscription && selectedPlan === "30day");
          
          if (shouldShowX) {
            shippingIcon.style.display = "none";
            shippingText.style.display = "flex";
            shippingText.style.alignItems = "center";
            shippingText.innerHTML = `
