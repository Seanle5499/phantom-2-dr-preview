        // Hide/show delivery frequency text
        if (pricingCapsules) {
          pricingCapsules.style.display =
            mode === "subscription" ? "block" : "none";
        }

        if (priceSave) {
          const save = pricingData[mode][plan].save;
          if (save > 0) {
            priceSave.style.display = "block";
            priceSave.textContent = `Save ${formatCurrency(
              save,
              currentCurrency
            )}`;
          } else {
            priceSave.style.display = "none";
          }
        }
      });
      updateTotal(pricingData[mode][selectedPlan].total);
      updateBenefits(); // Update benefits when pricing changes
    }

    // Toggle between subscription and one-time
    function toggleMode() {
      isSubscription = !isSubscription;
      const mode = isSubscription ? "subscription" : "onetime";
     const isResponsive = window.innerWidth <= 768;
       console.log("isMobile" , isResponsive)
      // Toggle switch UI
      toggleSwitch.style.background = isSubscription ? "#772B90" : "#B9A3C2";
  if (isSubscription) {
    const fontSize = isResponsive ? "20px" : "25px";
    console.log("fontSize" , fontSize)
    toggleText.innerHTML = `<span style="color: #772B90;  font-size: ${fontSize}; font-weight: 600;">Subscribe & save 10%</span>`;
  } else {
    const fontSize = isResponsive ? "20px" : "25px";
        console.log("fontSize" , isResponsive)
    toggleText.innerHTML = `<span style="color: #6F517B;  font-size: ${fontSize}; font-weight: 600;">One-time purchase</span>`;
  }
  
        // Responsive translateX based on screen size
      const isMobile = window.innerWidth <= 768;
      const translateValue = isMobile ? "-36px" : "-43px";
      toggleCircle.style.transform = isSubscription
        ? "translateX(0px)"
        : `translateX(${translateValue})`;

      updatePricingDisplay(mode);
      syncCarousel(pricingData[mode][selectedPlan].carousel_index);
    }

    // Event listeners
    toggleSwitch.addEventListener("click", toggleMode);
    toggleText.addEventListener("click", toggleMode);

    // Pricing card selection
    document.addEventListener("click", function (e) {
      const pricingCard = e.target.closest(".pricing-card");
      if (pricingCard) {
        document.querySelectorAll(".pricing-card").forEach((card) => {
          card.classList.remove("selected");
        });
        pricingCard.classList.add("selected");
        selectedPlan = pricingCard.getAttribute("data-plan");
        const mode = isSubscription ? "subscription" : "onetime";
        updateTotal(pricingData[mode][selectedPlan].total);
        updateBenefits(); // Update benefits when plan changes

        // Enhanced carousel sync with delay
        setTimeout(() => {
          syncCarousel(pricingData[mode][selectedPlan].carousel_index);
        }, 100);
      }
    });

    // Buy now button functionality
    const buyNowBtn = document.getElementById("buy-now-btn");
    if (buyNowBtn) {
      buyNowBtn.addEventListener("click", function () {
        const mode = isSubscription ? "subscription" : "onetime";
        const data = pricingData[mode][selectedPlan];

        const cartItem = {
          id: data.variant_id,
          quantity: 1,
        };

        if (mode === "subscription") {
          cartItem.selling_plan = data.selling_plan_id;
        }

        buyNowBtn.textContent = "ADDING TO CART...";
        buyNowBtn.disabled = true;
        buyNowBtn.style.opacity = "0.7";

        fetch("/cart/add.js", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(cartItem),
        })
          .then((res) => {
            if (res.ok) {
              window.location.href = "/checkout";
            } else {
              return res.json().then((err) => {
                alert(err.message || "Something went wrong");
              });
            }
          })
          .catch((err) => {
            alert("Failed to add to cart");
          })
          .finally(() => {
            buyNowBtn.textContent = "BUY NOW";
            buyNowBtn.disabled = false;
            buyNowBtn.style.opacity = "1";
          });
      });
    }

    // Initial setup
    updateBenefits(); // Set initial benefits state
    
    // Initial carousel sync
    setTimeout(() => {
      syncCarousel(
        pricingData[isSubscription ? "subscription" : "onetime"][selectedPlan]
          .carousel_index
      );
    }, 500);

    console.log("✅ Dynamic benefits setup complete!");
    console.log("💰 Current currency:", currentCurrency);
    console.log(
      "📊 Sample price:",
      formatCurrency(pricingData.subscription["90day"].price, currentCurrency)
    );
  }
});
