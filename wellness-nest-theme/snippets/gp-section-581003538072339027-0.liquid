    if (currentAttempt >= maxAttempts) {
      console.log("⚠️ Carousel loading timeout");
      callback();
      return;
    }

    const carouselExists = document.querySelector(
      '[class*="carousel"], [class*="slider"], [class*="swiper"], .gp-w-slider-thumbnail-item'
    );

    if (carouselExists) {
      console.log("✅ Carousel detected, proceeding...");
      callback();
    } else {
      console.log(
        `🔄 Waiting for carousel... (attempt ${
          currentAttempt + 1
        }/${maxAttempts})`
      );
      setTimeout(
        () => waitForCarousel(callback, maxAttempts, currentAttempt + 1),
        500
      );
    }
