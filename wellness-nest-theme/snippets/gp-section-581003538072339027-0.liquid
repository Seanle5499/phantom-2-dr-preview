      ".gem-slider-item-gp-gallery-gK9wKzCXt8-10009050251579",
      ".gp-gallery-image-item",
      ".gem-slider-item",
      ".gp-image-item",
      "[grid-index]",
      ".gp-w-slider-thumbnail-item",
      ".swiper-slide",
      ".slider-nav-item",
      ".carousel-thumb",
      ".thumbnail-item",
      "[data-slide-index]",
      ".splide__slide",
      ".flickity-page-dots button",
      ".slider-dots button",
      ".carousel-indicators li",
    ];

    let syncSuccess = false;
    const adjustedIndex = targetIndex - 1;

    // Try to sync gallery thumbnails first
    const galleryThumbnails = document.querySelectorAll(
      ".gem-slider-item-gp-gallery-gK9wKzCXt8-10009050251579"
    );
    if (
      galleryThumbnails.length > adjustedIndex &&
      galleryThumbnails[adjustedIndex]
    ) {
      console.log(
        `🎯 Found gallery thumbnails, syncing to index ${adjustedIndex + 1}`
      );
      galleryThumbnails[adjustedIndex].click();
      syncSuccess = true;
      console.log("✅ Gallery thumbnail sync successful!");
      return;
    }

    // Try grid-index based approach
    const gridItems = document.querySelectorAll("[grid-index]");
    if (gridItems.length > 0) {
      console.log(`🔍 Found ${gridItems.length} grid items`);
      const targetGridItem = document.querySelector(
        `[grid-index="${targetIndex}"]`
      );
      if (targetGridItem) {
        targetGridItem.click();
        syncSuccess = true;
        console.log(`✅ Grid-index sync successful for index ${targetIndex}!`);
        return;
      }
    }

    // Fallback to other selectors
    for (const selector of possibleSelectors) {
      try {
        const elements = document.querySelectorAll(selector);
        console.log(
          `🔍 Trying selector "${selector}", found ${elements.length} elements`
        );

        if (elements.length > adjustedIndex && elements[adjustedIndex]) {
          elements[adjustedIndex].click();
          console.log(
            `✅ Successfully synced carousel using selector: ${selector}`
          );
          syncSuccess = true;
          break;
        }
      } catch (error) {
        console.log(`❌ Error with selector "${selector}":`, error);
      }
    }

    if (!syncSuccess) {
      console.log("⚠️ Could not sync carousel");
    }
  }

  // Wait for carousel to be fully loaded
