      <style id="custom-css-gP1AnCFify">
        .gps .custom-free-shipping.disable * {
    color: #4A4A4A4D !important;
}
.gps .custom-free-shipping .custom-free-shipping-icon-x,
.gps .custom-free-shipping.disable .custom-free-shipping-icon-v {
    display: none;
}
.gps .custom-free-shipping.disable .custom-free-shipping-icon-x {
    display: block;
}
.gps .custom_unit_price_wrapper,
.gps .custom_daily_price_wrapper,
.gps .custom_variant_image_wrapper {
    display: none;
}
.gps .custom_unit_price_wrapper.active,
.gps .custom_daily_price_wrapper.active,
.gps .custom_variant_image_wrapper.active {
    display: block;
}
      </style>
    
      <script id="custom-js-gP1AnCFify">
        try {
          ;(function() {
  const container = document.querySelector('.gP1AnCFify');
  if (!container) return;

  window.addEventListener('gp:product-change-variant', ({ detail: { variantSelected: variant } }) => {
    const form = container.closest('form[action*="/cart/add"]');
    if (!form) return;
    
    console.log('variant: ', variant);

    // 1. Update selling_plan input
    const planId = (
      variant.selling_plan_allocations &&
      variant.selling_plan_allocations.length > 0
    ) ? variant.selling_plan_allocations[0].selling_plan_id : '';

    const toggle = form.querySelector('.custom-toggle-selling-plan');
    const sellInput = form.querySelector('input[name="selling_plan"]');
    if (sellInput) {
      sellInput.value = (toggle && toggle.classList.contains('disable')) ? '' : planId;
      sellInput.dataset.value = planId;
      sellInput.dataset.variantId = variant.id;
    }

    // 2. Toggle free-shipping UI
    const freeShippingEl = form.querySelector('.custom-free-shipping');
    if (freeShippingEl) {
      freeShippingEl.classList[
        /30 day/i.test(variant.title) ? 'add' : 'remove'
      ]('disable');
    }

    // 3. Activate matching elements by data-variant-id
    ['.custom_variant_image_wrapper', '.custom_unit_price_wrapper', '.custom_daily_price_wrapper']
      .forEach(selector => {
        form.querySelectorAll(selector).forEach(el => {
          el.classList[
            el.getAttribute('data-variant-id') == variant.id ? 'add' : 'remove'
          ]('active');
        });
      });

    // 4. Delivery-frequency toggle based on number in title
    const match = variant.title.match(/\d+/);
    if (match) {
      const number = match[0];
      form.querySelectorAll('.custom_delivery_frequency').forEach(el => {
        if (el.classList.contains(number)) {
          el.classList.remove('disable');
        } else {
          el.classList.add('disable');
        }
      });
    }
  });
})();

        } catch(err){}
      </script>
    
    </div>

      
