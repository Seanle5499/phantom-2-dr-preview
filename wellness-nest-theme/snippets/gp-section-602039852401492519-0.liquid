<script>
(function () {

  /* ============================================================
     CONFIG — only update these values per product
     ============================================================ */
  var VARIANT_ID = 49994527899963;
  var PLAN_IDS   = ['9801892155', '9801924923', '9801957691'];
  var DISCOUNTS  = [0.20, 0.20, 0.16];
  var PACK_QTY   = [1, 2, 3];
  var PACK_DAYS  = [30, 60, 90];
  var PACK_SHIP  = [
    'Ships free monthly',
    'Ships free every 2 months',
    'Ships free every 3 months'
  ];
  /* ============================================================ */

  var state = { option: 'subscription', idx: 0 };
  var plans = [];

  function activeCurrency() {
    return (window.Shopify && window.Shopify.currency && window.Shopify.currency.active) || 'USD';
  }

  var ZERO_DECIMAL = ['BIF','CLP','DJF','GNF','JPY','KMF','KRW','MGA',
                      'PYG','RWF','UGX','VND','VUV','XAF','XOF','XPF'];

  function isZeroDecimal(currency) {
    return ZERO_DECIMAL.indexOf(currency.toUpperCase()) !== -1;
  }

  function formatMoney(shopifyCents) {
    var currency = activeCurrency();
    var amount   = shopifyCents / 100;
    var decimals = isZeroDecimal(currency) ? 0 : 2;
    try {
      return new Intl.NumberFormat(navigator.language || 'en-US', {
        style: 'currency',
        currency: currency,
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals
      }).format(amount);
    } catch (e) {
      return amount.toFixed(decimals);
    }
  }

  function buildPlans(unitCents) {
    plans = PLAN_IDS.map(function (planId, i) {
      var originalCents   = unitCents * PACK_QTY[i];
      var discountedCents = Math.round(originalCents * (1 - DISCOUNTS[i]));
      var perDayCents     = discountedCents / PACK_DAYS[i];
      return {
        planId:     planId,
        qty:        PACK_QTY[i],
        original:   formatMoney(originalCents),
        discounted: formatMoney(discountedCents),
        perDay:     formatMoney(perDayCents) + '/day',
        otPrice:    formatMoney(originalCents),
        shipping:   PACK_SHIP[i]
      };
    });
  }

  var w         = document.querySelector('.rc-custom-widget');
  var otBox     = w.querySelector('.rc-opt-onetime');
  var subBox    = w.querySelector('.rc-opt-sub');
  var origEl    = w.querySelector('.rc-price-original');
  var discEl    = w.querySelector('.rc-disc-price');
  var perDayEl  = w.querySelector('.rc-price-perday');
  var shipEl    = w.querySelector('.rc-shipping-text');
  var otPriceEl = w.querySelector('.rc-ot-price');

  function updateBtnPrice(text) {
    var btn = document.querySelector('gp-product-price.gp-button-price .gp-price.gp-button-price');
    if (btn) btn.textContent = text;
  }

  function updateUI() {
    if (!plans.length) return;
    var p    = plans[state.idx];
    var isOt = state.option === 'onetime';
    otBox.classList.toggle('active-ot', isOt);
    subBox.classList.toggle('active-sub', !isOt);
    otPriceEl.textContent = p.otPrice;
    origEl.textContent    = p.original;
    discEl.textContent    = p.discounted;
    perDayEl.textContent  = p.perDay;
    shipEl.textContent    = p.shipping;
    updateBtnPrice(isOt ? p.otPrice : p.discounted);
  }

  otBox.addEventListener('click', function () { state.option = 'onetime'; updateUI(); });
  subBox.querySelector('.rc-opt-label').addEventListener('click', function () { state.option = 'subscription'; updateUI(); });

  w.querySelectorAll('.rc-pill').forEach(function (pill) {
    pill.addEventListener('click', function () {
      w.querySelectorAll('.rc-pill').forEach(function (p) { p.classList.remove('active'); });
      this.classList.add('active');
      state.idx = parseInt(this.dataset.planIndex, 10);
      updateUI();
    });
  });

  function addToCart() {
    var p = plans[state.idx];
    var payload = { id: VARIANT_ID, quantity: p.qty };
    if (state.option === 'subscription') payload.selling_plan = parseInt(p.planId, 10);
    return fetch('/cart/clear.js', { method: 'POST' })
      .then(function () {
        return fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [payload] })
        });
      })
      .then(function (r) { return r.json(); })
      .then(function () { window.location.href = '/checkout'; })
      .catch(function (err) {
        console.error('Cart error:', err);
        alert('Error adding to cart. Please try again.');
      });
  }

  function hijackATC() {
    var btn = document.querySelector('button.gp-button-atc');
    if (!btn) return false;
    var newBtn = btn.cloneNode(true);
    btn.parentNode.replaceChild(newBtn, btn);
    newBtn.addEventListener('click', function (e) {
      e.preventDefault(); e.stopPropagation(); e.stopImmediatePropagation();
      newBtn.setAttribute('data-state', 'loading');
      addToCart();
    }, true);
    var form = newBtn.closest('form');
    if (form) form.addEventListener('submit', function (e) { e.preventDefault(); e.stopPropagation(); }, true);
    return true;
  }

  var handle = window.location.pathname.match(/\/products\/([^/?#]+)/);
  if (handle) {
    fetch('/products/' + handle[1] + '.js')
      .then(function (r) { return r.json(); })
      .then(function (data) {
        var variant = data.variants.find(function (v) { return v.id === VARIANT_ID; });
        if (!variant) {
          variant = data.variants[0];
          console.warn('RC Widget: VARIANT_ID not found, using first variant.');
        }
        buildPlans(variant.price);
        updateUI();
        if (!hijackATC()) {
          var n = 0;
          var t = setInterval(function () {
            if (hijackATC() || ++n >= 30) clearInterval(t);
          }, 300);
        }
      })
      .catch(function (err) { console.error('RC Widget: price fetch failed', err); });
  }

})();
</script>
