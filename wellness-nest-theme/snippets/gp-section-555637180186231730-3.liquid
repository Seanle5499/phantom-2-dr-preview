      <script id="custom-js-gUqu7HyGX2">
        try {
          document.addEventListener("DOMContentLoaded", function() {
    // Hide the element initially
    const currentElements = document.querySelector('.gUqu7HyGX2');
    
    var product = document.querySelector('.gUqu7HyGX2').closest('gp-product').getContext();
    console.log('product1234', product)
    
    if (currentElements) {
        currentElements.classList.add('hiddenrc');
    }

    // Function to handle the logic when the required elements are found
    function setupSubscriptionOptions() {
        if (currentElements) {
            currentElements.classList.remove('hiddenrc'); // Show the element
        }

        const mainProduct = currentElements.closest('form');
        if (!mainProduct) return;
        const rcctwg = mainProduct.querySelector('.mainrc');
        const mainRecharge = rcctwg.querySelector('.rc-container-wrapper');
        if (mainRecharge) {
            const mainRCWidget = mainRecharge.querySelector('.rc-widget');
            if (mainRCWidget) {
                const mainSubscriptionOptions = currentElements.querySelectorAll('.gp-navs-tab');
                if (mainSubscriptionOptions.length > 0) {
                    
                    mainSubscriptionOptions.forEach((option, index) => {
                        // Add 'subsave' class to the first element, otherwise add 'onetime' class
                        if (index === 0) {
                            option.classList.add('subsave');
                        } else {
                            option.classList.add('onetime');
                        }
                        
                            mainSubscriptionOptions[0].click()
                        option.addEventListener('click', function() {
                            // Get selected subscription option
                            let selectedOption = this.classList.contains('onetime') ? 'onetime' : 'subsave';
                            let sellingPlan = this.classList.contains('onetime') ? '' : 'selling_plan';

                            let optionElements = mainRCWidget.querySelectorAll('.rc-option.rc_widget__option');
                            let inputElements = mainRCWidget.querySelectorAll('input.rc-radio__input');
                            let selectedInput = mainRCWidget.querySelector(`input.rc-radio__input[value="${selectedOption}"]`);

                            if (optionElements.length && inputElements.length && selectedInput) {
                                optionElements.forEach(opt => opt.classList.remove('rc_widget__option--active', 'rc-option--active'));
                                let selectedOptionElement = mainRCWidget.querySelector(`.rc-option.rc_widget__option.rc-option__${selectedOption}`);
                                if (selectedOptionElement) {
                                    selectedOptionElement.classList.add('rc_widget__option--active', 'rc-option--active');
                                }

                                let sellingPlanDropdown = mainRCWidget.querySelector('select.rc-selling-plans__dropdown');
                                if (sellingPlanDropdown) {
                                    sellingPlanDropdown.setAttribute('name', sellingPlan);
                                }

                                inputElements.forEach(input => input.checked = false);
                                selectedInput.checked = true;
                                selectedInput.click();
                            }
                            
                            if(selectedOption == "onetime") {
                               var firstTabcontent = document.querySelector('.firtsTabContent')
                               firstTabcontent.querySelector('.gp-cus-swatch-1p').click()
                            }
                            else if (selectedOption == "subsave"){
                            var secondTabContent = document.querySelector('.secondTabContent')
                               secondTabContent.querySelector('.gp-cus-swatch-1p').click()
                            }
                            
                            var countryCode = Shopify.country || "US";
                            var currencyCode = Shopify.currency.active || "USD";
                            
                            var varPrice =
                              selectedOption == "subsave"
                                ? product.variantSelected.selling_plan_allocations[0].price / 100
                                : product.variantSelected.price / 100;
                    
                            var curPrice = new Intl.NumberFormat("en-" + countryCode, {
                              style: "currency",
                              currency: currencyCode,
                            }).format(varPrice);
                            
                            console.log('curPrice', curPrice)
                            document.querySelector('.gTo3Lpfpbs .gp-product-price [data-gp-text]').textContent = curPrice
                        });
                    });
                }
                
            }
        }
    }

    // Observe changes to the DOM and call setupSubscriptionOptions when required elements are added
    const observer = new MutationObserver((mutations, obs) => {
        const mainProduct = document.querySelector('.gUqu7HyGX2')?.closest('form');
        const mainRecharge = mainProduct ? mainProduct.querySelector('.mainrc .rc-container-wrapper') : null;

        if (mainRecharge) {
            setupSubscriptionOptions();
            obs.disconnect(); // Stop observing once the elements are found and setup is done
        }
    });

    observer.observe(document.body, {
        childList: true,
        subtree: true
    });
});

        } catch(err){}
      </script>
    
  
