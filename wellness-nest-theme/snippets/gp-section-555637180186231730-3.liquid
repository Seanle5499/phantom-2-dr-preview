      <script id="custom-js-gppQXfVssB">
        try {
          
window.addEventListener("DOMContentLoaded", function () {
  var productElement = document.querySelector(".gppQXfVssB");

  if (productElement) {
    var productelm = productElement.closest("gp-product");
    var gpContext = productelm.getAttribute("gp-context");
    var product = productelm.getContext();

    var productvariantid = product.variantSelected.id;
    var productprice = product.variantSelected.price;
    var saveprice = product.variantSelected.selling_plan_allocations.length > 0
      ? product.variantSelected.selling_plan_allocations[0].price
      : 0;

    var onetimePriceElement = productelm.querySelector(".onetime strong");
    var rcsavepriceElement = productelm.querySelector(".subsave strong");

    var onetimepricect;
    var sabsavepricect;

    var variantorder = productelm.querySelectorAll(".variantorder");
    variantorder.forEach(function (quantityElement) {
      var checknumber = quantityElement.getAttribute("data-variant");
      if (String(productvariantid).trim() === String(checknumber).trim()) {
        var numberquantity = parseInt(quantityElement.getAttribute("data-number"));
        onetimepricect = productprice / numberquantity;
        sabsavepricect = saveprice / numberquantity;
      }
    });

    if (onetimePriceElement) {
      onetimePriceElement.innerHTML = Shopify.formatMoney(onetimepricect, money_format);
    }

    if (rcsavepriceElement) {
      rcsavepriceElement.innerHTML = Shopify.formatMoney(sabsavepricect, money_format);
    }

    window.addEventListener("gp:product-change-variant", function(data) {
      if (data.detail.productId === product.productId) {
          var variant = data.detail.variantSelected
         
            var countryCode = Shopify.country || "US";
            var currencyCode = Shopify.currency.active || "USD";
      
            //   Format selected variant price
          var varPrice = variant.selling_plan_allocations[0].price !== undefined ? variant.selling_plan_allocations[0].price / 100 : variant.price / 100;
         
         if (productelm.querySelectorAll("input.rc_widget__option__input").length > 0) {
            varPrice =
              productelm.querySelector("input.rc_widget__option__input:checked").value ==
              "onetime"
                ? variant.price / 100
                : varPrice;
          }
      
          var curPrice = new Intl.NumberFormat("en-" + countryCode, {
            style: "currency",
            currency: currencyCode,
          }).format(varPrice);   
          
          document.querySelector('.gTo3Lpfpbs .gp-product-price [data-gp-text]').textContent = curPrice
          
          if (
        productelm.querySelectorAll(
          'form[action="/cart/add"] > input[name="id"][type="hidden"]'
        ).length > 0
      ) {
        productelm
          .querySelector('form[action="/cart/add"] > input[name="id"][type="hidden"]')
          .value = variant.id;
        productelm
          .querySelector('form[action="/cart/add"] > input[name="id"][type="hidden"]')
          .setAttribute("data-value", variant.id);
      }
        }
    });
  }
});



