      <script id="custom-js-gA_R87v0Ci">
        try {
          // ╔═══════════════════════════════════════════════════════════════╗
// ║  CONFIG                                                       ║
// ╚═══════════════════════════════════════════════════════════════╝
var PRODUCT_HANDLE = "turkesterone-advanced-formula";

// Bundle tiers — top to bottom order
// qty_cart  : units actually added to cart
// pct_off   : display-only savings % (Shopify discount handles real reduction)
// badge     : badge label shown top-right ("" = no badge)
// best      : true = show LAUNCH OFFER + BEST VALUE badges
var BUNDLES = [
    {
        qty_cart: 6,   // units added to cart
        qty_pay:  3,   // units customer pays for (Shopify discount covers the rest)
        pct_off:  50,  // display savings %
        label:    "Buy 3 Get 3 Free",
        sub:      "3 bottles free — best value",
        badge:    "BEST VALUE",
        best:     true,
    },
    {
        qty_cart: 3,
        qty_pay:  2,   // pays for 2, gets 3
        pct_off:  33,
        label:    "Buy 2 Get 1 Free",
        sub:      "1 bottle free — popular choice",
        badge:    "POPULAR",
        best:     false,
    },
    {
        qty_cart: 1,
        qty_pay:  1,
        pct_off:  0,
        label:    "Buy 1",
        sub:      "Single bottle",
        badge:    "",
        best:     false,
    },
];

// ╔═══════════════════════════════════════════════════════════════╗
// ║  STATIC TEXT — edit labels here                               ║
// ╚═══════════════════════════════════════════════════════════════╝
var TEXT = {
    // Buttons
    btn_add_cart:       "ADD TO CART",
    btn_add_cart_plain: "ADD TO CART",
    btn_loading:        "ADDING...",
    // Badges
    badge_offer:        "LAUNCH OFFER",
    // Alerts
    alert_select_plan:  "Please select an offer",
    alert_cart_error:   "Error adding to cart. Please try again.",
};

// ╔═══════════════════════════════════════════════════════════════╗
// ║  CONSTANTS                                                    ║
// ╚═══════════════════════════════════════════════════════════════╝
var ZERO_DECIMAL_CURRENCIES = [
    'BIF', 'CLP', 'DJF', 'GNF', 'JPY', 'KMF', 'KRW', 'MGA',
    'PYG', 'RWF', 'UGX', 'VND', 'VUV', 'XAF', 'XOF', 'XPF'
];

// ╔═══════════════════════════════════════════════════════════════╗
// ║  STATE                                                        ║
// ╚═══════════════════════════════════════════════════════════════╝
var _variantId   = null;
var _unitPrice   = 0; // price in cents (for display only)

// ╔═══════════════════════════════════════════════════════════════╗
// ║  CURRENCY / FORMAT HELPERS                                    ║
// ╚═══════════════════════════════════════════════════════════════╝
function activeCurrency() {
    return (window.Shopify && window.Shopify.currency && window.Shopify.currency.active) || 'USD';
}

function isZeroDecimal(c) {
    return ZERO_DECIMAL_CURRENCIES.indexOf(c.toUpperCase()) !== -1;
}

function fmt(shopifyCents) {
    var currency = activeCurrency();
    var amount   = shopifyCents / 100;
    var decimals = isZeroDecimal(currency) ? 0 : 2;
    try {
        return new Intl.NumberFormat(navigator.language || 'en-US', {
            style: 'currency', currency: currency,
            minimumFractionDigits: decimals, maximumFractionDigits: decimals
        }).format(amount);
    } catch (e) { return amount.toFixed(decimals) + ' ' + currency; }
}

function esc(s) {
    var d = document.createElement("div");
    d.textContent = s;
    return d.innerHTML;
}

// ╔═══════════════════════════════════════════════════════════════╗
// ║  INJECT STATIC TEXT                                           ║
// ╚═══════════════════════════════════════════════════════════════╝
function updateDeliveryDate() {
    var el = document.querySelector("[data-delivery-date]");
    if (!el) return;

    var daysOfWeek = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
    var months     = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

    var targetDate = new Date();
    targetDate.setDate(targetDate.getDate() + 5);

    var dayName    = daysOfWeek[targetDate.getDay()];
    var dayOfMonth = targetDate.getDate();
    var monthName  = months[targetDate.getMonth()];

    el.textContent = dayName + ", " + dayOfMonth + " " + monthName;
}

function injectStaticText() {
    var btn = document.querySelector("[data-add-to-cart-btn]");
    if (btn) btn.textContent = TEXT.btn_add_cart_plain;
    updateDeliveryDate();
}

// ╔═══════════════════════════════════════════════════════════════╗
// ║  FETCH + INIT                                                 ║
// ╚═══════════════════════════════════════════════════════════════╝
fetch("/products/" + PRODUCT_HANDLE + ".js")
    .then(function (r) {
        if (!r.ok) throw new Error("Product not found: " + PRODUCT_HANDLE);
        return r.json();
    })
    .then(function (data) {
        var v       = data.variants[0];
        _variantId  = v.id;
        _unitPrice  = v.price; // cents, display only
        injectStaticText();
        buildBundles();
        initAddToCartBtn();
    })
    .catch(function (e) {
        console.error("[BundleWidget] fetch failed:", e);
    });

// ╔═══════════════════════════════════════════════════════════════╗
// ║  BUILD BUNDLE CARDS                                           ║
// ╚═══════════════════════════════════════════════════════════════╝
function buildBundles() {
    var c = document.querySelector("[data-plan-cards]");
    if (!c) return;

    var selectedCard = c.querySelector(".plan-card.selected");
    var prevQty      = selectedCard ? selectedCard.dataset.planQty : null;
    c.innerHTML      = "";

    BUNDLES.forEach(function (b, idx) {
        var def  = prevQty ? String(b.qty_cart) === String(prevQty) : idx === 0;
        var best = b.best;

        // ── Badges ──────────────────────────────────────────────
        var badges = best
            ? '<div class="plan-card__badges">' +
              '<span class="plan-card__badge-offer">' + esc(TEXT.badge_offer) + '</span>' +
              '<span class="plan-card__badge-best">' + esc(b.badge) + '</span>' +
              '</div>'
            : (b.badge
                ? '<div class="plan-card__badges plan-card__badges--right">' +
                  '<span class="plan-card__badge-popular">' + esc(b.badge) + '</span>' +
                  '</div>'
                : '');

        // ── Price display ────────────────────────────────────────
        // Discounted total = qty_pay × unit price (Shopify applies the free-bottle discount)
        var totalRetail     = _unitPrice * b.qty_cart; // retail value
        var totalDiscounted = _unitPrice * b.qty_pay;  // what customer actually pays

        // Per-bottle headline (big)
        var effectivePerBottle = Math.round(_unitPrice * b.qty_pay / b.qty_cart);
        var perBottleHtml = fmt(effectivePerBottle) + '<span class="plan-card__price-mo"> / bottle</span>';

        // Total line (small, below)
        var totalHtml = fmt(totalDiscounted);
        if (b.pct_off > 0) {
            totalHtml += ' <span class="plan-card__price-strike">' + fmt(totalRetail) + '</span>';
        }
        totalHtml += ' total';

        // ── Feature bullets ──────────────────────────────────────
        var feats;
        if (idx === 0) {
            // Buy 3 Get 3 Free
            feats = [
                { i: "🎯", text: "Best price per bottle" },
                { i: "💰", text: "Save the most — 3 bottles completely free" },
                { i: "🔵", text: "90-Day Money-Back Guarantee" },
                { i: "🧡", text: "Share with family and friends" },
                { i: "🚚", text: "Free Shipping to US, UK, CA, and most of EU and APAC" },
            ];
        } else if (idx === 1) {
            // Buy 2 Get 1 Free
            feats = [
                { i: "💰", text: "1 bottle free — great value" },
                { i: "🔵", text: "60-Day Money-Back Guarantee" },
                { i: "🚚", text: "Free Shipping to US, UK, CA, and most of EU and APAC" },
            ];
        } else {
            // Buy 1
            feats = [
                { i: "💊", text: "30-day supply" },
                { i: "🔵", text: "30-Day Money-Back Guarantee" },
                { i: "🚚", text: "Free Priority Shipping" },
            ];
        }

        var fHtml = '<div class="plan-card__features">';
        feats.forEach(function (f) {
            fHtml +=
                '<div class="plan-card__feature">' +
                '<span class="plan-card__feature-icon">' + f.i + '</span>' +
                '<span>' + esc(f.text) + '</span>' +
                '</div>';
        });
        fHtml += '</div>';

        c.insertAdjacentHTML('beforeend',
            '<div class="plan-card' + (def ? ' selected' : '') +
            '" data-plan-qty="' + b.qty_cart + '">' +

            badges +

            '<div class="plan-card__header"' + (best ? ' style="padding-top:4px"' : '') + '>' +
            '<div class="plan-card__left">' +
            '<div class="plan-card__radio-wrap">' +
            '<input type="radio" name="im8-plan" ' + (def ? 'checked ' : '') + '/>' +
            '<span class="plan-card__radio-icon"></span>' +
            '</div>' +
            '<div>' +
            '<div class="plan-card__title">' + esc(b.label) +
            (b.pct_off > 0 ? ' <span class="plan-card__save-label">(Save ' + b.pct_off + '%)</span>' : '') +
            '</div>' +
            '<div class="plan-card__billing">' + esc(b.sub) + '</div>' +
            '</div>' +
            '</div>' +
            '<div class="plan-card__right">' +
            '<div class="plan-card__price">' + perBottleHtml + '</div>' +
            '<div class="plan-card__price-day">' + totalHtml + '</div>' +
            '</div>' +
            '</div>' +

            '<hr class="plan-card__divider"/>' +
            fHtml +
            '</div>'
        );
    });

    // ── Click handlers ───────────────────────────────────────────
    var cards = c.querySelectorAll('.plan-card');
    cards.forEach(function (card) {
        card.addEventListener('click', function () {
            cards.forEach(function (c2) {
                c2.classList.remove('selected');
                var r = c2.querySelector('input[type="radio"]');
                if (r) r.checked = false;
            });
            card.classList.add('selected');
            var r = card.querySelector('input[type="radio"]');
            if (r) r.checked = true;
            updateAddToCartBtnPrice();
        });
    });

    updateAddToCartBtnPrice();
}

// ╔═══════════════════════════════════════════════════════════════╗
// ║  ADD TO CART                                                  ║
// ╚═══════════════════════════════════════════════════════════════╝
function initAddToCartBtn() {
    var btn = document.querySelector("[data-add-to-cart-btn]");
    if (!btn || btn._bundleBound) return;
    btn._bundleBound = true;

    btn.addEventListener('click', function () {
        if (btn.disabled) return;

        var selectedCard = document.querySelector('.plan-card.selected');
        if (!selectedCard) { alert(TEXT.alert_select_plan); return; }

        var qty = parseInt(selectedCard.dataset.planQty || 1, 10);

        // ── Meta Pixel ───────────────────────────────────────────
        if (window.fbq) fbq('track', 'AddToCart', {
            content_ids:  [String(_variantId)],
            content_type: 'product_variant',
            value:        parseFloat((_unitPrice * qty / 100).toFixed(2)),
            currency:     activeCurrency(),
            num_items:    qty,
            contents:     [{ id: String(_variantId), quantity: qty, item_price: parseFloat((_unitPrice / 100).toFixed(2)) }]
        });

        btn.disabled = true;
        btn.classList.add('is-loading');
        btn.textContent = TEXT.btn_loading;

        fetch(window.Shopify.routes.root + 'cart/add.js', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({
                items: [{ id: parseInt(_variantId, 10), quantity: qty }],
                sections:     'cart-drawer,cart-icon-bubble',
                sections_url: window.location.pathname,
            }),
        })
            .then(function (res) { return res.json(); })
            .then(function (response) {
                btn.disabled = false;
                btn.classList.remove('is-loading');
                updateAddToCartBtnPrice();

                // Open cart drawer — GemPages native first, then fallback
                var cartDrawer = document.querySelector('cart-drawer');
                if (cartDrawer && typeof cartDrawer.renderContents === 'function') {
                    cartDrawer.classList.remove('is-empty');
                    cartDrawer.renderContents(response);
                    return;
                }
                document.dispatchEvent(new CustomEvent('gp:open-cart-drawer', {
                    bubbles: true, cancelable: true,
                    detail: { data: response }, composed: true,
                }));
            })
            .catch(function (err) {
                console.error("[BundleWidget] cart/add failed:", err);
                btn.disabled = false;
                btn.classList.remove('is-loading');
                updateAddToCartBtnPrice();
                alert(TEXT.alert_cart_error);
            });
    });
}

function updateAddToCartBtnPrice() {
    var btn = document.querySelector("[data-add-to-cart-btn]");
    if (!btn || btn.classList.contains('is-loading')) return;
    btn.textContent = TEXT.btn_add_cart;
}
        } catch(err){}
      </script>
    
    

    

    
