// ── Plan Cards ──
function buildPlans() {
  var c = document.querySelector("[data-plan-cards]");
  if (!c || !_allGroups.length) return;

  var selectedCard = c.querySelector(".plan-card.selected");
  var prevDays = selectedCard ? selectedCard.dataset.planDays : null;
  c.innerHTML = "";

  var v0 = getActiveVariant();
  var allocs = v0.selling_plan_allocations || [];

  var plans = _allGroups
    .map(function(g) {
      var sp = g.selling_plans[0];
      var alloc = null;
      for (var i = 0; i < allocs.length; i++) {
        if (allocs[i].selling_plan_id === sp.id) { alloc = allocs[i]; break; }
      }
      var qty = 1;
      g.options.forEach(function(o) {
        if (o.name === "Product Quantity") qty = parseInt(o.values[0]) || 1;
      });
      var save = sp.price_adjustments && sp.price_adjustments[0]
        ? sp.price_adjustments[0].value : 0;
      return {
        originalIndex: _allGroups.indexOf(g),
        plan: sp, alloc: alloc, qty: qty, save: save,
        price: alloc ? alloc.price : v0.price,
        compare: alloc ? alloc.compare_at_price : v0.price,
        spId: sp.id,
      };
    })
    .filter(function(p) {
      if (ALLOWED_PLAN_INDICES && ALLOWED_PLAN_INDICES.length > 0)
        return ALLOWED_PLAN_INDICES.indexOf(p.originalIndex) !== -1;
      return true;
    });

  plans.sort(function(a, b) { return b.qty - a.qty; });

  var bestIdx = 0, maxS = 0;
  plans.forEach(function(p, i) { if (p.save > maxS) { maxS = p.save; bestIdx = i; } });

  plans.forEach(function(p, idx) {
    var best = idx === bestIdx;
    var days = p.qty * 30;
    var def = prevDays ? String(days) === String(prevDays) : idx === 0;
    var weeks = p.qty * 4;
    var billing = "Billed " + fmt(p.price * p.qty) + " every " + weeks + " weeks";
    var perDay = fmtPerDay(p.price, 30) + " / DAY";
    var saveLabelHtml = p.save > 0
      ? ' <span class="plan-card__save-label">(Save ' + p.save + "%)</span>" : "";
    var badges = best
      ? '<div class="plan-card__badges">' +
        '<span class="plan-card__badge-offer">Launch Offer</span>' +
        '<span class="plan-card__badge-best">Best Value</span></div>' : "";
    var priceHtml = fmtShort(p.price);
    if (p.compare && p.compare > p.price)
      priceHtml += ' <span class="plan-card__price-strike">' + fmtShort(p.compare) + "</span>";
    priceHtml += '<span class="plan-card__price-mo">/mo</span>';

    var feats = [];
    if (p.qty >= 3) {
      feats = [
        { i: "🎯", t: "Exclusive Access to " + days + " Day Transformation Program" },
        { i: "💰", t: "Maximum savings – lowest price per serving" },
        { i: "🔵", t: days + "-Day Money-Back Guarantee" },
        { i: "🧡", t: "Share with family and friends" },
        { i: "🚚", t: "Free Shipping to US, UK, CA, and most of EU and APAC" },
        { i: "📋", t: "Cancel or pause anytime" },
      ];
    } else if (p.qty >= 2) {
      feats = [
        { i: "💰", t: "Great savings per serving" },
        { i: "🚚", t: "Free Shipping to US, UK, CA, and most of EU and APAC" },
        { i: "📋", t: "Cancel or pause anytime" },
      ];
    } else {
      feats = [
        { i: "💰", t: "Save " + p.save + "% vs one-time purchase" },
        { i: "🚚", t: "Free Priority Shipping" },
        { i: "📋", t: "Cancel or pause anytime" },
      ];
    }
    var fHtml = '<div class="plan-card__features">';
    feats.forEach(function(f) {
      fHtml += '<div class="plan-card__feature"><span class="plan-card__feature-icon">' +
        f.i + "</span><span>" + esc(f.t) + "</span></div>";
    });
    fHtml += "</div>";

    c.insertAdjacentHTML("beforeend",
      '<div class="plan-card' + (def ? " selected" : "") +
      '" data-plan-days="' + days +
      '" data-selling-plan-id="' + p.spId +
      '" data-plan-qty="' + p.qty +
      '" data-monthly-price="' + p.price + '">' +
      badges +
      '<div class="plan-card__header"' + (best ? ' style="padding-top:4px"' : "") + ">" +
      '<div class="plan-card__left"><div class="plan-card__radio-wrap">' +
      '<input type="radio" name="im8-plan" ' + (def ? "checked " : "") + "/>" +
      '<span class="plan-card__radio-icon"></span></div><div>' +
      '<div class="plan-card__title">' + esc(days + "-Day Supply") + saveLabelHtml + "</div>" +
      '<div class="plan-card__billing">' + billing + "</div></div></div>" +
      '<div class="plan-card__right"><div class="plan-card__price">' + priceHtml + "</div>" +
      '<div class="plan-card__price-day">' + perDay + "</div></div></div>" +
      '<hr class="plan-card__divider"/>' + fHtml + "</div>"
    );
  });

  var cards = c.querySelectorAll(".plan-card");
  cards.forEach(function(card) {
    card.addEventListener("click", function() {
      cards.forEach(function(c2) {
        c2.classList.remove("selected");
        var r = c2.querySelector('input[type="radio"]');
        if (r) r.checked = false;
      });
      card.classList.add("selected");
      var r = card.querySelector('input[type="radio"]');
      if (r) r.checked = true;
      updateATCBtnPrice(); // ← đổi tên
    });
  });
  updateATCBtnPrice(); // ← đổi tên
}

// ── OTP (Buy One Time) ──
function buildOTP() {
  var ctr = document.querySelector("[data-otp-container]");
  var link = document.querySelector("[data-otp-link]");
  if (!ctr || !_allVariants.length) return;
  ctr.style.display = "";
  updateOTPPrice();

  if (link && !link._otpBound) {
    link._otpBound = true;

    link.addEventListener("click", function(e) {
      e.preventDefault();
      var vid = getActiveVariantId();
      var v = getActiveVariant();
      var priceCents = v ? v.price : 0;

    

      fetch("/cart/clear.js", { method: "POST" })
        .then(function() {
          return fetch("/cart/add.js", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ items: [{ id: parseInt(vid), quantity: 1 }] }),
          });
        })
        .then(function() {
             window.location.href = "/checkout";
        })
        .catch(function(err) {
          console.error("[OTP] failed:", err);
          window.location.href = "/cart/add?id=" + vid + "&quantity=1";
        });
    });
  }
}

function updateOTPPrice() {
  var priceEl = document.querySelector("[data-otp-price]");
  if (!priceEl || !_allVariants.length) return;
  var v = getActiveVariant();
  priceEl.textContent = fmt(v.price);
}

// ── Update giá trên GemPages ATC button ──
// ── Update giá trên GemPages ATC button ──
function updateATCBtnPrice(priceEl) {
  var el = priceEl || document.querySelector('gp-product-price.gp-button-price .gp-price.gp-button-price');
  var selectedCard = document.querySelector(".plan-card.selected");
  if (!el || !selectedCard) return;
  var priceCents = parseInt(selectedCard.dataset.monthlyPrice || 0, 10);
  if (priceCents > 0) el.textContent = fmtShort(priceCents) + " /mo";
}

// ── Hijack GemPages ATC button ──
function hijackATC() {
  var btn = document.querySelector('button.gp-button-atc');
  if (!btn) return false;

  var newBtn = btn.cloneNode(true);
  btn.parentNode.replaceChild(newBtn, btn);

  var btnPriceEl = newBtn.querySelector('.gp-price.gp-button-price');

  var form = newBtn.closest('form');
  if (form) form.addEventListener('submit', function(e) {
    e.preventDefault(); e.stopPropagation();
  }, true);

  updateATCBtnPrice(btnPriceEl);

  newBtn.addEventListener('click', function(e) {
    e.preventDefault(); e.stopPropagation(); e.stopImmediatePropagation();

    var variantId = getActiveVariantId();
    if (!variantId) { alert("Please select a variant"); return; }

    var selectedCard = document.querySelector(".plan-card.selected");
    if (!selectedCard) { alert("Please select a plan"); return; }

    var sellingPlanId = selectedCard.dataset.sellingPlanId;
    var qty = parseInt(selectedCard.dataset.planQty || 1, 10);
    var priceCents = parseInt(selectedCard.dataset.monthlyPrice || 0, 10);
    var totalCents = priceCents * qty;

    var payload = { id: parseInt(variantId, 10), quantity: qty };
    if (sellingPlanId && sellingPlanId !== "undefined" && sellingPlanId !== "null") {
      payload.selling_plan = parseInt(sellingPlanId, 10);
    }

    if (window.fbq) fbq('track', 'AddToCart', {
      content_ids: [String(variantId)],
      content_type: 'product_variant',
      value: (totalCents / 100).toFixed(2),
      currency: activeCurrency(),
      num_items: qty,
    });

    newBtn.setAttribute('data-state', 'loading');

    fetch("/cart/clear.js", { method: "POST" })
      .then(function() {
        return fetch("/cart/add.js", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ items: [payload] }),
        });
      })
      .then(function(r) { return r.json(); })
      .then(function() {
        if (window.fbq) {
          fbq('track', 'InitiateCheckout', {
            content_ids: [String(variantId)],
            content_type: 'product_variant',
            value: (totalCents / 100).toFixed(2),
            currency: activeCurrency(),
            num_items: qty,
          });
          setTimeout(function() { window.location.href = "/checkout"; }, 300);
        } else {
          window.location.href = "/checkout";
        }
      })
      .catch(function(err) {
        console.error("Cart error:", err);
        alert("Error adding to cart. Please try again.");
        newBtn.setAttribute('data-state', '');
        updateATCBtnPrice(btnPriceEl);
      });
  }, true);

  return true;
}// ── Init ──
function initAddToCartBtn() {
  if (!hijackATC()) {
    var n = 0;
    var t = setInterval(function() {
      if (hijackATC() || ++n >= 30) clearInterval(t);
    }, 300);
  }
}
