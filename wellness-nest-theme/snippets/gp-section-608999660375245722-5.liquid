        <div class="rc-plans">
          <div class="rc-pill active" data-plan-index="0"><div class="rc-pill-title">1 Month</div><div class="rc-pill-sub">Save 20%</div></div>
          <div class="rc-pill" data-plan-index="1"><div class="rc-pill-title">2 Months</div><div class="rc-pill-sub">Save 20%</div></div>
          <div class="rc-pill" data-plan-index="2"><div class="rc-pill-title">3 Months</div><div class="rc-pill-sub">Save 16%</div></div>
        </div>
      </div>
      <div class="rc-benefits-wrap">
