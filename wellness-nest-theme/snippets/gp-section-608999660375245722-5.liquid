.rc-prices-row { display: flex !important; flex-direction: row !important; align-items: center; gap: 4px; white-space: nowrap; }
.rc-price-original { font-size: 12px; color: #555; text-decoration: line-through; white-space: nowrap; }
.rc-price-main { font-size: 16px; font-weight: 700; white-space: nowrap; }
.rc-price-perday { font-size: 12px; color: #555; font-weight: 500; text-align: right; white-space: nowrap; line-height: 1; }
.rc-sub-container { padding: 0 16px !important; }
.rc-quantity-label { font-size: 13px; font-weight: 700; color: #1A1A1A; margin-bottom: 6px; }
.rc-plans { display: flex !important; flex-direction: row !important; flex-wrap: nowrap !important; gap: 8px; }
.rc-pill { flex: 1 1 0% !important; text-align: center; padding: 12px; border: 2px solid #D9D9D9; border-radius: 24px; background: #FFF; cursor: pointer; transition: border-color 0.15s, background 0.15s; min-width: 0 !important; }
.rc-pill.active { border-color: var(--rc-theme, #54B94A); background: var(--rc-theme-light, #F0FAF0); }
.rc-pill-title { font-size: 14px; font-weight: 700; color: #333; }
.rc-pill-sub { font-size: 12px; color: #555; margin-top: 2px; }
.rc-benefits { display: flex !important; flex-direction: row !important; align-items: center; justify-content: flex-start; column-gap: 12px; row-gap: 2px; flex-wrap: wrap; padding: 10px 16px; font-size: 11px; color: #555; }
.rc-benefit { display: inline-flex; align-items: center; gap: 4px; }
.rc-sub-content { display: block !important; padding-bottom: 10px; }
.rc-benefits-wrap { display: none !important; }
.rc-opt-sub.active-sub .rc-benefits-wrap { display: block !important; }
@media (max-width: 480px) {
  .rc-opt-label { padding: 12px 10px; gap: 6px; }
  .rc-pill-title { font-size: 12px; }
  .rc-pill-sub { font-size: 10px; }
  .rc-pill { padding: 10px 6px !important; }
}
</style>

