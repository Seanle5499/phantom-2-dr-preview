          <span class="rc-benefit"><svg width="14" height="14" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="2" fill="none"/><path d="M6 10l3 3 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="rc-shipping-text">Ships free monthly</span></span>
          <span class="rc-benefit"><svg width="14" height="14" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="2" fill="none"/><path d="M6 10l3 3 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>VIP discounts & perks</span></span>
          <span class="rc-benefit"><svg width="14" height="14" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="2" fill="none"/><path d="M6 10l3 3 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Pause, edit or cancel anytime</span></span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  (function () {

    /* ============================================================
       CONFIG — only update these values per product
       ============================================================ */
    var VARIANTS = {
      'Green Apple': { variantId: 50944061309243 },
      'Blueberry':   { variantId: 50941481550139 }
    };

    var PRODUCT_HANDLE = 'fusiforce-creatine-gummies'; // ← for landing pages only

    var PLAN_IDS  = ['9804349755', '9804415291', '9804382523'];
    var DISCOUNTS = [0.20, 0.20, 0.16];
    var PACK_QTY  = [1, 2, 3];
    var PACK_DAYS = [30, 60, 90];
    var PACK_SHIP = [
      'Ships free monthly',
      'Ships free every 2 months',
      'Ships free every 3 months'
    ];
    /* ============================================================ */

    var state            = { option: 'subscription', idx: 0 };
    var plans            = [];
    var currentVariantId = null;

    var w = document.querySelector('.rc-custom-widget');

    // ── Auto color from ATC button ──
    function applyThemeFromATC() {
      var btn = document.querySelector('button.gp-button-atc');
      if (!btn) return false;
      var color = window.getComputedStyle(btn).backgroundColor;
      if (color && color !== 'rgba(0, 0, 0, 0)' && color !== 'transparent') {
        w.style.setProperty('--rc-theme', color);
        w.style.setProperty('--rc-theme-light', color.replace('rgb(', 'rgba(').replace(')', ', 0.1)'));
        w.querySelectorAll('.rc-benefit svg').forEach(function (svg) {
          svg.style.color = color;
        });
        return true;
      }
      return false;
    }

    if (!applyThemeFromATC()) {
      var colorN = 0;
      var colorT = setInterval(function () {
        if (applyThemeFromATC() || ++colorN >= 30) clearInterval(colorT);
      }, 300);
    }

    var ZERO_DECIMAL = ['BIF','CLP','DJF','GNF','JPY','KMF','KRW','MGA','PYG','RWF','UGX','VND','VUV','XAF','XOF','XPF'];

    function activeCurrency() {
      return (window.Shopify && window.Shopify.currency && window.Shopify.currency.active) || 'USD';
    }
    function isZeroDecimal(c) { return ZERO_DECIMAL.indexOf(c.toUpperCase()) !== -1; }
    function formatMoney(cents) {
      var currency = activeCurrency();
      var amount   = cents / 100;
      var decimals = isZeroDecimal(currency) ? 0 : 2;
      try {
        return new Intl.NumberFormat(navigator.language || 'en-US', {
          style: 'currency', currency: currency,
          minimumFractionDigits: decimals, maximumFractionDigits: decimals
        }).format(amount);
      } catch(e) { return amount.toFixed(decimals); }
    }

    function buildPlans(unitCents) {
      plans = PLAN_IDS.map(function (planId, i) {
        var originalCents   = unitCents * PACK_QTY[i];
        var discountedCents = Math.round(originalCents * (1 - DISCOUNTS[i]));
        return {
          planId:     planId,
          qty:        PACK_QTY[i],
          original:   formatMoney(originalCents),
          discounted: formatMoney(discountedCents),
          perDay:     formatMoney(discountedCents / PACK_DAYS[i]) + '/day',
          otPrice:    formatMoney(originalCents),
          shipping:   PACK_SHIP[i]
        };
      });
    }

    var otBox     = w.querySelector('.rc-opt-onetime');
    var subBox    = w.querySelector('.rc-opt-sub');
    var origEl    = w.querySelector('.rc-price-original');
    var discEl    = w.querySelector('.rc-disc-price');
    var perDayEl  = w.querySelector('.rc-price-perday');
    var shipEl    = w.querySelector('.rc-shipping-text');
    var otPriceEl = w.querySelector('.rc-ot-price');

    function updateBtnPrice(text) {
      var btn = document.querySelector('gp-product-price.gp-button-price .gp-price.gp-button-price');
      if (btn) btn.textContent = text;
    }

    function updateUI() {
      if (!plans.length) return;
      var p    = plans[state.idx];
      var isOt = state.option === 'onetime';
      otBox.classList.toggle('active-ot', isOt);
      subBox.classList.toggle('active-sub', !isOt);
      otPriceEl.textContent = p.otPrice;
      origEl.textContent    = p.original;
      discEl.textContent    = p.discounted;
      perDayEl.textContent  = p.perDay;
      shipEl.textContent    = p.shipping;
      updateBtnPrice(isOt ? p.otPrice : p.discounted);
    }

    var productHandle = PRODUCT_HANDLE || (window.location.pathname.match(/\/products\/([^/?#]+)/) || [])[1];

    function loadVariant(variantTitle) {
      var v = VARIANTS[variantTitle];
      if (!v) return;
      currentVariantId = v.variantId;
      if (!productHandle) return;
      fetch('/products/' + productHandle + '.js')
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var variant = data.variants.find(function (vr) { return vr.id === v.variantId; });
          if (!variant) variant = data.variants[0];
          buildPlans(variant.price);
          updateUI();
        })
        .catch(function (err) { console.error('RC Widget:', err); });
    }

    function getSelectedFlavor() {
      var checked = document.querySelector('input[name*="-options-Flavor"]:checked');
      return checked ? checked.value : Object.keys(VARIANTS)[0];
    }

    document.addEventListener('change', function (e) {
      if (e.target && e.target.name && e.target.name.indexOf('-options-Flavor') !== -1) {
        loadVariant(e.target.value);
      }
    });

    document.addEventListener('gp:variantChanged', function (e) {
      if (e.detail && e.detail.variantId) {
        Object.keys(VARIANTS).forEach(function (title) {
          if (VARIANTS[title].variantId === e.detail.variantId) loadVariant(title);
        });
      }
    });

    document.addEventListener('variantChanged', function (e) {
      if (e.detail && e.detail.variant && e.detail.variant.id) {
        Object.keys(VARIANTS).forEach(function (title) {
          if (VARIANTS[title].variantId === e.detail.variant.id) loadVariant(title);
        });
      }
    });

    otBox.addEventListener('click', function () { state.option = 'onetime'; updateUI(); });
    subBox.querySelector('.rc-opt-label').addEventListener('click', function () { state.option = 'subscription'; updateUI(); });

    w.querySelectorAll('.rc-pill').forEach(function (pill) {
      pill.addEventListener('click', function () {
        w.querySelectorAll('.rc-pill').forEach(function (p) { p.classList.remove('active'); });
        this.classList.add('active');
        state.idx = parseInt(this.dataset.planIndex, 10);
        updateUI();
      });
    });

    function addToCart() {
      var p       = plans[state.idx];
      var payload = { id: currentVariantId, quantity: p.qty };
      if (state.option === 'subscription') payload.selling_plan = parseInt(p.planId, 10);
      return fetch('/cart/clear.js', { method: 'POST' })
        .then(function () {
          return fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: [payload] })
          });
        })
        .then(function (r) { return r.json(); })
        .then(function () { window.location.href = '/checkout'; })
        .catch(function (err) {
          console.error('Cart error:', err);
          alert('Error adding to cart. Please try again.');
        });
    }

    function hijackATC() {
      var btn = document.querySelector('button.gp-button-atc');
      if (!btn) return false;
      var newBtn = btn.cloneNode(true);
      btn.parentNode.replaceChild(newBtn, btn);
      newBtn.addEventListener('click', function (e) {
        e.preventDefault(); e.stopPropagation(); e.stopImmediatePropagation();
        newBtn.setAttribute('data-state', 'loading');
        addToCart();
      }, true);
      var form = newBtn.closest('form');
      if (form) form.addEventListener('submit', function (e) { e.preventDefault(); e.stopPropagation(); }, true);
      return true;
    }

    loadVariant(getSelectedFlavor());

    if (!hijackATC()) {
      var n = 0;
      var t = setInterval(function () {
        if (hijackATC() || ++n >= 30) clearInterval(t);
      }, 300);
    }

  })();
});
</script>
    </div>
    </div>
  
    </div>

      
