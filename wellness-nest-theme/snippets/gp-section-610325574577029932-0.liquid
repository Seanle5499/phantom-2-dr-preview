  save_label  : "(Oszczędź {pct}%)",
  billed_every: "Płatność {price} co {weeks} tygodni",
  per_day     : "{price} / DZIEŃ",
  // Features — 3+ months
  feat_3_program  : "Wyłączny Dostęp do {days}-dniowego Programu Transformacji",
  feat_3_savings  : "Maksymalne oszczędności – najniższa cena za porcję",
  feat_3_guarantee: "{days}-dniowa Gwarancja Zwrotu",
  feat_3_share    : "Podziel się z rodziną i przyjaciółmi",
  feat_3_shipping : "Darmowa Wysyłka do USA, UK, CA i większości EU i APAC",
  feat_3_cancel   : "Anuluj lub wstrzymaj w dowolnym momencie",
  // Features — 2 months
  feat_2_savings  : "Świetne oszczędności za porcję",
  feat_2_shipping : "Darmowa Wysyłka do USA, UK, CA i większości EU i APAC",
  feat_2_cancel   : "Anuluj lub wstrzymaj w dowolnym momencie",
  // Features — 1 month
  feat_1_savings  : "Oszczędź {pct}% vs jednorazowy zakup",
  feat_1_shipping : "Darmowa Wysyłka Priorytetowa",
  feat_1_cancel   : "Anuluj lub wstrzymaj w dowolnym momencie",
  // Buttons
  btn_add_cart      : "DODAJ DO KOSZYKA – {price} /MIES.",
  btn_add_cart_plain: "DODAJ DO KOSZYKA",
  btn_loading       : "DODAWANIE...",
  // Alerts
  alert_select_variant: "Proszę wybrać wariant",
  alert_select_plan   : "Proszę wybrać plan",
  alert_cart_error    : "Błąd podczas dodawania do koszyka. Spróbuj ponownie.",
};
// ╔═══════════════════════════════════════════════════════════════╗
// ║  CONSTANTS                                                    ║
// ╚═══════════════════════════════════════════════════════════════╝
var ZERO_DECIMAL_CURRENCIES = [
  'BIF','CLP','DJF','GNF','JPY','KMF','KRW','MGA',
  'PYG','RWF','UGX','VND','VUV','XAF','XOF','XPF'
];

// ╔═══════════════════════════════════════════════════════════════╗
// ║  STATE                                                        ║
// ╚═══════════════════════════════════════════════════════════════╝
var _allVariants = [];
var _allGroups   = [];
var _variantMap  = {};

// ╔═══════════════════════════════════════════════════════════════╗
// ║  TEXT HELPER                                                  ║
// ╚═══════════════════════════════════════════════════════════════╝
function t(key, vars) {
  var str = TEXT[key] || key;
  if (vars) {
    Object.keys(vars).forEach(function(k) {
      str = str.replace(new RegExp('\\{' + k + '\\}', 'g'), vars[k]);
    });
  }
  return str;
}

// ╔═══════════════════════════════════════════════════════════════╗
// ║  PURE HELPERS                                                 ║
// ╚═══════════════════════════════════════════════════════════════╝
function activeCurrency() {
  return (window.Shopify && window.Shopify.currency && window.Shopify.currency.active) || 'USD';
}

function isZeroDecimal(c) {
  return ZERO_DECIMAL_CURRENCIES.indexOf(c.toUpperCase()) !== -1;
}

function fmt(shopifyCents) {
  var currency = activeCurrency();
  var amount   = shopifyCents / 100;
  var decimals = isZeroDecimal(currency) ? 0 : 2;
  try {
    return new Intl.NumberFormat(navigator.language || 'en-US', {
      style: 'currency', currency: currency,
      minimumFractionDigits: decimals, maximumFractionDigits: decimals
    }).format(amount);
  } catch (e) { return amount.toFixed(decimals) + ' ' + currency; }
}

function fmtShort(shopifyCents) {
  var currency = activeCurrency();
  var amount   = shopifyCents / 100;
  try {
    return new Intl.NumberFormat(navigator.language || 'en-US', {
      style: 'currency', currency: currency,
      minimumFractionDigits: 0, maximumFractionDigits: 0
    }).format(amount);
  } catch (e) { return amount.toFixed(0) + ' ' + currency; }
}

function fmtPerDay(shopifyCents, days) {
  if (!days) return "";
  return fmt(shopifyCents / days);
}

function esc(s) {
  var d = document.createElement("div");
  d.textContent = s;
  return d.innerHTML;
}

// ╔═══════════════════════════════════════════════════════════════╗
// ║  DOM / STATE HELPERS                                          ║
// ╚═══════════════════════════════════════════════════════════════╝
function getActiveVariant() {
  var checked    = document.querySelector('input[name*="-options-Flavor"]:checked');
  var flavorName = checked ? checked.value : null;

  if (!flavorName) {
    var firstKey = Object.keys(_variantMap)[0];
    if (firstKey) flavorName = firstKey;
  }

  if (flavorName && _variantMap[flavorName]) {
    for (var i = 0; i < _allVariants.length; i++) {
      if (_allVariants[i].id === _variantMap[flavorName]) return _allVariants[i];
    }
  }

  return _allVariants[0];
}

function getActiveVariantId() {
  var v = getActiveVariant();
  return v ? v.id : null;
}

// ╔═══════════════════════════════════════════════════════════════╗
// ║  INJECT STATIC TEXT                                           ║
// ╚═══════════════════════════════════════════════════════════════╝
function injectStaticText() {
  var map = {
    "[data-label-subscribe]" : TEXT.label_subscribe,
    "[data-otp-label]"       : TEXT.label_otp,
    "[data-add-to-cart-btn]" : TEXT.btn_add_cart_plain,
  };
  Object.keys(map).forEach(function(sel) {
    var el = document.querySelector(sel);
    if (el) el.textContent = map[sel];
  });
}

// ╔═══════════════════════════════════════════════════════════════╗
// ║  FETCH + INIT                                                 ║
// ╚═══════════════════════════════════════════════════════════════╝
fetch("/products/" + PRODUCT_HANDLE + ".js")
  .then(function(r) { return r.json(); })
  .then(function(data) {
    _allVariants = data.variants;
    _allGroups   = data.selling_plan_groups || [];
    data.variants.forEach(function(v) {
      _variantMap[v.option1 || v.title] = v.id;
    });
    injectStaticText();
    buildPlans();
    buildOTP();
    initAddToCartBtn();
    forceFirstVariant();
  })
  .catch(function(e) { console.error("[PlanWidget] fetch failed:", e); });

// ╔═══════════════════════════════════════════════════════════════╗
// ║  VARIANT SELECTION                                            ║
// ╚═══════════════════════════════════════════════════════════════╝
function _selectFirstVariant(radio) {
  if (!radio) return;
  radio.checked = true;
  radio.dispatchEvent(new Event('change', { bubbles: true }));
  buildPlans();
  updateOTPPrice();
  console.log('[forceFirstVariant] selected:', radio.value);
}

function forceFirstVariant() {
  var radios = document.querySelectorAll('input[name*="-options-Flavor"]');

  if (!radios.length) {
    var obs = new MutationObserver(function(_, o) {
      var r = document.querySelectorAll('input[name*="-options-Flavor"]');
      if (r.length) { o.disconnect(); _selectFirstVariant(r[0]); }
    });
    obs.observe(document.body, { childList: true, subtree: true });
    return;
  }

  setTimeout(function() {
    var r          = document.querySelectorAll('input[name*="-options-Flavor"]');
    var anyChecked = document.querySelector('input[name*="-options-Flavor"]:checked');
    if (!anyChecked || anyChecked !== r[0]) _selectFirstVariant(r[0]);
  }, 300);
}

// ╔═══════════════════════════════════════════════════════════════╗
// ║  EVENT LISTENERS                                              ║
// ╚═══════════════════════════════════════════════════════════════╝
document.addEventListener('change', function(e) {
  if (e.target && e.target.name && e.target.name.indexOf('-options-Flavor') !== -1) {
    console.log('[flavor changed]', e.target.value, '→ variantId:', _variantMap[e.target.value]);
    buildPlans();
    updateOTPPrice();
  }
});

document.addEventListener('gp:variantChanged', function(e) {
  if (e.detail && e.detail.variantId) { buildPlans(); updateOTPPrice(); }
});

document.addEventListener('variantChanged', function(e) {
  if (e.detail && e.detail.variant && e.detail.variant.id) { buildPlans(); updateOTPPrice(); }
});

// ╔═══════════════════════════════════════════════════════════════╗
// ║  BUILD PLAN CARDS                                             ║
// ╚═══════════════════════════════════════════════════════════════╝
function buildPlans() {
  var c = document.querySelector("[data-plan-cards]");
  if (!c || !_allGroups.length) return;

  var selectedCard = c.querySelector(".plan-card.selected");
  var prevDays     = selectedCard ? selectedCard.dataset.planDays : null;
  c.innerHTML      = "";

  var v0    = getActiveVariant();
  var allocs = v0.selling_plan_allocations || [];

  var plans = _allGroups
    .map(function(g) {
      var sp    = g.selling_plans[0];
      var alloc = null;
      for (var i = 0; i < allocs.length; i++) {
        if (allocs[i].selling_plan_id === sp.id) { alloc = allocs[i]; break; }
      }
      var qty = 1;
      g.options.forEach(function(o) {
        if (o.name === "Product Quantity") qty = parseInt(o.values[0]) || 1;
      });
      var save = sp.price_adjustments && sp.price_adjustments[0]
        ? sp.price_adjustments[0].value : 0;
      return {
        originalIndex: _allGroups.indexOf(g),
        plan: sp, alloc: alloc, qty: qty, save: save,
        price  : alloc ? alloc.price            : v0.price,
        compare: alloc ? alloc.compare_at_price  : v0.price,
        spId   : sp.id,
      };
    })
    .filter(function(p) {
      return !ALLOWED_PLAN_INDICES.length ||
             ALLOWED_PLAN_INDICES.indexOf(p.originalIndex) !== -1;
    });

  plans.sort(function(a, b) { return b.qty - a.qty; });

  var bestIdx = 0, maxS = 0;
  plans.forEach(function(p, i) { if (p.save > maxS) { maxS = p.save; bestIdx = i; } });

  plans.forEach(function(p, idx) {
    var best  = idx === bestIdx;
    var days  = p.qty * 30;
    var weeks = p.qty * 4;
    var def   = prevDays ? String(days) === String(prevDays) : idx === 0;

    var billing = t('billed_every', { price: fmt(p.price * p.qty), weeks: weeks });
    var perDay  = t('per_day', { price: fmtPerDay(p.price, 30) });

    var saveLbl = p.save > 0
      ? ' <span class="plan-card__save-label">' + t('save_label', { pct: p.save }) + '</span>'
      : '';

    var badges = best
      ? '<div class="plan-card__badges">' +
        '<span class="plan-card__badge-offer">' + t('badge_offer') + '</span>' +
        '<span class="plan-card__badge-best">'  + t('badge_best')  + '</span>' +
        '</div>'
      : '';

    var priceHtml = fmtShort(p.price);
    if (p.compare && p.compare > p.price)
      priceHtml += ' <span class="plan-card__price-strike">' + fmtShort(p.compare) + '</span>';
    priceHtml += '<span class="plan-card__price-mo">/mo</span>';

    var feats;
    if (p.qty >= 3) {
      feats = [
        { i: "🎯", k: 'feat_3_program',   v: { days: days } },
        { i: "💰", k: 'feat_3_savings'                      },
        { i: "🔵", k: 'feat_3_guarantee', v: { days: days } },
        { i: "🧡", k: 'feat_3_share'                        },
        { i: "🚚", k: 'feat_3_shipping'                     },
        { i: "📋", k: 'feat_3_cancel'                       },
      ];
    } else if (p.qty >= 2) {
      feats = [
        { i: "💰", k: 'feat_2_savings'  },
        { i: "🚚", k: 'feat_2_shipping' },
        { i: "📋", k: 'feat_2_cancel'   },
      ];
    } else {
      feats = [
        { i: "💰", k: 'feat_1_savings',  v: { pct: p.save } },
        { i: "🚚", k: 'feat_1_shipping'                      },
        { i: "📋", k: 'feat_1_cancel'                        },
      ];
    }

    var fHtml = '<div class="plan-card__features">';
    feats.forEach(function(f) {
      fHtml +=
        '<div class="plan-card__feature">' +
        '<span class="plan-card__feature-icon">' + f.i + '</span>' +
        '<span>' + esc(t(f.k, f.v || {})) + '</span>' +
        '</div>';
    });
    fHtml += '</div>';

    c.insertAdjacentHTML('beforeend',
      '<div class="plan-card' + (def ? ' selected' : '') +
      '" data-plan-days="'       + days    +
      '" data-selling-plan-id="' + p.spId  +
      '" data-plan-qty="'        + p.qty   +
      '" data-monthly-price="'   + p.price + '">' +

      badges +

      '<div class="plan-card__header"' + (best ? ' style="padding-top:4px"' : '') + '>' +
        '<div class="plan-card__left">' +
          '<div class="plan-card__radio-wrap">' +
            '<input type="radio" name="im8-plan" ' + (def ? 'checked ' : '') + '/>' +
            '<span class="plan-card__radio-icon"></span>' +
          '</div>' +
          '<div>' +
            '<div class="plan-card__title">' +
              esc(t('day_supply', { days: days })) + saveLbl +
            '</div>' +
            '<div class="plan-card__billing">' + billing + '</div>' +
          '</div>' +
        '</div>' +
        '<div class="plan-card__right">' +
          '<div class="plan-card__price">' + priceHtml + '</div>' +
          '<div class="plan-card__price-day">' + perDay + '</div>' +
        '</div>' +
      '</div>' +

      '<hr class="plan-card__divider"/>' +
      fHtml +
      '</div>'
    );
  });

  // Click handlers
  var cards = c.querySelectorAll('.plan-card');
  cards.forEach(function(card) {
    card.addEventListener('click', function() {
      cards.forEach(function(c2) {
        c2.classList.remove('selected');
        var r = c2.querySelector('input[type="radio"]');
        if (r) r.checked = false;
      });
      card.classList.add('selected');
      var r = card.querySelector('input[type="radio"]');
      if (r) r.checked = true;
      updateAddToCartBtnPrice();
    });
  });

  updateAddToCartBtnPrice();
}

// ╔═══════════════════════════════════════════════════════════════╗
// ║  OTP (One-Time Purchase)                                      ║
// ╚═══════════════════════════════════════════════════════════════╝
function buildOTP() {
  var ctr  = document.querySelector("[data-otp-container]");
  var link = document.querySelector("[data-otp-link]");
  if (!ctr || !_allVariants.length) return;

  ctr.style.display = "";
  updateOTPPrice();

  if (link && !link._otpBound) {
    link._otpBound = true;
    link.addEventListener('click', function(e) {
      e.preventDefault();
      var vid = getActiveVariantId();
      fetch("/cart/add.js", {
        method : "POST",
        headers: { "Content-Type": "application/json" },
        body   : JSON.stringify({ items: [{ id: parseInt(vid), quantity: 1 }] }),
      })
      .then(function() { window.location.href = "/checkout"; })
      .catch(function(err) {
        console.error("[OTP] failed:", err);
        window.location.href = "/cart/add?id=" + vid + "&quantity=1";
      });
    });
  }
}

function updateOTPPrice() {
  var priceEl = document.querySelector("[data-otp-price]");
  if (!priceEl || !_allVariants.length) return;
  priceEl.textContent = fmt(getActiveVariant().price);
}

// ╔═══════════════════════════════════════════════════════════════╗
// ║  ADD TO CART (Subscription)                                   ║
// ╚═══════════════════════════════════════════════════════════════╝
function initAddToCartBtn() {
  var btn = document.querySelector("[data-add-to-cart-btn]");
  if (!btn) return;

  btn.addEventListener('click', function() {
    if (btn.disabled) return;

    var variantId = getActiveVariantId();
    if (!variantId) { alert(t('alert_select_variant')); return; }

    var selectedCard = document.querySelector('.plan-card.selected');
    if (!selectedCard) { alert(t('alert_select_plan')); return; }

    var sellingPlanId = selectedCard.dataset.sellingPlanId;
    var qty           = parseInt(selectedCard.dataset.planQty || 1, 10);
    var priceCents    = parseInt(selectedCard.dataset.monthlyPrice || 0, 10);
    var totalCents    = priceCents * qty;


    btn.disabled = true;
    btn.classList.add('is-loading');
    btn.textContent = t('btn_loading');

    var payload = { id: parseInt(variantId, 10), quantity: qty };
    if (sellingPlanId && sellingPlanId !== "undefined" && sellingPlanId !== "null") {
      payload.selling_plan = parseInt(sellingPlanId, 10);
    }

    fetch("/cart/add.js", {
      method : "POST",
      headers: { "Content-Type": "application/json" },
      body   : JSON.stringify({ items: [payload] }),
    })
    .then(function() {
      btn.disabled = false;
      btn.classList.remove('is-loading');
      updateAddToCartBtnPrice();
      window.location.href = "/checkout";
    })
    .catch(function(err) {
      console.error("Cart error:", err);
      alert(err.message || t('alert_cart_error'));
      btn.disabled = false;
      btn.classList.remove('is-loading');
      updateAddToCartBtnPrice();
    });
  });
}

function updateAddToCartBtnPrice() {
  var btn          = document.querySelector("[data-add-to-cart-btn]");
  var selectedCard = document.querySelector('.plan-card.selected');
  if (!btn || !selectedCard) return;
  if (btn.classList.contains('is-loading')) return;
  var priceCents = parseInt(selectedCard.dataset.monthlyPrice || 0, 10);
  btn.textContent = priceCents > 0
    ? t('btn_add_cart', { price: fmtShort(priceCents) })
    : t('btn_add_cart_plain');
}
        } catch(err){}
      </script>
    
    </div>

      
