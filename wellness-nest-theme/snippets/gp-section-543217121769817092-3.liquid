document.querySelector('.gCj8TCieaX').addEventListener('click', async function (event) {
    const button = event.currentTarget;

    // Disable the button to prevent multiple clicks
    button.disabled = true;

    try {
        const bundleWrapper = button.closest('.gp-custom-bundle-wrapper')
        const productForms = bundleWrapper.querySelectorAll('.gp-custom-bundle-products form[action*="/cart/add"]');

        for (let form of productForms) {
            const formData = new FormData(form);
            const response = await fetch('/cart/add.js', {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            
            if (!response.ok) throw new Error('Failed to add product to cart');
            await response.json();
        }

        // Redirect to checkout after all products are successfully added
        window.location.href = '/checkout';
    } catch (error) {
        console.error('Error adding products to cart:', error);
        // Re-enable the button if there's an error
        button.disabled = false;
    }
});

