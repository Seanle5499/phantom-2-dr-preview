      <script id="custom-js-gmVzdejdtp">
        try {
          window.addEventListener('DOMContentLoaded', function() {
  var productElement = document.querySelector(".gmVzdejdtp");

  function setActive(selector) {
    document.querySelectorAll('.mainvaluevariant.gp-cus-swatch-1p, .mainvaluevariant.gp-cus-swatch-2p, .mainvaluevariant.gp-cus-swatch-3p, .textontimemp.gp-cus-swatch-1p, .textontimemp.gp-cus-swatch-2p, .textontimemp.gp-cus-swatch-3p').forEach(function(elm) {
      elm.classList.remove('gp-active');
    });
    document.querySelectorAll(selector).forEach(function(elm) {
      elm.classList.add('gp-active');
    });
  }

  function addClickListener(selector, optionIndex) {
    document.querySelectorAll(selector).forEach(function(elm) {
      elm.addEventListener('click', function(e) {
        e.preventDefault();
        const optionElement = document.querySelector(`.gmVzdejdtp [variant-option-name] label:nth-of-type(${optionIndex})`);
        if (optionElement) {
          const rectangleListElement = optionElement.querySelector('[option-type="rectangle_list"]');
          if (rectangleListElement) {
            rectangleListElement.click();
          }
        }
        setActive(selector);
      });
    });
  }

  addClickListener('.gp-cus-swatch-1p', 1);
  addClickListener('.gp-cus-swatch-2p', 2);
  addClickListener('.gp-cus-swatch-3p', 3);

  var productElm = productElement.closest("gp-product");
  var dataload = productElm.getContext();
  //console.log(dataload);
  



      var variantload = dataload.variantSelected.id;
      //console.log(variantload);

      var variantOrder = productElm.querySelectorAll(".variantorder");
       //console.log(variantOrder);
      variantOrder.forEach(function(vid, index) {
        var variantOrderForCus = vid.getAttribute("data-variant");
        //console.log(variantOrderForCus);
        if (String(variantload).trim() === String(variantOrderForCus).trim()) {
          //console.log("Match found at index: ", index);
          var selector = `.gp-cus-swatch-${index + 1}p`;
          addClickListener(selector, index + 1);
          setActive(selector);
        } else {
          //console.log('Code chạy không đúng');
        }
      });
    
  
});

