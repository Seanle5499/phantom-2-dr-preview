// ╚═══════════════════════════════════════════════════════════════╝
(function im8AutoColor() {
  var wrapper = document.querySelector('.im8-variant-selects-wrapper');
  if (!wrapper) return;

  function isValidColor(hex) {
    return /^#[0-9A-Fa-f]{6}$/.test(hex) &&
      !/^#(000000|111111|121212|151515|1A1A1A|ffffff|FFFFFF|f4f4f4|F4F4F4)$/i.test(hex);
  }

  function hexToRgba(hex, alpha) {
    var r = parseInt(hex.slice(1,3), 16);
    var g = parseInt(hex.slice(3,5), 16);
    var b = parseInt(hex.slice(5,7), 16);
    return 'rgba(' + r + ',' + g + ',' + b + ',' + alpha + ')';
  }

  function extractHex(str) {
    var m = str && str.match(/#([0-9A-Fa-f]{6})\b/);
    return m ? m[0].toUpperCase() : null;
  }

  function rgbToHex(rgb) {
    var m = rgb.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
    if (!m) return null;
    return '#' + [m[1],m[2],m[3]].map(function(n) {
      return ('0' + parseInt(n).toString(16)).slice(-2).toUpperCase();
    }).join('');
  }

  // 1. Lấy màu brand từ GemPages inline styles
  function detectBrandColor() {
    var els = document.querySelectorAll('[style]');
    var colorCount = {};
    els.forEach(function(el) {
      var s = el.getAttribute('style') || '';
      ['--bc:', '--bgc:', '--bgc-mobile:'].forEach(function(prop) {
        var idx = s.indexOf(prop);
        if (idx === -1) return;
        var chunk = s.slice(idx + prop.length, idx + prop.length + 20);
        var hex = extractHex(chunk);
        if (hex && isValidColor(hex)) {
          colorCount[hex] = (colorCount[hex] || 0) + 1;
        }
      });
    });
    var top = null, max = 0;
    Object.keys(colorCount).forEach(function(hex) {
      if (colorCount[hex] > max) { max = colorCount[hex]; top = hex; }
    });
    return (top && max >= 2) ? top : null;
  }

  // 2. Lấy màu từ button thật trên page (bg + text)
function detectButtonColors() {
  // GemPages button dùng --bg và --c trong inline style
  var gpBtns = document.querySelectorAll('.gp-button-base, [class*="gp-button"]');
  
  for (var i = 0; i < gpBtns.length; i++) {
    var btn = gpBtns[i];
    var s   = btn.getAttribute('style') || '';

    // Đọc --bg
    var bgMatch  = s.match(/--bg:\s*(#[0-9A-Fa-f]{6})/);
    // Đọc --c
    var txtMatch = s.match(/--c:\s*(#[0-9A-Fa-f]{6})/);

    if (bgMatch && isValidColor(bgMatch[1])) {
      return {
        bg  : bgMatch[1].toUpperCase(),
        text: txtMatch ? txtMatch[1].toUpperCase() : '#FFFFFF'
      };
    }
  }

  // Fallback: đọc computed style
  var fallbackBtn = document.querySelector('.gp-button-base');
  if (fallbackBtn) {
    var cs    = getComputedStyle(fallbackBtn);
    var bgHex = rgbToHex(cs.backgroundColor);
    var txHex = rgbToHex(cs.color);
    if (bgHex && isValidColor(bgHex)) {
      return { bg: bgHex, text: txHex || '#ffffff' };
    }
  }

  return null;
}
  // 3. Lấy màu text từ heading thật trên page
  function detectHeadingColor() {
    var selectors = ['h1', 'h2', '.product__title', '[class*="product-title"]'];
    for (var i = 0; i < selectors.length; i++) {
      var el = document.querySelector(selectors[i]);
      if (!el) continue;
      var cs  = getComputedStyle(el);
      var hex = rgbToHex(cs.color);
      if (hex && !/^#(ffffff|FFFFFF)$/i.test(hex)) return hex;
    }
    return '#111111'; // fallback
  }

  function applyColors(brandColor, btnBg, btnText, cardText) {
    // Brand → border + radio accent
    ['--im8-red', '--im8-maroon', '--im8-border-active']
      .forEach(function(v) { wrapper.style.setProperty(v, brandColor); });

    // Button → lấy từ ATC button thật
    wrapper.style.setProperty('--im8-btn-bg',   btnBg);
    wrapper.style.setProperty('--im8-btn-text',  btnText);

    // Card text → lấy từ heading thật
    wrapper.style.setProperty('--im8-text-primary',   cardText);
    wrapper.style.setProperty('--im8-text-secondary', hexToRgba(cardText, 0.6));
    wrapper.style.setProperty('--im8-text-muted',     hexToRgba(cardText, 0.35));

    console.log('[im8] brand:', brandColor, '| btn-bg:', btnBg, '| btn-text:', btnText, '| card-text:', cardText);
  }

  function run() {
    var brandColor  = detectBrandColor()    || '#3A5A40';
    var btnColors   = detectButtonColors();
    var btnBg       = btnColors ? btnColors.bg   : brandColor;
    var btnText     = btnColors ? btnColors.text  : '#ffffff';
    var cardText    = detectHeadingColor();
    applyColors(brandColor, btnBg, btnText, cardText);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() { setTimeout(run, 300); });
  } else {
    setTimeout(run, 300);
