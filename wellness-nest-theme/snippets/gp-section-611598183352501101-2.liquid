      <style id="custom-css-gyt1qsfh7p">
        
/* ── Design Tokens ──────────────────────────────────────────────────── */
.im8-variant-selects-wrapper {
  --im8-red: #3A5A40;
  --im8-maroon: #3A5A40;
  --im8-border-warm: #e1cbb9;
  --im8-text-primary: #3A5A40;
  --im8-text-secondary: rgba(80, 0, 11, 0.6);
  --im8-text-muted: rgba(80, 0, 11, 0.35);
  --im8-border-active: #3A5A40;
  --im8-shadow-sm:
    0 2px 8px rgba(80, 0, 11, 0.04), 0 1px 2px rgba(0, 0, 0, 0.03);
  --im8-shadow-md:
    0 4px 16px rgba(80, 0, 11, 0.08), 0 1px 3px rgba(0, 0, 0, 0.04);
  --im8-ease-out: cubic-bezier(0.22, 1, 0.36, 1);
  --im8-radius-lg: 14px;
    font-family: "PPNeueMontreal", -apple-system, BlinkMacSystemFont, sans-serif !important;

  color: var(--im8-text-primary) !important;
  width: 100% !important;
}

.im8-variant-selects-wrapper *,
.im8-variant-selects-wrapper *::before,
.im8-variant-selects-wrapper *::after {
  box-sizing: border-box !important;
}

.im8-variant-selects-wrapper fieldset {
  border: none !important;
  margin: 0 0 24px !important;
  padding: 0 !important;
}

.im8-variant-selects-wrapper .vs-label {
  font-size: 15px !important;
  font-weight: 700 !important;
  color: var(--im8-text-primary) !important;
  margin-bottom: 12px !important;
  display: block !important;
}

/* ── Flavor Dropdown ────────────────────────────────────────────────── */
.im8-flavor-dropdown {
  position: relative !important;
  width: 100% !important;

  z-index: 10 !important;
  overflow: hidden !important;
}

.im8-flavor-dropdown.is-expanded {

  z-index: 20 !important;
  overflow: visible !important;
}

.im8-flavor-dropdown.is-expanded .im8-flavor-dropdown__trigger {
  border-color: var(--im8-border-active) !important;
  border-radius: var(--im8-radius-lg) var(--im8-radius-lg) 0 0 !important;
  box-shadow: none !important;
}

.im8-flavor-dropdown .im8-flavor-dropdown__trigger:hover {

  border-color: rgba(80, 0, 11, 0.25) !important;
  box-shadow: var(--im8-shadow-md) !important;
}

.im8-flavor-dropdown__trigger {
  display: flex !important;
  align-items: center !important;
  padding: 0 16px 0 0 !important;
  gap: 14px !important;
  min-height: 80px !important;
  cursor: pointer !important;
  user-select: none !important;
  border: 1px solid var(--im8-border-warm) !important;
  border-radius: var(--im8-radius-lg) !important;
  background: #fff !important;
  box-shadow: var(--im8-shadow-sm) !important;
  transition:
    border-color 0.3s var(--im8-ease-out),
    box-shadow 0.3s var(--im8-ease-out),
    border-radius 0.3s ease !important;
}

.im8-flavor-dropdown__thumb {
  width: 80px !important;
  height: 80px !important;
  border-radius: var(--im8-radius-lg) 0 0 var(--im8-radius-lg) !important;
  object-fit: cover !important;
  object-position: center !important;
  flex-shrink: 0 !important;
}

.im8-flavor-dropdown.is-expanded .im8-flavor-dropdown__thumb {
  border-bottom-left-radius: 0 !important;
}

.im8-flavor-dropdown__selected-info {
  flex: 1 !important;
  min-width: 0 !important;
  padding: 4px 0 !important;
}

.im8-flavor-dropdown__selected-name {
  font-size: 16px !important;
  font-weight: 700 !important;
  color: var(--im8-text-primary) !important;
  line-height: 1.3 !important;
  letter-spacing: -0.02em !important;
  display: flex !important;
  align-items: center !important;
  gap: 10px !important;
  flex-wrap: wrap !important;
}

.im8-flavor-dropdown__selected-sub {
  font-size: 13px !important;
  color: var(--im8-text-secondary) !important;
  margin-top: 2px !important;
}

.im8-flavor-dropdown__chevron {
  width: 20px !important;
  height: 20px !important;
  flex-shrink: 0 !important;
  transition: transform 0.35s var(--im8-ease-out) !important;
  color: var(--im8-text-muted) !important;
}

.im8-flavor-dropdown.is-expanded .im8-flavor-dropdown__chevron {
  transform: rotate(180deg) !important;
  color: var(--im8-text-secondary) !important;
}

.im8-flavor-dropdown__options {
  position: absolute !important;
  top: 100% !important;
  width: 100% !important;
  max-height: 0 !important;
  overflow: hidden !important;
  opacity: 0 !important;
  pointer-events: none !important;
  background: #fff !important;
  border: 1px solid transparent !important;
  border-top: none !important;
  border-radius: 0 0 var(--im8-radius-lg) var(--im8-radius-lg) !important;
  transition:
    max-height 0.35s var(--im8-ease-out),
    opacity 0.25s ease !important;
  z-index: 20 !important;
}

.im8-flavor-dropdown.is-expanded .im8-flavor-dropdown__options {
  max-height: 500px !important;
  opacity: 1 !important;
  pointer-events: auto !important;
  border-color: var(--im8-border-active) !important;
  box-shadow:
    0 16px 48px rgba(80, 0, 11, 0.16),
    0 4px 12px rgba(0, 0, 0, 0.05) !important;
}

.im8-flavor-dropdown__option {
  display: flex !important;
  align-items: center !important;
  gap: 14px !important;
  padding: 0 16px 0 0 !important;
  cursor: pointer !important;
  transition: background 0.2s ease !important;
  min-height: 76px !important;
  overflow: hidden !important;
  border-top: 1px solid rgba(80, 0, 11, 0.05) !important;
}

.im8-flavor-dropdown__option:last-child {
  border-radius: 0 0 var(--im8-radius-lg) var(--im8-radius-lg) !important;
}

.im8-flavor-dropdown__option:hover {
  background: rgba(80, 0, 11, 0.035) !important;
}

.im8-flavor-dropdown__option.is-selected {
  background: rgba(164, 0, 17, 0.06) !important;
}

.im8-flavor-dropdown__option-thumb {
  width: 76px !important;
  height: 76px !important;
  object-fit: cover !important;
  flex-shrink: 0 !important;
}

.im8-flavor-dropdown__option:last-child .im8-flavor-dropdown__option-thumb {
  border-bottom-left-radius: var(--im8-radius-lg) !important;
}

.im8-flavor-dropdown__option-info {
  flex: 1 !important;
  min-width: 0 !important;
}

.im8-flavor-dropdown__option-name {
  font-size: 15px !important;
  font-weight: 600 !important;
  color: var(--im8-text-primary) !important;
  display: flex !important;
  align-items: center !important;
  gap: 8px !important;
}

.im8-flavor-dropdown__check {
  width: 20px !important;
  height: 20px !important;
  flex-shrink: 0 !important;
  color: transparent !important;
  transition: color 0.2s ease !important;
}

.im8-flavor-dropdown__option.is-selected .im8-flavor-dropdown__check {
  color: var(--im8-red) !important;
}

[data-flavor-radios] {
  display: none !important;
}

/* ── Plan Cards ─────────────────────────────────────────────────────── */
.plan-cards-wrapper {
  display: flex !important;
  flex-direction: column !important;
  gap: 10px !important;
  width: 100% !important;
  overflow: visible !important;
}

.plan-card {
  position: relative !important;
  border-radius: 10px !important;
  border-color: rgba(80, 0, 11, 0.12) !important;
  background: transparent !important;
  box-shadow: none !important;
  padding: 14px 16px !important;
  cursor: pointer !important;
  border: 1px solid #3A5A40 !important;
  overflow: visible !important;
  transition: background 0.18s, box-shadow 0.18s !important;
}

.plan-card.selected {
  background: linear-gradient(120deg, rgb(234 245 238 / 80%) 0%, rgb(237 255 237 / 60%) 100%) !important;
  box-shadow:0 4px 12px 0 rgb(0 164 33 / 15%) !important;
  border-color: #3A5A40 !important;
  opacity: 0.85 !important;
