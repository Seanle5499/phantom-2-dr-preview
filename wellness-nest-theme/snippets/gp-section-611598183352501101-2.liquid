function isZeroDecimal(c) {
  return ZERO_DECIMAL_CURRENCIES.indexOf(c.toUpperCase()) !== -1;
}

function fmt(shopifyCents) {
  var currency = activeCurrency();
  var amount   = shopifyCents / 100;
  var decimals = isZeroDecimal(currency) ? 0 : 2;
  try {
    return new Intl.NumberFormat(navigator.language || 'en-US', {
      style: 'currency', currency: currency,
      minimumFractionDigits: decimals, maximumFractionDigits: decimals
    }).format(amount);
  } catch (e) { return amount.toFixed(decimals) + ' ' + currency; }
}

function fmtShort(shopifyCents) {
  var currency = activeCurrency();
  var amount   = shopifyCents / 100;
  try {
    return new Intl.NumberFormat(navigator.language || 'en-US', {
      style: 'currency', currency: currency,
      minimumFractionDigits: 0, maximumFractionDigits: 0
    }).format(amount);
  } catch (e) { return amount.toFixed(0) + ' ' + currency; }
}

function fmtPerDay(shopifyCents, days) {
  if (!days) return "";
  return fmt(shopifyCents / days);
