    const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']; // Thêm các tên tháng vào mảng
    date.setDate(date.getDate() + plus);
    const d = date.getDate();
    const m = dayOfWeek[date.getDay()]; // Lấy thứ từ mảng
    const mm = monthNames[date.getMonth()]; // Lấy tên tháng từ mảng
    return '' + m + ', ' + d + ' ' + mm; // Trả về định dạng mới
}

