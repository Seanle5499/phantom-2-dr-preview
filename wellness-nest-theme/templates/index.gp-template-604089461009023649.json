        "ggLyvPCbPlU_text": "<p>Dr. James DiNicolantonio</p>",
        "ggOf1pwJCaC_text": "<p>Dr. Jeremy London</p>",
        "ggY9O9OACyJ_text": "<p>Cardiovascular Research Scientist and Doctor of Pharmacy</p>",
