        "ggcNGo54FeJ_text": "<p>Dr. Darshan Shah</p>",
        "ggf9WOtpgBO_text": "<p>Board Certified Surgeon & Physician, CEO and Founder of Next Health</p>",
        "ggfdiNyRKiw_text": "<p>Board Certified Cardiovascular Surgeon</p>",
        "ggfl3_EkgUk_text": "<p>Dr. Dawn Mussallem</p>",
        "gghPfVqGXL4_text": "<p>Dr. James L. Green</p>",
        "gglxBfv8q8M_text": "<p>Dr. Ara Suppiah</p>",
        "ggyENLqCkyi_text": "<p>Double-Board Certified Physician & Host of Podcast \"Save Yourself\"</p>"
