    "gp_section_604089461160215201": {
      "settings": {
        "checksum": "639e9fbafb6924e6e53a7fe58772bb27b232ce980ca4d392a3804dd3fae565e0_1_1_0_0__1",
        "ggHC93qZ0K8_text": "<p>FAQs</p>",
        "ggHT0jYsk9f_text": "<p>Yes! IM8 Daily Ultimate Essentials is vegan, gluten-free, allergen-free, contains no artificial flavors, no added sugar, and no artificial sweeteners. It is NSF Certified for Sport and suitable for most dietary needs.</p>",
        "ggLfoKz2Qoz_text": "<p>Daily Ultimate Essentials has a refreshing acai and mixed berry flavor that our customers love. It mixes easily with cold water and is something you will look forward to drinking every morning.</p>",
        "ggPLmFSuk68_title": "How does the subscription work?",
        "ggf4naSQtTi_text": "<p>Our subscribe-and-save option delivers IM8 to your door on a regular schedule at a discounted price. You can update, pause, or cancel your subscription at any time with no commitment. All subscriptions include free shipping.</p>",
        "ggk_gaPqBQE_title": "What does Daily Ultimate Essentials taste like?",
        "ggt0xS917sT_title": "What are the main benefits of IM8 Daily Ultimate Essentials?",
        "ggtby47k8e5_text": "<p>IM8 Daily Ultimate Essentials delivers 92 nutrient-rich ingredients that support five key areas of health: energy, digestion, immunity, sleep, and mental clarity. It replaces up to 16 individual supplements with one convenient, delicious daily drink that is clinically proven and third-party tested.</p>",
        "ggtxM3JsICG_text": "<p>Most users report noticeable improvements in energy and digestion within the first week. For comprehensive benefits including improved sleep, immune support, and mental clarity, we recommend consistent daily use for 4-8 weeks.</p>",
        "ggvh8uiKQsF_title": "Is it suitable for dietary restrictions?",
        "ggwAIyGIs7h_title": "How soon will I notice results?"
      },
