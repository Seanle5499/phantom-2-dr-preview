        "ggyzO0s4Gar_text": "<p><strong>LA DIFFERENZA</strong></p>",
        "ggTetDGzBBM_text": "<strong>il nostro comitato medico consultivo</strong><br><span style=\"background-color:rgba(189, 229, 34, 0.77);\"><i><strong>che lo testa in prima persona</strong></i></span>",
        "ggN0q80cPLb_text": "<p><span style=\"font-size:px;\">\"La differenza tra FusiForce e la maggior parte delle caramelle alla creatina sul mercato sta nel protocollo di analisi. Testano il prodotto finito — dopo la cottura — che è l'unico modo per sapere cosa stai realmente assumendo. Il nostro laboratorio ha analizzato centinaia di integratori. Questo è uno dei pochi che mantiene costantemente ciò che l'etichetta promette.\"</span></p>",
        "ggkKMuAPIeJ_text": "<p><strong>Dr. Rajesh Sharma, Direttore del Controllo Qualità</strong></p><p><span style=\"font-size:14px;\">Laboratorio ISO 17025 | Oltre 15 anni di esperienza</span></p>",
        "ggXDiaR9PQt_text": "<p><span style=\"font-size:px;\"><strong>&nbsp;Dr. Rajesh Sharma, Direttore del Controllo Qualità</strong></span></p>",
        "ggjWegnkXuS_text": "<p><strong>RESPONSABILE RICERCA • UNIVERSITÀ DI OXFORD</strong></p>",
