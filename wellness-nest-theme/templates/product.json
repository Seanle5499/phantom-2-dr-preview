        "ggYjQcpRhBH_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0810/1563/6283/files/8_4.webp?v=1771829420",
        "ggYjQcpRhBH_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0810/1563/6283/files/7_3.webp?v=1771829408",
        "ggScGY3v75Q_text": "<p><strong>I Bought It for Testosterone. I Stayed for the Sleep.</strong></p>",
