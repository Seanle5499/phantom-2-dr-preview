        "ggg4rPagTxm_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0810/1563/6283/files/9_6.webp?v=1771829434",
        "ggg4rPagTxm_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0810/1563/6283/files/9_6.webp?v=1771829434",
        "ggkAmWUNobt_text": "<p><strong>Two Weeks In and I Wasn't Looking Back</strong></p>",
