        "checksum": "1175685e61c17644545f1daae167ded561bb2ee9479a90782fb1afb07b434bc7_1_1_1_0__1",
        "ggyzO0s4Gar_text": "<p><strong>THE DIFFERENCE</strong></p>",
        "ggTetDGzBBM_text": "<strong>meet our medical advisory board</strong><br><span style=\"background-color:rgba(189, 229, 34, 0.77);\"><i><strong>who actually test it</strong></i></span>",
        "ggN0q80cPLb_text": "<p><span style=\"font-size:px;\">\"The difference between FusiForce and most creatine gummies on the market is the testing protocol. They test the finished product — after cooking — which is the only way to know what you're actually getting. Our lab has tested hundreds of supplements. This is one of the few that consistently delivers what the label promises.\"</span></p>",
        "ggkKMuAPIeJ_text": "<p><strong>Dr. Rajesh Sharma, Director of Quality Assurance</strong></p><p><span style=\"font-size:14px;\">ISO 17025 Laboratory | 15+ Years Experience</span></p>",
        "ggXDiaR9PQt_text": "<p><span style=\"font-size:px;\"><strong>&nbsp;Dr. Rajesh Sharma, Director of Quality Assurance</strong></span></p>",
        "ggjWegnkXuS_text": "<p><strong>RESEARCH LEAD • UNIVERSITY OF OXFORD</strong></p>",
        "ggvugp_JOgb_text": "<p><strong>Dr. Latt Mansor, PhD</strong></p>",
