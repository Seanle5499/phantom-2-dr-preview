    "gp_section_610324367825568556": {
      "settings": {
        "checksum": "a54e97875cd34c0266a9bbf20a8d329aeeed9e183b740948f36a6582be33075e_1_1_1_0__1",
        "gg-Zky-YmOX_text": "<p>První kreatinový gumový bonbón v individuálních porcovaných sáčcích. Hoďte do tašky na posilovnu. Žádné sklenice. Žádný nepořádek. Žádné slepené hrudky.</p>",
        "gg2f4Wile8h_childItem_0": "<p>137 235+ spokojených zákazníků</p>",
        "gg39FXDVGf0_text": "Odvětví",
        "gg7poJKx0FO_text": "Náš standard",
        "ggA0QLTPCKQ_text": "<span style=\"color:rgb(58,90,64);\"><strong>67% of Creatine Gummies Contain Virtually No Creatine. </strong></span><span style=\"background-color:rgba(189,229,34,0.77);color:rgb(58,90,64);\"><i><strong>Here’s How We Proved FusiForce Is Different</strong></i></span>",
        "ggHJ7LFm4lL_text": "<p><strong>Jiní zakladatelé byli přistiženi při prodeji gumáků bez kreatinu a svalili vinu na dodavatele. My jsme vybudovali značku, která nikdy nepotřebuje výmluvy.</strong></p><p><br>Trvalo 10 měsíců zdokonalit kreatin monohydrát nejvyšší čistoty s Panax Ginsengem (10 % ginsenosidů). Kreatin se teplem rozkládá na bezcenný kreatinin — většina značek neprojde laboratorními testy. My jsme to vyřešili.</p><p><br>Prověřili jsme 50+ výrobců, vybrali toho nejpřísnějšího a nyní kontrolujeme každou šarži po výrobě přes laboratoře ISO 17025.</p><p>&nbsp;</p><p><a href=\"#g3wTy8wfqJ\"><strong><u>Výsledek: 99% čistota. Plných 5 000 mg ve 3 bonbónech. Každá zpráva zveřejněna.</u></strong></a></p>",
        "ggSNBDKHLrM_childItem_0": "<p>DOPRAVA ZDARMA nad 1600 Kč</p>",
        "ggTMEn_vDHT_text": "<p>Testováno po výrobě, ne před ní. Vzájemné audity s naším výrobcem. Plná klinická dávka 5g + standardizovaný Panax Ginseng.</p>",
        "ggVtdbmYxsK_text": "Naše inovace",
        "ggXlbhOQz8n_label": "<p>VYZKOUŠEJTE FUSIFORCE JEŠTĚ DNES!</p>",
        "ggb9UVdlMg9_text": "Jsme značka č. 1 v transparentních kreatinových gumových bonbónech v USA",
        "gggmvKAuMbQ_childItem_0": "<p>90denní záruka vrácení peněz</p>",
        "ggo_DvKcLxs_text": "<p>8 z 10 nejprodávanějších značek na Amazonu neprošlo. 3 neobsahovaly žádný kreatin. Jedna dodala pouhých 0,5 % z údaje na etiketě.</p>",
        "ggxkV_cka-Q_childItem_0": "<p>Zákaznická podpora 24/7</p>"
