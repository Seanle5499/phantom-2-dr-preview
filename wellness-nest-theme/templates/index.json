        "gg5uvepsbnp_text": "<p>10,000+ Verified Customers · Lab Reports on Every Batch</p>",
        "ggJbZtCdLJq_text": "<p>Premium<br>Supplements.</p>",
        "gg9gsDxbsP6_text": "<p>Published Proof.</p>",
        "ggobdtBm6DK_text": "<p>Every formula is founder-tested, third-party verified, and<br>backed by lab reports you can actually read. No<br>proprietary blends. No hidden doses.</p>",
        "ggyMPi5R23V_label": "<p><span style=\"font-size:px;\"><strong>Shop now</strong></span></p>",
        "ggOBB0bz3f6_text": "<p>Every Batch Tested</p>",
        "gg6Mjbuqv01_text": "<p>Lab Reports Published&nbsp;</p>",
        "gg0j6Jpkv3d_text": "<p>Founder-Tested Formulas</p>"
      }
