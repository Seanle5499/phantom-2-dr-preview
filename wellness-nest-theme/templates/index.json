        "section_preload": "true",
        "checksum": "a84dbb7e32be677231a1a7f797d6800cc21c045d170d8464fbb10cd6f1534010_1_1_1_0__1",
        "ggK-BDyMZiW_text": "<p>The Transparency Test</p>",
        "ggSkvsdFAod_text": "67% of Brands Hide&nbsp;What's Inside.",
        "ggQxLKEfTkb_text": "Here's What Honesty&nbsp;Looks Like.",
        "ggluKmhgQbY_text": "<p>Watch real customers react to seeing third-party lab reports for<br>the first time. No scripts. No actors. Just genuine surprise that a<br>brand would be this transparent.</p>",
        "gg3Na18dVxq_text": "<p><strong>Margaret T</strong></p>",
        "ggcXJJk38tF_text": "<p><i>Retired teacher, 64</i></p>",
        "ggJtPgQVj0x_text": "<p><strong>Margaret T</strong></p>",
