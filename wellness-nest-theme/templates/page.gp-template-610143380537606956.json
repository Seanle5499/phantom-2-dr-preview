        "ggWoAV_rxKV_text": "<p>James K.&nbsp;</p>",
        "ggiMNj71_P6_text": "<p>„Výrazně silnější a setrvalá erekce. Energie srší taky pořád.“&nbsp;</p>",
        "ggCg3PiUx1H_text": "<p>Steve T.</p>",
        "ggNA2HROGTw_text": "<p>„Když to vzal třetí týden. Opravdu vše vzalo radikální obrat.“</p>",
        "gg4-hffOEzl_text": "<p>Robert M.</p>",
