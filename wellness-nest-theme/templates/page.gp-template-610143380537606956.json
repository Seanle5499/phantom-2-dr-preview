    "gp_section_610143380705379116": {
      "type": "gp-section-610143380705379116",
      "settings": {
        "checksum": "34e952276f764455b0539ed30f623e3d97dc05e34f0ad298fad236959cab9c18_1_1_1_0__1",
        "ggtflqsmf7q_text": "<p>137 235+ Osob • Hodnoceno na 4.9 / 5 • 🔬 2 Obhajovací listy nad Klinikou</p>",
        "ggMZbYF5JOg_text": "<p>Na skladě je: Míň jako 847 ze sady očíslené 20000</p>",
        "ggqB-m5AOVp_text": "Výpisový dokument přes Test-Kliniky. Odpovedá to zbarvené a tuhé Pryskyřice Pravdy",
        "ggDWucH4ekv_text": "<p>Dílo Himálaje přes ShilaSource Osobní Formu | Obsáhlík dné = 30-ti Vydrž </p>",
        "ggG3JV9czK3_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0810/1563/6283/files/Frame_1000003454_1.webp",
        "ggG3JV9czK3_srcSet_tablet_src": "https://wellnessnest.co/cdn/shop/files/Frame_1000003454_1.webp?v=11705192227762507153",
        "ggG3JV9czK3_srcSet_mobile_src": "https://wellnessnest.co/cdn/shop/files/Frame_1000003454_1.webp?v=11705192227762507153",
        "ggQ3bIJsgmY_childItem_0": "<p>Doprava ZDARMA nad 1600 Kč</p>",
        "ggaTQloba7M_childItem_0": "<p>Zákaznický servis 24/7</p>",
        "ggNga6nKeUf_childItem_0": "<p>90denní záruka vrácení peněz</p>",
        "gglm4h3B7z-_childItem_0": "<p>Přez 137 235+ spokojených zákazníků</p>",
        "gg-4pbMLg83_text": "<p>\"Pracuji na noční směny. ShilaSource mi dal mnohem lepší regeneraci a konečně zase nabírám svaly. Laboratorní zprávy dokazují, že ShilaSource je nejčistší dávka. Kolegové se pořád ptají, proč vypadám tak svěže.\"&nbsp;</p>",
        "ggUDGrq2jHQ_srcSet_desktop_src": "https://placehold.co/225x225?text=Image",
        "ggUDGrq2jHQ_srcSet_mobile_src": "https://wellnessnest.co/cdn/shop/files/images_3.jpg?v=283900107939848332&width=552",
        "gg7RU-6FcEB_text": "<p><strong>Tomáš, 42, Praha </strong>- <span style=\"font-size:14px;\">Ověřený Zákazník</span></p>",
        "ggUicUSIOPB_text": "<p>\"Já i můj manžel je teď bereme oba. Jsme silnější, rychleji se zotavujeme a máme víc zábavy v posilovně. Říkáme jim naše 'bonbóny šťastného páru' — nejlepší návyk tohoto roku.\"&nbsp;</p>",
        "ggpWpPTLGvh_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0810/1563/6283/files/21_28b289b5-27ca-40c1-a490-9097c5463a35.webp",
        "ggpWpPTLGvh_srcSet_tablet_src": "https://cdn.shopify.com/s/files/1/0810/1563/6283/files/21_28b289b5-27ca-40c1-a490-9097c5463a35.webp",
        "ggpWpPTLGvh_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0810/1563/6283/files/21_28b289b5-27ca-40c1-a490-9097c5463a35.webp",
        "ggmYs4044F2_text": "<p><strong>Petra, 38, Brno &nbsp;</strong>- <span style=\"font-size:14px;\">Ověřený Zákazník</span></p>",
        "ggZBuXQFPYq_text": "<p>\"V 51 letech jsem si myslel, že shilajit je mýtus. Tato pryskyřice mi dokázala opak. Zvedám váhy, kterých jsem se roky nedotkl, a zotavuji se rychleji. Můj doktor se ptal, co dělám jinak. Řekl jsem mu 'magická černá pryskyřice jménem shilajit'. Zapsal si to.\"</p>",
        "ggglvLyVsQm_srcSet_desktop_src": "https://placehold.co/225x225?text=Image",
        "ggglvLyVsQm_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0810/1563/6283/files/images_4.jpg",
        "ggpXN6qjIJb_text": "<p><strong>Martin, 51, Ostrava </strong>- <span style=\"font-size:14px;\">Ověřený Zákazník</span></p>",
        "ggmFoHPRrc6_text": "<p>\"Po 12 letech tréninku jsem narazil na plató. Tato pryskyřice ho prolomila. Každý týden přidávám váhu a moje tréninky jsou zase silné. Můj parťák z posilovny je naštvaný, protože progresuji rychleji než on. Jen mu říkám, ať zkusí gummies.\"&nbsp;</p>",
        "ggVGESRbw0y_srcSet_desktop_src": "https://placehold.co/201x251?text=Image",
        "ggVGESRbw0y_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0810/1563/6283/files/images_2_6e26bcf2-66b0-4fb3-8b40-222b36885126.jpg",
        "ggw4z1_UBWp_text": "<p><strong>Jakub, 34, Plzeň </strong>- <span style=\"font-size:14px;\">Ověřený Zákazník</span></p>",
        "gg2KrqKHHay_text": "<p>\"Pracuji na noční směny. ShilaSource mi dal mnohem lepší regeneraci a konečně zase nabírám svaly. Laboratorní zprávy dokazují, že ShilaSource je nejčistší dávka. Kolegové se pořád ptají, proč vypadám tak svěže.\"&nbsp;</p>",
        "ggxgXx-XKA__srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0810/1563/6283/files/images_3.jpg",
        "ggxgXx-XKA__srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0810/1563/6283/files/images_3.jpg",
        "ggpw9Doaq3p_text": "<p><strong>Tomáš, 42, Praha </strong>- <span style=\"font-size:14px;\">Ověřený Zákazník</span></p>",
        "gg3jraTL9-k_text": "<p>\"Já i můj manžel je teď bereme oba. Jsme silnější, rychleji se zotavujeme a máme víc zábavy v posilovně. Říkáme jim naše 'bonbóny šťastného páru' — nejlepší návyk tohoto roku.\"&nbsp;</p>",
        "ggWw3yEBE6n_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0810/1563/6283/files/21_28b289b5-27ca-40c1-a490-9097c5463a35.webp",
        "ggWw3yEBE6n_srcSet_mobile_src": "https://placehold.co/1080x1080?text=Image",
        "ggfysjcnUmR_text": "<p><strong>Petra, 38, Brno &nbsp;</strong>- <span style=\"font-size:14px;\">Ověřený Zákazník</span></p>",
        "gg8xDLeONjE_text": "<p>\"V 51 letech jsem si myslel, že shilajit je mýtus. Tato pryskyřice mi dokázala opak. Zvedám váhy, kterých jsem se roky nedotkl, a zotavuji se rychleji. Můj doktor se ptal, co dělám jinak. Řekl jsem mu 'magická černá pryskyřice jménem shilajit'. Zapsal si to.\"&nbsp;</p>",
        "ggWdm12pme__srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0810/1563/6283/files/images_4.jpg",
        "ggWdm12pme__srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0810/1563/6283/files/images_4.jpg",
        "ggWFfyD0sAH_text": "<p><strong>Martin, 51, Ostrava </strong>- <span style=\"font-size:14px;\">Ověřený Zákazník</span></p>",
        "gg0pcqIRXjJ_text": "<p>\"Po 12 letech tréninku jsem narazil na plató. Tato pryskyřice ho prolomila. Každý týden přidávám váhu a moje tréninky jsou zase silné. Můj parťák z posilovny je naštvaný, protože progresuji rychleji než on. Jen mu říkám, ať zkusí gummies.\"&nbsp;</p>",
        "gg92qBh4swJ_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0810/1563/6283/files/images_2_6e26bcf2-66b0-4fb3-8b40-222b36885126.jpg",
        "gg92qBh4swJ_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0810/1563/6283/files/images_2_6e26bcf2-66b0-4fb3-8b40-222b36885126.jpg",
        "gg15DNM6dU__text": "<p><strong>Jakub, 34, Plzeň </strong>- <span style=\"font-size:14px;\">Ověřený Zákazník</span></p>"
      }
