    "gp_section_578423159384966017": {
      "settings": {
        "checksum": "6dfbb3fbc774e95a89dd3f66ccc789f2aa4786c5bcda74343333b1f0ec006e18_1_1_0_0__1",
        "ggA4LsDiTar_text": "Designed For <span style=\"color:#764293;\"><strong>MenoEase</strong></span>",
