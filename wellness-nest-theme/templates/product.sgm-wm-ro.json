    "testimonials_PP4p7x": {
      "type": "testimonials",
      "blocks": {
        "column_pQCAjm": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/gempages_501444340413891578-6333ccdf-ff00-47e4-a5cb-c6cedc04b7f7.png",
            "star_rating": 5,
            "title": "",
            "text": "<p>„A fi 'mai grea la mijloc' este una dintre principalele preocupări ale femeilor de peste 40 de ani. Formula Jeleurilor Shilajit pentru controlul grăsimii abdominale ajută femeile să arate și să se simtă grozav în cele mai noi stiluri, croieli și mărimi din butikurile lor preferate.\"</p>",
            "author": ""
          }
        },
        "column_pHThUz": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/2_4.webp",
            "star_rating": 5,
            "title": "",
            "text": "<p>„Fie că este vorba despre bufeuri, transpirații nocturne, schimbări de dispoziție, ceață cerebrală, energie scăzută sau alte probleme legate de fluctuațiile hormonale, Jeleurile Shilajit susțin în mod natural echilibrul corpului — pentru o viață mai fericită și mai sănătoasă.\"</p>",
            "author": ""
          }
        },
        "column_Vr3ChB": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/gempages_501444340413891578-7928b5a5-2c85-41dd-8a5c-c9145c978b96.png",
            "star_rating": 5,
            "title": "",
            "text": "<p>„Problemele digestive ocazionale după 40 de ani îi împiedică adesea pe femei să se bucure pe deplin de viață. Formula Jeleurilor Shilajit este concepută pentru a susține o digestie sănătoasă și a menține burtica calmă și fără disconfort.\"</p>",
            "author": ""
          }
        }
      },
