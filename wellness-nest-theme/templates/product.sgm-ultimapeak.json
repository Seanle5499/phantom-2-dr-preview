    "rich_text_ffpmqh": {
      "type": "rich-text",
      "blocks": {
        "heading_P7AQpd": {
          "type": "heading",
          "settings": {
            "title": "<strong>The 40+ Man's Secret to Staying Hard, Naturally</strong>",
            "title_highlight_color": "#53af01",
