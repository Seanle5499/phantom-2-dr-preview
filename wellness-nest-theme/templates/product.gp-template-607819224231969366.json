    "gp_section_607819224433820246": {
      "type": "gp-section-607819224433820246",
      "settings": {
        "checksum": "da47fa5910e1fa961e3b31a936d01b425b92aa8fb90333237ca6bf86267b3e50_1_1_1_0__1",
        "ggwkynPz5gr_text": "Why Your Bloating, Brain Fog &amp; Stalled Gains Are <span style=\"color:#3A5A40;\"><i>Actually Connected</i></span>",
        "ggR3mdbHPDa_text": "<p>You've been treating these as separate problems. A pre-workout for energy. Coffee for focus. Powder for gains.</p>",
        "ggOZSc3NBd4_text": "<p>But they all come down to one thing: <span style=\"color:#3A5A40;\"><strong>cellular energy (ATP).</strong></span></p>",
        "gg_59_N4D9X_text": "<p>Your body runs on ATP—every cell, every function. When ATP is depleted, everything suffers.</p>",
        "gg_i408sD_N_text": "<p><strong>Brain Fog</strong></p>",
        "ggU7ZAihc5B_text": "<p>Your brain uses 20% of your body's ATP for focus and clarity</p>",
        "ggTSvyHdogl_text": "<p><strong>Stalled Gains</strong></p>",
        "gg_NveHZYES_text": "<p>Muscles need ATP for protein synthesis and recovery</p>",
        "ggqyZZA_xOD_text": "<p><strong>Bloating</strong></p>",
        "ggUSj7qbrfx_text": "<p>Digestion requires ATP for proper gut function</p>",
        "ggMqVpLiBm1_text": "<p><strong>Low Energy</strong></p>",
        "ggKAtt-BbZj_text": "<p>Low ATP = your cellular battery is drained</p>"
      }
    },
