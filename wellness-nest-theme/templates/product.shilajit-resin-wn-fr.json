    "icon_bar_6wEb6x": {
      "type": "icon-bar",
      "blocks": {
        "column_NEnBRC": {
          "type": "column",
          "settings": {
            "icon": "Landscape 2",
            "filled_icon": false,
            "title": "Sélection des roches",
            "text": "<p>Des roches de Shilajit de qualité supérieure sont extraites à plus de 5 500 mètres d’altitude dans les montagnes de l’Himalaya.</p>"
          }
        },
        "column_X6HfPg": {
          "type": "column",
          "settings": {
            "icon": "Gradientrefreshcontent_copy",
            "filled_icon": false,
            "title": "Extraction",
            "text": "<p>Les roches sont broyées puis dissoutes dans l’eau afin de séparer les composants végétaux des résidus rocheux.</p>"
          }
        },
        "column_4HTQRd": {
          "type": "column",
          "settings": {
            "icon": "Filter Alt",
            "filled_icon": false,
            "title": "Filtration",
            "text": "<p> Le mélange est filtré plusieurs fois pour éliminer les impuretés, la poussière et les sédiments.</p>"
          }
        },
        "column_xQbwKw": {
          "type": "column",
          "settings": {
            "icon": "Labs",
            "filled_icon": false,
            "title": "Contrôle qualité",
            "text": "<p>Après filtration et séchage naturel, le Shilajit est <strong>analysé trois fois en laboratoire</strong> pour garantir sa pureté et sa sécurité.</p>"
          }
        }
      },
