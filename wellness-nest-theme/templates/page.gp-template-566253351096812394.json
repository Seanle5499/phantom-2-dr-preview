        "gg7YbHtGeov_text": "<p><strong>Still have questions?</strong></p>",
        "ggMHlXW4iey_text": "<p>Contact our support team at</p>",
        "ggBaadbbxRb_text": "<p>support@wellnessnest.co</p>",
        "ggX7ULk3Zmd_text": "<p>or check out our <strong>Help Center</strong> for more details We're here to help you conquer menopause naturally!</p>",
        "ggKkBZHcQ-B_text": "Dont Let Menopause Control Your Life",
        "gguLdqK4Jdj_label": "<p>Try MenoMate Now!</p>",
