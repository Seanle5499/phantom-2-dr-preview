    "gp_section_610324564756399058": {
      "type": "gp-section-610324564756399058",
      "settings": {
        "checksum": "056cf31cf2c482144b21b7a3e9459758dd5ab6abe31d8042282fe1df461bc84a_1_1_1_0__1",
        "ggyzO0s4Gar_text": "<p><strong>HET VERSCHIL</strong></p>",
        "ggTetDGzBBM_text": "<strong>maak kennis met onze medische adviesraad</strong><br><span style=\"background-color:rgba(189, 229, 34, 0.77);\"><i><strong>die het daadwerkelijk test</strong></i></span>",
        "ggN0q80cPLb_text": "<p><span style=\"font-size:px;\">\"Het verschil tussen FusiForce en de meeste creatine gummies op de markt is het testprotocol. Zij testen het eindproduct — na productie — wat de enige manier is om te weten wat je werkelijk krijgt. Ons lab heeft honderden supplementen getest. Dit is een van de weinige die consequent levert wat het etiket belooft.\"</span></p>",
        "ggkKMuAPIeJ_text": "<p><strong>Dr. Rajesh Sharma, Directeur Kwaliteitsborging</strong></p><p><span style=\"font-size:14px;\">ISO 17025 Laboratorium | 15+ Jaar Ervaring</span></p>",
