<script id="shila-scroll-depth">
(function(){
  var fired = {};
  var thresholds = [25, 50, 75, 100];
  function check(){
    var pct = Math.round(100 * (window.scrollY + window.innerHeight) / document.body.scrollHeight);
    for(var i = 0; i < thresholds.length; i++){
      var t = thresholds[i];
      if(pct >= t && !fired[t]){
        fired[t] = true;
        if(window.dataLayer) dataLayer.push({event:'scroll_depth', scroll_pct: t, page_type:'ageaura-advertorial'});
      }
    }
  }
  window.addEventListener('scroll', check, {passive:true});
  check();
})();
</script>


