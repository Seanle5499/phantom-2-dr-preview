<script id="funnel-route">
/* v32 Sprint 6 — Improved route() with UTM preservation + removed premature IC fire */
function route(e){
  if(e&&e.preventDefault) e.preventDefault();

  // Preserve UTMs + click-IDs in destination URL
  var qs = window.location.search;
  var dest = 'https://wellnessnest.co/pages/ageaura-pure-protocol';
  if (qs && qs.length > 1) dest += qs;

  // Fire engagement events only (no premature InitiateCheckout — that fires at real checkout)
  try { if(window.fbq) fbq('track','Lead', {content_name:'AgeAura Pure Protocol Advertorial CTA', content_category:'Longevity Advertorial'}); } catch(_e){}
  try { if(window.gtag) gtag('event','select_promotion', {promotion_name:'ageaura-advertorial-cta'}); } catch(_e){}
  try { if(window.dataLayer) dataLayer.push({event:'ageaura_cta_click', cta_destination:dest, page:'ageaura-av01-dr-marcus-hale'}); } catch(_e){}
  try { if(window.TriplePixel) TriplePixel('event','AdvertorialCTAClick',{page:'ageaura-av01-dr-marcus-hale'}); } catch(_e){}

  setTimeout(function(){ window.location.href = dest; }, 220);
}
</script>
