    "gp_section_610143325206348588": {
      "type": "gp-section-610143325206348588",
      "settings": {
        "checksum": "b3828df4d48ce4fe3f7dc13c1f71aa4e0ea547ecd591094539f9f5e7ae826cb9_1_1_1_0__1",
        "ggyzO0s4Gar_text": "<p><strong>Η ΔΙΑΦΟΡΑ</strong></p>",
        "ggTetDGzBBM_text": "<strong>γνωρίστε το ιατρικό μας συμβουλευτικό συμβούλιο</strong><br><i>οι οποίοι πραγματικά το δοκιμάζουν</i>",
        "ggN0q80cPLb_text": "<p><span style=\"font-size:px;\">\"Η διαφορά μεταξύ της ρητίνης ShilaSource Himalayan Shilajit και των περισσότερων Shilajit της αγοράς είναι το πρότυπο καθαρισμού. Φιλτράρουν τριπλά την ακατέργαστη ρητίνη και ελέγχουν για βαρέα μέταλλα, συγκέντρωση φουλβικού οξέος και μικροβιακή μόλυνση – σε κάθε παρτίδα. Το εργαστήριό μας έχει ελέγξει εκατοντάδες προϊόντα Shilajit. Αυτό είναι ένα από τα λίγα που αποδίδει σταθερά αυτά που υπόσχεται η ετικέτα.\"</span></p>",
        "ggkKMuAPIeJ_text": "<p><strong>Dr. Rajesh Sharma, Διευθυντής Διασφάλισης Ποιότητας</strong></p><p><span style=\"font-size:14px;\">Εργαστήριο ISO 17025 | 15+ Χρόνια Εμπειρίας</span></p>",
        "ggXDiaR9PQt_text": "<p><span style=\"font-size:px;\"><strong>&nbsp;Dr. Rajesh Sharma, Διευθυντής Διασφάλισης Ποιότητας</strong></span></p>",
        "ggjWegnkXuS_text": "<p><strong>ΕΠΙΚΕΦΑΛΗΣ ΕΡΕΥΝΑΣ • ΠΑΝΕΠΙΣΤΗΜΙΟ ΤΗΣ ΟΞΦΟΡΔΗΣ</strong></p>",
        "ggvugp_JOgb_text": "<p><strong>Dr. Latt Mansor, PhD</strong></p>",
        "ggMxJGU2fij_text": "<p><strong>ΒΙΟΧΗΜΙΚΟΣ • ΑΝΘΡΩΠΙΝΗ ΚΙΝΗΤΙΚΗ (HUMAN KINETICS)</strong></p>",
        "ggxM-hn15Yx_text": "<p><strong>Dr. Jeff Vogel, MD, MPH</strong></p>",
        "ggxlHNZDc-O_text": "<p><strong>ΠΙΣΤΟΠΟΙΗΜΕΝΟΣ ΕΙΔΙΚΟΣ • ΑΝΔΡΙΚΗ ΥΓΕΙΑ</strong></p>",
