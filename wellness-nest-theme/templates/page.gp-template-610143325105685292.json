    "gp_section_610143325223125804": {
      "type": "gp-section-610143325223125804",
      "settings": {
        "checksum": "5690e4fd4d4a135930a03198623314b94a7220530263093281169182569743b2_1_1_1_0__1",
        "ggbVQnotSp4_text": "γιατί shilasource;",
        "gg8zNdZFmPf_text": "Η Υγεία σας Μετράει<br><span style=\"background-color:rgba(189, 229, 34, 0.07);\"><i>Η Ποιότητα των Συμπληρωμάτων σας θα Έπρεπε Επίσης</i></span>",
        "ggKziR3Sz43_text": "<p><strong>ΡΗΤΙΝΗ SHILASOURCE HIMALAYAN SHILAJIT</strong></p>",
        "ggWdipz4xcl_childItem_0": "<p>Ρητίνη από τα Ιμαλάια, μίας προέλευσης</p>",
        "ggWdipz4xcl_childItem_1": "<p>75% επιβεβαιωμένο Φουλβικό Οξύ</p>",
        "ggWdipz4xcl_childItem_2": "<p>Τριπλός εργαστηριακός έλεγχος κάθε παρτίδας</p>",
        "ggWdipz4xcl_childItem_3": "<p>Μηδενικά υλικά πλήρωσης, καθόλου πρόσθετα</p>",
        "ggWdipz4xcl_childItem_4": "<p>Δημοσιευμένο Πιστοποιητικό Ανάλυσης (COA) για κάθε παρτίδα</p>",
        "ggWdipz4xcl_childItem_5": "<p>Σε φυσική μορφή ρητίνης = μέγιστη απορρόφηση</p>",
