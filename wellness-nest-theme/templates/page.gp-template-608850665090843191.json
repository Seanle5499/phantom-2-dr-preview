    "gp_section_609005024151864218": {
      "settings": {
        "checksum": "90a0cf1587ffadc98c6cd1dd7c33f40d54090a2bb44f2e0b9532b9125cec1214_1_1_1_0__1",
        "gIJVREupyJIuw_text": "Science-Backed Nutrition You Can Trust",
        "gSypsPnHFFXzL_text": "DAWN M.",
        "gg5RIZjGdcw_text": "<p><span style=\"color:rgb(112,113,112);font-size:px;\">Jamie F.</span></p>",
        "ggC0YRHfETw_text": "<p><strong>Beats AG1 in Taste and Results</strong></p>",
        "ggLcgOR3282_text": "<p><span style=\"font-size:px;\">In my 20's &amp; 30's I did triathlons. That's what attracted me to Nutrilite and XS. Building Amway filled my weekends and I stopped competing but just trained for fitness. I'm 2008 after stalling at Ruby my interest in Amway faded but not health and fitness.</span></p>",
        "ggOeVo2Epq5_text": "<p><span style=\"color:rgb(112,113,112);font-size:14px;\">Mark D.</span></p>",
        "ggZQujEgX0W_text": "<p><span style=\"font-size:px;\"><strong>There is something special about IM8.</strong></span></p>",
        "ggpIgVGpChw_text": "<p>I really wanted to love AG1, but let’s be honest—the taste is hard to get used to. IM8, on the other hand, tastes great and actually makes me feel more energized and focused. I didn’t think I’d notice a difference this fast!</p>",
        "gqbfAGjagTtRV_text": "<span style=\"font-size:px;\">6,000+ verified 5-star reviews*</span>",
        "gshrKynJKAaUS_text": "<p><span style=\"font-size:px;\">As a Mayo Clinic physician, I know nutrition is rooted in science. Access to quality supplements helps close the gaps in our diets.</span></p>"
      },
      "type": "gp-section-609005024151864218"
    },
