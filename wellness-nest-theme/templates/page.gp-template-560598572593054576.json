        "ggdT8X735_8_text": "<p>Phoenix, AZ</p>",
        "ggBfSRtuE_b_text": "Verified buyer",
        "ggr_5oZrrOQ_label": "<p>Try MenoMate Now!</p>",
        "gwpdmMKsubLaI_text": "<p>90-Day Money-back Guarantee</p>",
        "gpubOZkHVclLg_text": "<p>The Misdiagnosed Condition Robbing You of <span style=\"color:#A11CAD;\">Restful Sleep</span>: Why Your Doctor Missed It</p>",
        "ggZFPq6ksgY_text": "<strong>Gluteal Tendinopathy (GT)</strong>",
        "ggfBArEJbaN_text": "<p>affects nearly <strong>68% of women experiencing hip pain after 40</strong> — yet studies show it's correctly diagnosed less than 20% of the time.</p>",
        "ggYyBzGszRv_text": "<p>This progressive breakdown of hip tendons creates that familiar, deep ache that makes side-sleeping feel impossible and limits your daily activities without explanation.</p>",
        "ggqKUHbLgx2_text": "<p>Why Most Treatments Fail:&nbsp;</p><p>The Critical Difference <span style=\"color:#A11BAD;\">You Need to Know</span></p>",
        "ggq0sF66NVk_childItem_0": "<p><strong>Gluteal Tendinopathy</strong></p>",
        "ggq0sF66NVk_childItem_1": "<p>&nbsp; <strong>Arthritis</strong></p>",
        "ggmg-5mBkzO_text": "Where GT Pain Strikes",
        "gg9eM-k0dUw_text": "Where GT Pain Strikes",
        "ggjJ_Z65uUA_text": "<p>Penetrating discomfort radiating from deep within the hip, often extending down the outer thigh</p>",
        "ggeMTr2p5ga_text": "<p>Worsens when lying on your side</p>",
        "ggCJ2ejDaVI_text": "<p>Intensifies during prolonged sitting</p>",
        "ggfExmdo4Vb_text": "Where Arthritis Pain Occurs",
        "ggjNcM4lrTc_text": "Where Arthritis Pain Occurs",
        "gg9y81M3lxW_text": "<p>Concentrated in the groin region with morning stiffness</p>",
        "ggtiC1VW2sz_text": "<p>Usually worse with initial movement, then improves</p>",
        "ggd7o62f_r1_text": "<p>Typically most severe in the morning</p>"
      }
