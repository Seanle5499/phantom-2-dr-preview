    "gp_section_611895448222892634": {
      "type": "gp-section-611895448222892634",
      "settings": {
        "checksum": "8feb418e9447c4e778776323c324182e3c2fe40ed30de3e33df382b0023633f4_1_1_1_0__1",
        "ggQ2vuyc9Ry_text": "Ta Nejlepnšilší z US! ! z ShialiHimilaja !",
        "ggLnTF7QCwd_text": "Už stači le a jenída lyždika ze čistů!<br><i>a od štídlách z vědouci pódložené a na podlahované!</i>",
        "ggxZPkOdli8_text": "<p>Každé naše tvrzení se opírá o recenzované vědecké studie. Shilajit jsme nevymysleli — my z něj udělali ten nejlepší pro ženy.</p>",
        "ggpJcW0Ng_e_text": "<strong>93%</strong>",
        "ggymEDpVj1w_text": "<p>Koncentrace kyseliny fulvové ověřena nezávislými testy — patří mezi nejvyšší z komerčních přípravků na trhu.</p>",
        "ggCkvv_Eedz_text": "90 %",
        "ggTEUUdZqir_text": "<p>Žen v klinickém pozorování uvedlo snížení zánětu kloubů během 90 dnů suplementace látkama jako Shilajit.</p>",
        "gglE16Hu_iT_text": "98 %",
