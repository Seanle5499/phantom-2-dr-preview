        "ggyzO0s4Gar_text": "<p><strong>ROZDÍL</strong></p>",
        "ggTetDGzBBM_text": "<strong>Seznamte se s naší lékařskou radou</strong><br><i>která to vlastně testuje</i>",
        "ggN0q80cPLb_text": "<p><span style=\"font-size:px;\">\"Wellness Nest používá přesně ten stupeň čištění, o kterém jsem viděl, že přináší výsledky v klinických testech vstřebávání minerálů. Tyto medvídky Shilajit jsou skutečné.\"</span></p>",
        "ggkKMuAPIeJ_text": "<p><strong>Dr. Rajesh Sharma, ředitel zabezpečení kvality</strong></p><p><span style=\"font-size:14px;\">Laboratoř ISO 17025 | 15+ let zkušeností</span></p>",
        "ggXDiaR9PQt_text": "<p><span style=\"font-size:px;\"><strong>&nbsp;Dr. Rajesh Sharma, ředitel zabezpečení kvality</strong></span></p>",
        "ggjWegnkXuS_text": "<p><strong>VEDOUCÍ VÝZKUMU • UNIVERZITA V OXFORDU</strong></p>",
        "ggvugp_JOgb_text": "<p><strong>Dr. Latt Mansor, PhD</strong></p>",
