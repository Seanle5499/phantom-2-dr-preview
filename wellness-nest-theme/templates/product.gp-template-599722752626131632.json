    "gp_section_599731990060597795": {
      "type": "gp-section-599731990060597795",
      "settings": {
        "checksum": "aefa395c0bf1f7f4eb38fde655916bde5a5993d016844291e42cd29db1a4ad1a_1_1_1_0__1",
        "ggyOFZHcMNt_text": "<strong>Jak je „MenoBliss“ možný se Shilajit Gummies</strong>",
        "ggXmQbLVpBT_text": "<p><strong>Přirozená úleva od bolesti kloubů</strong></p>",
        "ggP9fKrmpss_text": "<p>Účinné protizánětlivé byliny jako zázvor, shilajit a ženšen pomáhají mírnit každodenní diskomfort, otoky a zlepšují hybnost. Ať jde o hormonální zánět nebo opotřebení věkem, tato formule podporuje plynulejší, přirozeně bezbolestný pohyb.</p>",
        "gg3adI4lC1F_text": "<p><strong>Zaměřeno na spalování tuku</strong></p>",
        "ggTGVThGJ1l_text": "<p>Konec boje s váhou po 30. Zázvor, černé mušlí a hormonálně vyrovnávající adaptogeny spalují tuky, zbavují otoků a dodávají energii - přirozeně, bez stimulantů.</p>",
        "ggnZF23Q8fX_text": "<p><strong>Přirozená hormonální podpora</strong></p>",
        "ggM8AQ2i0OE_text": "<p>Adaptogenní směs ašvagandy, kaunče a gokšury podporuje hormonální harmonii, snižuje stres a rozptyluje mentální mlhu. Je to přirozená cesta, jak získat zpět energii, emoční rovnováhu a vnitřní jistotu - bez syntetických hormonů.</p>"
      }
    },
