      "settings": {
        "checksum": "f6a7bc3a1358f9a510fcca08a3b6a87aa13c99a84f1367d56a83fdf02652db55_1_1_1_0__1",
        "ggtawWb3dla_text": "<strong>100% prémiový himálajský Shilajit: zlatý standard</strong>",
        "gg44D4-Athm_text": "<p><strong>Ověřený původ</strong> - 100% pravý shilajit s potvrzenými aktivními látkami</p>",
        "ggFRajk3VXW_text": "<p><strong>Čistý původ </strong>-<strong> </strong>Sklizeň výhradně z himálajských oblastí nad 5 500 m n. m.</p>",
