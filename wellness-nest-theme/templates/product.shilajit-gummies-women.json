          "type": "column",
          "settings": {
            "image": "shopify://shop_images/2_4.webp",
            "star_rating": 5,
            "title": "",
            "text": "<p>\"Be it hot flashes, night sweats, mood swings, brain fog, low energy, or any other menopause-related symptoms caused by hormonal fluctuations, Shilajit Gummies helps support the body in maintaining equilibrium naturally for a happier, healthier you.\"</p>",
            "author": ""
          }
        },
        "column_Vr3ChB": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/gempages_501444340413891578-7928b5a5-2c85-41dd-8a5c-c9145c978b96.png",
            "star_rating": 5,
            "title": "",
            "text": "<p>\"Occasional digestive issues after 40 often prevent women from enjoying life to the fullest. Shilajit Gummies’s formula is specially designed to support a healthy digestive system and keep the tummy calm and relaxed.\"</p>",
            "author": ""
          }
        }
