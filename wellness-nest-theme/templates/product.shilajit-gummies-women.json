          "settings": {
            "image": "shopify://shop_images/2_0c57197f-ab2c-461a-a7ba-b33c99234d15.png",
            "muted_autoplay": true,
            "title": "Natural Joint Pain Relief",
            "text": "<p>Joint aches and stiffness don’t have to slow you down. Potent anti-inflammatory herbs like <strong>Ginger</strong>, <strong>Shilajit</strong>, and <strong>Ginseng</strong> help ease everyday discomfort, reduce swelling, and improve mobility. Whether it’s hormonal inflammation or age-related wear, this formula supports smoother, pain-free movement—naturally.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_cTBzKX": {
          "type": "column",
