<body>
<style>html,body{margin:0;padding:0;}.loading{text-align:center;padding:80px 20px;color:#666;font-family:system-ui,sans-serif;}</style>
<script id="funnel-route">function route(e){if(e&&e.preventDefault)e.preventDefault();window.location.href='https://wellnessnest.co/products/shilasource-himalayan-shilajit-resin';}</script>
<div id="microplaque-body" class="loading">Loading content…</div>
<script id="microplaque-body-loader">
(function(){
  var base='//wellnessnest.co/cdn/shop/t/78/assets/';
  var chunks=['page.microplaque-v2-body-1.html','page.microplaque-v2-body-2.html','page.microplaque-v2-body-3.html','page.microplaque-v2-body-4.html'];
  Promise.all(chunks.map(function(f){return fetch(base+f).then(function(r){return r.text();});})).then(function(parts){
    var el=document.getElementById('microplaque-body');
    el.className='';
    el.innerHTML=parts.join('');
    el.querySelectorAll('script').forEach(function(oldS){
      var newS=document.createElement('script');
      Array.from(oldS.attributes).forEach(function(a){newS.setAttribute(a.name,a.value);});
      newS.text=oldS.text;
      oldS.parentNode.replaceChild(newS,oldS);
    });
    document.dispatchEvent(new Event('microplaque:loaded'));
  }).catch(function(err){
    document.getElementById('microplaque-body').innerHTML='<div style="padding:80px;text-align:center;color:#900">Failed to load: '+err.message+'</div>';
  });
})();
</script>
<script src="//wellnessnest.co/cdn/shop/t/78/assets/page.microplaque-v2-inline.js" defer></script>
</body>
