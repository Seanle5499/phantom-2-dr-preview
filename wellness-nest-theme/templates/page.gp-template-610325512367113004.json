        "ggL2ARKb-sl_text": "<p>Zeigten ein höheres Trainingsvolumen oder größere Leistungskapazität.</p>",
        "ggLnTF7QCwd_text": "<span style=\"color:#3A5A40;\">Lecker. Praktisch.</span><br><span style=\"background-color:rgba(189,229,34,0.77);color:#3A5A40;\"><i>Wissenschaftlich belegt.</i></span>",
