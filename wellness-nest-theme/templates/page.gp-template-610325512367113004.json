    },
    "gp_section_610325512467907372": {
      "settings": {
        "checksum": "fe0671c596e505782a41ac5262601cb60c9b48252e27361e1e460f4026a0185e_1_1_1_0__1",
        "ggP0T662fN1_text": "<p>*Diese Aussagen wurden nicht von der Food and Drug Administration geprüft. Dieses Produkt ist nicht dazu bestimmt, Krankheiten zu diagnostizieren, zu behandeln, zu heilen oder zu verhindern.</p>"
