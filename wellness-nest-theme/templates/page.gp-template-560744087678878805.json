        "gUpCPBscputuO_srcSet_desktop_src": "https://ucarecdn.com/ee6d5074-1640-4cc7-8933-47c8589c3dee/-/format/auto/",
        "gggUuiARdfW_text": "<p>I used to dread bedtime because of night sweats. Now, I actually look forward to resting I stay cool and wake up, energized!</p>",
        "ggbuVk0xxwh_srcSet_desktop_src": "https://ucarecdn.com/ee6d5074-1640-4cc7-8933-47c8589c3dee/-/format/auto/",
        "ggltsdkjaHM_text": "Donna s.",
