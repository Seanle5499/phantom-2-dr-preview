        "ggc-rNI65Ez_text": "Verified buyer",
        "gcZWVLbedZTXv_text": "<p><span style=\"color:#772B90;\"><strong>MenoMate</strong></span> balances hormones for healthy weight loss so you can:</p>",
        "gg53y8CdYfE_childItem_0": "<p><strong>Flatten Your Tummy</strong> - Ditch stubborn bloat</p>",
        "gg53y8CdYfE_childItem_1": "<p><strong>Feel Confident Showing Up Anywhere </strong>- No more hiding at home or wearing baggy sweats</p>",
