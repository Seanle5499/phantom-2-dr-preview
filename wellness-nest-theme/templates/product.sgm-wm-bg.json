    "multicolumn_8RDfDU": {
      "type": "multicolumn",
      "blocks": {
        "column_fJnqFM": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/1_24bae77c-2039-44b1-b95b-829a73b374a8.png",
            "muted_autoplay": true,
            "title": "Фокус върху изгарянето на мазнини",
            "text": "<p>Тази формула помага на жените над 30 да се борят с упоритото тегло чрез комбинация от активиращ метаболизма джинджифил и черен мусли, заедно с балансиращи хормоните адаптогени. Подкрепя здравословния метаболизъм на мазнините, намалява задържането на вода и осигурява постоянна енергия — без спадове и стимуланти, типични за други „мазнино-горители\".</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_JWbBNK": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/2_0c57197f-ab2c-461a-a7ba-b33c99234d15.png",
            "muted_autoplay": true,
            "title": "Естествено облекчение от ставни болки",
            "text": "<p>Ефективни противовъзпалителни билки като джинджифил, шиладжит и женшен помагат за облекчаване на ежедневния дискомфорт, подуването и подобряват подвижността. Независимо дали става въпрос за хормонално възпаление или износване с възрастта, тази формула подкрепя по-плавно, естествено безболезнено движение.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_cTBzKX": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/3_78630e42-da90-4cb6-9034-4e9796b01a7a.png",
            "muted_autoplay": true,
            "title": "Естествена хормонална подкрепа",
            "text": "<p>Адаптогенната смес от ашваганда, кауанче и гокшура подкрепя хормоналната хармония, намалява стреса и разсейва мъглявото съзнание. Това е естественият път да възвърнете енергията, емоционалния баланс и вътрешната увереност — без синтетични хормони.</p>",
            "link_label": "",
            "link": ""
          }
        }
      },
