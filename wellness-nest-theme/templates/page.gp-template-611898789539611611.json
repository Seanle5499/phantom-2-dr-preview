        "ggXDiaR9PQt_text": "<p><span style=\"font-size:px;\"><strong>&nbsp;Dr. Rajesh Sharma, Directeur de l'Assurance Qualité</strong></span></p>",
        "ggjWegnkXuS_text": "<p><strong>RESPONSABLE DE RECHERCHE • UNIVERSITÉ D'OXFORD</strong></p>",
