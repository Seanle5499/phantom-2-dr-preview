<script id="shila-empty-bullet-cleanup-v18">
/* ============================================================
   v18 ROOT-CAUSE FIX — Problem B (defense in depth)
   We removed the one known empty <li> in #ib00a8g (Last Resort)
   directly from the markup. But FunnelKonnekt funnels are full
   of similar placeholder bullets. This sweep removes any <li>
   whose ONLY descendants are an .fk-bullet-icon-container — i.e.
   a bullet that has no text body. Runs once after DOM ready and
   again after lazy-load fires.
   ============================================================ */
(function(){
  function sweep(){
    document.querySelectorAll('ul.fk-bullet > li').forEach(function(li){
      var hasText = li.querySelector('[data-text]');
      var text = (li.textContent || '').replace(/\s+/g,'').trim();
      if (!hasText && text.length === 0){
        li.remove();
      }
    });
  }
  if (document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', sweep);
  } else {
    sweep();
  }
  // Run once more after window load in case lazy content injects more
  window.addEventListener('load', function(){ setTimeout(sweep, 100); });
})();
</script>

