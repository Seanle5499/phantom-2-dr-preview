<script id="shila-scroll-events-v32">
/* v32 Sprint 6 — Scroll engagement events (25/50/75/100% depth) */
(function(){
  var fired = {25:false, 50:false, 75:false, 100:false};
  function check(){
    var docHeight = Math.max(document.body.scrollHeight, document.documentElement.scrollHeight);
    var pct = Math.round(((window.scrollY + window.innerHeight) / docHeight) * 100);
    [25, 50, 75, 100].forEach(function(t){
      if (!fired[t] && pct >= t) {
        fired[t] = true;
        try { if(window.fbq) fbq('track','ViewContent', {scroll_depth: t + '%', content_name:'ShilaSource Advertorial'}); } catch(_e){}
        try { if(window.gtag) gtag('event','scroll', {percent_scrolled: t}); } catch(_e){}
        try { if(window.dataLayer) dataLayer.push({event:'shila_scroll', depth: t, page:'ed-av01-shilasource-shilajit-resin'}); } catch(_e){}
        try { if(window.TriplePixel) TriplePixel('event','ScrollDepth',{depth: t, page:'ed-av01-shilasource-shilajit-resin'}); } catch(_e){}
      }
    });
  }
  window.addEventListener('scroll', check, {passive:true});
  setTimeout(check, 500);  // Initial check in case page is short
})();
</script>
