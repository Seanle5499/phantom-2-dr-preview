(function(){
  var root = document.getElementById('shila-comments');
  if (!root) return;
  root.addEventListener('click', function(e){
    var t = e.target.closest('a.fbc-action.fbc-like, a.fbc-action.fbc-reply, a.fbc-action');
    if (!t) return;
    e.preventDefault();
    if (t.classList.contains('fbc-like')) {
      var li = t.closest('li.fbc-comment');
      var likes = li.querySelector('.fbc-likes');
      var count = likes.querySelector('.fbc-likecount');
      var base = parseInt(likes.dataset.base, 10) || 0;
      if (t.classList.contains('fbc-liked')) {
        t.classList.remove('fbc-liked');
        count.textContent = base;
      } else {
        t.classList.add('fbc-liked');
        count.textContent = base + 1;
      }
    }
  });
})();
</script>
