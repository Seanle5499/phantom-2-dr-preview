<script id="shila-video-lazyload-v30">
/* v30 — IntersectionObserver lazy-loader for shila-19.mp4 (2.44 MB)
   Replaces autoplay+src= with data-src; loads + plays only when scrolled into viewport. */
(function(){
  var v = document.getElementById('is2i96r');
  if (!v) return;
  function load(){
    if (v.src) return;
    v.src = v.dataset.src;
    v.load();
    // FunnelKonnekt video was autoplay/loop/muted — preserve that intent on lazy hydrate
    v.setAttribute('autoplay','');
    var p = v.play();
    if (p && typeof p.catch === 'function') p.catch(function(){});
  }
  if (!('IntersectionObserver' in window)) {
    load();
    return;
  }
  var obs = new IntersectionObserver(function(entries, o){
    entries.forEach(function(e){
      if (!e.isIntersecting) return;
      load();
      o.disconnect();
    });
  }, {rootMargin: '300px'});
  obs.observe(v);
})();
</script>

