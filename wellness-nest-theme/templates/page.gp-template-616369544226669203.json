        "ggdS_hpsEWN_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0810/1563/6283/files/cz_15.webp",
        "ggdkBN7Uv-9_text": "Balíček 1",
        "gge-tO3Vhsw_text": "<p><span style=\"background-color:rgb(253,253,253);color:rgb(26,26,26);\"><strong>137 235+ zákazníků • Hodnocení 4.9/5 • 🔬 2 zprávy z nezávislých laboratoří</strong></span></p>",
