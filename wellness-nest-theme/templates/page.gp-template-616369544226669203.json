        "ggEstdqh4of_childItem_0": "<p>Předplaťte si a ušetřete 10 %: <strong>$44.95</strong>/sklenička</p>",
        "ggEstdqh4of_childItem_1": "<p>Jednorázový nákup: <strong>$49.95</strong>/sklenička</p>",
