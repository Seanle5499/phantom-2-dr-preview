    "gp_section_562301697247085442": {
      "type": "gp-section-562301697247085442",
      "settings": {
        "checksum": "a9912fa7e6fb02f98f5043d4f987d0b7ceff0be1e904631d4d616306d9411ee8_1_1_1_0__1",
        "gKegGvhiFSodc_text": "<p>Your Complete Menopause Solution:<span style=\"color:#F582AE;\"> Powerful Ingredients in Each Daily Dose</span></p>",
        "gaGcIecDtdtzx_text": "<p>Take just 2 easy-to-swallow capsules each morning to experience the full spectrum of MenoMate benefits:</p>",
        "gjJnWNpZOTySq_text": "<p><span style=\"color:#772B90;\">Hormonal Balance &amp; Metabolism Support</span></p>",
        "gAmOvQRqiCwIE_srcSet_desktop_src": "https://ucarecdn.com/ee6d5074-1640-4cc7-8933-47c8589c3dee/-/format/auto/",
        "gVoJlYyNRyEBd_text": "<p>MenoMate Probiotic Blend&nbsp;</p><p>(10 Billion CFU)</p>",
        "gutRBpVZekmCl_text": "<p>Our proprietary blend of Bifidobacterium lactis, Bifidobacterium breve, and Lactobacillus gasseri works to rebalance your gut microbiome, supporting natural GLP-1 production and targeting hormonal belly fat.</p>",
        "gXRihLaNzKXIo_srcSet_desktop_src": "https://ucarecdn.com/ee6d5074-1640-4cc7-8933-47c8589c3dee/-/format/auto/",
        "grRcSNqJElipu_text": "<p>DIM (Di-Indolylmethane)(40 mg)</p>",
        "gSQnIcHkcuegV_text": "<p>This powerful compound derived from cruciferous vegetables helps your body metabolize estrogen properly, reducing \"estrogen dominance\" that contributes to weight gain and mood swings.</p>",
        "gdkheNCrsCEnB_srcSet_desktop_src": "https://ucarecdn.com/ee6d5074-1640-4cc7-8933-47c8589c3dee/-/format/auto/",
        "ggtI_NdZpyi_text": "<p>Curry Leaf Extract (50 mg)</p>",
        "gWNEgrXwISGvZ_text": "<p>Rich in antioxidants that support healthy metabolism and blood sugar regulation, helping to reduce cravings and prevent energy crashes.</p>",
        "ggTqqJzd_XR_text": "<p><span style=\"color:#772B90;\"><strong>Hot Flash &amp; Comfort Support</strong></span></p>",
        "gIIaFYwrufEkr_srcSet_desktop_src": "https://ucarecdn.com/ee6d5074-1640-4cc7-8933-47c8589c3dee/-/format/auto/",
        "ggIvBqtc12B_text": "<p>Black Cohosh (40 mg)</p>",
        "gTCCTwLpNwaAO_text": "<p>Extensively studied for its ability to reduce hot flashes and night sweats by up to 70% in clinical trials.</p>",
        "gCFBFEsOFOcDD_srcSet_desktop_src": "https://ucarecdn.com/ee6d5074-1640-4cc7-8933-47c8589c3dee/-/format/auto/",
        "gPdLZGzkJDaih_text": "<p>Turmeric Root Extract (350mg)</p>",
        "gcUJtTYRUzCTz_text": "<p>Nature's anti-inflammatory powerhouse helps soothe joint discomfort, reduce bloating, and support overall comfort.</p>",
        "ggeGspWzvEC_text": "<p><span style=\"color:#772B90;\"><strong>Gut Health &amp; Bloating Relief</strong></span></p>",
        "gEIRvvjjTgfNT_srcSet_desktop_src": "https://ucarecdn.com/ee6d5074-1640-4cc7-8933-47c8589c3dee/-/format/auto/",
        "guWDNgLGfqtcY_text": "<p>Inulin (337.5 mg)</p>",
        "gWvjqFycZeolt_text": "<p>This prebiotic fiber feeds beneficial gut bacteria, reducing bloating while supporting healthy digestion and natural weight management.</p>",
        "gnXKTeiPpIhsY_srcSet_desktop_src": "https://ucarecdn.com/ee6d5074-1640-4cc7-8933-47c8589c3dee/-/format/auto/",
        "gAoTpzpymQwKL_text": "<p>Moringa Leaf Extract (35 mg)</p>",
        "gvzJTnMfwjLBR_text": "<p>&nbsp;Packed with over 90 nutrients and 46 antioxidants to support cellular health, energy production, and immune function.</p>",
        "ggk2SXem_rE_text": "<p><span style=\"color:#772B90;\"><strong>Absorption &amp; Efficacy Enhancers</strong></span></p>",
        "ggCdCS75t3j_srcSet_desktop_src": "https://ucarecdn.com/ee6d5074-1640-4cc7-8933-47c8589c3dee/-/format/auto/",
        "ggyyeQRIGm__text": "<p>Bioperine® Organic Black Pepper Extract (3 mg)</p>",
        "ggLWp1eFv0i_text": "<p>Increases absorption of turmeric and other key ingredients by up to 2000%, ensuring you get the full benefit of every ingredient.</p>",
        "ggR-a4A-mLh_srcSet_desktop_src": "https://ucarecdn.com/ee6d5074-1640-4cc7-8933-47c8589c3dee/-/format/auto/",
        "ggVC_GinTI1_text": "<p>Delayed-Release Capsule Technology</p>",
        "ggUg2n8mQDs_text": "<p>Protects our probiotics from harsh stomach acid, delivering them intact to your intestines where they can do their most important work.</p>",
        "ggTno9YwrbB_label": "<p>Try MenoMate Now!</p>",
        "ggVRcwfpJhe_text": "<p>90-Day Money-back Guarantee</p>"
      }
    },
    "gp_section_562301697247150978": {
      "type": "gp-section-562301697247150978",
      "settings": {
        "checksum": "007b44beda136e9b97df5e897149679f639da9596515c033d376109e7e177277_1_1_1_0__1",
