        "ggFBPTAi2Ra_srcSet_desktop_src": "https://ucarecdn.com/ee6d5074-1640-4cc7-8933-47c8589c3dee/-/format/auto/",
        "ggvMpP7JkCY_text": "Elizabeth Ross",
