        "ggmF2vXszfl_background_mobile_video": "https://www.youtube.com/watch?v=cyzh48XRS4M",
        "ggmF2vXszfl_background_mobile_videoHtml5": "https://media.w3.org/2010/05/sintel/trailer.mp4",
        "ggAl3gYLvKu_text": "<p>In a landmark 12-week clinical study, participants taking this specific probiotic strain experienced:</p>",
        "ggwMllU6Clf_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0810/1563/6283/files/fat_1.png?v=1744715821",
        "gg_5yVmBGcA_text": "<p>8.5% reduction in visceral belly fat</p>",
        "gg32sEKRZME_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0810/1563/6283/files/diet.png?v=1744715820",
        "ggZ27A6A5ND_text": "<p>Significant decrease in waist circumference</p>",
        "gg41VpY4CzY_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0810/1563/6283/files/trending.png?v=1744715959",
        "ggO2nvofG4y_text": "<p>Improved metabolic markers</p>",
        "ggtbWaCYp21_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0810/1563/6283/files/Untitled_design_22.png?v=1744545029",
        "ggUBeAyc45h_text": "<p>In a landmark 12-week clinical study, participants taking this specific probiotic strain experienced:</p>",
        "ggnDans0Sum_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0810/1563/6283/files/fat_1.png?v=1744715821",
        "ggyQd9TuRws_text": "<p>8.5% reduction in visceral belly fat</p>",
        "ggChUp3vx4a_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0810/1563/6283/files/diet.png?v=1744715820",
        "ggJyrZsEpCG_text": "<p>Significant decrease in waist circumference</p>",
        "ggHOLkMvb61_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0810/1563/6283/files/trending.png?v=1744715959",
        "ggTdzJ_cEtk_text": "<p>Improved metabolic markers</p>",
        "gguT9efMSKt_text": "<p><span style=\"font-size:px;\">All <u>without</u> changing their diet or exercise routine.</span></p>",
        "ggqiRgShmvj_text": "<p>MenoMate combines this powerful probiotic with 7 additional targeted ingredients designed to address every aspect of menopause—from hot flashes to energy levels to mood stability.</p>"
      }
