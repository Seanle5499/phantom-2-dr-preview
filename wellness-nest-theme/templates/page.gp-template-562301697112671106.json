        "checksum": "b04a285ebcf4e60db68b0166823753c39fb3a956a1b65f70b63356f4439e0d81_1_1_1_0__1",
        "ggfVJWVtq26_text": "<p>The Science Behind&nbsp;</p><p><span style=\"color:#772B90;\">MenoMate</span>'s Hormonal Belly Fat Solution</p>",
        "gqkWtmqeEUwsT_text": "<p>At the heart of MenoMate is our powerful probiotic blend, featuring Lactobacillus gasseri—the same strain clinically proven to target abdominal fat during hormonal transitions.</p>",
        "ggmF2vXszfl_background_desktop_image_src": "https://cdn.shopify.com/s/files/1/0810/1563/6283/files/gempages_501444340413891578-dd790d3c-195e-4bf9-bff4-c8a22c9525fd.png",
