    "gp_section_573918798241006361": {
      "settings": {
        "checksum": "fb3f6520f4893f1604566414af5babb6c0b491bd070265e3001906ed884ec6f6_1_1_0_0__1",
        "gFZtuJthKwTup_text": "<span style=\"color:#EE2E8D;\">FloraFresh</span>: Your Complete Feminine Wellness System",
        "gcZWVLbedZTXv_text": "<p><span style=\"color:#EB5D46;\"><strong>One simple daily capsule</strong></span> delivers comprehensive support without complicated routines, messy applicators, or embarrassing treatments</p>",
        "gg8voEKevFA_text": "<p>🌿</p>",
        "ggFwOjuEWcl_text": "<p><strong>From Discomfort to Confidence&nbsp;</strong><br>Beyond addressing dryness, FloraFresh eliminates embarrassing odor while restoring natural moisture. Women report feeling \"like themselves again\" within just one week as both hydration and healthy flora are restored.</p>",
        "ggL89lagxl7_text": "<p>90-Day Money-back Guarantee</p>",
        "ggR8R-qtnwc_text": "<p><strong>Full-Spectrum Support</strong><br>FloraFresh creates a protective microbiome throughout your urinary and reproductive systems—addressing both hydration and odor prevention through balanced flora and optimal pH levels.</p>",
        "ggRGwyLkjOK_text": "<p><strong>Intimacy Without Hesitation &nbsp;</strong><br>Customers consistently report renewed spontaneity due to FloraFresh's comprehensive approach. As one shared: \"I no longer worry about dryness or odor—I can just enjoy the moment without embarrassment.\"</p>",
        "gg_WktlScvg_text": "<p>💧</p>",
        "ggdTR9soHD8_text": "<p>🛡️</p>",
        "ggdUOAMyZA8_text": "<p><strong>Protection Through Life's Changes</strong><br>Our dual-action formula balances pH and maintains optimal flora throughout hormonal shifts, stress, or changes in intimacy—preventing both dryness and odor during every life stage from early adulthood through menopause.</p>",
        "gglOE-24VcZ_label": "<p>Try FloraFresh Now!</p>",
        "ggp99kvMWj9_text": "<p>🌸</p>"
