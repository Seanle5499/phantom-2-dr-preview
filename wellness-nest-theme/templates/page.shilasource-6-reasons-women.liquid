  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --ss-tint: #E8EDE3;
      --ss-tint-light: #FBFFED;
      --ss-accent: #A8C5A0;
      --ss-accent-dark: #3A5A40;
      --ss-sage: #A8C5A0;
      --ss-forest: #3A5A40;
      --ss-gold: #A8C5A0;
      --ss-gold-light: #FBFFED;
      --text-dark: #1a1a1a;
      --text-mid: #444;
      --text-light: #777;
      --border: #E0EDE0;
      --white: #FFFFFF;
      --max-w: 1000px;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Inter', sans-serif;
      background: #faf8f7;
      color: var(--text-dark);
      line-height: 1.65;
      font-size: 15px;
      -webkit-text-size-adjust: 100%;
    }

    /* ── HEADER ── */
    .site-header {
      background: var(--ss-accent);
      padding: 10px 20px;
      text-align: center;
      position: unset;
      top: 0;
      z-index: 200;
      box-shadow: 0 2px 12px rgba(0,0,0,0.15);
    }
    .site-header .brand {
        font-family: 'Inter', sans-serif;
      font-size: 26px;
      font-weight: 700;
      color: var(--white);
      letter-spacing: 0.02em;
    }
    .site-header .tagline {
      font-size: 14px;
      color: rgba(255,255,255,0.82);
      letter-spacing: 0.07em;
      text-transform: uppercase;
    }

    /* ── WRAPPER ── */
    .wrapper {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 0 18px;
    }

.wrapper2 {
      max-width: 800px;
      margin: 0 auto;
      padding: 30px 18px;
    }

    /* ── HERO ── */
    .hero {
      background: var(--white);
      padding: 18px 0 14px;
      
    }
    .hero .category-label {
      display: inline-block;
      background: var(--ss-tint);
      color: var(--ss-accent-dark);
      font-size: 0.62rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 4px 12px;
      border-radius: 20px;
      margin-bottom: 11px;
    }
    .hero h1 {
      font-family: 'Inter', sans-serif;
      font-size: clamp(1.45rem, 4.5vw, 2.05rem);
      font-weight: 700;
      line-height: 1.2;
      color: var(--text-dark);
      margin-bottom: 7px;
    }
    .hero .subtitle {
      font-size: 0.9rem;
      color: var(--text-mid);
      font-style: italic;
      margin-bottom: 13px;
    }
    .meta-bar {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 0;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .meta-bar img {
      width: 50px; height: 50px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid var(--ss-tint);
      flex-shrink: 0;
    }
    .meta-bar .meta-text .author { font-weight: 600; font-size: 18px; }
    .meta-bar .meta-text .date { font-size: 16px; color: var(--text-light); }
    .meta-bar .reading-time { margin-left: auto; font-size: 16px; color: var(--text-light); white-space: nowrap; }

    /* ── ARTICLE BODY ── */
    .article-body {
      background: var(--white);
      padding: 16px 0 6px;
    }
    .article-body p {
      color: var(--text-mid);
      margin-bottom: 10px;
      font-size: 20px;
      line-height: 1.2;
    }
    .article-body .intro-hook {
      font-size: 20px;
      font-weight: 500;
      color: var(--text-dark);
      border-left: 3px solid var(--ss-accent);
      padding-left: 14px;
      margin-bottom: 12px;
    }

    /* ── SECTION DIVIDER ── */
    .section-divider {
      border: none;
      border-top: 1px solid #f0e8e8;
      margin: 16px 0;
    }

    /* ── REASON BLOCKS ── */
    .reasons-section {
      background: var(--white);
      padding: 40px  16px;
    }

    .reason-block {
      display: grid;
      grid-template-columns: 269px 1fr;
      gap: 35px;
      align-items: start;
      margin-bottom: 20px;
    }
    .reason-block:last-child { margin-bottom: 8px; }

    .reason-image {
      width: 100%;
      border-radius: 10px;
      display: block;
      object-fit: cover;
      height: 230px;
      box-shadow: 0 3px 12px rgba(0,0,0,0.09);
    }

    /* Number + headline on same line */
    .reason-heading {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 6px;
      flex-wrap: nowrap;

    }
    .reason-number {
      display: inline-flex;
      align-items: center; justify-content: center;
      width: 33px; height: 33px;
      background: var(--ss-sage);
      color: var(--white);
      font-size: 0.72rem; font-weight: 700;
      border-radius: 50%;
      box-shadow: 0 2px 8px rgba(168, 197, 160,0.35);
      flex-shrink: 0;
      margin-right:10px
    }
    .reason-block h2 {
      font-family: 'Inter', sans-serif;
      font-size: 28px; font-weight: 700;
      color: var(--text-dark);
      line-height: 1.25;
      margin: 0;
    }
    .reason-block p {
      color: var(--text-mid);
      font-size: 20px; line-height: 1.2;
      margin-top: 16px;
    }

    /* ── PULL QUOTE ── */
    .inline-nudge {
      background: var(--ss-gold-light);
      border-left: 3px solid var(--ss-gold);
      border-radius: 0 8px 8px 0;
      padding: 11px 15px;
      margin: 14px 0;
      font-size: 16px;
      color: #6b4a1a;
      font-style: italic;
      line-height: 1.6;
    }

    /* ══════════════════════════════════
       URGENCY / OFFER BOX
    ══════════════════════════════════ */
    .urgency-section {
      background: #FBFFED;
      padding: 10px 0 18px;
    }

    .urgency-box {
      background: var(--white);
      border: 2px solid var(--ss-sage);
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 10px 40px rgba(168, 197, 160,0.2);
    }

    .urgency-box .flash-banner {
      background: var(--ss-forest);
      color: #FFFFFF;
      text-align: center;
      padding: 12px 16px;
      font-size: 0.77rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .urgency-box .flash-banner .flash-dot {
      width: 8px; height: 8px;
      background: #FFFFFF;
      border-radius: 50%;
      animation: pulse 1s infinite;
      flex-shrink: 0;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(1.4); }
    }

    .stock-meter-wrap { padding: 13px 20px 0; }
    .stock-meter-label {
      display: flex;
      justify-content: space-between;
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--ss-forest);
      margin-bottom: 5px;
    }
    .stock-meter-bar {
      height: 8px;
      background: #FBFFED;
      border-radius: 4px;
      overflow: hidden;
    }
    .stock-meter-fill {
      height: 100%;
      width: 8%;
