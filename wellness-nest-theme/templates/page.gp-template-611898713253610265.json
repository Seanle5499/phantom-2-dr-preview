        "ggjWegnkXuS_text": "<p><strong>FORSCHUNGSLEITER • UNIVERSITÄT OXFORD</strong></p>",
        "ggvugp_JOgb_text": "<p><strong>Dr. Med.  L.D Mansor der P.H.Doctor</strong></p>",
