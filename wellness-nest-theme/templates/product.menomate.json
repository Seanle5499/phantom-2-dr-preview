        "collapsible_row_TVNFXE": {
          "type": "collapsible_row",
          "settings": {
            "heading": "È solo per donne? Gli uomini possono prenderlo?",
            "icon": "quiz",
            "filled_icon": false,
            "row_content": "<p><strong>Solo donne.</strong> Formulato specificamente per ormoni della menopausa/perimenopausa. Uomini con dolori articolari - consigliamo formule articolari per uomini invece.</p>",
            "page": ""
          }
        },
        "collapsible_row_nqD9hG": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Quali sono gli ingredienti effettivi?",
            "icon": "quiz",
            "filled_icon": false,
            "row_content": "<p><strong>Formula medica:</strong> 10 Miliardi UFC Probiotici, Inulina (prebiotico), DIM (equilibrio ormonale), Black Cohosh (vampate), Curcuma (infiammazione), Moringa (energia), Bioperine® (assorbimento). <strong>ZERO ormoni, ZERO soia, ZERO glutine.</strong></p>",
            "page": ""
          }
        },
        "collapsible_row_xQrpXj": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Cosa succede se smetto di prenderlo?",
            "icon": "quiz",
            "filled_icon": false,
            "row_content": "<p><strong>Risposta onesta: i sintomi tornano in 5-7 giorni.</strong> Questo gestisce i sintomi, non cura la menopausa. Per questo il 73% delle clienti si abbona - risparmia e arriva automaticamente.</p>",
            "page": ""
          }
        },
        "collapsible_row_4bAkmy": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Ci sono effetti collaterali?",
            "icon": "quiz",
            "filled_icon": false,
            "row_content": "<p><strong>Rari e lievi.</strong> Alcune donne hanno leggero gonfiore i primi 2-3 giorni mentre i probiotici si adattano. Se hai reflusso o stomaco sensibile, prendi con cibo. Smetti se qualcosa non va.</p>",
            "page": ""
          }
        },
        "collapsible_row_BF8899": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Perché scegliere MenoMate rispetto ad altri?",
            "icon": "quiz",
            "filled_icon": false,
            "row_content": "<p><strong>Risolviamo i sintomi strani che altri ignorano</strong> - dolore all'anca, prurito orecchie, insonnia delle 3 del mattino. La maggior parte dei brand mira solo alle vampate. Più risultati in giorni, non mesi. <strong>Garanzia 90 giorni soddisfatti o rimborsati</strong> se non funziona.</p>",
            "page": ""
          }
