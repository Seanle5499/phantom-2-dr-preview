    "collapsible_content_UjwzNk": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_Nd7Hbw": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Estratto di Radice di Curcuma (350 mg) – “L’Estintore Naturale\"",
            "icon": "check_box",
            "filled_icon": false,
            "custom_icon": "shopify://shop_images/png-transparent-turmeric-powder-bowl-of-turmeric-powder-with-leaves-thumbnail.png",
            "row_content": "<p>Aiuta ad alleviare il fastidio alle articolazioni, ridurre il gonfiore ostinato e supportare un metabolismo naturalmente più veloce—così puoi muoverti liberamente senza dolori fastidiosi.</p>",
            "page": ""
          }
        },
        "collapsible_row_jbCmMH": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Inulina (337,5 mg) – “Il Prebiotico che Appiattisce la Pancia”",
            "icon": "check_box",
            "filled_icon": false,
            "custom_icon": "shopify://shop_images/TASC_inulin_800px800px_con_sombra.webp",
            "row_content": "<p>Alimenta i batteri intestinali benefici per ridurre il gonfiore, frenare le voglie di zucchero e accelerare la perdita di peso sana.</p>",
            "page": ""
          }
        },
        "collapsible_row_wERBxj": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Miscela Probiotica MenoMate (10 miliardi di CFU) – “Il Tuo Gestore del Peso Ormonale”",
            "icon": "check_box",
            "filled_icon": false,
            "custom_icon": "shopify://shop_images/images_2d405c07-e99b-455f-a6eb-33e191251047.jpg",
            "row_content": "<p>3 ceppi probiotici: <em>Bifidobacterium animalis subsp. Lactis, Bifidobacterium breve, Lactobacillus gasseri</em>—ceppi clinicamente studiati che aiutano a ridurre il gonfiore, potenziano l’immunità e stabilizzano gli sbalzi ormonali. Sentiti più leggera, equilibrata e meno incline agli attacchi di \"hanger\".</p>",
            "page": ""
          }
        },
        "collapsible_row_acj3HU": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Estratto di Foglie di Curry (50 mg) – “La Scintilla Metabolica”",
            "icon": "check_box",
            "filled_icon": false,
            "custom_icon": "shopify://shop_images/images_1_275e5e6f-3647-470f-b717-aac4eb1b640b.jpg",
            "row_content": "<p>Ricco di antiossidanti per stimolare il metabolismo e mantenere un livello di zucchero nel sangue sano.</p>",
            "page": ""
          }
        },
        "collapsible_row_kiFzik": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Cimicifuga (40 mg) – “L’Eliminatore delle Vampate di Calore”",
            "icon": "check_box",
            "filled_icon": false,
            "custom_icon": "shopify://shop_images/black-cohosh-steven-foster-square.jpg",
            "row_content": "<p>Riconosciuta da decenni per placare le vampate di calore e le sudorazioni notturne durante la menopausa.</p>",
            "page": ""
          }
        },
        "collapsible_row_GMzWCJ": {
          "type": "collapsible_row",
          "settings": {
            "heading": "DIM (Di-Indolilmetano) (40 mg) – “Il Ripristino degli Estrogeni”",
            "icon": "check_box",
            "filled_icon": false,
            "custom_icon": "shopify://shop_images/hy-15758.gif",
            "row_content": "<p>Regola naturalmente i livelli di \"estrogeno cattivo\", supporta la disintossicazione e calma gli sbalzi d'umore da PMS o menopausa.</p>",
            "page": ""
          }
        },
        "collapsible_row_x4z8YP": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Estratto di Foglie di Moringa (35 mg) – “Fonte di Energia e Immunità”",
            "icon": "check_box",
            "filled_icon": false,
            "custom_icon": "shopify://shop_images/images_2.jpg",
            "row_content": "<p>Ricco di vitamine, minerali e antiossidanti per combattere la fatica e supportare una funzione immunitaria sana.</p>",
            "page": ""
          }
        },
        "collapsible_row_33Tdk8": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Bioperine® Organic Black Pepper Extract (3 mg) – “The Absorption Amplifier”",
            "icon": "check_box",
            "filled_icon": false,
            "custom_icon": "shopify://shop_images/pepper-extract-peperine-500x500.webp",
            "row_content": "<p>Garantisce che ogni goccia preziosa della formula di MenoMate raggiunga il suo obiettivo per un effetto massimo.</p>",
            "page": ""
          }
        }
      },
