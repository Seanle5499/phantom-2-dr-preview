        "ggLnTF7QCwd_text": "<span style=\"color:#3A5A40;\">Νόστιμα. Φορητά.</span><br><span style=\"background-color:rgba(189,229,34,0.77);color:#3A5A40;\"><i>Υποστηριζόμενα από Μελέτες.</i></span>",
