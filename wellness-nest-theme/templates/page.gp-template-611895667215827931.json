    "gp_section_611895667450708955": {
      "type": "gp-section-611895667450708955",
      "settings": {
        "checksum": "be333470910e6111fcd6a5cb95bcddedabfe9108849715a76fc81a503883df6f_1_1_1_0__1",
        "ggEk8Xn4gbS_text": "Υποστηρίζεται από Αποτελέσματα",
        "ggJzxrZWFV-_text": "<strong>Τα Αποτελέσματα Ξεκινούν Με Αποδείξεις</strong>",
        "gg-7L9URhXs_text": "<p>87+ απαραίτητα μέταλλα, βιταμίνες και αμινοξέα που υπάρχουν φυσικά στην αυθεντική ρητίνη Shilajit Ιμαλαΐων — τροφοδοτώντας το σώμα σας σε κυτταρικό επίπεδο.</p>",
        "gga8bEpOCCM_text": "16.500+",
        "ggt9JaRUEOL_text": "<p>Οι γυναίκες παγκοσμίως εμπιστεύονται το ShilaSource Himalayan Shilajit Resin για τη διαχείριση των συμπτωμάτων της εμμηνόπαυσης και την αποκατάσταση της ορμονικής ισορροπίας καθημερινά.</p>",
        "ggnwCGkjnxo_text": "<strong>87%</strong>",
