    "gp_section_610325574644204332": {
      "type": "gp-section-610325574644204332",
      "settings": {
        "checksum": "70a316cda70253c6c5fb7769e03950f6ea1422eafabcfca3845ae4d3f69fbd12_1_1_1_0__1",
        "ggyzO0s4Gar_text": "<p><strong>RÓŻNICA</strong></p>",
        "ggTetDGzBBM_text": "<strong>poznaj naszą radę medyczną</strong><br><span style=\"background-color:rgba(189, 229, 34, 0.77);\"><i><strong>która naprawdę to testuje</strong></i></span>",
        "ggN0q80cPLb_text": "<p><span style=\"font-size:px;\">\"Różnica między FusiForce a większością żelek z kreatyną na rynku to protokół testowy. Testują gotowy produkt — po produkcji — co jest jedynym sposobem, aby wiedzieć, co naprawdę dostajesz. Nasze laboratorium przetestowało setki suplementów. To jeden z nielicznych, który konsekwentnie dostarcza to, co obiecuje etykieta.\"</span></p>",
