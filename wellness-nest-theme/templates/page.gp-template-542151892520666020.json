    "gp_section_542151892822983588": {
      "settings": {
        "checksum": "57c97d36d2a7680730620fd53f48817f2e7f4184e9eaa2ddeb4a8f249d53f40a_1_1_0_0__1",
        "gg15tYQafkp_text": "<p>Verbessert die kognitiven Funktionen, reduziert Stress und stärkt das Immunsystem.</p>",
        "gg3Fbfyt7_O_text": "Primavie® gereinigtes Shilajit:",
        "gg4WSyo-UPP_text": "minimaler, natürlicher Inhaltsstoff:",
        "gg5kVenRKnk_text": "<p>Fördert bessere gesundheitliche Ergebnisse und trägt zur ökologischen Nachhaltigkeit bei.</p>",
        "gg93yBx6xUC_text": "<p>$4.90</p>",
        "ggAE_whKtVu_text": "90 Tage Rückgaberecht",
        "ggCCXwknqso_text": "Shilajit Shockwave",
        "ggGgMGzrKMs_text": "Koffein-Extrakt:",
        "ggGhojVF4B4_text": "Erfahren Sie, warum 11.523 Menschen Shilajit Shockwave als ihr bevorzugtes Supplement gewählt haben, um Körper und Geist aufzuladen.",
        "ggInjcOYDDr_text": "Arzt formuliert",
        "ggLn9JARsz-_text": "Tulsi-Extrakt (heiliges Basilikum):",
        "ggQ5UP8HQMw_text": "<p>$0.6</p>",
        "ggUP68fefOu_text": "Unsere Vorgesetzten",
        "ggUTleWD9_p_text": "<p>Steigert die ATP-Produktion, ein Schlüsselmolekül für die Energieerzeugung in Zellen.</p>",
        "ggYW5Td62jK_text": "<p>Sandy B. 33</p>",
