    "gp_section_542151892822786980": {
      "settings": {
        "checksum": "040cc4a5509a2738dac52b7b67ee968633f3712e9694a1576dc8d203950b867c_1_1_0_0__1",
        "gg5W5gHQbeH_text": "<p><strong>Antwort: </strong>Shilajit Shockwave ist sehr stark. Wir empfehlen, mit nur wenigen Tropfen zu beginnen. Sobald Sie sich an die Erfahrung gewöhnt haben, können Sie die Dosierung nach Ihrem Geschmack erhöhen.<br>Für eine maximale Wirksamkeit geben Sie 1ml (einen vollen Tropfen) in den Mund, schlucken Sie und atmen Sie ein paar Mal tief ein.</p>",
        "ggBPrG0AB_o_text": "<p><strong>Antwort: </strong>Eine wirksame Methode, um Ihre Atemwege zu beeinflussen. Liefert Ergebnisse, die Sie spüren können. Die Wirkung tritt innerhalb von Sekunden ein.</p>",
        "ggFS9EWWdaD_text": "<p><strong>Antwort: </strong>Antwort: Ja! Wir haben viele positive Rückmeldungen von Asthmatikern und Menschen mit anderen Atembeschwerden erhalten, die Shilajit Shockwave verwenden. Bisher wurden keine Kontraindikationen gemeldet.</p>",
        "ggH3Z11_Xhc_text": "Häufig gestellte Fragen",
        "ggRHC6fQkMY_text": "Shilajit Shockwave - laden Sie Ihren Tag mit natürlicher Energie und geistiger Klarheit au",
        "ggb7jdTkHgP_childItem_0": "<p>Erobern Sie Ihren Tag mit neuem Elan und geistiger Klarheit.</p>",
        "ggb7jdTkHgP_childItem_1": "<p>Bewahre Ruhe und Stärke, auch in schwierigen Zeiten.</p>",
        "ggb7jdTkHgP_childItem_2": "<p>Erschließen Sie das volle Potenzial Ihres Körpers für Spitzenleistungen.</p>",
        "ggr10dL76E0_text": "<p><strong>Antwort: </strong>Sie spüren die Wirkung von Shilajit Shockwave fast sofort. Die vollen Leistungsvorteile stellen sich im Laufe von 3-5 Minuten ein und halten typischerweise 4-5 Stunden an, je nach Person.</p>",
        "ggyPvX-7RJg_childItem_0": "<p>WARUM SHILAJIT IN TROPFENFORM?</p>",
        "ggyPvX-7RJg_childItem_1": "<p>WIE SOLLTE DIESES PRODUKT VERWENDET WERDEN?</p>",
        "ggyPvX-7RJg_childItem_2": "<p>WIE LANGE HALTEN SIE?</p>",
        "ggyPvX-7RJg_childItem_3": "<p>SIND SIE FÜR ASTHMATIKER SICHER?</p>"
      },
