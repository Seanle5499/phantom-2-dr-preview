        "ggTSvyHdogl_text": "<p><strong>Stalled Gains</strong></p>",
        "gg_NveHZYES_text": "<p>Muscles need ATP for protein synthesis and recovery</p>",
        "ggqyZZA_xOD_text": "<p><strong>Bloating</strong></p>",
        "ggUSj7qbrfx_text": "<p>Digestion requires ATP for proper gut function</p>",
        "ggMqVpLiBm1_text": "<p><strong>Low Energy</strong></p>",
        "ggKAtt-BbZj_text": "<p>Low ATP = your cellular battery is drained</p>"
      }
    },
