        "checksum": "0eb2a4ae262e27bd9b5cb6d02f839255cee46ffa27cb477dd86e9465a7824bee_1_1_1_0__1",
        "ggEk8Xn4gbS_text": "STÖDD AV KLINISKA STUDIER",
        "ggJzxrZWFV-_text": "Resultat Börjar Med Bevis",
        "gg-7L9URhXs_text": "<p>87+ Essentiella mineraler, vitaminer och aminosyror naturligt närvarande i äkta Himalaya Shilajit-harts — ger din kropp energi på cellnivå.</p>",
        "gga8bEpOCCM_text": "93%",
