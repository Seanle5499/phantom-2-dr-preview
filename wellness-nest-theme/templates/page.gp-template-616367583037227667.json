        "gg5_D89t81q_text": "<p><span style=\"background-color:rgba(255,255,255,0.02);color:rgb(0,0,0);font-size:px;\"><strong>Luis G.</strong></span></p>",
        "ggEZPOwYAc6_text": "<span style=\"font-size:px;\">Il miglior shilajit che abbia mai comprato.</span>",
