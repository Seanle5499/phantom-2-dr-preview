        "ggcDjVgYqcx_text": "Klaar om jezelf weer te voelen?",
        "gghCBpXD5sY_text": "<p>Ik Ben Al 11 Weken Niet Meer Doorweekt Wakker Geworden.&nbsp;</p>",
        "ggaxQlqOwSI_text": "<p><strong>Deborah F., verpleegkundige, </strong>38 jaar · 5 maanden gebruik</p>",
        "ggTks5AA7sd_text": "<p>Ik Nam Het Initiatief op een Dinsdag. Twee Keer. Hij Wist Niet Wat Hem Overkwam.</p>",
        "ggWoAV_rxKV_text": "<p><strong>Christine A.,</strong> 36 jaar · 2 maanden gebruik</p>",
        "ggiMNj71_P6_text": "<p>Ik Kocht Het voor de Overgang. Ik Bleef omdat Mijn Hoofd Weer Werkte.&nbsp;</p>",
        "ggCg3PiUx1H_text": "<p><strong>Laura G.,</strong> 44 jaar · 4 maanden gebruik</p>",
        "ggNA2HROGTw_text": "<p><strong>Ik Kan Weer een Pot Openen Zonder Pijn te Vertrekken. Meer Hoef Ik Niet te Zeggen.&nbsp;</strong></p>",
        "gg4-hffOEzl_text": "<p><strong>Susan T.,</strong> 42 jaar · 4 maanden gebruik</p>",
        "ggAYGDh6Yc__label": "<p>PROBEER SHILASOURCE VANDAAG NOG!</p>",
        "gge-eqiY3ZG_childItem_0": "<p>GRATIS verzending vanaf 65 €</p>",
